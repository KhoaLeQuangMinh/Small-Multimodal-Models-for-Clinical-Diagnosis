{"case_id": "amebiasis", "disease": "Amebiasis", "extraction": {"entities": [{"name": "Amebiasis", "type": "Disease", "description": "Invasive protozoan infection caused by Entamoeba histolytica, manifesting primarily as amoebic colitis (dysentery) or extraintestinal amoebic liver abscess."}, {"name": "Ingestion of Chlorine-Resistant Entamoeba histolytica Cysts via Contaminated Water or Food", "type": "Vector_Exposure", "description": "Fecal-oral transmission route involving consumption of drinking water or raw unwashed produce contaminated with infectious, quadri-nucleate cysts resistant to standard water chlorination."}, {"name": "Oral-Anal Sexual Contact and Institutional Crowding", "type": "Vector_Exposure", "description": "Person-to-person transmission pathway through oral-anal sexual contact (notably among men who have sex with men) or high-density institutional living environments and day-care centers."}, {"name": "Travel or Residence in Tropical Endemic Regions with Deficient Municipal Sanitation", "type": "Vector_Exposure", "description": "Epidemiological exposure in tropical and subtropical regions lacking municipal water sanitation, including the Indian subcontinent, sub-Saharan Africa, Mexico, Central/South America, and Southeast Asia."}, {"name": "Adult Male Sex Aged 20 to 50 with Chronic Alcohol Consumption", "type": "Vector_Exposure", "description": "Demographic risk group with a 7- to 10-fold higher incidence of amoebic liver abscess, with heavy alcohol intake and dietary iron acting as potent cofactors."}, {"name": "Entamoeba histolytica", "type": "Pathogen", "description": "Invasive, pathogenic, anaerobic protozoan parasite whose motile trophozoites adhere to colonic epithelium via Gal/GalNAc lectin and destroy tissue via amoebapores and cysteine proteinases."}, {"name": "Anchovy-Paste Liver Abscess Aspirate", "type": "Cardinal_Sign", "description": "Pathognomonic thick, homogeneous, odorless, reddish-brown or chocolate-colored necrotic fluid aspirated from an amoebic hepatic cavity, representing liquefactive necrosis of hepatocytes."}, {"name": "Stool Trophozoites with Ingested Erythrocytes (Erythrophagocytosis)", "type": "Admission_Lab_Imaging", "description": "Diagnostic microscopic identification of motile 15-40 micrometer Entamoeba histolytica trophozoites containing phagocytosed host red blood cells in warm fresh stool wet mount or ulcer exudate."}, {"name": "Discrete Colonic Flask-Shaped Ulcers with Normal Intervening Mucosa", "type": "Admission_Lab_Imaging", "description": "Endoscopic demonstration of classic discrete, collar-button or flask-shaped mucosal ulcerations with undermined necrotic borders separated by normal, uninvolved colonic mucosa."}, {"name": "Hepatobronchial Fistula with Chocolate-Paste Sputum Expectoration", "type": "Cardinal_Sign", "description": "Direct transdiaphragmatic rupture of a superior hepatic lobe amoebic abscess into the bronchial tree causing productive expectoration of large volumes of anchovy-paste sputum."}, {"name": "Solitary Posterior-Superior Right Hepatic Lobe Hypoechoic Lesion on Ultrasound", "type": "Admission_Lab_Imaging", "description": "Bedside ultrasonography demonstrating a solitary (70-85% of cases), round or oval, well-defined hypoechoic mass in hepatic segment VII or VIII abutting the liver capsule without a calcified wall."}, {"name": "Currant Jelly Maroon Bloody Mucoid Dysentery with Subacute Onset", "type": "Cardinal_Sign", "description": "Subacute onset over 1 to 3 weeks of progressive crampy lower abdominal pain, localized tenderness, and 6 to 12 bowel movements daily containing dark red altered blood and mucus with low or absent fever."}, {"name": "Amoebic Liver Abscess Acute Febrile Syndrome without Concurrent Diarrhea", "type": "Cardinal_Sign", "description": "Acute 1- to 2-week presentation of high continuous or remittent fever (38.5-40°C), shaking chills, drenching sweats, and dull RUQ pain, with over 70-80% having no concurrent diarrhea."}, {"name": "Point Tenderness over Liver with Positive Liver Murphy Sign", "type": "Cardinal_Sign", "description": "Exquisite localized tenderness elicited by intercostal percussion or palpation over the right lower rib cage, accompanied by tender, smooth hepatomegaly."}, {"name": "Marked Neutrophilic Leukocytosis without Peripheral Eosinophilia", "type": "Admission_Lab_Imaging", "description": "Admission complete blood count showing marked leukocytosis (12,000-25,000/mcL) with left shift (>10% band forms) in over 80% of liver abscess cases, with normal peripheral eosinophil count."}, {"name": "Elevated Alkaline Phosphatase with Marked Systemic Inflammatory Markers", "type": "Admission_Lab_Imaging", "description": "Admission liver biochemistries showing serum ALP elevated 2- to 4-fold above normal, mild transaminitis (AST/ALT 1.5-3x ULN), preserved bilirubin, and markedly elevated CRP (>100 mg/L) and ESR (>60 mm/h)."}, {"name": "Positive Serum Anti-Amoebic IgG Serology or Fecal Gal/GalNAc Lectin Antigen", "type": "Admission_Lab_Imaging", "description": "Diagnostic seropositivity via serum IgG ELISA/IHA (>95% sensitivity after day 7 of symptoms) or stool ELISA detecting Entamoeba histolytica Gal/GalNAc lectin antigen."}, {"name": "Elevated Right Hemidiaphragm with Sympathetic Pleural Effusion on Chest Radiography", "type": "Admission_Lab_Imaging", "description": "Admission chest X-ray findings showing elevation of the right hemidiaphragm, right lower lobe basilar atelectasis, and a reactive sympathetic right pleural effusion."}, {"name": "Cecal Amoeboma Inflammatory Mass", "type": "Cardinal_Sign", "description": "Exophytic, granulomatous, inflammatory colonic mass usually located in the cecum or ascending colon presenting with a palpable right lower quadrant mass mimicking cecal adenocarcinoma."}, {"name": "Prominent Peripheral Eosinophilia (>1000/mcL or >10%)", "type": "Exclusion_Criterion", "description": "Significant absolute or relative peripheral blood eosinophilia (>1000/mcL or >10%), which definitively indicates an invasive helminthic parasite rather than protozoan amoebiasis."}, {"name": "Foul-Smelling Malodorous or Green Purulent Abscess Aspirate", "type": "Exclusion_Criterion", "description": "Aspirated hepatic cavity fluid that is putrid, foul-smelling, or green/yellow and loaded with bacteria on Gram stain, characteristic of bacterial pyogenic liver abscess."}, {"name": "Negative Serum Amoebic Serology Beyond Day 7 of Hepatic Symptoms", "type": "Exclusion_Criterion", "description": "Absence of detectable serum anti-amoebic IgG antibodies on ELISA or IHA in a patient presenting more than 7 days following the onset of hepatic symptoms."}, {"name": "Hyperacute High Spiking Fever with Dense Sheets of Fecal Neutrophils", "type": "Exclusion_Criterion", "description": "Hyperacute presentation with temperature >39°C, profound systemic toxicity, tenesmus, and fecal microscopy packed with dense sheets of neutrophils/pus cells."}, {"name": "Hepatic Cyst with Thick Calcified Wall and Internal Daughter Vesicles", "type": "Exclusion_Criterion", "description": "Hepatic imaging showing a well-demarcated cystic lesion with a thick calcified laminated wall, internal daughter vesicles, or 'water-lily' sign on ultrasound."}, {"name": "Pyogenic Liver Abscess", "type": "Disease", "description": "Bacterial liver abscess (most commonly E. coli, K. pneumoniae, S. aureus) occurring in older individuals with biliary disease or diabetes, frequently multiple/bilobar and yielding foul purulent exudate."}, {"name": "Echinococcosis (Cystic Hydatid Disease)", "type": "Disease", "description": "Zoonotic larval cestode infection caused by Echinococcus granulosus presenting as an indolent, slow-growing, afebrile calcified liver cyst with daughter vesicles and peripheral eosinophilia."}, {"name": "Bacillary Dysentery (Shigellosis)", "type": "Disease", "description": "Acute bacterial colitis caused by Shigella or Campylobacter species characterized by hyperacute onset, high fever (>39°C), severe systemic toxicity, tenesmus, and abundant fecal pus cells."}, {"name": "Colorectal Carcinoma", "type": "Disease", "description": "Malignant neoplasm of the colon presenting with right iliac fossa mass, weight loss, and cellular dysplasia on biopsy that fails to regress on antimicrobial therapy."}, {"name": "Non-Pathogenic Commensal Entamoeba Infection (E. dispar / E. moshkovskii)", "type": "Disease", "description": "Intestinal colonization by morphologically identical commensal Entamoeba species that lack pathogenic tissue-destructive mechanisms, erythrophagocytosis, or extraintestinal dissemination."}, {"name": "Clinical Defervescence and RUQ Pain Relief within 48 to 72 Hours of Metronidazole", "type": "Drug_Response", "description": "Rapid therapeutic response characterized by defervescence, resolution of night sweats, and marked relief of right upper quadrant pain within 48 to 72 hours of oral or IV metronidazole (750 mg TID)."}, {"name": "Tinidazole Tissue Amebicide Therapy", "type": "Drug_Response", "description": "Rapid clinical cure following once-daily oral tinidazole (2 g daily for 3 to 5 days), offering high tissue amebicidal efficacy with superior gastrointestinal tolerability compared to metronidazole."}, {"name": "Sequential Luminal Amebicide Clearance (Paromomycin / Diloxanide Furoate)", "type": "Drug_Response", "description": "Mandatory subsequent course of non-absorbable luminal amebicides (paromomycin 25-35 mg/kg/day for 7 days or diloxanide furoate 500 mg TID for 10 days) to eradicate persistent intraluminal cysts and prevent relapse."}, {"name": "Standard Antibacterial Penicillins, Aminoglycosides, and Macrolides", "type": "Drug_Response", "description": "Conventional broad-spectrum antibacterial regimens lacking anaerobic protozoocidal activity, resulting in therapeutic failure when administered without nitroimidazoles."}, {"name": "Auranofin Thioredoxin Reductase Inhibition", "type": "Drug_Response", "description": "Inhibition of parasite thioredoxin reductase (EhTrxR) by gold-containing compound auranofin, markedly enhancing amebic susceptibility to reactive oxygen species in colitis and hepatic abscess models."}], "relationships": [{"source": "Amebiasis", "target": "Ingestion of Chlorine-Resistant Entamoeba histolytica Cysts via Contaminated Water or Food", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] Amebiasis is acquired via the fecal-oral route through ingestion of infectious, quadri-nucleate, chlorine-resistant Entamoeba histolytica cysts in fecally contaminated drinking water or raw unwashed produce."}, {"source": "Amebiasis", "target": "Oral-Anal Sexual Contact and Institutional Crowding", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] Amebiasis spreads directly person-to-person through oral-anal sexual practices (particularly among men who have sex with men) or close contact in crowded institutional living environments and day-care facilities."}, {"source": "Amebiasis", "target": "Travel or Residence in Tropical Endemic Regions with Deficient Municipal Sanitation", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Amebiasis exposure occurs predominantly in tropical and subtropical endemic regions characterized by poor municipal sanitation and inadequate municipal water infrastructure."}, {"source": "Amebiasis", "target": "Adult Male Sex Aged 20 to 50 with Chronic Alcohol Consumption", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Amebiasis manifests as amoebic liver abscess overwhelmingly in adult males aged 20 to 50 years (7- to 10-fold higher risk than females), strongly potentiated by heavy alcohol consumption and dietary iron."}, {"source": "Amebiasis", "target": "Entamoeba histolytica", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Amebiasis is etiologically caused by the invasive protozoan Entamoeba histolytica, whose motile trophozoites invade the colonic epithelium and disseminate via the portal venous system to cause liquefactive necrosis."}, {"source": "Amebiasis", "target": "Anchovy-Paste Liver Abscess Aspirate", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Needle aspiration of amoebic liver abscess yields pathognomonic thick, odorless, reddish-brown, chocolate-colored necrotic fluid resembling anchovy sauce or chocolate pudding."}, {"source": "Amebiasis", "target": "Stool Trophozoites with Ingested Erythrocytes (Erythrophagocytosis)", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Direct microscopic identification of motile amoebic trophozoites containing ingested red blood cells (erythrophagocytosis) in fresh warm stool or ulcer exudate confirms invasive Entamoeba histolytica infection."}, {"source": "Amebiasis", "target": "Discrete Colonic Flask-Shaped Ulcers with Normal Intervening Mucosa", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Colonoscopy demonstrates pathognomonic discrete, collar-button or flask-shaped mucosal ulcerations with undermined necrotic borders separated by normal, uninvolved colonic mucosa."}, {"source": "Amebiasis", "target": "Hepatobronchial Fistula with Chocolate-Paste Sputum Expectoration", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Direct transdiaphragmatic extension of a superior right hepatic lobe amoebic abscess into the bronchial tree causes productive expectoration of cups of anchovy-paste sputum via a hepatobronchial fistula."}, {"source": "Amebiasis", "target": "Solitary Posterior-Superior Right Hepatic Lobe Hypoechoic Lesion on Ultrasound", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Bedside ultrasonography identifies a solitary (70-85% of cases), round or oval, well-defined hypoechoic mass located in hepatic segment VII or VIII immediately abutting the liver capsule without a calcified rim."}, {"source": "Amebiasis", "target": "Currant Jelly Maroon Bloody Mucoid Dysentery with Subacute Onset", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Intestinal amebiasis typically presents with insidious, subacute crampy lower abdominal pain and 6 to 12 daily bowel movements of dark red altered blood and mucus (currant-jelly or maroon stool) with low or absent fever."}, {"source": "Amebiasis", "target": "Amoebic Liver Abscess Acute Febrile Syndrome without Concurrent Diarrhea", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Extraintestinal amoebic liver abscess presents with acute high fever (38.5-40°C), shaking chills, drenching diaphoresis, and dull RUQ pain, with over 70-80% of patients having no concurrent diarrhea or gastrointestinal symptoms."}, {"source": "Amebiasis", "target": "Point Tenderness over Liver with Positive Liver Murphy Sign", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Physical examination reveals focal point tenderness over the liver on intercostal percussion or palpation (positive liver Murphy sign) accompanied by smooth, tender hepatomegaly."}, {"source": "Amebiasis", "target": "Marked Neutrophilic Leukocytosis without Peripheral Eosinophilia", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Complete blood count at admission shows marked neutrophilic leukocytosis (12,000-25,000/mcL) with left shift (>10% band forms) in >80% of liver abscess cases, with complete absence of peripheral eosinophilia."}, {"source": "Amebiasis", "target": "Elevated Alkaline Phosphatase with Marked Systemic Inflammatory Markers", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Admission laboratory testing reveals serum alkaline phosphatase elevated 2-4x ULN in >75-80% of cases, mild AST/ALT transaminitis, normal or mildly elevated bilirubin, and intense systemic inflammation with CRP >100 mg/L and ESR >60 mm/h."}, {"source": "Amebiasis", "target": "Positive Serum Anti-Amoebic IgG Serology or Fecal Gal/GalNAc Lectin Antigen", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Diagnostic confirmation at triage is provided by serum anti-amoebic IgG serology (>95% sensitive after day 7 of symptoms) or rapid stool ELISA detection of Entamoeba histolytica Gal/GalNAc lectin antigen."}, {"source": "Amebiasis", "target": "Elevated Right Hemidiaphragm with Sympathetic Pleural Effusion on Chest Radiography", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Admission chest radiography demonstrates elevation of the right hemidiaphragm, right basilar atelectasis, and a sympathetic right-sided pleural effusion overlying the hepatic abscess."}, {"source": "Amebiasis", "target": "Cecal Amoeboma Inflammatory Mass", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Chronic localized amoebic colitis can form an amoeboma, an exophytic inflammatory pseudotumor of the cecum or ascending colon presenting as a palpable right lower quadrant mass."}, {"source": "Amebiasis", "target": "Prominent Peripheral Eosinophilia (>1000/mcL or >10%)", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Presence of significant peripheral blood eosinophilia (>1,000/mcL or >10%) rules out uncomplicated amoebic liver abscess, indicating an invasive helminthic infection (e.g., Fasciola, Toxocara, or Echinococcus)."}, {"source": "Amebiasis", "target": "Foul-Smelling Malodorous or Green Purulent Abscess Aspirate", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Foul-smelling, putrid, or greenish-yellow purulent aspirate containing visible bacteria rules out uncomplicated amoebic liver abscess, which is characteristically odorless and bacteriologically sterile."}, {"source": "Amebiasis", "target": "Negative Serum Amoebic Serology Beyond Day 7 of Hepatic Symptoms", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] A negative serum anti-amoebic IgG serology (ELISA or IHA) in a patient presenting more than 7 days following the onset of hepatic symptoms makes amoebic liver abscess exceptionally unlikely (>95% negative predictive value)."}, {"source": "Amebiasis", "target": "Hyperacute High Spiking Fever with Dense Sheets of Fecal Neutrophils", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Hyperacute explosive onset with high spiking fevers (>39°C), severe systemic prostration, and microscopic sheets of fecal leukocytes rules out uncomplicated amoebic colitis, establishing bacillary dysentery."}, {"source": "Amebiasis", "target": "Hepatic Cyst with Thick Calcified Wall and Internal Daughter Vesicles", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Identification of a thick calcified laminated cyst wall, internal daughter vesicles, or the water-lily sign on ultrasound rules out amoebic liquefactive abscess, indicating echinococcal hydatid disease."}, {"source": "Amebiasis", "target": "Pyogenic Liver Abscess", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from pyogenic liver abscess, which occurs equally in older individuals with biliary/metabolic comorbidities, frequently presents with multiple bilobar lesions, and yields foul bacterial pus requiring prolonged antibiotics and drainage."}, {"source": "Amebiasis", "target": "Echinococcosis (Cystic Hydatid Disease)", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from echinococcosis, which manifests as an indolent, slow-growing, afebrile calcified cystic cavity with daughter vesicles and peripheral eosinophilia rather than acute liquefactive hepatic necrosis."}, {"source": "Amebiasis", "target": "Bacillary Dysentery (Shigellosis)", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from bacillary dysentery (shigellosis), which presents hyperacutely with high spiking fevers, systemic toxicity, and dense sheets of fecal neutrophils, whereas amoebic colitis features a subacute course, absent/low fever, and scarce fecal neutrophils."}, {"source": "Amebiasis", "target": "Colorectal Carcinoma", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from colorectal carcinoma, as a cecal amoeboma clinically and radiographically mimics adenocarcinoma but demonstrates granulomatous inflammation on biopsy and completely resolves within 4-6 weeks of nitroimidazole therapy."}, {"source": "Amebiasis", "target": "Non-Pathogenic Commensal Entamoeba Infection (E. dispar / E. moshkovskii)", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from non-pathogenic Entamoeba dispar or E. moshkovskii colonization, which share identical microscopic cyst and trophozoite morphology but lack erythrophagocytosis, Gal/GalNAc lectin positivity, and tissue invasiveness."}, {"source": "Amebiasis", "target": "Clinical Defervescence and RUQ Pain Relief within 48 to 72 Hours of Metronidazole", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Amebiasis demonstrates rapid clinical response with defervescence, cessation of night sweats, and marked pain relief within 48 to 72 hours of starting tissue amebicide metronidazole."}, {"source": "Amebiasis", "target": "Tinidazole Tissue Amebicide Therapy", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Amebiasis responds effectively to short-course tissue amebicide tinidazole (2 g once daily for 3 to 5 days) for both invasive colitis and amoebic liver abscess."}, {"source": "Amebiasis", "target": "Sequential Luminal Amebicide Clearance (Paromomycin / Diloxanide Furoate)", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Amebiasis requires sequential eradication of persistent intestinal cysts with non-absorbable luminal amebicides (paromomycin or diloxanide furoate) following nitroimidazole therapy to prevent relapse."}, {"source": "Amebiasis", "target": "Standard Antibacterial Penicillins, Aminoglycosides, and Macrolides", "keywords": "INTRINSICALLY_RESISTANT_TO", "description": "[INTRINSICALLY_RESISTANT_TO] Amebiasis is intrinsically refractory to standard antibacterial regimens (penicillins, aminoglycosides, macrolides) when administered without nitroimidazole amebicides."}, {"source": "Amebiasis", "target": "Auranofin Thioredoxin Reductase Inhibition", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Entamoeba histolytica exhibits potent in vitro and in vivo sensitivity to auranofin via targeted inhibition of parasite thioredoxin reductase (EhTrxR)."}]}}
{"case_id": "cholera", "disease": "Cholera", "extraction": {"entities": [{"name": "Cholera", "type": "Disease", "description": "Acute, life-threatening diarrhoeal infection caused by toxigenic Vibrio cholerae (serogroups O1 and O139), characterized by abrupt onset of profuse, painless secretory watery diarrhea, severe dehydration, and rapid hypovolemic shock within hours."}, {"name": "Fecally Contaminated Drinking Water and Compromised WASH Infrastructure", "type": "Vector_Exposure", "description": "Primary fecal-oral transmission vehicle, prevalent during humanitarian crises, refugee displacement, flooding, or municipal water and sewage system collapse."}, {"name": "Raw or Undercooked Shellfish from Brackish Estuarine Waters", "type": "Vector_Exposure", "description": "Marine reservoir exposure where Vibrio cholerae colonizes chitinous surfaces of zooplankton (copepods) and shellfish in warm coastal and estuarine aquatic ecosystems (>15-20°C)."}, {"name": "Blood Group O Host Susceptibility", "type": "Vector_Exposure", "description": "Inherent host immunogenetic risk factor strongly predisposing individuals to severe cholera gravis and life-threatening dehydration upon Vibrio cholerae exposure."}, {"name": "Vibrio cholerae Serogroups O1 and O139", "type": "Pathogen", "description": "Comma-shaped, highly motile, oxidase-positive Gram-negative bacilli; epidemic cholera is caused exclusively by serogroup O1 (biotypes Classical and El Tor; serotypes Inaba, Ogawa, Hikojima) and serogroup O139 Bengal."}, {"name": "Cholera Enterotoxin AB5 Subunit Complex", "type": "Pathogen", "description": "Potent protein enterotoxin consisting of an enzymatically active A subunit and five B receptor-binding subunits, responsible for catastrophic intestinal fluid and electrolyte hypersecretion."}, {"name": "Painless Voluminous Rice-Water Diarrhea", "type": "Cardinal_Sign", "description": "Pathognomonic triage physical hallmark presenting as explosive, effortless, translucent grayish-white watery stool with suspended mucus flecks and a fishy odor, lacking fecal matter, blood, or pus, purging 500-1000 mL/hour."}, {"name": "Severe Hypovolemic Shock with Washerwoman Wrinkled Skin and Hollow Orbits", "type": "Cardinal_Sign", "description": "Life-threatening triage sign of cholera gravis with >10% body weight fluid deficit, manifesting with sunken eyes, deeply shriveled wrinkled fingers ('washerwoman's hands'), absent radial pulse, skin pinch retraction >2 seconds, and hoarse whispering voice (vox cholerica)."}, {"name": "Effortless Non-Bilious Watery Vomiting", "type": "Cardinal_Sign", "description": "Sudden projectile, non-bilious clear watery vomiting occurring soon after diarrhea onset without preceding nausea or retching, accelerating dehydration."}, {"name": "Excruciating Calf and Abdominal Muscle Cramps", "type": "Cardinal_Sign", "description": "Severe painful tonic spasms primarily involving the gastrocnemius, thigh, and abdominal wall musculature, caused by profound acute hypokalemia, hypomagnesemia, and base loss."}, {"name": "Rapid Darting Shooting-Star Motility on Darkfield Stool Microscopy", "type": "Admission_Lab_Imaging", "description": "Point-of-care microscopic finding in fresh rice-water stool demonstrating rapidly darting vibrios with characteristic scintillating motility that is instantly arrested by specific O1/O139 antiserum."}, {"name": "Severe Hemoconcentration and Stress Neutrophilic Leukocytosis", "type": "Admission_Lab_Imaging", "description": "Admission CBC showing markedly elevated hematocrit (50-60%) and hemoglobin (>18-20 g/dL) reflecting profound plasma volume depletion, accompanied by stress leukocytosis (WBC 15,000-25,000/µL) with normal platelets."}, {"name": "Profound Metabolic Acidosis with Collapsed Serum Bicarbonate", "type": "Admission_Lab_Imaging", "description": "Admission chemistry and blood gas pattern with serum bicarbonate collapsing to <8-12 mEq/L and pH <7.15-7.25 due to massive intestinal bicarbonate loss (fecal [HCO3-] 40-50 mEq/L) and lactic acidosis, provoking compensatory Kussmaul respiration."}, {"name": "Prerenal Azotemia with BUN to Creatinine Ratio Exceeding 20 to 1", "type": "Admission_Lab_Imaging", "description": "Severe acute kidney injury pattern on admission metabolic panel with elevated BUN and serum creatinine, marked oliguria or anuria, and BUN:creatinine ratio >20:1 driven by renal hypoperfusion."}, {"name": "Acellular Fecal Smear Lacking Pus Cells and Erythrocytes", "type": "Admission_Lab_Imaging", "description": "Admission point-of-care stool microscopy demonstrating complete absence of polymorphonuclear leukocytes (pus cells) and red blood cells, confirming a non-invasive secretory pathology."}, {"name": "Inferior Vena Cava Complete Collapse on Bedside Ultrasound", "type": "Admission_Lab_Imaging", "description": "Admission POCUS examination demonstrating slit-like, completely collapsed inferior vena cava with >50% inspiratory collapsibility and hyperperistaltic fluid-distended small bowel loops without bowel wall thickening."}, {"name": "Point-of-Care Cholera O1 and O139 Dipstick Antigen Test", "type": "Admission_Lab_Imaging", "description": "Rapid immunochromatographic dipstick testing of fresh stool providing immediate triage identification of Vibrio cholerae O1 and O139 lipopolysaccharide antigens at admission."}, {"name": "High Continuous Fever Exceeding 39°C", "type": "Exclusion_Criterion", "description": "High continuous pyrexia (>39°C) in an adult patient at presentation, characteristic of invasive systemic or enteric infections but fundamentally atypical of cholera."}, {"name": "Gross Hematochezia Melena or Stool Pus Cells", "type": "Exclusion_Criterion", "description": "Presence of macroscopic red blood, dark black melenic stool, or sheets of fecal polymorphonuclear neutrophils on microscopic smear indicating mucosal ulceration."}, {"name": "Chronic Diarrheal Duration Exceeding 7 Days", "type": "Exclusion_Criterion", "description": "Diarrheal illness persisting or recurring for more than one week, incompatible with the acute explosive hyper-voluminous course of cholera."}, {"name": "Severe Tenesmus and Low-Volume Colicky Stools", "type": "Exclusion_Criterion", "description": "Intense painful rectal straining (tenesmus) accompanied by painful small-volume mucoid evacuations, pathognomonic of invasive rectosigmoid colitis."}, {"name": "Bacillary Dysentery", "type": "Disease", "description": "Acute invasive bacterial infection of the colon caused by Shigella species, presenting with high fever, severe colicky abdominal cramps, tenesmus, and bloody mucoid stools."}, {"name": "Enterotoxigenic Escherichia coli Gastroenteritis", "type": "Disease", "description": "Common cause of traveler's watery diarrhea caused by heat-labile (LT) and/or heat-stable (ST) enterotoxins, resulting in self-limited watery stools."}, {"name": "Amoebic Dysentery", "type": "Disease", "description": "Invasive colonic protozoan infection caused by Entamoeba histolytica, causing subacute bloody diarrhea and discrete ulcerations."}, {"name": "Viral Gastroenteritis", "type": "Disease", "description": "Acute viral intestinal infection caused by Rotavirus or Norovirus, characterized by prominent antecedent nausea, vomiting preceding diarrhea, and low-grade fever."}, {"name": "Intravenous Ringer's Lactate Resuscitation", "type": "Drug_Response", "description": "First-line crystalloid resuscitation solution providing balanced electrolytes and lactate substrate to rapidly reverse hypovolemic shock, restore arterial pressure, and buffer severe metabolic acidosis."}, {"name": "Reduced-Osmolarity Oral Rehydration Solution", "type": "Drug_Response", "description": "Standard WHO oral electrolyte solution utilizing intact SGLT-1 intestinal sodium-glucose cotransport to drive passive mucosal water absorption, matching ongoing stool volume loss."}, {"name": "Single-Dose Oral Doxycycline or Azithromycin Regimen", "type": "Drug_Response", "description": "Adjunctive single-dose antimicrobial therapy (Doxycycline 300 mg or Azithromycin 1 g) administered following initial rehydration to eradicate Vibrio carriage and curb purging volume."}, {"name": "Adjunctive Oral Zinc Therapy in Pediatric Cholera", "type": "Drug_Response", "description": "Adjunctive micronutrient therapy (20 mg/day for 10-14 days) in children under 5 years, accelerating mucosal regeneration and reducing diarrhea duration."}, {"name": "Antibiotic Monotherapy Without Aggressive Fluid Resuscitation", "type": "Drug_Response", "description": "Lethal clinical pitfall of administering antibiotics alone without immediate, aggressive intravenous and oral fluid replacement, which fails to prevent cardiovascular collapse."}], "relationships": [{"source": "Cholera", "target": "Fecally Contaminated Drinking Water and Compromised WASH Infrastructure", "keywords": "EXPOSURE_TO, fecal-oral transmission, contaminated water, WASH breakdown, environmental risk", "description": "[EXPOSURE_TO] Ingestion of municipal or surface water contaminated with human fecal matter is the predominant transmission route driving explosive cholera outbreaks."}, {"source": "Cholera", "target": "Raw or Undercooked Shellfish from Brackish Estuarine Waters", "keywords": "EXPOSURE_TO, marine reservoir, undercooked shellfish, estuarine ecosystem", "description": "[EXPOSURE_TO] Ingestion of raw or insufficiently cooked oysters, crabs, or other shellfish harvested from warm, brackish estuarine waters serves as an established vehicle for sporadic and epidemic cholera."}, {"source": "Cholera", "target": "Blood Group O Host Susceptibility", "keywords": "EXPOSURE_TO, host genetic susceptibility, blood group O, severe disease risk", "description": "[EXPOSURE_TO] Individuals with blood group O possess heightened clinical vulnerability to developing severe, life-threatening dehydration (cholera gravis) following Vibrio cholerae exposure."}, {"source": "Cholera", "target": "Vibrio cholerae Serogroups O1 and O139", "keywords": "HAS_PATHOGEN, causative organism, comma bacillus, O1 and O139 serogroups", "description": "[HAS_PATHOGEN] Cholera is caused by toxigenic Vibrio cholerae serogroup O1 (Classical or El Tor biotypes) or serogroup O139, which colonize the small intestinal mucosa."}, {"source": "Cholera", "target": "Cholera Enterotoxin AB5 Subunit Complex", "keywords": "HAS_PATHOGEN, cholera toxin, AB5 enterotoxin, adenylate cyclase activation", "description": "[HAS_PATHOGEN] Cholera toxin ADP-ribosylates the Gs-alpha regulatory protein in small intestinal enterocytes, permanently activating adenylate cyclase and driving massive intracellular cAMP accumulation with active chloride, bicarbonate, and water secretion."}, {"source": "Cholera", "target": "Painless Voluminous Rice-Water Diarrhea", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, rice-water stool, high purging rate", "description": "[HAS_PATHOGNOMONIC_HALLMARK] The abrupt appearance of copious, non-bloody, translucent rice-water stool purging at rates of up to 1 L/hour without abdominal pain or tenesmus is the pathognomonic hallmark of severe cholera."}, {"source": "Cholera", "target": "Severe Hypovolemic Shock with Washerwoman Wrinkled Skin and Hollow Orbits", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, cholera gravis, washerwoman hands, hypovolemic shock", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Critical intravascular collapse featuring washerwoman wrinkled fingertips, hollow eyes, impalpable radial pulse, and vox cholerica reflects rapid loss of >10% body fluid volume within hours."}, {"source": "Cholera", "target": "Effortless Non-Bilious Watery Vomiting", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, projectile vomiting, painless fluid loss, admission hallmark", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Painless, effortless clear watery vomiting emerges abruptly following the onset of watery purging, drastically exacerbating acute volume depletion."}, {"source": "Cholera", "target": "Excruciating Calf and Abdominal Muscle Cramps", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, severe muscle cramps, hypokalemic spasm, calf cramps", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Excruciating spasms of the calf muscles and abdominal wall develop rapidly at triage due to catastrophic fecal depletion of potassium, magnesium, and bicarbonate."}, {"source": "Cholera", "target": "Rapid Darting Shooting-Star Motility on Darkfield Stool Microscopy", "keywords": "EXHIBITS_LAB_PATTERN, lab hallmark, point of care, shooting-star motility, darkfield microscopy", "description": "[EXHIBITS_LAB_PATTERN] Direct darkfield examination of fresh rice-water stool reveals the classic scintillating shooting-star motility of Vibrio cholerae, confirmed at triage by immediate immobilization with anti-O1/O139 antiserum."}, {"source": "Cholera", "target": "Severe Hemoconcentration and Stress Neutrophilic Leukocytosis", "keywords": "EXHIBITS_LAB_PATTERN, lab hallmark, admission CBC, hemoconcentration, elevated hematocrit", "description": "[EXHIBITS_LAB_PATTERN] Markedly contracted intravascular volume produces severe hemoconcentration with hematocrit reaching 50-60% and secondary catecholamine-mediated neutrophilic leukocytosis on admission CBC."}, {"source": "Cholera", "target": "Profound Metabolic Acidosis with Collapsed Serum Bicarbonate", "keywords": "EXHIBITS_LAB_PATTERN, lab hallmark, metabolic acidosis, base deficit, Kussmaul breathing", "description": "[EXHIBITS_LAB_PATTERN] Massive stool bicarbonate loss leads to severe metabolic acidosis with serum bicarbonate collapsing below 12 mEq/L and compensatory deep Kussmaul breathing on arrival."}, {"source": "Cholera", "target": "Prerenal Azotemia with BUN to Creatinine Ratio Exceeding 20 to 1", "keywords": "EXHIBITS_LAB_PATTERN, lab hallmark, prerenal acute kidney injury, elevated BUN creatinine ratio", "description": "[EXHIBITS_LAB_PATTERN] Acute prerenal azotemia with a BUN to creatinine ratio >20:1 develops rapidly at admission as severe dehydration causes renal hypoperfusion and oliguria."}, {"source": "Cholera", "target": "Acellular Fecal Smear Lacking Pus Cells and Erythrocytes", "keywords": "EXHIBITS_LAB_PATTERN, lab hallmark, stool smear, absent fecal leukocytes, acellular stool", "description": "[EXHIBITS_LAB_PATTERN] Microscopic evaluation of rice-water stool reveals an acellular smear devoid of fecal leukocytes and erythrocytes, establishing an enterotoxin-driven non-invasive secretory process."}, {"source": "Cholera", "target": "Inferior Vena Cava Complete Collapse on Bedside Ultrasound", "keywords": "EXHIBITS_LAB_PATTERN, imaging hallmark, POCUS, collapsed IVC, hyperperistaltic bowel", "description": "[EXHIBITS_LAB_PATTERN] Bedside POCUS ultrasound confirms critical intravascular hypovolemia via an unvisualized or fully collapsing inferior vena cava and reveals fluid-filled hyperactive small bowel loops without wall thickening."}, {"source": "Cholera", "target": "Point-of-Care Cholera O1 and O139 Dipstick Antigen Test", "keywords": "EXHIBITS_LAB_PATTERN, lab hallmark, point of care, rapid diagnostic test, RDT antigen", "description": "[EXHIBITS_LAB_PATTERN] Rapid immunochromatographic dipstick testing of fresh stool provides immediate point-of-care identification of Vibrio cholerae O1 and O139 lipopolysaccharide antigens at hospital admission."}, {"source": "Cholera", "target": "High Continuous Fever Exceeding 39°C", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, high fever", "description": "[RULED_OUT_BY] Presence of high continuous fever (>39°C) at admission strongly rules out uncomplicated cholera, which is afebrile or presents with hypothermia in shock."}, {"source": "Cholera", "target": "Gross Hematochezia Melena or Stool Pus Cells", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, bloody stool, fecal leukocytes", "description": "[RULED_OUT_BY] The presence of gross blood, melena, or fecal pus cells on admission microscopy rules out cholera, signaling an invasive mucosal enteritis such as shigellosis or amoebiasis."}, {"source": "Cholera", "target": "Chronic Diarrheal Duration Exceeding 7 Days", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, chronic diarrhea timeline", "description": "[RULED_OUT_BY] A diarrheal duration of greater than 7 days rules out acute cholera, which presents with hyperacute onset (hours to days) and completes its course within 2 to 6 days."}, {"source": "Cholera", "target": "Severe Tenesmus and Low-Volume Colicky Stools", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, tenesmus, low volume stool", "description": "[RULED_OUT_BY] Painful tenesmus with small-volume colicky evacuations rules out cholera, which is characterized by painless, effortless, massive-volume fluid purging."}, {"source": "Cholera", "target": "Bacillary Dysentery", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, Shigella, dysentery", "description": "[DIFFERENTIATED_FROM] Bacillary dysentery presents with high fever (>39°C), severe colicky abdominal cramps, tenesmus, and small-volume bloody stools filled with pus cells; cholera presents with painless, massive non-bloody rice-water diarrhea, normal temperature, and an acellular stool smear."}, {"source": "Cholera", "target": "Enterotoxigenic Escherichia coli Gastroenteritis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, ETEC, traveler's diarrhea", "description": "[DIFFERENTIATED_FROM] ETEC produces modest self-limiting diarrhea (3-5 stools/day, rarely exceeding 1-2 L/day) without severe dehydration; cholera produces catastrophic multi-liter purging (>500-1000 mL/hr, 10-20 L/day), washerwoman skin, and rapid hypovolemic shock."}, {"source": "Cholera", "target": "Amoebic Dysentery", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, Entamoeba histolytica, amoebiasis", "description": "[DIFFERENTIATED_FROM] Amoebic dysentery has an insidious subacute onset over 1-3 weeks with localized right-lower-quadrant tenderness and low-volume bloody stools with erythrophagocytic trophozoites; cholera has an explosive onset over hours with painless massive rice-water purging."}, {"source": "Cholera", "target": "Viral Gastroenteritis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, Rotavirus, Norovirus", "description": "[DIFFERENTIATED_FROM] Viral gastroenteritis typically features antecedent nausea, persistent vomiting prior to diarrhea, low-grade fever, and low to moderate stool purging volumes; cholera presents with abrupt effortless diarrhea followed by vomiting, non-bloody rice-water effluent, and massive purging volumes."}, {"source": "Cholera", "target": "Intravenous Ringer's Lactate Resuscitation", "keywords": "RESPONDS_TO, fluid resuscitation, Ringer's lactate, hypovolemic shock reversal", "description": "[RESPONDS_TO] Rapid intravenous infusion of Ringer's lactate (100 mL/kg, with 30 mL/kg within 30 minutes in adults) restores peripheral pulses and normalizes blood pressure within 1-2 hours while lactate metabolizes to correct profound acidosis."}, {"source": "Cholera", "target": "Reduced-Osmolarity Oral Rehydration Solution", "keywords": "RESPONDS_TO, oral rehydration solution, WHO ORS, sodium-glucose cotransport", "description": "[RESPONDS_TO] Reduced-osmolarity WHO-ORS restores and maintains hydration by exploiting intact intestinal sodium-glucose cotransport even during active enterotoxin-mediated secretion, dramatically reducing mortality to <1%."}, {"source": "Cholera", "target": "Single-Dose Oral Doxycycline or Azithromycin Regimen", "keywords": "RESPONDS_TO, antimicrobial therapy, single-dose doxycycline, azithromycin, volume reduction", "description": "[RESPONDS_TO] Single-dose oral doxycycline (300 mg) or azithromycin (1 g) administered after initial fluid stabilization halves diarrheal stool output and shortens Vibrio cholerae fecal excretion to 24-48 hours."}, {"source": "Cholera", "target": "Adjunctive Oral Zinc Therapy in Pediatric Cholera", "keywords": "RESPONDS_TO, pediatric zinc supplementation, mucosal regeneration, diarrhea reduction", "description": "[RESPONDS_TO] Adjunctive oral zinc supplementation (20 mg/day for 10-14 days) in children under 5 years significantly reduces the total duration and volume of diarrheal stool output."}, {"source": "Cholera", "target": "Antibiotic Monotherapy Without Aggressive Fluid Resuscitation", "keywords": "INTRINSICALLY_RESISTANT_TO, treatment failure, antibiotic monotherapy, fatal dehydration", "description": "[INTRINSICALLY_RESISTANT_TO] Cholera fails to respond to antimicrobial therapy alone without aggressive fluid resuscitation, resulting in fatal hypovolemic shock and renal shutdown within hours despite bacterial eradication."}]}}
{"case_id": "dengue", "disease": "Dengue", "extraction": {"entities": [{"name": "Dengue", "type": "Disease", "description": "Acute mosquito-borne arboviral infection caused by the dengue virus, characterized by sudden high fever, retro-orbital pain, severe break-bone arthralgias/myalgias, and potential progression during defervescence to plasma leakage, thrombocytopenia, and hypovolemic shock."}, {"name": "Aedes aegypti Mosquito Vector", "type": "Vector_Exposure", "description": "Primary diurnal anthropophilic mosquito vector that rests indoors, bites during daylight hours, and breeds in domestic artificial water containers in tropical and subtropical urban environments."}, {"name": "Aedes albopictus Mosquito Vector", "type": "Vector_Exposure", "description": "Secondary mosquito vector of dengue adapted to peri-domestic and rural vegetated environments with higher cold tolerance."}, {"name": "Rapid Unplanned Tropical Urbanization and Artificial Water Storage", "type": "Vector_Exposure", "description": "Dense urban tropical settings with inadequate piped water infrastructure requiring domestic water storage (cisterns, drums, clay jars) and discarded non-biodegradable containers (tires, plastic)."}, {"name": "Secondary Heterologous Dengue Infection", "type": "Vector_Exposure", "description": "Prior infection with a different dengue virus serotype predisposing the host to antibody-dependent enhancement (ADE), drastically elevating the risk of severe dengue and plasma leakage syndrome."}, {"name": "Dengue Virus (DENV-1, DENV-2, DENV-3, DENV-4)", "type": "Pathogen", "description": "Enveloped, positive-sense single-stranded RNA arbovirus of the genus Flavivirus (family Flaviviridae) comprising four antigenically distinct serotypes."}, {"name": "Retro-Orbital Headache Exacerbated by Eye Movements", "type": "Cardinal_Sign", "description": "Severe frontal cephalalgia coupled with intense retrobulbar ache aggravated by ocular motion, highly characteristic of early dengue infection."}, {"name": "Saddleback Biphasic Fever Pattern", "type": "Cardinal_Sign", "description": "Abrupt high-grade fever (39-40°C) lasting 3 to 4 days that temporarily remits before recurring in a second spike around days 5 to 6."}, {"name": "Positive Tourniquet Test with Petechial Capillary Fragility", "type": "Cardinal_Sign", "description": "Bedside demonstration of >= 10 petechiae per square inch after maintaining blood pressure cuff midway between systolic and diastolic pressure for 5 minutes."}, {"name": "Critical Phase Plasma Leakage with Narrowed Pulse Pressure", "type": "Cardinal_Sign", "description": "Systemic vascular hyperpermeability occurring at or near defervescence (days 3-7) resulting in narrowing pulse pressure (<= 20 mmHg), cold clammy extremities, and dengue shock syndrome."}, {"name": "Islands of White in a Sea of Red Convalescent Rash", "type": "Cardinal_Sign", "description": "Confluent maculopapular petechial rash with sharply demarcated round pale islands of normal skin, accompanied by intense palmar and plantar pruritus during recovery (days 7-10)."}, {"name": "Early Leukopenia Nadir with Atypical Plasmacytoid Lymphocytosis", "type": "Admission_Lab_Imaging", "description": "Admission complete blood count revealing profound leukopenia (< 4,000/µL, often < 2,500/µL) driven by neutropenia, accompanied by reactive plasmacytoid lymphocytes prior to the critical phase."}, {"name": "Severe Thrombocytopenia with Concurrent Hemoconcentration", "type": "Admission_Lab_Imaging", "description": "Rapid progressive platelet count decline (< 100,000/µL) concurrent with hematocrit elevation >= 20% above baseline (or HCT > 45% in adult males, > 40% in females), confirming vascular plasma leakage."}, {"name": "Preferential AST Elevation over ALT Transaminitis", "type": "Admission_Lab_Imaging", "description": "Hepatic transaminitis displaying an AST:ALT ratio > 1 reflecting combined hepatocellular and skeletal muscle injury, accompanied by normal to minimally elevated total bilirubin."}, {"name": "Gallbladder Wall Thickening with Pericholecystic Fluid and Right Pleural Effusion", "type": "Admission_Lab_Imaging", "description": "Point-of-care ultrasound demonstrating edematous, striated gallbladder wall thickening (>= 3 mm without gallstones), subcapsular hepatic fluid, and right-sided pleural effusion on chest imaging."}, {"name": "Fever Duration Exceeding 10 Days", "type": "Exclusion_Criterion", "description": "Fever persisting continuously or intermittently beyond 10 days, exceeding the acute 2-7 day febrile envelope of dengue."}, {"name": "Marked Neutrophilic Leukocytosis Exceeding 15,000/uL", "type": "Exclusion_Criterion", "description": "Peripheral white blood cell count exceeding 15,000/µL with neutrophilia and toxic left shift in the absence of secondary bacterial superinfection."}, {"name": "Normal Platelet Count Above 150,000/uL on Days 4 to 7", "type": "Exclusion_Criterion", "description": "Complete preservation of normal platelet counts (> 150,000/µL) throughout days 4 through 7 of illness, making severe dengue and plasma leak syndrome exceedingly unlikely."}, {"name": "Early Marked Direct Hyperbilirubinemia and Acute Renal Failure", "type": "Exclusion_Criterion", "description": "Early-onset deep clinical jaundice with direct hyperbilirubinemia and oliguric acute renal failure within the first 3 to 5 days of illness."}, {"name": "Chikungunya", "type": "Disease", "description": "Alphaviral infection transmitted by Aedes mosquitoes presenting with severe, symmetric polyarthritis/synovitis but lacking vascular hyperpermeability."}, {"name": "Zika Virus Infection", "type": "Disease", "description": "Arboviral flavivirus infection characterized by low-grade fever, bilateral non-purulent conjunctivitis, and early descending maculopapular rash without plasma leakage."}, {"name": "Leptospirosis", "type": "Disease", "description": "Zoonotic spirochetal infection causing fever, conjunctival suffusion, severe calf tenderness, marked neutrophilic leukocytosis, and hepato-renal failure (Weil disease)."}, {"name": "Malaria", "type": "Disease", "description": "Intraerythrocytic parasitic infection caused by Plasmodium species presenting with periodic paroxysmal rigors, splenomegaly, and intravascular hemolytic anemia."}, {"name": "Titrated Isotonic Crystalloid Fluid Resuscitation", "type": "Drug_Response", "description": "Judiciously administered isotonic crystalloids (normal saline, Ringer's lactate) restoring hemodynamic stability, normalizing pulse pressure, reducing hemoconcentration, and maintaining urine output (> 0.5-1 mL/kg/h)."}, {"name": "Empirical Broad-Spectrum Antibacterial Therapy", "type": "Drug_Response", "description": "Empirical broad-spectrum beta-lactams, macrolides, and fluoroquinolones that fail to alter fever defervescence, platelet trajectory, or hemoconcentration in acute dengue."}, {"name": "NSAIDs and Aspirin Induced Bleeding Toxicity", "type": "Drug_Response", "description": "Non-steroidal anti-inflammatory agents (ibuprofen, naproxen) and aspirin, which exacerbate hemorrhagic diathesis, provoke gastric ulceration, and impair platelet function."}, {"name": "Paracetamol Antipyresis", "type": "Drug_Response", "description": "Acetaminophen (paracetamol) providing safe fever control and mild analgesic symptom relief without increasing the risk of mucosal or gastrointestinal hemorrhage."}], "relationships": [{"source": "Dengue", "target": "Aedes aegypti Mosquito Vector", "keywords": "TRANSMITTED_BY, primary vector, Aedes aegypti, diurnal mosquito, domestic breeder", "description": "[TRANSMITTED_BY] Transmitted primarily by the bites of infected female Aedes aegypti mosquitoes, which are highly anthropophilic, bite during daylight hours, and breed in domestic and peridomestic artificial water containers."}, {"source": "Dengue", "target": "Aedes albopictus Mosquito Vector", "keywords": "TRANSMITTED_BY, secondary vector, Aedes albopictus, peri-domestic vector", "description": "[TRANSMITTED_BY] Transmitted secondarily by Aedes albopictus mosquitoes, which thrive in peri-domestic vegetated habitats and tolerate cooler climates, expanding transmission into suburban and rural regions."}, {"source": "Dengue", "target": "Rapid Unplanned Tropical Urbanization and Artificial Water Storage", "keywords": "EXPOSURE_TO, urban transmission, domestic water storage, artificial larval containers", "description": "[EXPOSURE_TO] Driven by rapid unplanned urbanization with high population density, intermittent municipal water forcing domestic water storage in cisterns/drums/jars, and accumulation of discarded tires and plastic containers."}, {"source": "Dengue", "target": "Secondary Heterologous Dengue Infection", "keywords": "EXPOSURE_TO, antibody dependent enhancement, heterologous serotype, severe dengue risk", "description": "[EXPOSURE_TO] Previous infection with a heterologous DENV serotype predisposes the patient to antibody-dependent enhancement (ADE), leading to massive viral replication, intense cytokine release, and high risk of severe plasma leakage."}, {"source": "Dengue", "target": "Dengue Virus (DENV-1, DENV-2, DENV-3, DENV-4)", "keywords": "HAS_PATHOGEN, causative agent, Flavivirus, arbovirus, positive-sense RNA", "description": "[HAS_PATHOGEN] Caused by the dengue virus (DENV), a positive-sense single-stranded RNA Flavivirus existing as four distinct antigenic serotypes (DENV-1, DENV-2, DENV-3, and DENV-4)."}, {"source": "Dengue", "target": "Retro-Orbital Headache Exacerbated by Eye Movements", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, retro-orbital pain, ocular movement headache, early febrile sign", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Severe frontal headache paired with intense retro-orbital pain exacerbated by eye movements during the early febrile phase is a cardinal clinical hallmark of dengue fever."}, {"source": "Dengue", "target": "Saddleback Biphasic Fever Pattern", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, saddleback fever, biphasic temperature curve, clinical timeline", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Abrupt onset high-grade fever (39-40°C) with a saddleback biphasic profile—temporary defervescence around day 3-4 followed by a secondary febrile spike—is highly suggestive of dengue."}, {"source": "Dengue", "target": "Positive Tourniquet Test with Petechial Capillary Fragility", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, tourniquet test, petechiae, capillary fragility, triage hallmark", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Detection of >= 10 petechiae per square inch under 5-minute mid-blood pressure cuff inflation provides an immediate, low-cost bedside physical hallmark of vascular capillary fragility in dengue."}, {"source": "Dengue", "target": "Critical Phase Plasma Leakage with Narrowed Pulse Pressure", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, plasma leakage, critical phase, narrowing pulse pressure, dengue shock", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Acute systemic capillary hyperpermeability developing at defervescence (days 3-7), manifesting as narrowing pulse pressure (<= 20 mmHg), cold clammy extremities, and fluid accumulation, defines the critical phase of severe dengue."}, {"source": "Dengue", "target": "Islands of White in a Sea of Red Convalescent Rash", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, convalescent rash, islands of white, pruritic rash, pathognomonic sign", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Confluent erythematous maculopapular petechial eruption sparing small rounded areas of pale normal skin ('islands of white in a sea of red'), accompanied by intense palmar and plantar itching, is pathognomonic during recovery (days 7-10)."}, {"source": "Dengue", "target": "Early Leukopenia Nadir with Atypical Plasmacytoid Lymphocytosis", "keywords": "EXHIBITS_LAB_PATTERN, leukopenia, neutropenia, atypical lymphocytes, admission CBC", "description": "[EXHIBITS_LAB_PATTERN] Early admission leukopenia (WBC nadir < 4,000/µL, frequently < 2,500/µL) driven by neutropenia and early lymphopenia, followed by the appearance of reactive plasmacytoid lymphocytes, heralds the critical phase."}, {"source": "Dengue", "target": "Severe Thrombocytopenia with Concurrent Hemoconcentration", "keywords": "EXHIBITS_LAB_PATTERN, thrombocytopenia, hemoconcentration, hematocrit rise, plasma leakage", "description": "[EXHIBITS_LAB_PATTERN] Rapidly declining platelet count (< 100,000/µL, dropping < 20,000/µL in severe cases) combined with a >= 20% elevation in hematocrit above baseline serves as the definitive laboratory pattern of vascular plasma extravasation."}, {"source": "Dengue", "target": "Preferential AST Elevation over ALT Transaminitis", "keywords": "EXHIBITS_LAB_PATTERN, AST higher than ALT, hepatic transaminitis, normal bilirubin, triage LFTs", "description": "[EXHIBITS_LAB_PATTERN] Serum aminotransferases show elevated AST and ALT with AST characteristically higher than ALT (AST:ALT ratio > 1) due to virus-mediated skeletal muscle and hepatocyte necrosis, alongside normal total bilirubin."}, {"source": "Dengue", "target": "Gallbladder Wall Thickening with Pericholecystic Fluid and Right Pleural Effusion", "keywords": "EXHIBITS_LAB_PATTERN, POCUS ultrasound, gallbladder wall edema, right pleural effusion, bedside imaging", "description": "[EXHIBITS_LAB_PATTERN] Point-of-care ultrasound demonstrating thickened striated gallbladder wall (>= 3 mm without lithiasis), subcapsular hepatic fluid, and right-sided pleural effusion on chest imaging serves as an early triage imaging marker of capillary leak."}, {"source": "Dengue", "target": "Fever Duration Exceeding 10 Days", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, fever duration cutoff", "description": "[RULED_OUT_BY] A febrile illness lasting continuously or intermittently longer than 10 days rules out acute dengue, which strictly adheres to a 2 to 7 day (maximum 10 day) febrile timeframe."}, {"source": "Dengue", "target": "Marked Neutrophilic Leukocytosis Exceeding 15,000/uL", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, leukocytosis cutoff", "description": "[RULED_OUT_BY] Marked neutrophilic leukocytosis (WBC > 15,000/µL) with toxic bandemia in the absence of secondary bacterial superinfection rules out uncomplicated dengue, which is consistently characterized by leukopenia."}, {"source": "Dengue", "target": "Normal Platelet Count Above 150,000/uL on Days 4 to 7", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, normal platelets, critical window", "description": "[RULED_OUT_BY] A normal platelet count (> 150,000/µL) maintained during days 4 through 7 of illness makes severe dengue and dengue hemorrhagic fever virtually impossible."}, {"source": "Dengue", "target": "Early Marked Direct Hyperbilirubinemia and Acute Renal Failure", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, early jaundice, acute renal failure", "description": "[RULED_OUT_BY] Early gross clinical jaundice with direct hyperbilirubinemia and oliguric acute renal failure at initial admission rules out uncomplicated dengue, strongly indicating leptospirosis (Weil disease) or severe malaria."}, {"source": "Dengue", "target": "Chikungunya", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, symmetric polyarthritis, joint disability", "description": "[DIFFERENTIATED_FROM] Chikungunya causes excruciating, symmetric polyarthritis and tenosynovitis (wrists, fingers, ankles) with preserved platelet counts (> 100,000/µL) and absence of capillary leak; Dengue causes dominant retro-orbital pain, severe neutropenia, thrombocytopenia, and plasma leak."}, {"source": "Dengue", "target": "Zika Virus Infection", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, non-purulent conjunctivitis, low-grade fever", "description": "[DIFFERENTIATED_FROM] Zika virus infection is characterized by low-grade fever (< 38.5°C), prominent bilateral non-purulent conjunctivitis, and early descending pruritic maculopapular rash without plasma leakage; Dengue causes high fever (> 39°C), severe thrombocytopenia (< 50,000/µL), and hemoconcentration."}, {"source": "Dengue", "target": "Leptospirosis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, conjunctival suffusion, calf myalgia, Weil disease", "description": "[DIFFERENTIATED_FROM] Leptospirosis presents with marked bilateral conjunctival suffusion, intense calf pain, neutrophilic leukocytosis (WBC > 12,000/µL), high ESR/CRP, and early direct hyperbilirubinemia with azotemia; Dengue exhibits leukopenia, AST > ALT, normal bilirubin, and hemoconcentration."}, {"source": "Dengue", "target": "Malaria", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, cyclical rigors, splenomegaly, hemolytic anemia", "description": "[DIFFERENTIATED_FROM] Malaria exhibits periodic paroxysms of severe rigors, prominent early splenomegaly, and hemolytic anemia (elevated indirect bilirubin, high LDH) without hemoconcentration or plasma extravasation; Dengue exhibits retro-orbital pain, hemoconcentration, and vascular leak syndrome."}, {"source": "Dengue", "target": "Titrated Isotonic Crystalloid Fluid Resuscitation", "keywords": "RESPONDS_TO, fluid resuscitation, isotonic crystalloids, pulse pressure stabilization", "description": "[RESPONDS_TO] Meticulously titrated intravenous isotonic crystalloids (normal saline or Ringer's lactate) achieve prompt widening of narrowed pulse pressure, reduction of elevated hematocrit, and maintenance of urine output (> 0.5-1 mL/kg/h) during dengue shock."}, {"source": "Dengue", "target": "Empirical Broad-Spectrum Antibacterial Therapy", "keywords": "INTRINSICALLY_RESISTANT_TO, antibiotic refractoriness, therapeutic unresponsiveness, viral etiology", "description": "[INTRINSICALLY_RESISTANT_TO] Empirical broad-spectrum beta-lactams, macrolides, or fluoroquinolones completely fail to produce defervescence or alter the platelet and hematocrit trajectories in acute dengue."}, {"source": "Dengue", "target": "NSAIDs and Aspirin Induced Bleeding Toxicity", "keywords": "INTRINSICALLY_RESISTANT_TO, contraindication, hemorrhagic risk, gastritis, platelet inhibition", "description": "[INTRINSICALLY_RESISTANT_TO] Non-steroidal anti-inflammatory drugs (NSAIDs) and aspirin are strictly contraindicated due to their provocation of severe mucosal hemorrhage, gastrointestinal ulceration, and exacerbation of platelet dysfunction."}, {"source": "Dengue", "target": "Paracetamol Antipyresis", "keywords": "RESPONDS_TO, safe antipyresis, symptomatic pain relief, paracetamol, acetaminophen", "description": "[RESPONDS_TO] Paracetamol (acetaminophen) provides safe antipyresis and relief of break-bone musculoskeletal aches at weight-appropriate dosages without compromising hemostasis or precipitating hemorrhage."}]}}
{"case_id": "echinococcosis", "disease": "Echinococcosis", "extraction": {"entities": [{"name": "Echinococcosis", "type": "Disease", "description": "A chronic zoonotic parasitic disease caused by larval metacestodes of cyclophyllidean tapeworms of the genus Echinococcus (primarily E. granulosus causing cystic echinococcosis and E. multilocularis causing alveolar echinococcosis), characterized by slow-growing visceral hydatid cysts or destructive infiltrative hepatic pseudotumors with prolonged latency."}, {"name": "Direct Contact with Domestic Dogs Shedding Tapeworm Eggs", "type": "Vector_Exposure", "description": "Close contact with infected domestic canines acting as definitive hosts (e.g., petting dog fur, muzzle licking) harboring adult Echinococcus tapeworms in their small intestines and shedding microscopic eggs in feces."}, {"name": "Ingestion of Food or Water Contaminated with Dog or Fox Feces", "type": "Vector_Exposure", "description": "Consumption of unboiled drinking water, raw vegetables, or wild-gathered forest berries contaminated with feces of wild foxes or domestic dogs carrying infectious Echinococcus oncospheres."}, {"name": "Pastoral Sheep-Raising and Home Livestock Slaughter Exposure", "type": "Vector_Exposure", "description": "Occupational or community exposure in pastoral livestock-rearing regions where sheep, goats, or cattle act as intermediate hosts and offal is fed to sheepdogs, perpetuating the dog-sheep transmission cycle."}, {"name": "Sylvatic Wildlife Cycle Exposure in Boreal and Northern Temperate Zones", "type": "Vector_Exposure", "description": "Exposure to wild carnivore definitive hosts (red foxes, arctic foxes) and small rodent intermediate hosts (voles, lemmings) maintaining the sylvatic transmission cycle of Echinococcus multilocularis across cold temperate and boreal northern latitudes."}, {"name": "Echinococcus granulosus sensu lato", "type": "Pathogen", "description": "A cyclophyllidean cestode species complex (primarily E. granulosus sensu stricto [genotypes G1-G3, sheep strain], E. canadensis, and E. ortleppi) causing unilocular and multivesicular cystic echinococcosis encapsulated by a fibrovascular host pericyst."}, {"name": "Echinococcus multilocularis", "type": "Pathogen", "description": "The fox tapeworm cestode whose larval metacestode proliferates aggressively via external microvesicle budding without a protective pericyst, infiltrating hepatic parenchyma and mimicking necrotic liver cancer."}, {"name": "Echinococcus vogeli", "type": "Pathogen", "description": "A neotropical tapeworm species endemic to Central and South America causing polycystic echinococcosis in human visceral organs."}, {"name": "Echinococcus oligarthrus", "type": "Pathogen", "description": "A neotropical tapeworm species endemic to Central and South America causing unicystic echinococcosis, utilizing wild felids as definitive hosts."}, {"name": "Multivesicular Daughter Cysts with Spoke-Wheel Honeycomb Pattern on Ultrasound (WHO CE2)", "type": "Admission_Lab_Imaging", "description": "Pathognomonic multiseptated cystic liver lesion containing multiple internal daughter cysts separated by matrix, producing a classic wheel-spoke, rosette, or honeycomb acoustic architecture on ultrasound."}, {"name": "Water-Lily Floating Membrane Sign on Ultrasound (WHO CE3a)", "type": "Admission_Lab_Imaging", "description": "Detachment and collapse of the laminated endocyst membrane floating freely within the cystic cavity, visualized on bedside ultrasound as undulating acoustic echoes resembling a water-lily."}, {"name": "Anechoic Unilocular Cyst with Double-Contour Wall and Snowstorm Sign (WHO CE1)", "type": "Admission_Lab_Imaging", "description": "Well-defined, round, unilocular anechoic cystic cavity demonstrating a distinct double-line boundary wall and fine internal acoustic echoes shifting with patient repositioning ('snowstorm sign' of floating hydatid sand)."}, {"name": "Thick Hyperechoic Eggshell Calcification with Posterior Acoustic Shadowing (WHO CE5)", "type": "Admission_Lab_Imaging", "description": "Curvilinear, dense hyperechoic mural calcification surrounding an inactive, non-viable hydatid cyst, casting a continuous dense posterior acoustic shadow on ultrasound or computed tomography."}, {"name": "Infiltrative Hepatic Mass with Geographic Microcalcifications and Central Necrotic Cavitation", "type": "Admission_Lab_Imaging", "description": "Heterogeneous, invasive hepatic mass with irregular borders, scattered nodular and ring-like microcalcifications displaying a geographic pattern, and a central ischemic necrotic pseudo-cavity characteristic of alveolar echinococcosis."}, {"name": "Hydatid Sand with Free Protoscolices and Refractile Hooklets on Microscopy", "type": "Admission_Lab_Imaging", "description": "Direct microscopic examination of aspirated hydatid fluid revealing free protoscolices, rostellar hooklets, and degraded laminated membrane fragments."}, {"name": "Spike in Peripheral Eosinophilia Above 20 Percent Following Cyst Fissure or Leakage", "type": "Admission_Lab_Imaging", "description": "Marked acute elevation in peripheral blood eosinophil count (>20-40%) on admission complete blood count triggered by micro-leakage or fissure of antigenic hydatid fluid into systemic circulation."}, {"name": "Positive Echinococcus Specific IgG Serology by ELISA and Western Blot", "type": "Admission_Lab_Imaging", "description": "Diagnostic detection of serum IgG antibodies directed against Echinococcus antigen B and antigen 5 (for cystic echinococcosis) or recombinant Em18 and Em2+ antigens (yielding >95% sensitivity for alveolar echinococcosis)."}, {"name": "Elevated Serum Alkaline Phosphatase and GGT from Extrinsic Ductal Compression", "type": "Admission_Lab_Imaging", "description": "Marked elevation in cholestatic liver enzymes (alkaline phosphatase and gamma-glutamyl transferase) with normal to mildly elevated transaminases, resulting from mechanical compression of intrahepatic bile ducts by expanding hydatid cysts."}, {"name": "Classic Triad of Biliary Colic, Obstructive Jaundice, and Urticaria or Anaphylaxis", "type": "Cardinal_Sign", "description": "Pathognomonic presentation of intrabiliary hydatid cyst rupture marked by acute right upper quadrant colic, fluctuating obstructive jaundice, and severe urticaria or anaphylaxis with hydatid membrane passage."}, {"name": "Hydatid Vomica with Salty Expectorated Fluid and White Grape-Skin Membranes", "type": "Cardinal_Sign", "description": "Sudden dramatic expectoration of copious salty hydatid fluid, hemoptysis, and collapsed white gelatinous membranes (grape-skin appearance) caused by intrathoracic rupture into a bronchus."}, {"name": "Sudden Anaphylactic Collapse Triggered by Cyst Rupture or Leakage", "type": "Cardinal_Sign", "description": "Abrupt life-threatening anaphylactic shock featuring diffuse urticaria, angioedema, severe bronchospasm, and circulatory collapse provoked by traumatic or spontaneous cyst rupture and peritoneal fluid spillage."}, {"name": "Stony-Hard Non-Tender Hepatomegaly with Progressive Obstructive Cholestasis", "type": "Cardinal_Sign", "description": "Palpation of an irregular, rigid, stony-hard liver mass in the right upper quadrant associated with progressive jaundice and cachexia, characteristic of the infiltrative pseudotumor of alveolar echinococcosis."}, {"name": "Acute Onset High Spiking Fever and Sepsis Within 48 Hours Without Antecedent Rupture or Abscess", "type": "Exclusion_Criterion", "description": "Hyperacute toxic presentation characterized by high fevers (>38.5°C), rigors, and septic shock developing within 48 hours without antecedent allergic collapse or bacterial cyst infection, ruling out uncomplicated echinococcosis."}, {"name": "Thin-Walled Simple Liver Cyst Under 1 Millimeter with Avascular Fluid and Negative Serology", "type": "Exclusion_Criterion", "description": "Presence of a paper-thin cyst wall (<1 mm) lacking double contours, completely devoid of internal septations, daughter vesicles, hydatid sand, or mural calcifications, with negative Echinococcus serology."}, {"name": "Arterial Hypervascular Liver Lesion with Elevated CA19-9 or AFP and Absence of Microcalcifications", "type": "Exclusion_Criterion", "description": "Infiltrative hepatic lesion demonstrating intense arterial hypervascular enhancement without dense geographic microcalcifications on multiphasic CT, accompanied by markedly elevated serum tumor markers (AFP or CA19-9) and negative Em2+/Em18 serology."}, {"name": "Amoebic Liver Abscess", "type": "Disease", "description": "A hepatic cavitary infection caused by Entamoeba histolytica presenting with acute high fever, rigors, right upper quadrant pain, absence of eosinophilia, and thick 'anchovy-paste' pus without internal membranes or calcifications."}, {"name": "Simple Hepatic Cyst", "type": "Disease", "description": "A benign non-parasitic congenital liver cyst displaying an imperceptible thin wall (<1 mm), homogeneous anechoic fluid, complete absence of internal daughter vesicles or calcifications, and negative serology."}, {"name": "Cholangiocarcinoma", "type": "Disease", "description": "A malignant biliary epithelial neoplasm that mimics alveolar echinococcosis through infiltrative growth and central necrosis, distinguished by elevated CA19-9, arterial enhancement, and absence of geographic microcalcifications."}, {"name": "Hepatocellular Carcinoma", "type": "Disease", "description": "A primary hepatic malignancy distinguished from alveolar echinococcosis by early arterial phase wash-in and delayed wash-out on multiphasic CT, markedly elevated alpha-fetoprotein (AFP), and lack of dense microcalcifications."}, {"name": "Albendazole Anthelmintic Chemotherapy", "type": "Drug_Response", "description": "Oral benzimidazole therapy (10-15 mg/kg/day taken with fat-rich meals) inhibiting parasite beta-tubulin polymerization; provides effective cysticidal therapy in small active cysts (CE1, CE3a <5 cm), peri-procedural spillage prophylaxis, and indefinite parasitostatic suppression in unresectable alveolar echinococcosis."}, {"name": "PAIR Percutaneous Aspiration and Scolicidal Hypertonic Saline or Ethanol Instillation", "type": "Drug_Response", "description": "Minimally invasive ultrasound-guided percutaneous puncture, aspiration of fluid, injection of scolicidal agent (20% hypertonic saline or 95% ethanol for 15-20 minutes), and re-aspiration, indicated for active uncomplicated cysts (CE1, CE3a >5 cm)."}, {"name": "Radical Surgical Resection with Scolicidal Field Isolation", "type": "Drug_Response", "description": "Complete surgical removal of the intact hydatid cyst (pericystectomy or partial liver resection) using scolicidal-soaked packs to isolate the operative field, indicated for multivesicular cysts (CE2, CE3b), cysts with biliary communication, or resectable alveolar echinococcosis."}, {"name": "Standard Antibacterial and Antiviral Regimens", "type": "Drug_Response", "description": "Conventional broad-spectrum antibacterial and antiviral agents, which lack activity against cestode metacestodes and fail to alter the clinical course of echinococcosis."}], "relationships": [{"source": "Echinococcosis", "target": "Direct Contact with Domestic Dogs Shedding Tapeworm Eggs", "keywords": "definitive host, dog contact, fecal-oral transmission, egg ingestion", "description": "[TRANSMITTED_BY] Echinococcosis is transmitted by direct contact with infected domestic dogs harboring adult tapeworms in their small intestines, shedding microscopic environmentally durable eggs adhered to fur or around the muzzle."}, {"source": "Echinococcosis", "target": "Ingestion of Food or Water Contaminated with Dog or Fox Feces", "keywords": "foodborne contamination, unboiled water, wild berries, fecal contamination", "description": "[EXPOSURE_TO] Echinococcosis occurs through ingestion of unboiled drinking water, unwashed agricultural produce, or wild-gathered berries contaminated with carnivore feces containing infectious Echinococcus oncospheres."}, {"source": "Echinococcosis", "target": "Pastoral Sheep-Raising and Home Livestock Slaughter Exposure", "keywords": "pastoral farming, sheep-dog cycle, livestock offal, intermediate hosts", "description": "[EXPOSURE_TO] Echinococcosis is strongly predisposed by rural residence in pastoral sheep-raising regions where domestic dogs are fed raw livestock viscera containing fertile hydatid cysts."}, {"source": "Echinococcosis", "target": "Sylvatic Wildlife Cycle Exposure in Boreal and Northern Temperate Zones", "keywords": "sylvatic cycle, red foxes, wild canids, rodent intermediate host, boreal endemicity", "description": "[EXPOSURE_TO] Echinococcosis (specifically alveolar echinococcosis) is predisposed by residence or foraging in northern temperate and boreal ecosystems where wild foxes, canids, and arvicoline rodents maintain an intense sylvatic transmission cycle."}, {"source": "Echinococcosis", "target": "Echinococcus granulosus sensu lato", "keywords": "cestode, cyclophyllidean tapeworm, cystic echinococcosis, hydatid disease", "description": "[HAS_PATHOGEN] Echinococcosis is caused by the larval metacestode stage of Echinococcus granulosus sensu lato, which forms fluid-filled unilocular and multivesicular hydatid cysts encapsulated by a host fibrous pericyst."}, {"source": "Echinococcosis", "target": "Echinococcus multilocularis", "keywords": "fox tapeworm, alveolar echinococcosis, infiltrative metacestode, microvesicles", "description": "[HAS_PATHOGEN] Echinococcosis is caused by Echinococcus multilocularis, producing alveolar echinococcosis characterized by malignant-like infiltrative proliferation of microvesicles invading hepatic parenchyma and vascular channels."}, {"source": "Echinococcosis", "target": "Echinococcus vogeli", "keywords": "neotropical cestode, polycystic echinococcosis, South America, Central America", "description": "[HAS_PATHOGEN] Echinococcosis can be caused by Echinococcus vogeli, an etiologic agent of neotropical polycystic echinococcosis reported in Central and South America."}, {"source": "Echinococcosis", "target": "Echinococcus oligarthrus", "keywords": "neotropical cestode, unicystic echinococcosis, wild felids", "description": "[HAS_PATHOGEN] Echinococcosis can be caused by Echinococcus oligarthrus, producing rare neotropical unicystic echinococcosis in Central and South America."}, {"source": "Echinococcosis", "target": "Multivesicular Daughter Cysts with Spoke-Wheel Honeycomb Pattern on Ultrasound (WHO CE2)", "keywords": "WHO CE2, daughter cysts, spoke-wheel sign, honeycomb rosette, ultrasound staging", "description": "[EXHIBITS_LAB_PATTERN] Echinococcosis exhibits pathognomonic multivesicular daughter cysts with a spoke-wheel, rosette, or honeycomb architecture on abdominal ultrasound, diagnostic of active WHO stage CE2."}, {"source": "Echinococcosis", "target": "Water-Lily Floating Membrane Sign on Ultrasound (WHO CE3a)", "keywords": "WHO CE3a, water-lily sign, undulating membrane, endocyst detachment, ultrasound sign", "description": "[EXHIBITS_LAB_PATTERN] Echinococcosis presents with the pathognomonic water-lily sign on bedside ultrasound, caused by detachment and collapse of the laminated parasitic membrane within the hydatid cyst cavity in transitional WHO stage CE3a."}, {"source": "Echinococcosis", "target": "Anechoic Unilocular Cyst with Double-Contour Wall and Snowstorm Sign (WHO CE1)", "keywords": "WHO CE1, unilocular cyst, double-line wall, snowstorm sign, shifting echoes", "description": "[EXHIBITS_LAB_PATTERN] Echinococcosis exhibits an anechoic unilocular cystic lesion with a sharp double-line wall and internal shifting echoes resembling a snowstorm on patient movement, representing active WHO stage CE1."}, {"source": "Echinococcosis", "target": "Thick Hyperechoic Eggshell Calcification with Posterior Acoustic Shadowing (WHO CE5)", "keywords": "WHO CE5, eggshell calcification, acoustic shadow, calcified cyst, inactive cyst", "description": "[EXHIBITS_LAB_PATTERN] Echinococcosis exhibits thick curvilinear hyperechoic eggshell calcification with dense posterior acoustic shadowing on ultrasound and CT, diagnostic of an inactive, non-viable WHO stage CE5 cyst."}, {"source": "Echinococcosis", "target": "Infiltrative Hepatic Mass with Geographic Microcalcifications and Central Necrotic Cavitation", "keywords": "alveolar echinococcosis, geographic calcifications, pseudocavity, infiltrative liver mass", "description": "[EXHIBITS_LAB_PATTERN] Echinococcosis (specifically alveolar echinococcosis) presents on CT/ultrasound as an infiltrative tumor-like liver mass with dense geographic microcalcifications and central ischemic necrotic cavitation lacking daughter cysts."}, {"source": "Echinococcosis", "target": "Hydatid Sand with Free Protoscolices and Refractile Hooklets on Microscopy", "keywords": "hydatid sand, protoscolices, hooklets, microscopy, parasitic fluid analysis", "description": "[EXHIBITS_LAB_PATTERN] Echinococcosis exhibits pathognomonic hydatid sand containing microscopic protoscolices and chitinous hooklets upon microscopic evaluation of aspirated or expelled cyst fluid."}, {"source": "Echinococcosis", "target": "Spike in Peripheral Eosinophilia Above 20 Percent Following Cyst Fissure or Leakage", "keywords": "peripheral eosinophilia, eosinophil spike, cyst leakage, antigenic stimulation, CBC", "description": "[EXHIBITS_LAB_PATTERN] Echinococcosis demonstrates a sharp surge in peripheral blood eosinophilia (>20-40%) on admission complete blood count during or immediately following cyst micro-fissuring, leakage, or rupture."}, {"source": "Echinococcosis", "target": "Positive Echinococcus Specific IgG Serology by ELISA and Western Blot", "keywords": "antigen B, antigen 5, Em18, Em2+, IgG serology, Western blot", "description": "[EXHIBITS_LAB_PATTERN] Echinococcosis demonstrates elevated serum IgG titers on specific ELISA or Western blot detecting antigen B/antigen 5 (CE) or recombinant Em2+/Em18 antigens (AE)."}, {"source": "Echinococcosis", "target": "Elevated Serum Alkaline Phosphatase and GGT from Extrinsic Ductal Compression", "keywords": "alkaline phosphatase, GGT, cholestatic pattern, extrinsic biliary compression", "description": "[EXHIBITS_LAB_PATTERN] Echinococcosis exhibits a cholestatic biochemical profile with elevated serum alkaline phosphatase and GGT caused by mechanical extrinsic compression of intrahepatic biliary ducts by the expanding metacestode."}, {"source": "Echinococcosis", "target": "Classic Triad of Biliary Colic, Obstructive Jaundice, and Urticaria or Anaphylaxis", "keywords": "intrabiliary rupture triad, biliary colic, jaundice, urticaria, hydatid membranes", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Echinococcosis presents with the pathognomonic intrabiliary rupture triad consisting of severe biliary colic, fluctuating obstructive jaundice, and urticaria or anaphylaxis with evacuation of hydatid membranes."}, {"source": "Echinococcosis", "target": "Hydatid Vomica with Salty Expectorated Fluid and White Grape-Skin Membranes", "keywords": "vomica, bronchial rupture, grape-skin membranes, salty sputum, pulmonary CE", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Echinococcosis presents with pathognomonic hydatid vomica, characterized by sudden coughing spells expectorating profuse salty fluid and gelatinous grape-skin membranes upon intrabronchial cyst rupture."}, {"source": "Echinococcosis", "target": "Sudden Anaphylactic Collapse Triggered by Cyst Rupture or Leakage", "keywords": "anaphylactic shock, circulatory collapse, cyst rupture, blunt trauma, antigenic fluid", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Echinococcosis presents with sudden life-threatening anaphylactic collapse provoked by traumatic or spontaneous puncture and peritoneal spillage of hyper-antigenic hydatid cyst fluid."}, {"source": "Echinococcosis", "target": "Stony-Hard Non-Tender Hepatomegaly with Progressive Obstructive Cholestasis", "keywords": "stony hepatomegaly, alveolar echinococcosis, obstructive jaundice, hepatic mass", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Echinococcosis (alveolar form) presents on physical examination as a stony-hard, non-tender irregular hepatic mass associated with slowly progressive biliary obstruction and portal hypertension."}, {"source": "Echinococcosis", "target": "Acute Onset High Spiking Fever and Sepsis Within 48 Hours Without Antecedent Rupture or Abscess", "keywords": "hyperacute sepsis, high spiking fever, toxic presentation, negative likelihood ratio", "description": "[RULED_OUT_BY] Echinococcosis is ruled out by the hyperacute onset of high spiking fevers, chills, and septic shock within 48 hours in the absence of documented bacterial superinfection or anaphylactic collapse."}, {"source": "Echinococcosis", "target": "Thin-Walled Simple Liver Cyst Under 1 Millimeter with Avascular Fluid and Negative Serology", "keywords": "thin cyst wall, absence of daughter cysts, negative serology, simple cyst", "description": "[RULED_OUT_BY] Echinococcosis is ruled out by ultrasound identification of an entirely unilocular thin-walled (<1 mm) hepatic cyst without double-layer contours, daughter cysts, or mural calcifications alongside negative Echinococcus serology."}, {"source": "Echinococcosis", "target": "Arterial Hypervascular Liver Lesion with Elevated CA19-9 or AFP and Absence of Microcalcifications", "keywords": "arterial hyperenhancement, elevated AFP, elevated CA19-9, absence of microcalcifications", "description": "[RULED_OUT_BY] Echinococcosis (specifically alveolar echinococcosis) is ruled out by the presence of arterial phase hypervascular contrast enhancement on multiphasic CT, markedly elevated CA19-9 or AFP, and complete absence of microcalcifications."}, {"source": "Echinococcosis", "target": "Amoebic Liver Abscess", "keywords": "Entamoeba histolytica, anchovy-sauce pus, acute fever, lack of eosinophilia", "description": "[DIFFERENTIATED_FROM] Echinococcosis is differentiated from amoebic liver abscess, which presents acutely with high spiking fever, severe abdominal pain, complete lack of eosinophilia, and thick anchovy-paste aspirate lacking internal membranes or calcifications."}, {"source": "Echinococcosis", "target": "Simple Hepatic Cyst", "keywords": "simple liver cyst, thin wall, lack of daughter cysts, negative serology", "description": "[DIFFERENTIATED_FROM] Echinococcosis is differentiated from simple non-parasitic hepatic cysts, which display thin imperceptible walls (<1 mm), strictly homogeneous anechoic fluid, complete absence of internal membranes or eggshell calcifications, and negative serology."}, {"source": "Echinococcosis", "target": "Cholangiocarcinoma", "keywords": "biliary malignancy, CA19-9, hypervascular enhancement, central necrosis", "description": "[DIFFERENTIATED_FROM] Echinococcosis (alveolar form) is differentiated from cholangiocarcinoma, which exhibits elevated serum CA19-9, hypervascular arterial contrast enhancement on triphasic CT, and lacks the pathognomonic dense geographic microcalcifications and positive Em2+/Em18 serology of alveolar echinococcosis."}, {"source": "Echinococcosis", "target": "Hepatocellular Carcinoma", "keywords": "primary liver cancer, AFP, arterial wash-in, venous wash-out, microcalcifications", "description": "[DIFFERENTIATED_FROM] Echinococcosis is differentiated from hepatocellular carcinoma, which features elevated serum alpha-fetoprotein (AFP), classic arterial phase wash-in with portovenous wash-out on dynamic CT, and absence of echinococcal calcific matrix."}, {"source": "Echinococcosis", "target": "Albendazole Anthelmintic Chemotherapy", "keywords": "albendazole, benzimidazole, beta-tubulin inhibitor, cysticidal therapy, parasitostatic", "description": "[RESPONDS_TO] Echinococcosis responds to albendazole chemotherapy (10-15 mg/kg/day taken with fatty meals), which inhibits parasite beta-tubulin polymerization, leading to cyst inactivation in small active cysts and preventing secondary seeding."}, {"source": "Echinococcosis", "target": "PAIR Percutaneous Aspiration and Scolicidal Hypertonic Saline or Ethanol Instillation", "keywords": "PAIR technique, percutaneous intervention, hypertonic saline, ethanol scolicide, CE1 and CE3a", "description": "[RESPONDS_TO] Echinococcosis responds to the PAIR procedure (percutaneous puncture, aspiration, injection of 20% hypertonic saline or 95% ethanol for 15-20 minutes, and re-aspiration) for active uncomplicated cysts greater than 5 cm."}, {"source": "Echinococcosis", "target": "Radical Surgical Resection with Scolicidal Field Isolation", "keywords": "pericystectomy, partial hepatectomy, scolicidal pack isolation, CE2, CE3b, radical surgery", "description": "[RESPONDS_TO] Echinococcosis responds to radical surgical resection (pericystectomy or anatomical hepatectomy) with meticulous intraoperative scolicidal field isolation, providing curative therapy for large multivesicular cysts and localized alveolar lesions."}, {"source": "Echinococcosis", "target": "Standard Antibacterial and Antiviral Regimens", "keywords": "antibiotic refractoriness, antibacterial resistance, antiviral ineffectiveness", "description": "[INTRINSICALLY_RESISTANT_TO] Echinococcosis is intrinsically resistant to standard antibacterial and antiviral regimens, exhibiting complete lack of therapeutic response in the absence of secondary bacterial superinfection."}]}}
{"case_id": "foodborne_trematodes", "disease": "Foodborne Trematodes", "extraction": {"entities": [{"name": "Foodborne Trematodes", "type": "Disease", "description": "A group of zoonotic helminthiases caused by digenetic flukes (liver flukes: Clonorchis sinensis, Opisthorchis viverrini/felineus, Fasciola hepatica/gigantica; lung flukes: Paragonimus westermani; and intestinal flukes) acquired through consumption of raw or undercooked freshwater fish, crustaceans, or aquatic plants, leading to chronic hepatobiliary, pulmonary, or ectopic diseases."}, {"name": "Ingestion of Raw or Undercooked Freshwater Cyprinid Fish", "type": "Vector_Exposure", "description": "Dietary consumption of raw, undercooked, pickled, fermented, or sun-dried freshwater cyprinid fish (such as carp dishes, Thai koi pla, or Chinese raw fish porridge) harboring encysted metacercariae of Clonorchis sinensis or Opisthorchis species."}, {"name": "Ingestion of Raw or Undercooked Freshwater Crustaceans", "type": "Vector_Exposure", "description": "Dietary consumption of raw, undercooked, salted, marinated, or wine-soaked freshwater river crabs or crayfish (such as drunken crabs) containing encysted metacercariae of Paragonimus westermani or related lung fluke species."}, {"name": "Ingestion of Raw Freshwater Aquatic Plants", "type": "Vector_Exposure", "description": "Ingestion of raw, unwashed wild aquatic vegetables (particularly watercress [Nasturtium officinale], water spinach, water chestnuts, or mint) or untreated surface water contaminated with encysted metacercariae of Fasciola hepatica or Fasciola gigantica in livestock-grazing regions."}, {"name": "Freshwater Snail Intermediate Host Aquatic Environment", "type": "Vector_Exposure", "description": "Ecological exposure to freshwater aquatic habitats harboring specific snail species that serve as mandatory first intermediate hosts required for trematode larval multiplication and cercarial shedding."}, {"name": "Consumption of Raw Paratenic Wild Boar Meat", "type": "Vector_Exposure", "description": "Ingestion of raw or undercooked meat from paratenic mammalian hosts (such as wild boars) that feed on freshwater crustaceans, transmitting viable Paragonimus metacercariae."}, {"name": "Clonorchis sinensis", "type": "Pathogen", "description": "The Chinese liver fluke, a digenetic trematode dwelling within intrahepatic bile ducts for up to 20-30 years, causing chronic mechanical ductal injury, adenomatous hyperplasia, recurrent pyogenic cholangiohepatitis, and cholangiocarcinoma."}, {"name": "Opisthorchis viverrini", "type": "Pathogen", "description": "The Southeast Asian liver fluke, highly endemic in the lower Mekong basin, dwelling within intrahepatic bile ducts and designated as an IARC Group 1 biological carcinogen causing cholangiocarcinoma."}, {"name": "Opisthorchis felineus", "type": "Pathogen", "description": "A liver fluke endemic to Russia and Eastern Europe that parasitizes intrahepatic bile ducts and the gallbladder following consumption of raw cyprinid fish."}, {"name": "Fasciola hepatica", "type": "Pathogen", "description": "The common sheep liver fluke, a large trematode (20-30 mm) that penetrates Glisson's capsule and burrows through hepatic parenchyma during an acute invasive phase before colonizing the major biliary tract in its chronic phase."}, {"name": "Fasciola gigantica", "type": "Pathogen", "description": "The giant liver fluke, a zoonotic parasite endemic in tropical regions of Africa and Asia causing acute destructive hepatic parenchymal tunneling and chronic biliary obstruction."}, {"name": "Paragonimus westermani", "type": "Pathogen", "description": "The Oriental lung fluke, whose juvenile flukes penetrate the peritoneal cavity and diaphragm to encapsulate in pairs within pulmonary parenchyma connecting with bronchioles, or migrate aberrantly to the central nervous system."}, {"name": "Recurrent Biliary Colic with Marked Eosinophilia", "type": "Cardinal_Sign", "description": "Cardinal clinical presentation of hepatobiliary fluke infection characterized by right upper quadrant abdominal pain, intermittent obstructive biliary colic, and marked peripheral blood eosinophilia."}, {"name": "Rusty-Brown Sputum with Operculated Fluke Eggs", "type": "Cardinal_Sign", "description": "Pathognomonic expectoration of thick, gelatinous 'chocolate-sauce' or rusty-brown sputum containing clotted blood, Charcot-Leyden crystals, and masses of operculated Paragonimus eggs."}, {"name": "Acute Invasive Hepatic Tunneling Syndrome", "type": "Cardinal_Sign", "description": "Acute presentation of fascioliasis occurring 1-12 weeks post-ingestion, characterized by high continuous or spiking fever (39-40°C), painful hepatomegaly, severe right upper quadrant tenderness, urticaria, facial angioedema, and massive leukocytosis."}, {"name": "Intrahepatic Cholangiocarcinoma in Chronic Fluke Carriage", "type": "Cardinal_Sign", "description": "Definitive malignant transformation of intrahepatic and perihilar biliary duct epithelium into cholangiocarcinoma driven by chronic Clonorchis sinensis or Opisthorchis viverrini irritation, parasite granulin secretome, and endogenous nitrosamines."}, {"name": "Ectopic Cerebral Paragonimiasis with Adult-Onset Focal Seizures", "type": "Cardinal_Sign", "description": "Severe neurological complication of Paragonimus migration through craniocervical connective tissue, presenting with adult-onset focal epilepsy, visual field defects, intracerebral hemorrhage, and chronic intracranial hypertension."}, {"name": "Massive Peripheral Blood Eosinophilia (>40-80%)", "type": "Admission_Lab_Imaging", "description": "Striking admission hematologic hallmark, reaching 40-80% of total differential count (absolute eosinophil count 10,000-35,000/μL) with marked leukocytosis in acute invasive fascioliasis, and 15-35% in paragonimiasis."}, {"name": "Markedly Elevated Serum IgE Concentration", "type": "Admission_Lab_Imaging", "description": "Admission serologic hallmark routinely exceeding 1,000 to 5,000 IU/mL, reflecting intense Th2-mediated helminthic immune activation during active fluke tissue migration."}, {"name": "Disproportionately Elevated Serum ALP and GGT with Mild Transaminitis", "type": "Admission_Lab_Imaging", "description": "Admission liver chemistry pattern demonstrating marked elevations of Alkaline Phosphatase (ALP) and Gamma-Glutamyl Transferase (GGT) with mild-to-moderate transaminitis (AST/ALT 2-4x ULN) and direct hyperbilirubinemia during biliary obstruction."}, {"name": "Branching Serpentine Hypoechoic Hepatic Tracks on Ultrasound", "type": "Admission_Lab_Imaging", "description": "Bedside abdominal ultrasound hallmark revealing linear, branching, serpentine hypoechoic parenchymal tunnels and burrows in the subcapsular liver parenchyma during acute juvenile Fasciola migration."}, {"name": "Diffuse Uniform Peripheral Intrahepatic Bile Duct Dilation on Ultrasound", "type": "Admission_Lab_Imaging", "description": "Bedside ultrasound hallmark of chronic clonorchiasis demonstrating diffuse, non-tapering dilation of peripheral intrahepatic bile ducts with enhanced periductal echogenicity while the common bile duct remains of normal caliber."}, {"name": "Ring-Shaped Cystic Pulmonary Lesions on Admission Chest Radiography", "type": "Admission_Lab_Imaging", "description": "Triage chest X-ray findings in pulmonary paragonimiasis showing 1-3 cm round, ring-shaped cystic lesions with thin or thick walls, patchy nodular opacities, pleural thickening, or spontaneous pneumothorax."}, {"name": "Multilocular Soap-Bubble Calcifications on Brain CT/MRI", "type": "Admission_Lab_Imaging", "description": "Pathognomonic neuroimaging finding in cerebral paragonimiasis demonstrating clustered, multilocular, calcified cystic lesions with ring enhancement forming a distinctive 'soap-bubble' appearance."}, {"name": "Sputum Microscopy Demonstrating Operculated Paragonimus Eggs", "type": "Admission_Lab_Imaging", "description": "Triage microscopic examination of unstained sputum wet mount demonstrating large (80-120 x 45-65 μm), golden-brown, thick-shelled operculated eggs with an opercular collar rim."}, {"name": "Stool Concentration Microscopy Demonstrating Urn-Shaped Fluke Eggs", "type": "Admission_Lab_Imaging", "description": "Microscopic stool examination by Kato-Katz or formalin-ether concentration revealing small (25-35 x 12-19 μm), yellowish-brown, pitcher/urn-shaped operculated eggs with an expanded shoulder collar and abopercular knob, diagnostic of Clonorchis or Opisthorchis."}, {"name": "Stool Microscopy Demonstrating Large Operculated Fasciola Eggs", "type": "Admission_Lab_Imaging", "description": "Microscopic identification of large (130-150 x 65-90 μm), golden-yellow, unembryonated operculated eggs in stool or duodenal aspirates during the chronic biliary phase of fascioliasis."}, {"name": "Complete Absence of Dietary Freshwater Seafood or Aquatic Plant Exposure", "type": "Exclusion_Criterion", "description": "Total absence of dietary history involving raw or undercooked freshwater fish, crustaceans, wild aquatic vegetables (watercress), or unboiled pasture surface water, which virtually excludes foodborne trematode infection."}, {"name": "Total Absence of Peripheral Blood Eosinophilia (<3%)", "type": "Exclusion_Criterion", "description": "Normal peripheral blood eosinophil count (<3% or normal absolute count) in an acutely symptomatic patient with fever, right upper quadrant pain, or pulmonary infiltrates, which strongly excludes acute fascioliasis and acute paragonimiasis."}, {"name": "Acid-Fast Bacilli Detection on Sputum Smear or GeneXpert without Eosinophilia", "type": "Exclusion_Criterion", "description": "Microbiological confirmation of Mycobacterium tuberculosis by acid-fast smear or GeneXpert PCR in the absence of peripheral eosinophilia, effectively excluding pulmonary paragonimiasis in a cavitary lung presentation."}, {"name": "Solitary Round Hepatic Liquefactive Cavity with Positive Amoebic Serology", "type": "Exclusion_Criterion", "description": "Demonstration of a single round liquefactive liver abscess containing anchovy-paste pus with positive Entamoeba histolytica serology and zero eosinophilia, excluding acute fascioliasis."}, {"name": "Acoustic-Shadowing Choledocholithiasis with Neutrophilic Leukocytosis", "type": "Exclusion_Criterion", "description": "Sonographic demonstration of acoustic-shadowing gallstones in the common bile duct accompanied by marked neutrophilic leukocytosis without eosinophilia, ruling out biliary fluke disease in favor of calculous cholangitis."}, {"name": "Pulmonary Tuberculosis", "type": "Disease", "description": "A mycobacterial pulmonary infection that mimics pulmonary paragonimiasis with chronic cough, hemoptysis, and cavitary infiltrates, but lacks peripheral blood eosinophilia, lacks operculated sputum eggs, and tests positive for acid-fast bacilli."}, {"name": "Amoebic Liver Abscess", "type": "Disease", "description": "A protozoan hepatic infection caused by Entamoeba histolytica presenting with high fever and tender hepatomegaly, differentiated from acute fascioliasis by a solitary round liquefactive abscess, positive amoebic serology, lack of branching parenchymal tracks, and absence of eosinophilia."}, {"name": "Acute Bacterial Cholangitis with Choledocholithiasis", "type": "Disease", "description": "Bacterial biliary infection secondary to choledocholithiasis presenting with Charcot's triad (fever, jaundice, RUQ pain), differentiated from liver fluke disease by acoustic shadowing stones on ultrasound, neutrophilic shift without eosinophilia, and absence of raw fish dietary history."}, {"name": "Praziquantel Therapeutic Susceptibility in Clonorchiasis, Opisthorchiasis, and Paragonimiasis", "type": "Drug_Response", "description": "Rapid clinical and parasitological response to oral praziquantel (25 mg/kg TID for 2-3 days), achieving >85-100% cure rates in Clonorchis sinensis, Opisthorchis viverrini, and Paragonimus westermani by inducing tegumental disruption and spastic paralysis."}, {"name": "Triclabendazole First-Line Cure in Fascioliasis", "type": "Drug_Response", "description": "Oral triclabendazole (10 mg/kg single dose or 20 mg/kg divided dose taken with food), which exhibits unique fasciolicidal efficacy against both juvenile migratory and adult Fasciola flukes, producing rapid defervescence and >95% cure."}, {"name": "Intrinsic Praziquantel Refractoriness in Fascioliasis", "type": "Drug_Response", "description": "Total lack of therapeutic response (0% cure rate) of Fasciola hepatica and Fasciola gigantica to standard or high-dose praziquantel regimens due to their exceptionally thick tegumental architecture, resulting in persistent infection and clinical treatment failure."}, {"name": "Refractoriness to Standard Broad-Spectrum Antibacterials", "type": "Drug_Response", "description": "Total failure of broad-spectrum beta-lactam antibiotics, cephalosporins, or antimalarials to achieve clinical defervescence or resolve symptoms in patients with acute or chronic foodborne trematode infections."}], "relationships": [{"source": "Foodborne Trematodes", "target": "Ingestion of Raw or Undercooked Freshwater Cyprinid Fish", "keywords": "TRANSMITTED_BY, dietary exposure, raw fish, cyprinid carp, metacercariae", "description": "[TRANSMITTED_BY] Foodborne Trematodes causing clonorchiasis and opisthorchiasis are acquired via dietary consumption of raw, undercooked, pickled, or fermented freshwater cyprinid fish harboring encysted metacercariae."}, {"source": "Foodborne Trematodes", "target": "Ingestion of Raw or Undercooked Freshwater Crustaceans", "keywords": "TRANSMITTED_BY, dietary exposure, river crabs, crayfish, drunken crabs, metacercariae", "description": "[TRANSMITTED_BY] Foodborne Trematodes causing paragonimiasis are transmitted through ingestion of raw, salted, wine-soaked, or undercooked freshwater crustaceans (river crabs or crayfish) harboring infectious metacercariae."}, {"source": "Foodborne Trematodes", "target": "Ingestion of Raw Freshwater Aquatic Plants", "keywords": "TRANSMITTED_BY, dietary exposure, watercress, aquatic plants, unboiled surface water", "description": "[TRANSMITTED_BY] Foodborne Trematodes causing fascioliasis are transmitted through consumption of raw, unwashed aquatic plants (particularly wild watercress) or drinking untreated surface water harboring encysted metacercariae in livestock-grazing regions."}, {"source": "Foodborne Trematodes", "target": "Freshwater Snail Intermediate Host Aquatic Environment", "keywords": "EXPOSURE_TO, snail host, freshwater ecosystem, zoonotic life cycle", "description": "[EXPOSURE_TO] Foodborne Trematodes depend obligately on freshwater snail first intermediate hosts to complete their digenetic developmental life cycles in endemic aquatic environments."}, {"source": "Foodborne Trematodes", "target": "Consumption of Raw Paratenic Wild Boar Meat", "keywords": "TRANSMITTED_BY, paratenic host, wild boar, crustacean predator", "description": "[TRANSMITTED_BY] Foodborne Trematodes (Paragonimus species) can be transmitted secondarily through ingestion of undercooked or raw meat from paratenic mammalian hosts such as wild boars that feed on infected freshwater crustaceans."}, {"source": "Foodborne Trematodes", "target": "Clonorchis sinensis", "keywords": "HAS_PATHOGEN, Chinese liver fluke, intrahepatic bile ducts, cholangiocarcinoma", "description": "[HAS_PATHOGEN] Foodborne Trematodes include Clonorchis sinensis, the Chinese liver fluke that colonizes intrahepatic bile ducts and causes chronic cholangitis and cholangiocarcinoma."}, {"source": "Foodborne Trematodes", "target": "Opisthorchis viverrini", "keywords": "HAS_PATHOGEN, Southeast Asian liver fluke, Mekong basin, biliary carcinogen", "description": "[HAS_PATHOGEN] Foodborne Trematodes include Opisthorchis viverrini, a major biliary parasite in Southeast Asia classified as an IARC Group 1 biological carcinogen."}, {"source": "Foodborne Trematodes", "target": "Opisthorchis felineus", "keywords": "HAS_PATHOGEN, liver fluke, Eastern Europe, Russia, cyprinid fish", "description": "[HAS_PATHOGEN] Foodborne Trematodes include Opisthorchis felineus, a liver fluke endemic to Russia and Eastern Europe that infects the human biliary tree."}, {"source": "Foodborne Trematodes", "target": "Fasciola hepatica", "keywords": "HAS_PATHOGEN, common sheep liver fluke, hepatic parenchyma, bile ducts", "description": "[HAS_PATHOGEN] Foodborne Trematodes include Fasciola hepatica, which causes acute destructive hepatic parenchymal migration and chronic obstructive biliary disease."}, {"source": "Foodborne Trematodes", "target": "Fasciola gigantica", "keywords": "HAS_PATHOGEN, giant liver fluke, invasive hepatic migration, tropical fascioliasis", "description": "[HAS_PATHOGEN] Foodborne Trematodes include Fasciola gigantica, a large fluke causing severe hepatic parenchymal destruction and biliary obstruction across tropical Africa and Asia."}, {"source": "Foodborne Trematodes", "target": "Paragonimus westermani", "keywords": "HAS_PATHOGEN, Oriental lung fluke, pulmonary encapsulation, hemoptysis", "description": "[HAS_PATHOGEN] Foodborne Trematodes include Paragonimus westermani, the Oriental lung fluke that encapsulates in cystic lung cavities and may migrate aberrantly to the central nervous system."}, {"source": "Foodborne Trematodes", "target": "Recurrent Biliary Colic with Marked Eosinophilia", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, biliary colic, RUQ pain, eosinophilia, liver flukes", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Foodborne Trematodes affecting the biliary tract present characteristically with recurrent right upper quadrant biliary colic accompanied by marked peripheral blood eosinophilia."}, {"source": "Foodborne Trematodes", "target": "Rusty-Brown Sputum with Operculated Fluke Eggs", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, rusty sputum, chocolate sauce hemoptysis, operculated eggs, lung fluke", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Foodborne Trematodes presenting as paragonimiasis exhibit the hallmark expectoration of thick, rusty-brown 'chocolate-sauce' sputum laden with microscopic operculated fluke eggs and Charcot-Leyden crystals."}, {"source": "Foodborne Trematodes", "target": "Acute Invasive Hepatic Tunneling Syndrome", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, acute fascioliasis, high fever, tender hepatomegaly, urticaria", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Foodborne Trematodes causing acute fascioliasis manifest with high spiking fever (39-40°C), painful hepatomegaly, urticaria, and profound leukocytosis during juvenile fluke parenchymal migration."}, {"source": "Foodborne Trematodes", "target": "Intrahepatic Cholangiocarcinoma in Chronic Fluke Carriage", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, cholangiocarcinoma, bile duct cancer, Clonorchis, Opisthorchis", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Foodborne Trematodes involving chronic Clonorchis sinensis or Opisthorchis viverrini infection induce malignant transformation into intrahepatic and perihilar cholangiocarcinoma."}, {"source": "Foodborne Trematodes", "target": "Ectopic Cerebral Paragonimiasis with Adult-Onset Focal Seizures", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, cerebral paragonimiasis, adult onset epilepsy, intracranial hypertension", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Foodborne Trematodes with ectopic intracranial migration of Paragonimus present with adult-onset focal epilepsy, visual disturbances, and intracranial hypertension."}, {"source": "Foodborne Trematodes", "target": "Massive Peripheral Blood Eosinophilia (>40-80%)", "keywords": "EXHIBITS_LAB_PATTERN, extreme eosinophilia, leukocytosis, acute invasive phase", "description": "[EXHIBITS_LAB_PATTERN] Foodborne Trematodes demonstrate dramatic admission peripheral blood eosinophilia (often >40-80% in acute fascioliasis and >15-35% in paragonimiasis) with marked leukocytosis."}, {"source": "Foodborne Trematodes", "target": "Markedly Elevated Serum IgE Concentration", "keywords": "EXHIBITS_LAB_PATTERN, hyper-IgE, Th2 response, helminthic activation", "description": "[EXHIBITS_LAB_PATTERN] Foodborne Trematodes trigger intense helminthic Th2 immunity resulting in markedly elevated admission serum IgE levels exceeding 1,000-5,000 IU/mL."}, {"source": "Foodborne Trematodes", "target": "Disproportionately Elevated Serum ALP and GGT with Mild Transaminitis", "keywords": "EXHIBITS_LAB_PATTERN, cholestatic liver enzymes, elevated ALP, elevated GGT, biliary irritation", "description": "[EXHIBITS_LAB_PATTERN] Foodborne Trematodes affecting the hepatobiliary system display a cholestatic biochemical profile with marked elevations of ALP and GGT alongside mild-to-moderate transaminitis (AST/ALT 2-4x ULN)."}, {"source": "Foodborne Trematodes", "target": "Branching Serpentine Hypoechoic Hepatic Tracks on Ultrasound", "keywords": "EXHIBITS_LAB_PATTERN, tunnels and burrows, liver ultrasound, acute fascioliasis", "description": "[EXHIBITS_LAB_PATTERN] Foodborne Trematodes in the acute fascioliasis phase reveal pathognomonic linear and branching serpentine hypoechoic parenchymal tracks ('tunnels and burrows') on triage abdominal ultrasonography."}, {"source": "Foodborne Trematodes", "target": "Diffuse Uniform Peripheral Intrahepatic Bile Duct Dilation on Ultrasound", "keywords": "EXHIBITS_LAB_PATTERN, peripheral ductal dilation, periductal echogenicity, ultrasound, clonorchiasis", "description": "[EXHIBITS_LAB_PATTERN] Foodborne Trematodes causing clonorchiasis display diffuse, non-tapering dilation of peripheral intrahepatic bile ducts with periductal thickening while the common bile duct remains of normal caliber."}, {"source": "Foodborne Trematodes", "target": "Ring-Shaped Cystic Pulmonary Lesions on Admission Chest Radiography", "keywords": "EXHIBITS_LAB_PATTERN, chest X-ray, cystic lesions, nodular opacities, paragonimiasis", "description": "[EXHIBITS_LAB_PATTERN] Foodborne Trematodes presenting as paragonimiasis exhibit 1-3 cm ring-shaped cystic lesions, patchy nodular infiltrates, or pleural effusions on triage chest radiography."}, {"source": "Foodborne Trematodes", "target": "Multilocular Soap-Bubble Calcifications on Brain CT/MRI", "keywords": "EXHIBITS_LAB_PATTERN, soap bubble appearance, brain CT, MRI, cerebral paragonimiasis", "description": "[EXHIBITS_LAB_PATTERN] Foodborne Trematodes presenting with cerebral paragonimiasis show clustered, ring-enhancing, multilocular calcified cystic lesions producing a 'soap-bubble' appearance on brain imaging."}, {"source": "Foodborne Trematodes", "target": "Sputum Microscopy Demonstrating Operculated Paragonimus Eggs", "keywords": "EXHIBITS_LAB_PATTERN, sputum wet mount, operculated eggs, opercular shoulder, Paragonimus", "description": "[EXHIBITS_LAB_PATTERN] Foodborne Trematodes causing pulmonary paragonimiasis are definitively identified at triage by unstained sputum microscopy demonstrating golden-brown operculated eggs with an opercular collar rim."}, {"source": "Foodborne Trematodes", "target": "Stool Concentration Microscopy Demonstrating Urn-Shaped Fluke Eggs", "keywords": "EXHIBITS_LAB_PATTERN, Kato-Katz, urn-shaped eggs, abopercular knob, Clonorchis, Opisthorchis", "description": "[EXHIBITS_LAB_PATTERN] Foodborne Trematodes causing clonorchiasis or opisthorchiasis are confirmed by stool Kato-Katz concentration microscopy demonstrating small (25-35 μm) urn-shaped operculated eggs with a shoulder rim and abopercular knob."}, {"source": "Foodborne Trematodes", "target": "Stool Microscopy Demonstrating Large Operculated Fasciola Eggs", "keywords": "EXHIBITS_LAB_PATTERN, large operculated eggs, Fasciola, stool microscopy", "description": "[EXHIBITS_LAB_PATTERN] Foodborne Trematodes in the chronic biliary phase of fascioliasis reveal large (130-150 μm), golden-yellow, unembryonated operculated eggs on stool or biliary aspirate microscopy."}, {"source": "Foodborne Trematodes", "target": "Complete Absence of Dietary Freshwater Seafood or Aquatic Plant Exposure", "keywords": "RULED_OUT_BY, dietary exposure absent, negative epidemiological history", "description": "[RULED_OUT_BY] Foodborne Trematodes are ruled out by the complete absence of dietary exposure to raw or undercooked freshwater fish, crustaceans, aquatic plants (watercress), or unboiled pastoral surface water."}, {"source": "Foodborne Trematodes", "target": "Total Absence of Peripheral Blood Eosinophilia (<3%)", "keywords": "RULED_OUT_BY, normal eosinophils, absence of eosinophilia, acute phase rule-out", "description": "[RULED_OUT_BY] Foodborne Trematodes presenting with acute febrile hepatic or pulmonary illness are ruled out by a normal peripheral blood eosinophil count (<3% or normal absolute count)."}, {"source": "Foodborne Trematodes", "target": "Acid-Fast Bacilli Detection on Sputum Smear or GeneXpert without Eosinophilia", "keywords": "RULED_OUT_BY, AFB smear positive, GeneXpert positive, tuberculosis confirmation", "description": "[RULED_OUT_BY] Foodborne Trematodes mimicking pulmonary cavitation are ruled out when sputum analysis confirms acid-fast bacilli or GeneXpert positivity in the setting of normal eosinophils and absent parasite eggs."}, {"source": "Foodborne Trematodes", "target": "Solitary Round Hepatic Liquefactive Cavity with Positive Amoebic Serology", "keywords": "RULED_OUT_BY, solitary abscess cavity, anchovy paste pus, positive amoebic serology", "description": "[RULED_OUT_BY] Foodborne Trematodes with acute hepatic pain are ruled out when imaging reveals a solitary round liquefactive abscess with anchovy-paste pus and positive Entamoeba serology without eosinophilia."}, {"source": "Foodborne Trematodes", "target": "Acoustic-Shadowing Choledocholithiasis with Neutrophilic Leukocytosis", "keywords": "RULED_OUT_BY, gallstones on ultrasound, neutrophilia without eosinophilia, calculous obstruction", "description": "[RULED_OUT_BY] Foodborne Trematodes causing obstructive biliary colic are ruled out by sonographic visualization of acoustic-shadowing gallstones in the common bile duct accompanied by neutrophilic leukocytosis without eosinophilia."}, {"source": "Foodborne Trematodes", "target": "Pulmonary Tuberculosis", "keywords": "DIFFERENTIATED_FROM, cavitary hemoptysis, chronic cough, acid-fast bacilli, eosinophilia contrast", "description": "[DIFFERENTIATED_FROM] Foodborne Trematodes (Paragonimus westermani) are differentiated from pulmonary tuberculosis by marked peripheral blood eosinophilia (>15-35%), history of raw crab/crayfish ingestion, and golden-brown operculated eggs in sputum rather than acid-fast bacilli."}, {"source": "Foodborne Trematodes", "target": "Amoebic Liver Abscess", "keywords": "DIFFERENTIATED_FROM, hepatic mass, fever, Entamoeba histolytica, tunneling contrast", "description": "[DIFFERENTIATED_FROM] Foodborne Trematodes (acute Fasciola hepatica) are differentiated from amoebic liver abscess by massive eosinophilia (>40%), serpentine subcapsular tracks, raw watercress exposure, and lack of solitary liquefactive cavity."}, {"source": "Foodborne Trematodes", "target": "Acute Bacterial Cholangitis with Choledocholithiasis", "keywords": "DIFFERENTIATED_FROM, biliary colic, Charcot triad, gallstones, eosinophilia contrast", "description": "[DIFFERENTIATED_FROM] Foodborne Trematodes (Clonorchis/Opisthorchis) are differentiated from acute bacterial calculous cholangitis by the presence of marked eosinophilia, diffuse non-tapering peripheral bile duct dilation, and raw freshwater fish dietary exposure."}, {"source": "Foodborne Trematodes", "target": "Praziquantel Therapeutic Susceptibility in Clonorchiasis, Opisthorchiasis, and Paragonimiasis", "keywords": "RESPONDS_TO, praziquantel, anthelmintic cure, Clonorchis, Opisthorchis, Paragonimus", "description": "[RESPONDS_TO] Foodborne Trematodes caused by Clonorchis sinensis, Opisthorchis viverrini, and Paragonimus westermani respond definitively to oral praziquantel (25 mg/kg TID for 2-3 days) with high cure rates (>85-100%)."}, {"source": "Foodborne Trematodes", "target": "Triclabendazole First-Line Cure in Fascioliasis", "keywords": "RESPONDS_TO, triclabendazole, fasciolicidal drug, Fasciola cure, rapid defervescence", "description": "[RESPONDS_TO] Foodborne Trematodes caused by Fasciola hepatica and Fasciola gigantica respond exclusively to oral triclabendazole (10 mg/kg single dose or 20 mg/kg divided dose taken with a fatty meal) with rapid defervescence and >95% cure."}, {"source": "Foodborne Trematodes", "target": "Intrinsic Praziquantel Refractoriness in Fascioliasis", "keywords": "INTRINSICALLY_RESISTANT_TO, praziquantel failure, zero efficacy, Fasciola resistance", "description": "[INTRINSICALLY_RESISTANT_TO] Foodborne Trematodes caused by Fasciola species are intrinsically refractory to praziquantel (0% cure rate), resulting in total clinical and parasitological treatment failure."}, {"source": "Foodborne Trematodes", "target": "Refractoriness to Standard Broad-Spectrum Antibacterials", "keywords": "INTRINSICALLY_RESISTANT_TO, antibacterial failure, beta-lactam resistance, empirical antibiotic refractoriness", "description": "[INTRINSICALLY_RESISTANT_TO] Foodborne Trematodes are intrinsically unresponsive to broad-spectrum antibacterial regimens (penicillins, cephalosporins, fluoroquinolones) or antimalarials, showing persistent fever and symptoms."}, {"source": "Clonorchis sinensis", "target": "Ingestion of Raw or Undercooked Freshwater Cyprinid Fish", "keywords": "TRANSMITTED_BY, dietary transmission, raw fish porridge, encysted metacercariae", "description": "[TRANSMITTED_BY] Clonorchis sinensis infection is contracted through dietary ingestion of raw, pickled, or undercooked freshwater cyprinid fish containing infectious metacercariae."}, {"source": "Opisthorchis viverrini", "target": "Ingestion of Raw or Undercooked Freshwater Cyprinid Fish", "keywords": "TRANSMITTED_BY, dietary transmission, koi pla, fermented fish, Mekong basin", "description": "[TRANSMITTED_BY] Opisthorchis viverrini infection is contracted via traditional consumption of raw or fermented freshwater cyprinid fish (koi pla) containing viable metacercariae."}, {"source": "Paragonimus westermani", "target": "Ingestion of Raw or Undercooked Freshwater Crustaceans", "keywords": "TRANSMITTED_BY, dietary transmission, drunken crabs, crayfish soup, metacercariae", "description": "[TRANSMITTED_BY] Paragonimus westermani is transmitted to humans through dietary ingestion of raw, pickled, or drunken freshwater crabs and crayfish harboring encysted metacercariae."}, {"source": "Fasciola hepatica", "target": "Ingestion of Raw Freshwater Aquatic Plants", "keywords": "TRANSMITTED_BY, dietary transmission, watercress, pasture surface water, metacercariae", "description": "[TRANSMITTED_BY] Fasciola hepatica transmission occurs through the ingestion of unwashed raw freshwater plants (watercress) or drinking surface water contaminated with encysted metacercariae."}, {"source": "Fasciola gigantica", "target": "Ingestion of Raw Freshwater Aquatic Plants", "keywords": "TRANSMITTED_BY, dietary transmission, tropical aquatic plants, metacercariae", "description": "[TRANSMITTED_BY] Fasciola gigantica is acquired via ingestion of contaminated freshwater aquatic vegetables harboring encysted metacercariae in endemic tropical regions."}, {"source": "Paragonimus westermani", "target": "Consumption of Raw Paratenic Wild Boar Meat", "keywords": "TRANSMITTED_BY, paratenic host, wild boar ingestion, muscle larvae", "description": "[TRANSMITTED_BY] Paragonimus westermani can be acquired through ingestion of raw or undercooked meat from paratenic wild boars harboring viable muscle larvae."}, {"source": "Clonorchis sinensis", "target": "Intrahepatic Cholangiocarcinoma in Chronic Fluke Carriage", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, biliary malignancy, cholangiocarcinoma, Group 1 carcinogen", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Clonorchis sinensis causes chronic biliary inflammation and epithelial dysplasia culminating in intrahepatic cholangiocarcinoma."}, {"source": "Opisthorchis viverrini", "target": "Intrahepatic Cholangiocarcinoma in Chronic Fluke Carriage", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, cholangiocarcinogenesis, biliary cancer, granulin secretome", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Opisthorchis viverrini is a Group 1 biological carcinogen that directly drives intrahepatic and perihilar cholangiocarcinogenesis."}, {"source": "Fasciola hepatica", "target": "Acute Invasive Hepatic Tunneling Syndrome", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, parenchymal burrowing, tender hepatomegaly, high fever", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Fasciola hepatica juvenile migration through Glisson's capsule produces acute hepatic tunneling syndrome with high fever, RUQ tenderness, and massive eosinophilia."}, {"source": "Paragonimus westermani", "target": "Rusty-Brown Sputum with Operculated Fluke Eggs", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, rusty sputum, chocolate sauce hemoptysis, operculated eggs", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Paragonimus westermani pulmonary infection characteristically produces rusty-brown chocolate-sauce sputum containing operculated eggs."}, {"source": "Paragonimus westermani", "target": "Ectopic Cerebral Paragonimiasis with Adult-Onset Focal Seizures", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, ectopic migration, adult epilepsy, soap bubble sign", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Paragonimus westermani ectopic migration into the cranium manifests with adult-onset focal epilepsy and soap-bubble cystic calcifications."}, {"source": "Fasciola hepatica", "target": "Branching Serpentine Hypoechoic Hepatic Tracks on Ultrasound", "keywords": "EXHIBITS_LAB_PATTERN, hepatic ultrasound, tunnels and burrows, parenchymal migration", "description": "[EXHIBITS_LAB_PATTERN] Fasciola hepatica juvenile flukes create linear branching hypoechoic tunnels in the liver parenchyma visible on admission ultrasound."}, {"source": "Clonorchis sinensis", "target": "Diffuse Uniform Peripheral Intrahepatic Bile Duct Dilation on Ultrasound", "keywords": "EXHIBITS_LAB_PATTERN, periductal echogenicity, peripheral biliary dilation, ultrasound", "description": "[EXHIBITS_LAB_PATTERN] Clonorchis sinensis creates diffuse, non-tapering peripheral bile duct dilation with normal extrahepatic ducts on admission ultrasound."}, {"source": "Paragonimus westermani", "target": "Sputum Microscopy Demonstrating Operculated Paragonimus Eggs", "keywords": "EXHIBITS_LAB_PATTERN, sputum wet mount, operculated eggs, diagnostic microscopy", "description": "[EXHIBITS_LAB_PATTERN] Paragonimus westermani is diagnosed at triage by unstained sputum microscopy demonstrating golden-brown operculated eggs."}, {"source": "Clonorchis sinensis", "target": "Stool Concentration Microscopy Demonstrating Urn-Shaped Fluke Eggs", "keywords": "EXHIBITS_LAB_PATTERN, stool Kato-Katz, urn-shaped eggs, diagnostic microscopy", "description": "[EXHIBITS_LAB_PATTERN] Clonorchis sinensis is confirmed by stool concentration microscopy demonstrating small urn-shaped operculated eggs with an abopercular knob."}, {"source": "Fasciola hepatica", "target": "Stool Microscopy Demonstrating Large Operculated Fasciola Eggs", "keywords": "EXHIBITS_LAB_PATTERN, large operculated eggs, stool microscopy, chronic biliary phase", "description": "[EXHIBITS_LAB_PATTERN] Fasciola hepatica in the chronic biliary stage is identified by stool microscopy demonstrating large unembryonated operculated eggs."}, {"source": "Clonorchis sinensis", "target": "Praziquantel Therapeutic Susceptibility in Clonorchiasis, Opisthorchiasis, and Paragonimiasis", "keywords": "RESPONDS_TO, praziquantel efficacy, adult worm clearance, anthelmintic cure", "description": "[RESPONDS_TO] Clonorchis sinensis is highly susceptible to oral praziquantel (25 mg/kg TID for 2-3 days) with 85-100% cure rates."}, {"source": "Opisthorchis viverrini", "target": "Praziquantel Therapeutic Susceptibility in Clonorchiasis, Opisthorchiasis, and Paragonimiasis", "keywords": "RESPONDS_TO, praziquantel efficacy, adult fluke cure, mass drug administration", "description": "[RESPONDS_TO] Opisthorchis viverrini infection is eradicated by oral praziquantel with cure rates approaching 100%."}, {"source": "Paragonimus westermani", "target": "Praziquantel Therapeutic Susceptibility in Clonorchiasis, Opisthorchiasis, and Paragonimiasis", "keywords": "RESPONDS_TO, praziquantel efficacy, resolution of hemoptysis, lung fluke cure", "description": "[RESPONDS_TO] Paragonimus westermani responds rapidly to oral praziquantel (25 mg/kg TID for 3 days), halting cough and hemoptysis within 7-14 days."}, {"source": "Fasciola hepatica", "target": "Triclabendazole First-Line Cure in Fascioliasis", "keywords": "RESPONDS_TO, triclabendazole, fasciolicidal drug, high cure rate", "description": "[RESPONDS_TO] Fasciola hepatica infection responds definitively to oral triclabendazole (10 mg/kg single dose), achieving rapid defervescence and >95% cure."}, {"source": "Fasciola gigantica", "target": "Triclabendazole First-Line Cure in Fascioliasis", "keywords": "RESPONDS_TO, triclabendazole, tropical fascioliasis, definitive anthelmintic", "description": "[RESPONDS_TO] Fasciola gigantica flukes are killed by oral triclabendazole, the definitive drug of choice."}, {"source": "Fasciola hepatica", "target": "Intrinsic Praziquantel Refractoriness in Fascioliasis", "keywords": "INTRINSICALLY_RESISTANT_TO, praziquantel failure, zero efficacy, tegumental thickness", "description": "[INTRINSICALLY_RESISTANT_TO] Fasciola hepatica is intrinsically resistant to praziquantel (0% cure rate), leading to total therapeutic failure if prescribed."}, {"source": "Fasciola gigantica", "target": "Intrinsic Praziquantel Refractoriness in Fascioliasis", "keywords": "INTRINSICALLY_RESISTANT_TO, praziquantel failure, lack of efficacy, tegumental barrier", "description": "[INTRINSICALLY_RESISTANT_TO] Fasciola gigantica is intrinsically refractory to praziquantel due to its thick outer tegumental structure."}]}}
{"case_id": "leishmaniasis", "disease": "Leishmaniasis", "extraction": {"entities": [{"name": "Leishmaniasis", "type": "Disease", "description": "A complex vector-borne protozoal infection caused by obligate intracellular parasites of the genus Leishmania, presenting across three distinct clinical syndromes: visceral leishmaniasis (kala-azar, characterized by prolonged undulating fever, massive splenomegaly, pancytopenia, hypergammaglobulinemia, and high fatality if untreated), cutaneous leishmaniasis (indolent volcano-like crusted ulcers with preserved local sensation), and mucocutaneous leishmaniasis (destructive naso-oropharyngeal cartilage erosion)."}, {"name": "Phlebotomine Sandfly Bite", "type": "Vector_Exposure", "description": "Inoculation by the bite of tiny (1.5-3 mm), silent, non-buzzing female phlebotomine sandflies (genus Phlebotomus in Old World arid zones and Mediterranean; genus Lutzomyia in New World tropical rainforests) that bite predominantly from dusk to dawn and breed in organic debris, rodent burrows, termite mounds, and cracked mud walls."}, {"name": "Endemic Visceral Leishmaniasis Geographic Exposure in South Asia and East Africa", "type": "Vector_Exposure", "description": "Residence in or travel to high-burden rural anthroponotic visceral leishmaniasis foci, including the Gangetic plains of Eastern India (Bihar, West Bengal), Bangladesh, Nepal, and East African savannah regions (Sudan, South Sudan, Ethiopia, Kenya)."}, {"name": "Zoonotic Canine Reservoir Exposure in the Mediterranean Basin and Latin America", "type": "Vector_Exposure", "description": "Domestic and stray dog reservoir exposure maintaining transmission of zoonotic Leishmania infantum (chagasi) via phlebotomine sandfly vectors in peri-urban and rural areas of the Mediterranean basin, Middle East, Central Asia, and Latin America (predominantly Brazil)."}, {"name": "Sylvatic Forest Rodent and Marsupial Habitat Exposure in Latin America", "type": "Vector_Exposure", "description": "Occupational or environmental exposure within tropical rainforest ecosystems (affecting gum tree harvesters, loggers, military personnel, and eco-tourists) inhabited by wild rodent and marsupial reservoirs harboring New World Leishmania species."}, {"name": "Human Immunodeficiency Virus (HIV) Co-Infection and Cellular Immunosuppression", "type": "Vector_Exposure", "description": "Profound defect in host cell-mediated immunity (CD4+ T-cell depletion in HIV/AIDS, organ transplantation, chemotherapy, or severe malnutrition) that accelerates the progression of asymptomatic Leishmania infection to full-blown visceral disease, atypical multisystem involvement, frequent relapses, and high mortality."}, {"name": "Leishmania donovani Species Complex", "type": "Pathogen", "description": "Obligate intracellular dimorphic protozoan parasite multiplying as aflagellated amastigotes inside host mononuclear phagocytes, causing anthroponotic visceral leishmaniasis (kala-azar) and post-kala-azar dermal leishmaniasis (PKDL) in South Asia and East Africa."}, {"name": "Leishmania infantum (syn. Leishmania chagasi)", "type": "Pathogen", "description": "Obligate intracellular protozoan belonging to the Leishmania donovani complex that causes zoonotic visceral leishmaniasis in infants, young children, and immunocompromised adults across the Mediterranean basin, Middle East, and Latin America."}, {"name": "Leishmania braziliensis Complex", "type": "Pathogen", "description": "Aggressive protozoan parasite belonging to the Viannia subgenus that causes New World cutaneous leishmaniasis with high propensity for late hematogenous or lymphatic metastatic dissemination to the naso-oropharyngeal mucosa (mucocutaneous leishmaniasis / Espundia)."}, {"name": "Leishmania mexicana Complex", "type": "Pathogen", "description": "New World protozoan pathogen responsible for localized cutaneous leishmaniasis, chronic destructive chiclero's ulcer of the ear pinna cartilage, and anergic diffuse cutaneous leishmaniasis in Central and South America."}, {"name": "Leishmania major and Leishmania tropica", "type": "Pathogen", "description": "Old World protozoan parasites responsible for zoonotic (L. major) and anthroponotic (L. tropica) localized cutaneous leishmaniasis (oriental sore) characterized by self-limiting or chronic crusted dermal ulcers in the Middle East, North Africa, and Central Asia."}, {"name": "Massive Non-Tender Splenomegaly", "type": "Cardinal_Sign", "description": "Progressive, massive enlargement of the spleen, which becomes firm, hard, non-tender, and often extends down below the umbilicus into the right iliac fossa or pelvic brim, reflecting intense reticuloendothelial hyperplasia and parasite sequestration."}, {"name": "Double-Spiking Daily Fever Curve (Dromedary Fever)", "type": "Cardinal_Sign", "description": "Chronic, undulating or spiking remittent fever classically displaying two distinct temperature spikes within a 24-hour cycle ('dromedary curve'), accompanied by chills, drenching night sweats, and absence of severe toxic prostration corresponding to fever magnitude."}, {"name": "Profound Cachexia with Ashen Cutaneous Hyperpigmentation", "type": "Cardinal_Sign", "description": "Severe progressive wasting, marked temporal hollowing, prominent ribs, protuberant abdomen, and grayish-black hyperpigmentation noticeable on the forehead, temples, perioral skin, hands, and abdomen (giving rise to the Hindi name Kala-Azar or 'black fever')."}, {"name": "Volcano-Like Painless Cutaneous Ulcer with Raised Indurated Border", "type": "Cardinal_Sign", "description": "Indolent, painless dermal ulcer with sharply demarcated, elevated, violaceous, indurated rolled margins and an adherent central crusted necrotic crater oozing serous exudate, with completely intact local sensory innervation."}, {"name": "Destructive Mucocutaneous Granulomatous Ulceration with Tapir-Face Deformity", "type": "Cardinal_Sign", "description": "Metastatic granulomatous destruction of the cartilaginous nasal septum, nasal columella, palate, pharynx, and larynx, resulting in septal perforation, nasal collapse, and classical 'tapir face' (espundia) disfigurement."}, {"name": "Chiclero's Auricular Chondral Ulcer", "type": "Cardinal_Sign", "description": "Chronic, mutilating necrotizing ulceration involving the helix and anti-helix of the ear pinna caused by Leishmania mexicana, leading to severe erosion and permanent notch-like defects of the auricular cartilage."}, {"name": "Post-Kala-Azar Dermal Leishmaniasis (PKDL)", "type": "Cardinal_Sign", "description": "Dermatological complication developing months to years following visceral leishmaniasis cure, presenting as hypopigmented macules that evolve into non-ulcerating erythematous papules, plaques, and nodules teeming with amastigotes on the face, trunk, and limbs, serving as an infectious reservoir."}, {"name": "Pancytopenia with Severe Leukopenia, Anemia, and Thrombocytopenia", "type": "Admission_Lab_Imaging", "description": "Concurrent admission depression of all three peripheral hematologic lineages: normocytic normochromic anemia (hemoglobin often < 7-8 g/dL), profound leukopenia (WBC < 2,500-3,500/uL with absolute neutrophil count < 1,000/uL), and marked thrombocytopenia (platelets < 50,000-80,000/uL), driven by bone marrow reticuloendothelial replacement and splenic pooling."}, {"name": "Marked Polyclonal Hypergammaglobulinemia with Reversed Albumin-to-Globulin Ratio", "type": "Admission_Lab_Imaging", "description": "Intense polyclonal B-cell activation driving astronomical serum IgG levels, elevating total serum protein (> 9-11 g/dL) while serum albumin is severely depressed (< 2.5 g/dL), producing a characteristic reversed Albumin-to-Globulin (A:G) ratio (< 0.5)."}, {"name": "Intracellular Leishman-Donovan Amastigote Bodies in Macrophages", "type": "Admission_Lab_Imaging", "description": "Microscopic identification on Giemsa- or Wright-stained smears of splenic aspirate (>95% sensitivity), bone marrow aspirate (70-85% sensitivity), lymph node aspirate, or dermal scraping showing round-to-oval 2-4 um aflagellated amastigotes containing a purplish nucleus and a perpendicular rod-shaped kinetoplast inside histiocytes."}, {"name": "Positive Recombinant Kinesin Antigen rK39 Immunochromatographic Dipstick", "type": "Admission_Lab_Imaging", "description": "Point-of-care rapid diagnostic serological test detecting circulating antibodies directed against the 39-amino-acid repeat of Leishmania donovani kinesin-related protein, offering >98% sensitivity and specificity in immunocompetent patients in South Asia (lower sensitivity ~85% in East Africa)."}, {"name": "Homogeneous Splenomegaly and Hepatomegaly on Bedside Ultrasound", "type": "Admission_Lab_Imaging", "description": "Abdominal ultrasonography demonstrating massive splenomegaly with homogeneous parenchymal echotexture and smooth hepatomegaly, while definitively confirming the absence of focal abscesses, cysts, biliary obstruction, or periportal fibrosis."}, {"name": "Marked Neutrophilic Leukocytosis (WBC > 15,000/uL)", "type": "Exclusion_Criterion", "description": "Leukocyte count exceeding 15,000/uL with pronounced absolute neutrophilia, which strongly argues against uncomplicated visceral leishmaniasis, an illness consistently defined by reticuloendothelial bone marrow infiltration and severe neutropenic leukopenia."}, {"name": "Loss of Thermal or Pinprick Sensation within Cutaneous Skin Lesion", "type": "Exclusion_Criterion", "description": "Hypoesthesia or complete anesthesia to fine touch, pinprick, or thermal stimuli within a dermatological plaque or ulcer, which excludes cutaneous leishmaniasis (where local cutaneous sensation remains strictly preserved) and indicates tuberculoid leprosy."}, {"name": "Circulating Leukemic Blast Cells on Peripheral Blood Smear or Bone Marrow", "type": "Exclusion_Criterion", "description": "Identification of immature myeloid or lymphoid blast cells (>20% in marrow or prominent in peripheral blood), which establishes a primary hematologic malignancy (acute myeloid/lymphoblastic leukemia) as the etiology of pancytopenia and splenomegaly."}, {"name": "Periportal Pipestem Fibrosis and Schistosoma Eggs on Microscopic Stool Exam", "type": "Exclusion_Criterion", "description": "Demonstration of periportal 'pipestem' (Symmers) fibrosis on liver ultrasonography along with viable lateral-spined Schistosoma mansoni ova in stool or rectal biopsy, which excludes visceral leishmaniasis in a patient presenting with splenomegaly and portal hypertension."}, {"name": "Intraerythrocytic Plasmodium Ring Trophozoites on Blood Smear with Indirect Hyperbilirubinemia", "type": "Exclusion_Criterion", "description": "Identification of intraerythrocytic ring-stage malaria parasites on Giemsa-stained thin/thick blood films alongside unconjugated hyperbilirubinemia, cyclic rigors, and rapid clinical resolution following artemisinin-combination therapy."}, {"name": "Hyperreactive Malarial Splenomegaly (HMS)", "type": "Disease", "description": "Chronic immunological disorder secondary to recurrent malaria characterized by massive splenomegaly, marked polyclonal IgM elevation, and responsiveness to antimalarial chemoprophylaxis; differentiated from visceral leishmaniasis by absence of severe leukopenia, lack of amastigotes on marrow aspirate, and negative rK39 testing."}, {"name": "Hepatosplenic Schistosomiasis", "type": "Disease", "description": "Chronic helminthic granulomatous disease caused by Schistosoma mansoni or S. japonicum causing presinusoidal portal hypertension, esophageal varices, and splenomegaly; differentiated from visceral leishmaniasis by afebrile course, preserved bone marrow hematopoiesis (normal leukocyte counts), periportal pipestem fibrosis on ultrasound, and eggs in stool."}, {"name": "Tuberculoid Leprosy", "type": "Disease", "description": "Mycobacterial skin infection caused by Mycobacterium leprae producing hypopigmented or erythematous plaques; differentiated from cutaneous leishmaniasis by complete loss of thermal and tactile sensation within lesions and thickened palpable peripheral nerves."}, {"name": "Acute Leukemia and Myeloproliferative Disorders", "type": "Disease", "description": "Malignant hematologic neoplasms presenting with splenomegaly, fever, and cytopenias; differentiated from visceral leishmaniasis by bone marrow aspirate demonstrating clonal blast populations rather than LD bodies within benign histiocytes."}, {"name": "Tropical Phagedenic and Bacterial Pyogenic Ulcers", "type": "Disease", "description": "Acute, painful, rapidly extending necrotizing dermal ulcerations caused by polymicrobial bacterial infection (fusospirochetal, Staphylococcus aureus, Streptococcus pyogenes); differentiated from cutaneous leishmaniasis by acute painful purulent onset, rapid response to beta-lactams, and lack of indolent indurated volcanic edges."}, {"name": "Liposomal Amphotericin B Intravenous Monotherapy", "type": "Drug_Response", "description": "Global first-line antileishmanial regimen for visceral leishmaniasis; a single intravenous dose of 10 mg/kg in South Asia achieves definitive cure rates exceeding 95-98%, with rapid defervescence within 7-10 days, splenic regression, and hematologic normalization."}, {"name": "Miltefosine Oral Regimen", "type": "Drug_Response", "description": "First oral alkylphosphocholine antileishmanial agent administered at 2.5 mg/kg/day orally for 28 days, exhibiting high efficacy in visceral and cutaneous leishmaniasis, with strict contraindication in pregnant females due to potent teratogenic risk."}, {"name": "Pentavalent Antimonial Parenteral Therapy (Sodium Stibogluconate and Meglumine Antimoniate)", "type": "Drug_Response", "description": "Parenteral therapy at 20 mg Sb5+/kg/day IV or IM for 20-30 days effective for cutaneous, mucocutaneous, and antimonial-sensitive visceral leishmaniasis, requiring cardiac monitoring due to risks of QT interval prolongation, lethal arrhythmias, pancreatitis, and chemical hepatitis."}, {"name": "Intralesional Antimonial Infiltration and Topical Paromomycin Ointment", "type": "Drug_Response", "description": "Local therapeutic modality for uncomplicated localized Old World cutaneous leishmaniasis, utilizing intralesional antimonial injections (1-3 mL every 3-7 days) or topical 15% paromomycin sulfate ointment to induce direct parasite membrane disintegration without systemic toxicity."}, {"name": "Acquired Pentavalent Antimonial Resistance in the Bihar Endemic Focus", "type": "Drug_Response", "description": "Widespread parasite resistance of Leishmania donovani to sodium stibogluconate in the Bihar state of Eastern India, resulting in therapeutic failure rates exceeding 60-65% and necessitating liposomal amphotericin B or combination regimens as first-line replacements."}, {"name": "Broad-Spectrum Antibacterial Agent Refractoriness", "type": "Drug_Response", "description": "Total absence of clinical or microbiological response to standard broad-spectrum antibacterial regimens (including beta-lactams, macrolides, fluoroquinolones, cephalosporins, and aminoglycosides) despite prolonged administration for presumed bacterial sepsis or skin infection."}], "relationships": [{"source": "Leishmaniasis", "target": "Phlebotomine Sandfly Bite", "keywords": "sandfly vector bite, phlebotomus, lutzomyia, dusk to dawn inoculation", "description": "[TRANSMITTED_BY] Leishmaniasis is transmitted to humans during the blood meal of infected female phlebotomine sandflies (Phlebotomus in the Old World, Lutzomyia in the New World) regurgitating metacyclic promastigotes into the dermis."}, {"source": "Leishmaniasis", "target": "Endemic Visceral Leishmaniasis Geographic Exposure in South Asia and East Africa", "keywords": "epidemiologic travel history, kala-azar endemicity, bihar, east africa, south asia", "description": "[EXPOSURE_TO] Visceral leishmaniasis transmission is intensely concentrated in rural agricultural areas of Eastern India, Bangladesh, Nepal, Sudan, South Sudan, and Ethiopia where sandfly vectors flourish in mud dwellings."}, {"source": "Leishmaniasis", "target": "Zoonotic Canine Reservoir Exposure in the Mediterranean Basin and Latin America", "keywords": "canine reservoir host, leishmania infantum, peri-urban zoonosis, brazil, mediterranean", "description": "[EXPOSURE_TO] Zoonotic visceral leishmaniasis is maintained in domestic dog reservoirs, where sandflies feed on parasitized dogs and transmit Leishmania infantum to humans, particularly affecting infants and immunocompromised adults."}, {"source": "Leishmaniasis", "target": "Sylvatic Forest Rodent and Marsupial Habitat Exposure in Latin America", "keywords": "forest reservoir host, chiclero occupation, jungle exposure, new world cutaneous leishmaniasis", "description": "[EXPOSURE_TO] Cutaneous and mucocutaneous leishmaniasis in the Americas is an occupational jungle zoonosis acquired when humans intrude into rainforest ecosystems where Lutzomyia sandflies feed on sylvatic rodent and marsupial reservoirs."}, {"source": "Leishmaniasis", "target": "Human Immunodeficiency Virus (HIV) Co-Infection and Cellular Immunosuppression", "keywords": "hiv coinfection, cd4 cell immunosuppression, visceral disease progression, opportunistic reactivation", "description": "[EXPOSURE_TO] HIV co-infection and systemic immunosuppression impair Th1 cell-mediated control, transforming latent Leishmania infection into aggressive, relapsing, multi-organ visceral or diffuse cutaneous leishmaniasis."}, {"source": "Leishmaniasis", "target": "Leishmania donovani Species Complex", "keywords": "etiologic agent, visceral leishmaniasis, obligate intracellular protozoan, macrophage amastigote", "description": "[HAS_PATHOGEN] Leishmaniasis in its anthroponotic visceral form is caused by Leishmania donovani, which parasitizes host mononuclear phagocytes and disseminates throughout the reticuloendothelial organs including the spleen, liver, and bone marrow."}, {"source": "Leishmaniasis", "target": "Leishmania infantum (syn. Leishmania chagasi)", "keywords": "zoonotic visceral pathogen, leishmania infantum, leishmania chagasi, pediatric kala-azar", "description": "[HAS_PATHOGEN] Leishmaniasis manifests as zoonotic visceral disease caused by Leishmania infantum (chagasi), targeting domestic dogs as primary reservoirs and causing systemic reticuloendothelial disease in humans."}, {"source": "Leishmaniasis", "target": "Leishmania braziliensis Complex", "keywords": "mucocutaneous pathogen, viannia subgenus, espundia, metastatic mucosal dissemination", "description": "[HAS_PATHOGEN] Leishmaniasis presents in destructive mucocutaneous forms primarily caused by the Leishmania braziliensis complex, which metastasizes to respiratory and oral cartilaginous structures."}, {"source": "Leishmaniasis", "target": "Leishmania mexicana Complex", "keywords": "cutaneous chondral pathogen, chiclero ulcer, leishmania mexicana, diffuse cutaneous leishmaniasis", "description": "[HAS_PATHOGEN] Leishmaniasis in Central America and Mexico is frequently caused by Leishmania mexicana, leading to indolent cutaneous lesions and mutilating auricular cartilage ulceration."}, {"source": "Leishmaniasis", "target": "Leishmania major and Leishmania tropica", "keywords": "old world cutaneous leishmaniasis, oriental sore, leishmania major, leishmania tropica", "description": "[HAS_PATHOGEN] Leishmaniasis causes Old World cutaneous disease through Leishmania major and Leishmania tropica, producing localized granulomatous skin ulcerations at sandfly inoculation sites."}, {"source": "Leishmaniasis", "target": "Massive Non-Tender Splenomegaly", "keywords": "massive splenomegaly, firm non-tender spleen, reticuloendothelial hyperplasia, pelvic brim spleen", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Visceral leishmaniasis is hallmarked by massive, hard, non-tender splenomegaly extending across the abdomen, resulting from profound macrophage proliferation and vascular congestion."}, {"source": "Leishmaniasis", "target": "Double-Spiking Daily Fever Curve (Dromedary Fever)", "keywords": "dromedary fever pattern, double daily fever spike, undulating chronic fever, kala-azar fever", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Visceral leishmaniasis exhibits a characteristic dromedary fever pattern featuring two febrile spikes daily over weeks to months, contrasting with cyclic malarial paroxysms."}, {"source": "Leishmaniasis", "target": "Profound Cachexia with Ashen Cutaneous Hyperpigmentation", "keywords": "cachexia, temporal wasting, kala-azar hyperpigmentation, black fever, protuberant abdomen", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Advanced visceral leishmaniasis causes rapid cachectic wasting alongside dark grayish-black hyperpigmentation of the face and extremities due to cytokine-mediated wasting and endocrine disturbance."}, {"source": "Leishmaniasis", "target": "Volcano-Like Painless Cutaneous Ulcer with Raised Indurated Border", "keywords": "volcanic crater ulcer, indurated violaceous border, oriental sore, intact sensation, painless ulcer", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Cutaneous leishmaniasis manifests as an indolent volcano-like ulcer featuring raised indurated borders and a central necrotic base while preserving tactile sensation."}, {"source": "Leishmaniasis", "target": "Destructive Mucocutaneous Granulomatous Ulceration with Tapir-Face Deformity", "keywords": "mucocutaneous espundia, septal perforation, tapir face deformity, laryngeal cartilage destruction", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Mucocutaneous leishmaniasis leads to irreversible cartilage necrosis and ulceration of the nasopharynx and palate, causing tapir snout deformity and airway compromise."}, {"source": "Leishmaniasis", "target": "Chiclero's Auricular Chondral Ulcer", "keywords": "chiclero ulcer, pinna cartilage destruction, ear notch defect, leishmania mexicana", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Chiclero's ulcer is a hallmark chondral manifestation of Leishmania mexicana infection causing permanent destructive clefting of the pinna."}, {"source": "Leishmaniasis", "target": "Post-Kala-Azar Dermal Leishmaniasis (PKDL)", "keywords": "pkdl, post-kala-azar dermal leishmaniasis, hypopigmented macules, nodular facial rash, reservoir host", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Post-kala-azar dermal leishmaniasis presents as a diffuse macular or nodular cutaneous eruption following visceral leishmaniasis cure, serving as an important human transmission reservoir."}, {"source": "Leishmaniasis", "target": "Pancytopenia with Severe Leukopenia, Anemia, and Thrombocytopenia", "keywords": "pancytopenia, severe leukopenia, neutropenia, normocytic anemia, thrombocytopenia, hypersplenism", "description": "[EXHIBITS_LAB_PATTERN] Visceral leishmaniasis consistently produces admission pancytopenia, marked by profound leukopenia (often < 2,500/uL) and thrombocytopenia resulting from bone marrow parasitization and hypersplenic sequestration."}, {"source": "Leishmaniasis", "target": "Marked Polyclonal Hypergammaglobulinemia with Reversed Albumin-to-Globulin Ratio", "keywords": "hypergammaglobulinemia, reversed ag ratio, polyclonal igg surge, elevated total protein, hypoalbuminemia", "description": "[EXHIBITS_LAB_PATTERN] Visceral leishmaniasis triggers immense polyclonal B-cell activation, yielding severe hypergammaglobulinemia (A:G ratio < 0.5) with total protein frequently exceeding 10 g/dL."}, {"source": "Leishmaniasis", "target": "Intracellular Leishman-Donovan Amastigote Bodies in Macrophages", "keywords": "leishman-donovan bodies, amastigotes, kinetoplast, bone marrow aspirate, splenic smear, giemsa stain", "description": "[EXHIBITS_LAB_PATTERN] Microscopic demonstration of intracellular Leishman-Donovan amastigotes displaying a characteristic rod-shaped kinetoplast within macrophages on tissue aspirates represents the gold standard diagnostic pattern."}, {"source": "Leishmaniasis", "target": "Positive Recombinant Kinesin Antigen rK39 Immunochromatographic Dipstick", "keywords": "rk39 rapid test, kinesin antigen dipstick, serological point of care, kala-azar rdt", "description": "[EXHIBITS_LAB_PATTERN] Visceral leishmaniasis demonstrates high-titer reactivity on the rK39 immunochromatographic dipstick test, providing rapid bed-side serological confirmation at triage."}, {"source": "Leishmaniasis", "target": "Homogeneous Splenomegaly and Hepatomegaly on Bedside Ultrasound", "keywords": "ultrasound splenomegaly, homogeneous spleen echotexture, smooth hepatomegaly, absence of abscesses", "description": "[EXHIBITS_LAB_PATTERN] Bedside abdominal ultrasound in visceral leishmaniasis reveals massive uniform splenomegaly without focal lesions, helping rule out amoebic or pyogenic splenic abscesses and echinococcal cysts."}, {"source": "Leishmaniasis", "target": "Marked Neutrophilic Leukocytosis (WBC > 15,000/uL)", "keywords": "neutrophilic leukocytosis, elevated wbc, rule out visceral leishmaniasis, leukopenia requirement", "description": "[RULED_OUT_BY] The presence of marked neutrophilic leukocytosis (WBC > 15,000/uL) strongly rules out uncomplicated visceral leishmaniasis, pointing toward acute pyogenic bacterial infection or leukemoid reaction."}, {"source": "Leishmaniasis", "target": "Loss of Thermal or Pinprick Sensation within Cutaneous Skin Lesion", "keywords": "anesthetic skin lesion, loss of sensation, preserved cutaneous sensation, rule out cutaneous leishmaniasis", "description": "[RULED_OUT_BY] Loss of sensation (anesthetic patch) within a chronic skin lesion strongly rules out cutaneous leishmaniasis, which consistently maintains intact neurocutaneous sensation."}, {"source": "Leishmaniasis", "target": "Circulating Leukemic Blast Cells on Peripheral Blood Smear or Bone Marrow", "keywords": "leukemic blasts, acute leukemia, bone marrow malignancy, rule out leishmaniasis", "description": "[RULED_OUT_BY] Detection of neoplastic blast cells on peripheral blood film or bone marrow aspirate rules out leishmaniasis as the primary driver of splenomegaly and pancytopenia."}, {"source": "Leishmaniasis", "target": "Periportal Pipestem Fibrosis and Schistosoma Eggs on Microscopic Stool Exam", "keywords": "symmers pipestem fibrosis, schistosoma mansoni eggs, afebrile portal hypertension, rule out visceral leishmaniasis", "description": "[RULED_OUT_BY] Ultrasonographic demonstration of Symmers periportal pipestem fibrosis combined with schistosome eggs in stool confirms hepatosplenic schistosomiasis and excludes visceral leishmaniasis."}, {"source": "Leishmaniasis", "target": "Intraerythrocytic Plasmodium Ring Trophozoites on Blood Smear with Indirect Hyperbilirubinemia", "keywords": "plasmodium intraerythrocytic ring, blood film malaria, unconjugated hyperbilirubinemia, rule out leishmaniasis", "description": "[RULED_OUT_BY] Demonstration of intraerythrocytic Plasmodium rings on Giemsa blood smear confirms acute or chronic malaria as the source of fever and splenomegaly, excluding isolated leishmaniasis."}, {"source": "Leishmaniasis", "target": "Hyperreactive Malarial Splenomegaly (HMS)", "keywords": "hms, chronic malaria, massive splenomegaly contrast, artemisinin response, rk39 negative", "description": "[DIFFERENTIATED_FROM] Leishmaniasis is differentiated from hyperreactive malarial splenomegaly by its double-spiking daily fevers, severe pancytopenia, marked IgG hypergammaglobulinemia, positive rK39 dipstick, and intracellular LD bodies in bone marrow macrophages."}, {"source": "Leishmaniasis", "target": "Hepatosplenic Schistosomiasis", "keywords": "schistosomiasis contrast, pipestem fibrosis, afebrile portal hypertension, stool ova", "description": "[DIFFERENTIATED_FROM] Leishmaniasis is differentiated from hepatosplenic schistosomiasis because leishmaniasis produces unremitting high fever, profound bone marrow pancytopenia, and marrow amastigotes, whereas schistosomiasis is afebrile with preserved leukocyte counts and periportal fibrosis."}, {"source": "Leishmaniasis", "target": "Tuberculoid Leprosy", "keywords": "leprosy differential, anesthetic patch, peripheral neuropathy, preserved sensation", "description": "[DIFFERENTIATED_FROM] Cutaneous leishmaniasis is differentiated from tuberculoid leprosy by its ulcerated volcanic morphology, completely preserved sensation within lesions, normal peripheral nerves, and presence of amastigotes rather than acid-fast bacilli on biopsy."}, {"source": "Leishmaniasis", "target": "Acute Leukemia and Myeloproliferative Disorders", "keywords": "hematologic malignancy differential, leukemic blasts, marrow cytogenetics, ld bodies contrast", "description": "[DIFFERENTIATED_FROM] Leishmaniasis is differentiated from acute leukemia and myeloproliferative disorders by bone marrow cytology showing histiocytes packed with Leishman-Donovan bodies and reactive polyclonal plasmacytosis rather than neoplastic blast infiltration."}, {"source": "Leishmaniasis", "target": "Tropical Phagedenic and Bacterial Pyogenic Ulcers", "keywords": "bacterial skin ulcer differential, painful purulent ulcer, antibiotic response contrast", "description": "[DIFFERENTIATED_FROM] Cutaneous leishmaniasis is differentiated from bacterial pyogenic and tropical phagedenic ulcers by its indolent, painless chronic evolution, raised indurated borders, refractory response to antibacterial agents, and presence of intracellular amastigotes on edge scraping."}, {"source": "Leishmaniasis", "target": "Liposomal Amphotericin B Intravenous Monotherapy", "keywords": "first-line visceral therapy, liposomal amphotericin b, ambisome single dose, 95 percent cure rate", "description": "[RESPONDS_TO] Visceral leishmaniasis responds rapidly to intravenous liposomal amphotericin B (single dose of 10 mg/kg in South Asia or multi-dose regimens in East Africa), achieving >95% cure and prompt resolution of fever and splenomegaly."}, {"source": "Leishmaniasis", "target": "Miltefosine Oral Regimen", "keywords": "oral antileishmanial, miltefosine, 28-day regimen, teratogenic contraindication", "description": "[RESPONDS_TO] Leishmaniasis responds to oral miltefosine (2.5 mg/kg/day for 28 days), which achieves high cure rates for visceral leishmaniasis and Old/New World cutaneous leishmaniasis, provided strict pregnancy prevention is maintained."}, {"source": "Leishmaniasis", "target": "Pentavalent Antimonial Parenteral Therapy (Sodium Stibogluconate and Meglumine Antimoniate)", "keywords": "pentavalent antimonials, sodium stibogluconate, meglumine antimoniate, qt prolongation risk", "description": "[RESPONDS_TO] Antimonial-sensitive strains of Leishmania respond to parenteral sodium stibogluconate or meglumine antimoniate (20 mg Sb5+/kg/day for 20-30 days), though monitored for cardiotoxicity and pancreatitis."}, {"source": "Leishmaniasis", "target": "Intralesional Antimonial Infiltration and Topical Paromomycin Ointment", "keywords": "intralesional antimonials, topical paromomycin, localized cutaneous therapy, membrane disruption", "description": "[RESPONDS_TO] Uncomplicated localized cutaneous leishmaniasis responds favorably to intralesional pentavalent antimonial infiltration or topical paromomycin ointment, inducing accelerated ulcer healing without systemic toxicity."}, {"source": "Leishmaniasis", "target": "Acquired Pentavalent Antimonial Resistance in the Bihar Endemic Focus", "keywords": "antimonial drug resistance, bihar kala-azar failure, sodium stibogluconate unresponsiveness", "description": "[INTRINSICALLY_RESISTANT_TO] Visceral leishmaniasis strains in the hyperendemic focus of Bihar, India exhibit extensive acquired resistance to pentavalent antimonials (failure rates >60-65%), precluding their empirical use in this region."}, {"source": "Leishmaniasis", "target": "Broad-Spectrum Antibacterial Agent Refractoriness", "keywords": "antibiotic refractoriness, beta-lactam failure, fluoroquinolone unresponsiveness, diagnostic clue", "description": "[INTRINSICALLY_RESISTANT_TO] Leishmaniasis is intrinsically refractory to standard broad-spectrum antibacterial agents (beta-lactams, fluoroquinolones, macrolides), providing a critical diagnostic clue when prolonged febrile or ulcerative illness fails to respond to empiric antibiotic courses."}]}}
{"case_id": "leprosy", "disease": "Leprosy", "extraction": {"entities": [{"name": "Leprosy", "type": "Disease", "description": "A chronic infectious granulomatous disease caused by Mycobacterium leprae (and rarely Mycobacterium lepromatosis), predominantly affecting superficial cooler tissues including Schwann cells of the peripheral nervous system and cutaneous macrophages, leading to distinctive anesthetic skin lesions, peripheral nerve trunk enlargement, and progressive sensory and motor deformities."}, {"name": "Prolonged Household Contact with Untreated Multibacillary Patient via Respiratory Droplets", "type": "Vector_Exposure", "description": "Prolonged, intimate household contact with an untreated multibacillary leprosy patient shedding infectious Mycobacterium leprae bacilli through respiratory droplets and nasal mucosal secretions during coughing and sneezing."}, {"name": "Direct Contact with or Handling of Wild Nine-Banded Armadillos (Dasypus novemcinctus)", "type": "Vector_Exposure", "description": "Zoonotic exposure through handling, hunting, butchering, or consuming wild nine-banded armadillos (Dasypus novemcinctus), which serve as natural sylvatic reservoirs of Mycobacterium leprae in the Americas."}, {"name": "Extended Residence in High-Burden Tropical Endemic Regions (India, Brazil, Indonesia)", "type": "Vector_Exposure", "description": "Long-term residence or exposure in high-burden tropical and subtropical developing countries, particularly South-East Asia (India accounting for >50% of global cases, Indonesia) and South America (Brazil), where sustained transmission occurs."}, {"name": "Mycobacterium leprae", "type": "Pathogen", "description": "An obligate intracellular, acid-fast, pleomorphic actinobacterium possessing an extraordinary tropism for peripheral nerve Schwann cells and histiocytes, displaying an extremely slow replication rate (12-14 days doubling time) and an optimal growth temperature of 27-30°C."}, {"name": "Mycobacterium lepromatosis", "type": "Pathogen", "description": "A genetically divergent acid-fast mycobacterial pathogen identified as a causative agent of severe diffuse lepromatous leprosy and necrotizing Lucio's phenomenon, primarily reported in Mexico, Central America, and parts of the Caribbean."}, {"name": "Hypopigmented Anesthetic Skin Patch with Definite Loss of Thermal Sensation", "type": "Cardinal_Sign", "description": "Well-demarcated or diffuse hypopigmented or erythematous cutaneous plaque or macule exhibiting objective, definite impairment or loss of thermal sensation (warm/cold), light touch, and pinprick pain, representing the cardinal clinical hallmark of tuberculoid and borderline leprosy."}, {"name": "Enlarged Tender Peripheral Nerve Trunk with Associated Sensorimotor Deficit", "type": "Cardinal_Sign", "description": "Palpably thickened, firm, and tender peripheral nerve trunks at superficial predilection sites (e.g., ulnar nerve at the medial epicondyle, common fibular nerve at the fibular neck, posterior tibial nerve behind the medial malleolus, or great auricular nerve in the neck) accompanied by sensory deficit or muscular weakness."}, {"name": "Slit-Skin Smear Acid-Fast Bacilli with Intracellular Globi", "type": "Admission_Lab_Imaging", "description": "Microscopic visualization of acid-fast bacilli arranged in clumps or globi resembling packs of cigarettes using modified Ziehl-Neelsen (Fite-Faraco) staining on slit dermal smears obtained from cooler anatomical sites (earlobes, elbows, lesion borders) with a Bacteriological Index of 1+ to 6+."}, {"name": "Facies Leontina with Madarosis and Infiltrated Pendulous Earlobes", "type": "Cardinal_Sign", "description": "Characteristic leonine facies seen in advanced lepromatous leprosy caused by diffuse infiltrative nodular thickening of facial skin, deep furrowing over the forehead and cheeks, pendulous earlobe infiltration, and complete bilateral loss of eyebrows and eyelashes (madarosis)."}, {"name": "Ulnar Neuropathy Claw Hand Deformity with Hypothenar Amyotrophy", "type": "Cardinal_Sign", "description": "Neuropathic deformity resulting from ulnar nerve trunk destruction at the olecranon groove, manifested by hyperextension of metacarpophalangeal joints and flexion of interphalangeal joints in the 4th and 5th digits, interosseous guttering, hypothenar wasting, and loss of medial hand sensation."}, {"name": "Painless Chronic Plantar Neuropathic Ulcer (Mal Perforant)", "type": "Cardinal_Sign", "description": "Indolent, deep, painless ulceration over weight-bearing points of the plantar foot (metatarsal heads or heel) caused by complete loss of protective nociception and autonomic denervation following posterior tibial nerve neuropathy, often leading to secondary osteomyelitis and trophic bone resorption."}, {"name": "Lagophthalmos with Inability to Close Eyelids and Risk of Corneal Keratitis", "type": "Cardinal_Sign", "description": "Inability to achieve complete voluntary closure of the palpebral fissure due to orbicularis oculi paralysis from zygomatic branch facial nerve involvement, exposing the cornea to drying, ulceration, keratitis, and secondary blindness."}, {"name": "Type 1 Leprosy Reversal Reaction with Acute Painful Neuritis and Plaque Swelling", "type": "Cardinal_Sign", "description": "Acute delayed-type (Type IV) hypersensitivity episode occurring in borderline leprosy patients, manifesting as sudden intense erythema, edema, and ulceration of pre-existing skin plaques combined with severe agonizing peripheral nerve pain (neuritis) and rapid loss of sensorimotor function."}, {"name": "Type 2 Erythema Nodosum Leprosum (ENL) with Tender Subcutaneous Nodules and Systemic Vasculitis", "type": "Cardinal_Sign", "description": "Severe immune complex-mediated (Type III) hypersensitivity vasculitis arising in lepromatous patients, characterized by crops of acutely tender, bright red subcutaneous nodules, remittent high fever, arthralgias, iridocyclitis, orchitis, and marked neutrophilic leukocytosis."}, {"name": "High-Resolution Nerve Ultrasound Showing Asymmetrical Nerve Enlargement and Loss of Fascicular Pattern", "type": "Admission_Lab_Imaging", "description": "Bedside neuromuscular ultrasound demonstrating marked, asymmetrical cross-sectional area enlargement (>10-12 mm²) of peripheral nerve trunks (ulnar, common peroneal), architectural loss of fascicular echo-texture, and endoneurial hyperemia on color Doppler."}, {"name": "Bedside Cutaneous Sensory Mapping Demonstrating Hierarchical Loss of Temperature and Light Touch", "type": "Admission_Lab_Imaging", "description": "Standardized physical sensory mapping of cutaneous patches demonstrating hierarchical sensory impairment where thermal discrimination (cold vs. warm) is lost first, followed by fine light touch testing with Semmes-Weinstein monofilaments, while pain/pinprick is lost last."}, {"name": "Completely Intact Cutaneous Sensation to Temperature and Light Touch within Solitary Skin Lesions", "type": "Exclusion_Criterion", "description": "Normal, intact discrimination of cold, warm, and fine light touch across the entirety of an isolated hypopigmented or erythematous skin patch, which definitively rules out tuberculoid and borderline forms of leprosy."}, {"name": "Intense Cutaneous Pruritus or Excoriated Lesions", "type": "Exclusion_Criterion", "description": "Presence of intense, severe itching, scratching, or linear excoriations within skin lesions, which is characteristic of eczema, scabies, or allergic dermatoses and effectively rules out leprosy lesions that are characteristically anesthetic and non-pruritic."}, {"name": "Rapid Acute-Onset Symmetrical Distal Polyneuropathy without Cutaneous Patches or Palpable Nerve Trunk Thickening", "type": "Exclusion_Criterion", "description": "Acute or subacute, strictly symmetrical glove-and-stocking polyneuropathy lacking focal palpable peripheral nerve enlargement, mononeuritis multiplex features, or hypopigmented anesthetic skin macules, indicative of metabolic, toxic, or demyelinating polyneuropathies."}, {"name": "Cutaneous Leishmaniasis", "type": "Disease", "description": "A vector-borne protozoal infection presenting with solitary or multiple volcano-like ulcerations with raised indurated borders on exposed skin that possess completely preserved tactile sensation, spare peripheral nerve trunks, and show Leishmania amastigotes on Giemsa stain."}, {"name": "Vitiligo", "type": "Disease", "description": "An acquired autoimmune depigmenting dermatosis presenting with chalky white macules and patches characterized by complete epidermal melanocyte loss but entirely normal cutaneous thermal and tactile sensation, preserved sweating, and unaffected peripheral nerves."}, {"name": "Pityriasis Versicolor", "type": "Disease", "description": "A superficial fungal dermatomycosis caused by Malassezia yeasts causing fine branny-scaling hypopigmented macules with fully preserved sensation, normal peripheral nerves, and characteristic fungal hyphae/spores on potassium hydroxide (KOH) examination."}, {"name": "Diabetic Peripheral Neuropathy", "type": "Disease", "description": "A chronic metabolic length-dependent symmetric sensory polyneuropathy of feet and hands occurring in the setting of chronic hyperglycemia, which lacks focal cutaneous hypopigmented anesthetic plaques and lacks palpably thickened peripheral nerve trunks."}, {"name": "Cutaneous Tuberculosis (Lupus Vulgaris)", "type": "Disease", "description": "A chronic form of cutaneous tuberculosis producing brownish-red granulomatous plaques with apple-jelly nodules on diascopy that retain intact sensory perception and do not invade or enlarge peripheral nerve trunks."}, {"name": "WHO Multidrug Therapy (MDT) Regimen Comprising Rifampicin, Dapsone, and Clofazimine", "type": "Drug_Response", "description": "Standardized World Health Organization multidrug regimen consisting of supervised monthly rifampicin combined with daily dapsone (for paucibacillary cases over 6 months) plus clofazimine (for multibacillary cases over 12 months), achieving bacillary clearance and cure while preventing resistance."}, {"name": "High-Dose Systemic Corticosteroids (Prednisolone) for Reversal Neuritis", "type": "Drug_Response", "description": "Prompt administration of oral prednisolone (starting at 40 mg daily and tapered over 16-24 weeks) which suppresses acute cell-mediated intraneural edema, halts rapid nerve destruction, and averts irreversible motor deformities during Type 1 reactions."}, {"name": "Thalidomide for Type 2 Reaction (Erythema Nodosum Leprosum)", "type": "Drug_Response", "description": "Potent anti-inflammatory immunomodulator providing rapid, dramatic clinical defervescence and resolution of painful subcutaneous inflammatory nodules within 48 to 72 hours in severe Type 2 ENL (strictly contraindicated in females of childbearing potential due to severe teratogenicity)."}, {"name": "Standard Beta-Lactam and Cephalosporin Antibiotics", "type": "Drug_Response", "description": "Standard broad-spectrum antibacterial regimens including penicillins, ampicillin, cephalosporins, and conventional macrolides, to which Mycobacterium leprae is intrinsically refractory and completely non-responsive."}], "relationships": [{"source": "Leprosy", "target": "Prolonged Household Contact with Untreated Multibacillary Patient via Respiratory Droplets", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] Leprosy is predominantly transmitted from person to person via infectious upper airway droplets and nasal secretions during prolonged, close household contact with an untreated multibacillary patient."}, {"source": "Leprosy", "target": "Direct Contact with or Handling of Wild Nine-Banded Armadillos (Dasypus novemcinctus)", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Zoonotic infection can occur through direct contact with, hunting, skinning, or butchering wild nine-banded armadillos (Dasypus novemcinctus), which serve as natural sylvatic reservoirs of Mycobacterium leprae."}, {"source": "Leprosy", "target": "Extended Residence in High-Burden Tropical Endemic Regions (India, Brazil, Indonesia)", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Leprosy acquisition is strongly linked to prolonged residence or travel in high-burden tropical and subtropical developing countries, predominantly South-East Asia (India and Indonesia) and Latin America (Brazil)."}, {"source": "Leprosy", "target": "Mycobacterium leprae", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Leprosy is caused by Mycobacterium leprae, an obligate intracellular, acid-fast bacillus displaying unique tropism for peripheral nerve Schwann cells and dermal histiocytes."}, {"source": "Leprosy", "target": "Mycobacterium lepromatosis", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Leprosy can be caused by Mycobacterium lepromatosis, a related acid-fast species responsible for severe diffuse lepromatous leprosy and necrotizing Lucio's phenomenon."}, {"source": "Leprosy", "target": "Hypopigmented Anesthetic Skin Patch with Definite Loss of Thermal Sensation", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] The presence of one or more hypopigmented or reddish cutaneous lesions demonstrating definite objective loss of thermal sensation and light touch is a cardinal pathognomonic WHO diagnostic sign of leprosy."}, {"source": "Leprosy", "target": "Enlarged Tender Peripheral Nerve Trunk with Associated Sensorimotor Deficit", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Palpably thickened, firm, and tender peripheral nerve trunks (such as the ulnar or common fibular nerve) accompanied by distal motor weakness or sensory impairment constitute a cardinal WHO diagnostic hallmark of leprosy."}, {"source": "Leprosy", "target": "Slit-Skin Smear Acid-Fast Bacilli with Intracellular Globi", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Slit-skin smear microscopy stained with Fite-Faraco modified acid-fast stain demonstrating clusters and globi of intracellular bacilli (Bacteriological Index 1+ to 6+) confirms multibacillary leprosy at admission."}, {"source": "Leprosy", "target": "Facies Leontina with Madarosis and Infiltrated Pendulous Earlobes", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Advanced lepromatous leprosy exhibits the pathognomonic lion-like facies (facies leontina) caused by diffuse nodular facial infiltration, thickened earlobes, and bilateral loss of eyebrows and eyelashes (madarosis)."}, {"source": "Leprosy", "target": "Ulnar Neuropathy Claw Hand Deformity with Hypothenar Amyotrophy", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Peripheral ulnar nerve trunk damage produces a characteristic claw hand deformity (main en griffe) with flexion of the fourth and fifth digits, interosseous guttering, and hypothenar muscular wasting."}, {"source": "Leprosy", "target": "Painless Chronic Plantar Neuropathic Ulcer (Mal Perforant)", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Severe posterior tibial nerve denervation causes loss of plantar sensation leading to chronic painless plantar neuropathic ulcers (mal perforant) and digital trophic bone resorption."}, {"source": "Leprosy", "target": "Lagophthalmos with Inability to Close Eyelids and Risk of Corneal Keratitis", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Infiltration of the zygomatic branch of the facial nerve induces orbicularis oculi paralysis resulting in paralytic lagophthalmos, corneal exposure, ulceration, and potential blindness."}, {"source": "Leprosy", "target": "Type 1 Leprosy Reversal Reaction with Acute Painful Neuritis and Plaque Swelling", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Type 1 reversal reactions present as an acute delayed-type hypersensitivity flare characterized by sudden erythema and edema of skin lesions accompanied by acute excruciating neuritis and rapid motor paralysis."}, {"source": "Leprosy", "target": "Type 2 Erythema Nodosum Leprosum (ENL) with Tender Subcutaneous Nodules and Systemic Vasculitis", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Type 2 reaction (ENL) presents as sudden crops of painful, bright red subcutaneous nodules with high fever, arthralgias, orchitis, and systemic immune-complex vasculitis in multibacillary patients."}, {"source": "Leprosy", "target": "High-Resolution Nerve Ultrasound Showing Asymmetrical Nerve Enlargement and Loss of Fascicular Pattern", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Bedside neuromuscular high-resolution ultrasound shows focal or diffuse asymmetrical peripheral nerve trunk enlargement (>10-12 mm² cross-sectional area), disrupted fascicular architecture, and endoneurial hyperemia on color Doppler."}, {"source": "Leprosy", "target": "Bedside Cutaneous Sensory Mapping Demonstrating Hierarchical Loss of Temperature and Light Touch", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Objective bedside sensory evaluation demonstrates hierarchical cutaneous sensory loss where thermal sensation (cold vs. warm) is lost first, followed sequentially by light touch, while pain sensation is lost last."}, {"source": "Leprosy", "target": "Completely Intact Cutaneous Sensation to Temperature and Light Touch within Solitary Skin Lesions", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Finding entirely intact and normal cutaneous sensation to cold, warm, and fine touch within a solitary well-demarcated skin lesion firmly rules out tuberculoid and borderline forms of leprosy."}, {"source": "Leprosy", "target": "Intense Cutaneous Pruritus or Excoriated Lesions", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] The presence of severe itching, intense pruritus, or excoriated cutaneous plaques rules out leprosy lesions, which are characteristically non-pruritic, hypopigmented, and anesthetic."}, {"source": "Leprosy", "target": "Rapid Acute-Onset Symmetrical Distal Polyneuropathy without Cutaneous Patches or Palpable Nerve Trunk Thickening", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Acute-onset strictly symmetrical distal polyneuropathy in the absence of palpably enlarged peripheral nerve trunks or anesthetic cutaneous macules rules out standard leprous peripheral neuropathy."}, {"source": "Leprosy", "target": "Cutaneous Leishmaniasis", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Cutaneous Leishmaniasis, which manifests with volcano-like ulcerations that maintain intact local sensation, lack peripheral nerve trunk enlargement, and show Leishmania amastigotes on smear."}, {"source": "Leprosy", "target": "Vitiligo", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Vitiligo, where depigmented chalk-white macules maintain completely normal thermal and tactile sensation, normal sweating, and no associated peripheral nerve enlargement."}, {"source": "Leprosy", "target": "Pityriasis Versicolor", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Pityriasis Versicolor, which presents with superficial scaling patches with completely preserved sensory perception, normal nerves, and fungal elements on KOH preparation."}, {"source": "Leprosy", "target": "Diabetic Peripheral Neuropathy", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Diabetic Peripheral Neuropathy, which is strictly symmetrical and length-dependent, lacks cutaneous anesthetic plaques, lacks palpably thickened nerve trunks, and correlates with chronic hyperglycemia."}, {"source": "Leprosy", "target": "Cutaneous Tuberculosis (Lupus Vulgaris)", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Cutaneous Tuberculosis (Lupus Vulgaris), which produces apple-jelly granulomatous plaques on diascopy with fully preserved cutaneous sensation and without peripheral nerve involvement."}, {"source": "Leprosy", "target": "WHO Multidrug Therapy (MDT) Regimen Comprising Rifampicin, Dapsone, and Clofazimine", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Leprosy responds curative to standard WHO Multidrug Therapy (monthly rifampicin combined with daily dapsone and clofazimine), eliminating viable bacilli and promoting lesion resolution."}, {"source": "Leprosy", "target": "High-Dose Systemic Corticosteroids (Prednisolone) for Reversal Neuritis", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Acute Type 1 reversal reactions and acute tender neuritis respond promptly to high-dose systemic prednisolone (starting at 40 mg daily), which relieves intraneural edema and prevents irreversible paralysis."}, {"source": "Leprosy", "target": "Thalidomide for Type 2 Reaction (Erythema Nodosum Leprosum)", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Severe Type 2 reactions (Erythema Nodosum Leprosum) exhibit rapid defervescence and resolution of painful subcutaneous inflammatory nodules within 48 to 72 hours of thalidomide therapy."}, {"source": "Leprosy", "target": "Standard Beta-Lactam and Cephalosporin Antibiotics", "keywords": "INTRINSICALLY_RESISTANT_TO", "description": "[INTRINSICALLY_RESISTANT_TO] Mycobacterium leprae is intrinsically unresponsive to standard empirical antibiotics such as beta-lactams, cephalosporins, and conventional macrolides."}]}}
{"case_id": "leptospirosis", "disease": "Leptospirosis", "extraction": {"entities": [{"name": "Leptospirosis", "type": "Disease", "description": "A life-threatening biphasic zoonotic infection caused by pathogenic spirochetes of the genus Leptospira, characterized by an acute leptospiremic phase with fever, conjunctival suffusion, and calf tenderness, potentially progressing to severe icteric Weil disease (jaundice, acute renal failure, hemorrhage) or catastrophic severe pulmonary hemorrhagic syndrome."}, {"name": "Rodent Urine Contaminated Floodwaters or Soil", "type": "Vector_Exposure", "description": "Environmental surface water, wet mud, soil, or urban floodwaters contaminated with urine from chronically colonized rodents, serving as the primary vehicle for percutaneous or permucosal transmission during monsoons and flooding."}, {"name": "Asymptomatic Rodent Maintenance Hosts", "type": "Vector_Exposure", "description": "Brown and black rats (Rattus norvegicus, Rattus rattus) and field mice that maintain chronic asymptomatic colonization of renal proximal tubules and shed massive quantities of viable Leptospira spirochetes in their urine indefinitely."}, {"name": "Occupational and Recreational Freshwater Inoculation", "type": "Vector_Exposure", "description": "High-risk percutaneous or permucosal exposure through occupational tasks (sewer cleaning, rice farming, abattoir work) or freshwater immersion sports (rafting, canoeing, triathlon) involving contact with contaminated water."}, {"name": "Leptospira interrogans", "type": "Pathogen", "description": "Pathogenic obligate aerobic, highly motile spirochete of the genus Leptospira comprising over 250 distinct serovars across >24 serogroups, which invades host tissues, disseminates hematogenously, and causes extensive microvascular endothelial injury."}, {"name": "Conjunctival Suffusion Without Inflammatory Exudate", "type": "Cardinal_Sign", "description": "Bilateral ciliary and bulbar conjunctival erythema and vascular engorgement appearing on days 3–4 of illness, characteristically devoid of purulent discharge, crusting, or chemosis, serving as a pathognomonic physical hallmark in 60–85% of cases."}, {"name": "Severe Gastrocnemius Calf Muscle Tenderness", "type": "Cardinal_Sign", "description": "Disproportionate, excruciating myalgia and intense tenderness localized to the calf (gastrocnemius and soleus) and lumbar paraspinal muscles, often rendering the patient unable to walk or tolerate light manual palpation."}, {"name": "Weil Disease Triad of Jaundice Renal Failure and Hemorrhage", "type": "Cardinal_Sign", "description": "Severe icteric leptospirosis occurring in 5–15% of patients, manifested by the life-threatening triad of deep bronze-colored jaundice, rapid acute kidney injury, and hemorrhagic diathesis."}, {"name": "Severe Pulmonary Hemorrhagic Syndrome", "type": "Cardinal_Sign", "description": "Catastrophic intra-alveolar hemorrhage secondary to toxin-mediated pulmonary capillary endothelial damage, presenting with sudden dyspnea, hemoptysis, and hypoxic respiratory failure with mortality exceeding 50%."}, {"name": "Biphasic Fever with Shaking Chills", "type": "Cardinal_Sign", "description": "Abrupt onset of high remittent or continuous fever (39–40°C) accompanied by violent shaking chills, diaphoresis, and severe frontal/retro-orbital headache during the initial leptospiremic phase (days 1–7)."}, {"name": "High Total Bilirubin with Disproportionately Mild Transaminitis", "type": "Admission_Lab_Imaging", "description": "Marked conjugated hyperbilirubinemia (total bilirubin 10–30 mg/dL) reflecting canalicular cholestasis, accompanied by only mild-to-moderate transaminase elevations (AST and ALT 100–300 U/L, rarely >5x ULN, virtually never >1,000 U/L)."}, {"name": "Early Hypokalemic or Normokalemic Acute Kidney Injury", "type": "Admission_Lab_Imaging", "description": "Rapidly rising serum creatinine and BUN that presents uniquely in early stages as polyuric or non-oliguric hypokalemic/normokalemic renal failure due to spirochetal toxin inhibition of apical Na+/K+/2Cl- cotransporters in the loop of Henle."}, {"name": "Marked Neutrophilic Leukocytosis with Bandemia", "type": "Admission_Lab_Imaging", "description": "Total peripheral white blood cell count of 12,000–25,000/uL with >80% neutrophils and >10% bands (or leukemoid reactions >30,000/uL in severe Weil disease), markedly distinguishing leptospirosis from arboviral leukopenia."}, {"name": "Severe Thrombocytopenia with High C-Reactive Protein", "type": "Admission_Lab_Imaging", "description": "Platelet count <100,000/uL (frequently <50,000/uL in severe pulmonary or renal failure) paired with profound elevation of inflammatory markers (CRP >100–200 mg/L and high ESR) reflecting systemic vasculitis and microvascular injury."}, {"name": "Markedly Elevated Serum Creatine Kinase", "type": "Admission_Lab_Imaging", "description": "Total serum creatine kinase elevated >5–10 times the upper limit of normal in >50% of patients at presentation, resulting from intense skeletal muscle necrosis and rhabdomyolysis."}, {"name": "Diffuse Snowflake Alveolar Infiltrates on Chest Radiography", "type": "Admission_Lab_Imaging", "description": "Bedside chest radiograph showing bilateral patchy, non-segmental alveolar infiltrates or diffuse nodular 'snowstorm / snowflake' opacities predominantly affecting the middle and lower zones, indicating alveolar hemorrhage."}, {"name": "Nephromegaly with Acalculous Gallbladder Wall Edema on Bedside Ultrasound", "type": "Admission_Lab_Imaging", "description": "Abdominal ultrasound demonstrating bilateral enlarged kidneys with increased cortical echogenicity and acalculous gallbladder wall edema, while confirming normal, non-dilated intra- and extrahepatic bile ducts."}, {"name": "Presence of Purulent Conjunctival Exudate", "type": "Exclusion_Criterion", "description": "Copious purulent or mucopurulent ocular discharge, conjunctival crusting, or marked chemosis, which contradicts the classic dry vascular ciliary injection of leptospiral conjunctival suffusion."}, {"name": "Severe Transaminitis with AST or ALT Exceeding 2000 U/L", "type": "Exclusion_Criterion", "description": "Serum AST or ALT elevations exceeding 1,000–2,000 U/L, which indicates massive acute hepatocellular necrosis (typical of viral or toxic hepatitis) rather than the cholestatic transaminitis of leptospirosis."}, {"name": "Leukopenia with WBC Count Under 4000 per Microliter", "type": "Exclusion_Criterion", "description": "Normal or depressed total peripheral white blood cell count (<4,000/uL) in the presence of acute febrile jaundice and renal failure, arguing strongly against acute leptospirosis."}, {"name": "Biliary Ductal Dilation on Ultrasound", "type": "Exclusion_Criterion", "description": "Ultrasonographic evidence of intrahepatic or extrahepatic biliary duct dilation or choledocholithiasis, establishing mechanical extrahepatic biliary obstruction."}, {"name": "Presence of Intraerythrocytic Parasites on Blood Smear", "type": "Exclusion_Criterion", "description": "Microscopic visualization of intraerythrocytic Plasmodium trophozoites, schizonts, or gametocytes on Giemsa-stained blood smears, confirming malaria as the etiology."}, {"name": "Acute Viral Hepatitis", "type": "Disease", "description": "Acute viral hepatitis (HAV, HBV, HEV) causing jaundice, anorexia, and tender hepatomegaly."}, {"name": "Dengue Fever", "type": "Disease", "description": "Arboviral infection presenting with acute high fever, retro-orbital pain, myalgia, severe thrombocytopenia, and plasma leakage."}, {"name": "Acute Bacterial Cholangitis", "type": "Disease", "description": "Ascending biliary infection presenting with Charcot's triad (fever, jaundice, right upper quadrant pain) due to biliary ductal obstruction."}, {"name": "Severe Falciparum Malaria", "type": "Disease", "description": "Life-threatening parasitic infection caused by Plasmodium falciparum presenting with cyclical fevers, rigors, hemolytic jaundice, and renal failure."}, {"name": "Intravenous Penicillin G or Ceftriaxone Therapy", "type": "Drug_Response", "description": "Parenteral bactericidal therapy with high-dose intravenous Penicillin G (1.5 million units IV q6h) or Ceftriaxone (1–2 g IV daily) for 7 days, which significantly curtails fever duration and halts progression of renal failure when initiated early."}, {"name": "Oral Doxycycline or Azithromycin Therapy", "type": "Drug_Response", "description": "Oral antimicrobial regimen (Doxycycline 100 mg BID or Azithromycin) for mild outpatient leptospirosis, leading to prompt defervescence and cessation of urinary leptospiral shedding."}, {"name": "Jarisch-Herxheimer Reaction Following First Antibiotic Dose", "type": "Drug_Response", "description": "Acute clinical exacerbation occurring in 10–20% of patients within 2–6 hours of the first parenteral antibiotic dose, characterized by sudden rigors, temperature spike, and transient hypotension resulting from massive spirochetal lysis."}, {"name": "Ineffective Antimicrobial Monotherapy Without Organ Support in Weil Syndrome", "type": "Drug_Response", "description": "Antimicrobial therapy alone fails to avert mortality in advanced Weil disease or severe pulmonary hemorrhage without timely renal replacement therapy (hemodialysis) and lung-protective mechanical ventilation."}], "relationships": [{"source": "Leptospirosis", "target": "Rodent Urine Contaminated Floodwaters or Soil", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Transmission occurs via percutaneous or permucosal exposure to floodwaters, mud, wet soil, or surface water contaminated with urine shed by chronically colonized rodents (Rattus norvegicus, Rattus rattus)."}, {"source": "Leptospirosis", "target": "Asymptomatic Rodent Maintenance Hosts", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] Primary reservoir maintenance hosts are rodents that excrete astronomical quantities of viable Leptospira spirochetes into the environment indefinitely without developing clinical disease."}, {"source": "Leptospirosis", "target": "Occupational and Recreational Freshwater Inoculation", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Agricultural workers (rice/sugarcane), sewage laborers, and freshwater recreational athletes experience percutaneous or permucosal inoculation during environmental water exposure."}, {"source": "Leptospirosis", "target": "Leptospira interrogans", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Caused by pathogenic spirochetes of the genus Leptospira, predominantly Leptospira interrogans, which disseminate hematogenously during the septicemic phase and invade renal tubules, liver parenchyma, and capillary endothelium."}, {"source": "Leptospirosis", "target": "Conjunctival Suffusion Without Inflammatory Exudate", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Present in 60–85% of cases on days 3–4, presenting as bilateral intense ciliary flush devoid of purulent secretions or conjunctival crusting, representing a distinctive diagnostic physical hallmark."}, {"source": "Leptospirosis", "target": "Severe Gastrocnemius Calf Muscle Tenderness", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Severe, disproportionate myalgia localized to the gastrocnemius calf and lumbar paraspinal muscles is a classic hallmark of early leptospiremic phase disease."}, {"source": "Leptospirosis", "target": "Weil Disease Triad of Jaundice Renal Failure and Hemorrhage", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Life-threatening icteric syndrome manifested by deep bronze/orange jaundice, rapid acute kidney injury, and diathetic hemorrhage."}, {"source": "Leptospirosis", "target": "Severe Pulmonary Hemorrhagic Syndrome", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Catastrophic manifestation of leptospirosis featuring extensive capillary endothelial injury leading to intra-alveolar bleeding and lethal hypoxic respiratory failure."}, {"source": "Leptospirosis", "target": "Biphasic Fever with Shaking Chills", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Abrupt onset of high spiking fever accompanied by violent shaking chills, diaphoresis, and severe cephalalgia representing initial bacteremic dissemination."}, {"source": "Leptospirosis", "target": "High Total Bilirubin with Disproportionately Mild Transaminitis", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Serum total/direct bilirubin is markedly elevated with dramatic jaundice, while transaminases (AST/ALT) remain disproportionately modest (<300–400 U/L), sharply distinguishing leptospirosis from hepatocellular necrosis."}, {"source": "Leptospirosis", "target": "Early Hypokalemic or Normokalemic Acute Kidney Injury", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Acute kidney injury presenting with preserved urine output and normal or low serum potassium levels due to impaired tubular sodium and potassium reabsorption."}, {"source": "Leptospirosis", "target": "Marked Neutrophilic Leukocytosis with Bandemia", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Prominent neutrophilic leukocytosis with significant left shift and toxic granulation is universally evident at initial hospital triage."}, {"source": "Leptospirosis", "target": "Severe Thrombocytopenia with High C-Reactive Protein", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Concomitant severe thrombocytopenia alongside extreme elevations of acute phase reactants (CRP >100 mg/L) reflects intense systemic inflammation and endothelial disruption."}, {"source": "Leptospirosis", "target": "Markedly Elevated Serum Creatine Kinase", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Substantial elevation of creatine kinase reflects direct skeletal muscle injury and ongoing myositis/rhabdomyolysis."}, {"source": "Leptospirosis", "target": "Diffuse Snowflake Alveolar Infiltrates on Chest Radiography", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Admission chest radiograph displaying bilateral patchy snowflake nodular opacities indicative of intra-alveolar hemorrhage."}, {"source": "Leptospirosis", "target": "Nephromegaly with Acalculous Gallbladder Wall Edema on Bedside Ultrasound", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Abdominal sonography demonstrates bilateral nephromegaly and acalculous gallbladder wall thickening while explicitly confirming normal, non-dilated biliary ducts."}, {"source": "Leptospirosis", "target": "Presence of Purulent Conjunctival Exudate", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] The presence of purulent or copious inflammatory conjunctival exudate strongly argues against leptospirosis, whose cardinal hallmark is pure non-purulent conjunctival suffusion."}, {"source": "Leptospirosis", "target": "Severe Transaminitis with AST or ALT Exceeding 2000 U/L", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] AST or ALT elevations above 2,000 U/L effectively exclude uncomplicated leptospirosis, where hepatic involvement produces striking cholestatic jaundice with transaminases typically below 400 U/L."}, {"source": "Leptospirosis", "target": "Leukopenia with WBC Count Under 4000 per Microliter", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Total white blood cell count <4,000/uL in the presence of severe febrile jaundice and renal impairment strongly excludes leptospirosis, which consistently provokes marked neutrophilic leukocytosis."}, {"source": "Leptospirosis", "target": "Biliary Ductal Dilation on Ultrasound", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Sonographic evidence of dilated intra- or extrahepatic biliary ducts or choledocholithiasis rules out leptospirosis in favor of acute mechanical or bacterial cholangitis."}, {"source": "Leptospirosis", "target": "Presence of Intraerythrocytic Parasites on Blood Smear", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Identification of intraerythrocytic Plasmodium species on blood film confirms malaria as the source of hemolysis, rigors, and jaundice rather than leptospirosis."}, {"source": "Leptospirosis", "target": "Acute Viral Hepatitis", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Leptospirosis is differentiated from acute viral hepatitis by the presence of marked neutrophilic leukocytosis, elevated serum creatine kinase, acute renal injury, conjunctival suffusion, and transaminases <400 U/L, whereas viral hepatitis exhibits transaminases >1,000–5,000 U/L and normal renal function."}, {"source": "Leptospirosis", "target": "Dengue Fever", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Leptospirosis is differentiated from dengue fever by profound neutrophilic leukocytosis, marked direct hyperbilirubinemia, severe calf tenderness, and highly elevated CRP (>100 mg/L), whereas dengue features prominent leukopenia (<4,000/uL), hemoconcentration, normal bilirubin, and low CRP."}, {"source": "Leptospirosis", "target": "Acute Bacterial Cholangitis", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Leptospirosis is differentiated from acute bacterial cholangitis by completely normal, non-dilated bile ducts on abdominal ultrasound, prominent non-purulent conjunctival suffusion, and disproportionate calf tenderness."}, {"source": "Leptospirosis", "target": "Severe Falciparum Malaria", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Leptospirosis is differentiated from severe falciparum malaria by predominantly direct (conjugated) hyperbilirubinemia, absence of intraerythrocytic parasites on blood smear, and presence of bilateral conjunctival suffusion and calf pain, whereas malaria causes indirect (unconjugated) hemolytic jaundice with elevated LDH."}, {"source": "Leptospirosis", "target": "Intravenous Penicillin G or Ceftriaxone Therapy", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Severe leptospirosis responds promptly to intravenous penicillin G or ceftriaxone; early administration within the first 4–7 days of symptom onset significantly accelerates defervescence and halts progression of organ failure."}, {"source": "Leptospirosis", "target": "Oral Doxycycline or Azithromycin Therapy", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Mild outpatient leptospirosis responds rapidly to a 7-day course of oral doxycycline or azithromycin, shortening illness duration and eliminating urinary spirochete shedding."}, {"source": "Leptospirosis", "target": "Jarisch-Herxheimer Reaction Following First Antibiotic Dose", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Development of a Jarisch-Herxheimer reaction (rigors, fever spike, hypotension) within 2–6 hours of antibiotic initiation serves as a diagnostic therapeutic clue reflecting massive bactericidal lysis of spirochetes."}, {"source": "Leptospirosis", "target": "Ineffective Antimicrobial Monotherapy Without Organ Support in Weil Syndrome", "keywords": "INTRINSICALLY_RESISTANT_TO", "description": "[INTRINSICALLY_RESISTANT_TO] Antibiotic therapy alone without aggressive supportive management (early renal replacement therapy, mechanical ventilation for SPHS) fails to curtail mortality in advanced multi-organ failure."}]}}
{"case_id": "malaria", "disease": "Malaria", "extraction": {"entities": [{"name": "Malaria", "type": "Disease", "description": "Life-threatening protozoan intraerythrocytic parasitic infection caused by Plasmodium species, characterized by cyclical fever paroxysms, acute hemolysis, profound thrombocytopenia, and risk of microvascular sequestration or multiorgan failure."}, {"name": "Nocturnal Anopheles Mosquito Bite", "type": "Vector_Exposure", "description": "Primary vector transmission via the bite of infective nocturnal female mosquitoes of the genus Anopheles (e.g., An. gambiae, An. funestus, An. stephensi), typically feeding between dusk and dawn."}, {"name": "Tropical Endemic Area Travel or Residence", "type": "Vector_Exposure", "description": "Recent travel to or residence in malaria-endemic tropical and subtropical regions, predominantly sub-Saharan Africa (>95% global burden), South and Southeast Asia, Western Pacific, and the Amazon basin."}, {"name": "Infected Blood Transfusion or Contaminated Needle Sharing", "type": "Vector_Exposure", "description": "Non-vector parenteral transmission occurring through blood product transfusions, needle sharing among intravenous drug users, or vertical congenital transmission from mother to fetus."}, {"name": "Plasmodium falciparum", "type": "Pathogen", "description": "Deadliest human malaria protozoan; invades erythrocytes of all ages, induces high-density parasitemia, PfEMP1-mediated endothelial cytoadherence, microvascular sequestration, and severe multi-organ dysfunction."}, {"name": "Plasmodium vivax", "type": "Pathogen", "description": "Most widespread human malaria parasite outside Africa; selectively infects reticulocytes, forms dormant hepatic hypnozoites capable of periodic clinical relapses months to years post-inoculation."}, {"name": "Plasmodium ovale", "type": "Pathogen", "description": "Benign tertian malaria protozoan primarily endemic in sub-Saharan West and Central Africa; selectively invades reticulocytes and forms persistent intrahepatic hypnozoites causing delayed relapses."}, {"name": "Plasmodium malariae", "type": "Pathogen", "description": "Human malaria species characterized by a 72-hour quartan erythrocytic replication cycle, selectivity for senescent erythrocytes, low parasitemia, and potential to cause chronic immune-complex nephrotic syndrome."}, {"name": "Plasmodium knowlesi", "type": "Pathogen", "description": "Zoonotic simian malaria parasite endemic in Southeast Asia (macaque reservoir) with an ultra-rapid 24-hour replication cycle causing daily quotidian fevers and rapid progression to severe malaria."}, {"name": "Classical Malarial Paroxysm with Rigors and Diaphoresis", "type": "Cardinal_Sign", "description": "Pathognomonic triphasic fever attack synchronous with erythrocyte schizont rupture: sudden cold stage with violent shivering and rigors (15-60 min), hot stage with fever spike to 39-41°C (2-6 hr), and drenching sweating defervescence stage (2-4 hr)."}, {"name": "Periodic Tertian or Quartan Fever Rhythm", "type": "Cardinal_Sign", "description": "Synchronous recurring fever spike patterns: tertian rhythm every 48 hours in P. vivax/ovale/falciparum, quartan rhythm every 72 hours in P. malariae, or quotidian rhythm every 24 hours in P. knowlesi."}, {"name": "Tender Splenomegaly with Hemolytic Jaundice and Pallor", "type": "Cardinal_Sign", "description": "Clinical triad consisting of an acutely enlarged, soft, tender spleen appearing within 3-7 days, accompanied by mild scleral icterus and conjunctival/mucocutaneous pallor."}, {"name": "Cerebral Malaria with Impaired Consciousness and Convulsions", "type": "Cardinal_Sign", "description": "Cardinal manifestation of severe P. falciparum malaria characterized by coma (Glasgow Coma Scale < 11 in adults or Blantyre Coma Score < 3 in children), generalized seizures, and malarial retinopathy."}, {"name": "Blackwater Fever with Hemoglobinuria and Acute Renal Failure", "type": "Cardinal_Sign", "description": "Severe clinical hallmark featuring dark mahogany or black-colored urine resulting from massive intravascular hemolysis and hemoglobinuria, associated with oliguria and rapid creatinine elevation."}, {"name": "Severe Lactic Acidosis with Kussmaul Breathing", "type": "Cardinal_Sign", "description": "Deep, rapid, labored hyperventilation (Kussmaul breathing) in severe malaria driven by marked systemic lactic acidosis (> 5 mmol/L) and microvascular capillary hypoperfusion."}, {"name": "Intraerythrocytic Parasites on Giemsa Blood Smear", "type": "Admission_Lab_Imaging", "description": "Definitive admission microscopy on thick and thin blood films showing intraerythrocytic ring-form trophozoites, crescentic banana-shaped gametocytes (P. falciparum), or amoeboid forms with Schüffner dots (P. vivax)."}, {"name": "Positive Malaria Rapid Diagnostic Test for HRP2 and pLDH", "type": "Admission_Lab_Imaging", "description": "Rapid immunochromatographic antigen detection on fingerstick blood positive for Plasmodium falciparum Histidine-Rich Protein 2 (HRP2) and/or pan-Plasmodium parasite lactate dehydrogenase (pLDH) or aldolase."}, {"name": "Hemolytic Anemia with Depleted Haptoglobin and Elevated LDH", "type": "Admission_Lab_Imaging", "description": "Normocytic normochromic anemia with acute hemoglobin/hematocrit drop, undetectable serum haptoglobin (< 0.1 g/L), marked serum lactate dehydrogenase elevation (LDH > 500-1000 IU/L), and elevated reticulocyte count."}, {"name": "Profound Thrombocytopenia with Normal or Low WBC Count", "type": "Admission_Lab_Imaging", "description": "Platelet count markedly depressed (< 100,000/µL, frequently < 50,000/µL) in 70-85% of patients, accompanied by a normal or leukopenic white blood cell count (3,000-6,000/µL) without marked bacterial leukocytosis."}, {"name": "Unconjugated Hyperbilirubinemia with Mild Transaminitis", "type": "Admission_Lab_Imaging", "description": "Elevation of indirect (unconjugated) serum bilirubin (> 2-3 mg/dL) with normal or only modestly elevated transaminases (AST and ALT < 3x upper limit of normal), confirming hemolytic rather than obstructive or hepatocellular jaundice."}, {"name": "POCUS Splenomegaly with Normal Gallbladder Wall", "type": "Admission_Lab_Imaging", "description": "Point-of-care ultrasound (POCUS) demonstrating homogenous splenomegaly and mild hepatomegaly with thin, non-edematous gallbladder wall (< 3 mm) and absence of subcapsular splenic hematoma, abscess, or plasma leakage."}, {"name": "Symptom Onset Less Than 7 Days Post-Exposure", "type": "Exclusion_Criterion", "description": "Presentation with fever and constitutional symptoms within less than 7 days after first exposure or arrival in a malaria-endemic region."}, {"name": "Three Consecutive Negative Quality-Assured Blood Smears and RDTs", "type": "Exclusion_Criterion", "description": "Three consecutive high-magnification thick and thin blood Giemsa smears and antigen-based RDTs performed 12 to 24 hours apart yielding negative parasite results."}, {"name": "Marked Microvascular Plasma Leakage with Hemoconcentration", "type": "Exclusion_Criterion", "description": "Presence of systemic plasma leakage evidenced by hemoconcentration (hematocrit rise >= 20%), pleural effusion, ascites, or stratified gallbladder wall edema on imaging."}, {"name": "Marked Neutrophilic Leukocytosis Exceeding 15000 per Microliter", "type": "Exclusion_Criterion", "description": "Prominent neutrophilic leukocytosis (WBC > 15,000/µL) with significant left shift and toxic granulation on admission CBC."}, {"name": "Dengue Fever", "type": "Disease", "description": "Acute viral arboviral infection caused by Dengue virus transmitted by Aedes aegypti, presenting with saddleback fever, retro-orbital pain, severe myalgia, hemoconcentration, and plasma leakage."}, {"name": "Typhoid Fever", "type": "Disease", "description": "Invasive systemic salmonellosis caused by Salmonella enterica serovar Typhi presenting with prolonged step-ladder fever, relative bradycardia, rose spots, and abdominal symptoms."}, {"name": "Leptospirosis", "type": "Disease", "description": "Zoonotic spirochetal illness caused by Leptospira interrogans transmitted via floodwater or rodent urine, presenting with biphasic fever, conjunctival suffusion, calf tenderness, jaundice, and acute renal failure."}, {"name": "Scrub Typhus", "type": "Disease", "description": "Zoonotic mite-borne infection caused by Orientia tsutsugamushi transmitted by larval trombiculid chiggers, presenting with acute fever, regional lymphadenopathy, maculopapular rash, and eschar."}, {"name": "Rapid Defervescence Following Artemisinin-Based Combination Therapy", "type": "Drug_Response", "description": "Dramatic clinical defervescence to normal body temperature and >90% reduction in circulating asexual parasites within 24 to 48 hours of starting oral Artemisinin-based Combination Therapy (ACT)."}, {"name": "Intravenous Artesunate Parasite Clearance in Severe Malaria", "type": "Drug_Response", "description": "Rapid destruction of circulating and sequestered ring-stage Plasmodium parasites following parenteral intravenous artesunate (2.4 mg/kg IV), significantly reducing mortality in severe complicated malaria."}, {"name": "Hypnozoite Eradication by 8-Aminoquinolines", "type": "Drug_Response", "description": "Radical cure of dormant liver-stage hypnozoites in Plasmodium vivax and Plasmodium ovale infections using a 14-day course of Primaquine or single-dose Tafenoquine following confirmation of normal G6PD activity."}, {"name": "Intrinsic Refractoriness to Standard Antibacterial Agents", "type": "Drug_Response", "description": "Total lack of defervescence, persistent fever paroxysms, and ongoing intraerythrocytic parasitemia when empirically treated with standard broad-spectrum antibacterial agents (beta-lactams, cephalosporins, aminoglycosides)."}], "relationships": [{"source": "Malaria", "target": "Nocturnal Anopheles Mosquito Bite", "keywords": "TRANSMITTED_BY, mosquito vector, anopheles, nocturnal feeding", "description": "[TRANSMITTED_BY] Malaria is primarily transmitted through the nocturnal bites of infected female Anopheles mosquitoes inoculating sporozoites during blood meals taken between dusk and dawn."}, {"source": "Malaria", "target": "Tropical Endemic Area Travel or Residence", "keywords": "EXPOSURE_TO, geographic endemicity, travel history, tropical medicine", "description": "[EXPOSURE_TO] Exposure occurs through living in or travelling to tropical and subtropical transmission zones, where sub-Saharan Africa carries over 95% of worldwide cases and fatalities."}, {"source": "Malaria", "target": "Infected Blood Transfusion or Contaminated Needle Sharing", "keywords": "TRANSMITTED_BY, parenteral inoculation, blood transfusion, congenital transmission", "description": "[TRANSMITTED_BY] Malaria can be transmitted parenterally without mosquito vectors via transfusion of infected erythrocytic units, contaminated needle sharing, or vertically across the placenta."}, {"source": "Malaria", "target": "Plasmodium falciparum", "keywords": "HAS_PATHOGEN, causative agent, malignant tertian, cytoadherence", "description": "[HAS_PATHOGEN] Plasmodium falciparum causes malignant tertian malaria and is responsible for >95% of malaria deaths worldwide, driven by universal erythrocyte invasion, extensive cytoadherence, and deep capillary sequestration."}, {"source": "Malaria", "target": "Plasmodium vivax", "keywords": "HAS_PATHOGEN, causative agent, benign tertian, hypnozoites, relapsing malaria", "description": "[HAS_PATHOGEN] Plasmodium vivax produces benign tertian malaria with reticulocyte tropism and dormant liver-stage hypnozoites that cause recurrent relapses at periodic intervals if radical cure is not achieved."}, {"source": "Malaria", "target": "Plasmodium ovale", "keywords": "HAS_PATHOGEN, causative agent, ovale tertian, dormant hypnozoites", "description": "[HAS_PATHOGEN] Plasmodium ovale produces tertian fever paroxysms and harbours latent hypnozoites in hepatocytes leading to late clinical relapses."}, {"source": "Malaria", "target": "Plasmodium malariae", "keywords": "HAS_PATHOGEN, causative agent, quartan malaria, chronic infection, nephrotic syndrome", "description": "[HAS_PATHOGEN] Plasmodium malariae induces quartan fever periodicities every 72 hours, restricted to aging erythrocytes, and can persist asymptomatically for decades or provoke chronic glomerulonephritis."}, {"source": "Malaria", "target": "Plasmodium knowlesi", "keywords": "HAS_PATHOGEN, causative agent, zoonotic malaria, quotidian fever, 24-hour cycle", "description": "[HAS_PATHOGEN] Plasmodium knowlesi is a zoonotic parasite transmitted from wild macaque hosts in Southeast Asia that replicates every 24 hours, often generating hyperparasitemia and rapid clinical collapse."}, {"source": "Malaria", "target": "Classical Malarial Paroxysm with Rigors and Diaphoresis", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, malarial paroxysm, rigors, diaphoresis, rules in", "description": "[HAS_PATHOGNOMONIC_HALLMARK] The classical malarial paroxysm corresponds to synchronous intravascular schizont rupture, sequentially progressing through violent teeth-chattering rigors, intense hyperpyrexia with throbbing cephalalgia, and drenching diaphoresis with rapid defervescence."}, {"source": "Malaria", "target": "Periodic Tertian or Quartan Fever Rhythm", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, fever periodicity, tertian rhythm, quartan fever", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Regular fever periodicity recurring every 48 hours (tertian) or every 72 hours (quartan) matches the synchronized merozoite release cycle and strongly differentiates malaria from continuous bacterial fevers."}, {"source": "Malaria", "target": "Tender Splenomegaly with Hemolytic Jaundice and Pallor", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, splenomegaly, hemolytic icterus, anemia pallor", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Early palpable, tender splenomegaly combined with scleral icterus and mucosal pallor is a hallmark physical examination triad reflecting acute splenic sequestration and active erythrocyte hemolysis."}, {"source": "Malaria", "target": "Cerebral Malaria with Impaired Consciousness and Convulsions", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, cerebral malaria, coma, convulsions, malarial retinopathy", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Cerebral malaria manifests at admission as unarousable coma, recurrent generalized convulsions, and characteristic retinal whitening/hemorrhages driven by sequestered parasitized erythrocytes in cerebral capillaries."}, {"source": "Malaria", "target": "Blackwater Fever with Hemoglobinuria and Acute Renal Failure", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, blackwater fever, hemoglobinuria, acute tubular necrosis", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Blackwater fever is a dramatic presentation of massive intravascular hemolysis yielding port-wine to black urine from severe hemoglobinuria, culminating in acute tubular necrosis and renal compromise."}, {"source": "Malaria", "target": "Severe Lactic Acidosis with Kussmaul Breathing", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, metabolic acidosis, Kussmaul respiration, respiratory distress", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Deep labored respiratory distress (acidotic Kussmaul breathing) represents systemic tissue hypoxia and lactic acidosis (lactate > 5 mmol/L), serving as one of the strongest bedside predictors of mortality."}, {"source": "Malaria", "target": "Intraerythrocytic Parasites on Giemsa Blood Smear", "keywords": "EXHIBITS_LAB_PATTERN, blood smear microscopy, Giemsa stain, ring trophozoites, parasitemia", "description": "[EXHIBITS_LAB_PATTERN] Peripheral blood Giemsa stain microscopy at triage provides definitive confirmation, with thick smears detecting low-level parasitemia and thin smears quantifying percentage parasitemia and differentiating Plasmodium species."}, {"source": "Malaria", "target": "Positive Malaria Rapid Diagnostic Test for HRP2 and pLDH", "keywords": "EXHIBITS_LAB_PATTERN, rapid diagnostic test, RDT, HRP2, pLDH antigen", "description": "[EXHIBITS_LAB_PATTERN] Bedside RDTs rapidly detect circulating HRP2 and pLDH antigens at admission triage, confirming active or recent falciparum and non-falciparum Plasmodium parasitemia within 15 minutes."}, {"source": "Malaria", "target": "Hemolytic Anemia with Depleted Haptoglobin and Elevated LDH", "keywords": "EXHIBITS_LAB_PATTERN, hemolytic anemia, depleted haptoglobin, elevated LDH, reticulocytosis", "description": "[EXHIBITS_LAB_PATTERN] Admission laboratory profile exhibits brisk intravascular and extravascular hemolysis characterized by an acute drop in hemoglobin, undetectable haptoglobin, markedly elevated serum LDH, and compensatory reticulocytosis."}, {"source": "Malaria", "target": "Profound Thrombocytopenia with Normal or Low WBC Count", "keywords": "EXHIBITS_LAB_PATTERN, thrombocytopenia, leukopenia, splenic pooling, admission CBC", "description": "[EXHIBITS_LAB_PATTERN] Complete blood count at triage characteristically shows profound thrombocytopenia (< 100,000/µL) alongside a normal or low leukocyte count (3,000-6,000/µL) resulting from splenic pooling and immune platelet destruction."}, {"source": "Malaria", "target": "Unconjugated Hyperbilirubinemia with Mild Transaminitis", "keywords": "EXHIBITS_LAB_PATTERN, indirect hyperbilirubinemia, unconjugated jaundice, mild transaminitis", "description": "[EXHIBITS_LAB_PATTERN] Hepatic chemistry at admission demonstrates predominant unconjugated (indirect) hyperbilirubinemia with minimal transaminase elevation (< 3x ULN), reflecting extensive erythrocyte destruction rather than viral hepatitis."}, {"source": "Malaria", "target": "POCUS Splenomegaly with Normal Gallbladder Wall", "keywords": "EXHIBITS_LAB_PATTERN, POCUS ultrasound, splenomegaly, normal gallbladder, no plasma leakage", "description": "[EXHIBITS_LAB_PATTERN] Bedside POCUS reveals acute splenomegaly with a normal thin gallbladder wall and absence of third-space plasma leakage, distinguishing malaria from the acute thickened edematous gallbladder wall seen in dengue."}, {"source": "Malaria", "target": "Symptom Onset Less Than 7 Days Post-Exposure", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, incubation period", "description": "[RULED_OUT_BY] Symptom onset occurring less than 7 days after initial entry into an endemic zone rules out Plasmodium falciparum malaria, because hepatic intrahepatic schizogony requires an obligatory biological minimum incubation of 7 to 9 days."}, {"source": "Malaria", "target": "Three Consecutive Negative Quality-Assured Blood Smears and RDTs", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, serial microscopy, negative RDT", "description": "[RULED_OUT_BY] Three consecutive quality-assured thick and thin Giemsa smears alongside negative antigen RDTs obtained 12 to 24 hours apart completely rules out acute symptomatic malaria as the etiology of the current febrile illness."}, {"source": "Malaria", "target": "Marked Microvascular Plasma Leakage with Hemoconcentration", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, plasma leakage, hemoconcentration", "description": "[RULED_OUT_BY] Presence of significant microvascular plasma leakage with hemoconcentration (hematocrit rise >= 20%), pleural effusion, or ascites rules out uncomplicated malaria, pointing decisively toward severe dengue shock syndrome."}, {"source": "Malaria", "target": "Marked Neutrophilic Leukocytosis Exceeding 15000 per Microliter", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, leukocytosis, bacterial sepsis", "description": "[RULED_OUT_BY] Marked neutrophilic leukocytosis (WBC > 15,000/µL) strongly excludes uncomplicated malaria, which typically presents with normal or leukopenic white counts (3,000-6,000/µL); high leukocytosis indicates pyogenic bacterial sepsis, leptospirosis, or enteric perforation."}, {"source": "Malaria", "target": "Dengue Fever", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, arbovirus, hemoconcentration", "description": "[DIFFERENTIATED_FROM] Dengue Fever is differentiated at triage by severe retro-orbital headache, positive tourniquet test, hemoconcentration (hematocrit rise >= 20%), plasma leakage (pleural effusion, gallbladder wall edema), and AST > ALT elevation without splenomegaly or hemolytic jaundice; in contrast, Malaria features hemolytic anemia with low hematocrit, unconjugated hyperbilirubinemia, early splenomegaly, and intraerythrocytic parasites on blood smear."}, {"source": "Malaria", "target": "Typhoid Fever", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, enteric fever, Faget sign", "description": "[DIFFERENTIATED_FROM] Typhoid Fever is differentiated by an insidious step-ladder gradual temperature rise, relative bradycardia (Faget sign), rose spots on the trunk, dull apathetic facies, and lack of cyclical sweating rigors; in contrast, Malaria presents with sudden-onset violent teeth-chattering rigors, drenching diaphoresis, acute hemolytic anemia, and rapid defervescence cycles."}, {"source": "Malaria", "target": "Leptospirosis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, spirochete, conjunctival suffusion", "description": "[DIFFERENTIATED_FROM] Leptospirosis is differentiated by striking bilateral conjunctival suffusion without purulent exudate, severe gastrocnemius calf tenderness, marked neutrophilic leukocytosis (WBC > 15,000/µL), and direct (conjugated) hyperbilirubinemia with elevated ESR/CRP; in contrast, Malaria presents with unconjugated (indirect) hyperbilirubinemia, normal/low WBC, and Giemsa smear parasite visualization."}, {"source": "Malaria", "target": "Scrub Typhus", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, rickettsia, eschar", "description": "[DIFFERENTIATED_FROM] Scrub Typhus is differentiated by a pathognomonic necrotic cigarette-burn eschar at the chigger bite site, regional lymphadenopathy, and generalized macular trunk rash; in contrast, Malaria lacks eschars and rash, and is diagnosed by intraerythrocytic ring forms and positive HRP2/pLDH antigen tests."}, {"source": "Malaria", "target": "Rapid Defervescence Following Artemisinin-Based Combination Therapy", "keywords": "RESPONDS_TO, therapeutic verification, artemisinin response, defervescence, ACT", "description": "[RESPONDS_TO] Uncomplicated malaria responds rapidly to oral Artemisinin-based Combination Therapy (e.g., artemether-lumefantrine, artesunate-amodiaquine, dihydroartemisinin-piperaquine) with complete fever resolution and profound (>90%) asexual parasite clearance within 24 to 48 hours."}, {"source": "Malaria", "target": "Intravenous Artesunate Parasite Clearance in Severe Malaria", "keywords": "RESPONDS_TO, therapeutic verification, severe malaria, intravenous artesunate, rapid parasite clearance", "description": "[RESPONDS_TO] Severe complicated malaria responds swiftly to parenteral intravenous artesunate administered at 0, 12, and 24 hours, clearing circulating ring-stage parasitemia faster than intravenous quinine and lowering overall clinical mortality."}, {"source": "Malaria", "target": "Hypnozoite Eradication by 8-Aminoquinolines", "keywords": "RESPONDS_TO, therapeutic verification, radical cure, primaquine, tafenoquine, hypnozoites", "description": "[RESPONDS_TO] Relapsing malaria caused by P. vivax and P. ovale responds to radical cure with 8-aminoquinolines (Primaquine or Tafenoquine), which eradicate dormant intrahepatic hypnozoites and abolish long-latency recurrent relapses once G6PD deficiency is excluded."}, {"source": "Malaria", "target": "Intrinsic Refractoriness to Standard Antibacterial Agents", "keywords": "INTRINSICALLY_RESISTANT_TO, antibiotic failure, intrinsic resistance, lack of defervescence", "description": "[INTRINSICALLY_RESISTANT_TO] Plasmodium species are intrinsically unresponsive to standard empirical broad-spectrum antibacterials (penicillins, 3rd-generation cephalosporins, aminoglycosides), resulting in continued fever paroxysms and unabated parasite proliferation."}]}}
{"case_id": "melioidosis", "disease": "Melioidosis", "extraction": {"entities": [{"name": "Melioidosis", "type": "Disease", "description": "Severe, life-threatening tropical infectious disease caused by the environmental Gram-negative bacterium Burkholderia pseudomallei, characterized by protean manifestations ranging from localized abscesses and severe necrotizing pneumonia to fulminant bacteremic septic shock, especially in patients with diabetes mellitus."}, {"name": "Burkholderia pseudomallei", "type": "Pathogen", "description": "Aerobic, motile, oxidase-positive, Gram-negative saprophytic bacillus exhibiting a characteristic bipolar 'safety-pin' staining appearance; survives intracellularly and persists in tropical wet soil and water."}, {"name": "Wet Soil and Surface Water Inoculation During Monsoons", "type": "Vector_Exposure", "description": "Direct percutaneous inoculation of broken skin or minor abrasions with Burkholderia pseudomallei from wet tropical agricultural soils, mud, or surface water during monsoons (e.g., rice farming, walking barefoot, gardening)."}, {"name": "Aerosol Inhalation During Tropical Storms and Cyclones", "type": "Vector_Exposure", "description": "Inhalation of aerosolized Burkholderia pseudomallei in soil dust and water droplets during severe weather events such as typhoons, monsoons, cyclones, and near-drowning events, leading to rapid-onset severe pulmonary melioidosis."}, {"name": "Type 2 Diabetes Mellitus Host Predisposition", "type": "Vector_Exposure", "description": "The single most critical predisposing host comorbidity, present in 40–60% of all melioidosis cases, driven by neutrophil oxidative burst impairment and defective phagocytosis."}, {"name": "Hazardous Alcohol Consumption Host Predisposition", "type": "Vector_Exposure", "description": "Chronic heavy alcohol misuse present in 15–30% of melioidosis patients, impairing alveolar macrophage function and cell-mediated immunity, predisposing to bacteremia and severe sepsis."}, {"name": "Chronic Kidney Disease Host Predisposition", "type": "Vector_Exposure", "description": "Underlying chronic renal insufficiency present in 10–25% of cases, conferring an independent high risk for bacteremic melioidosis, acute renal deterioration, and fatal septic shock."}, {"name": "Endemic Tropical Geographic Exposure", "type": "Vector_Exposure", "description": "Residence in or travel to core endemic zones, predominantly Northern Australia (Top End, Kimberley) and Southeast Asia (Thailand, Vietnam, Cambodia, Laos, Malaysia, Singapore), South Asia (India), Latin America, or the US Gulf Coast."}, {"name": "Honeycomb Swiss-Cheese Splenic Microabscesses", "type": "Cardinal_Sign", "description": "Multiple small, discrete coalescing hypoechoic microabscesses throughout the splenic and hepatic parenchyma producing a pathognomonic Swiss-cheese or honeycomb pattern on POCUS ultrasound or admission CT."}, {"name": "Suppurative Parotitis in Pediatric Patients", "type": "Cardinal_Sign", "description": "Acute, painful, unilateral preauricular swelling and abscess formation representing a pathognomonic hallmark of melioidosis in children in endemic Southeast Asian regions (accounting for up to 30% of pediatric cases)."}, {"name": "Prostatic Abscess in Adult Males", "type": "Cardinal_Sign", "description": "Acute pelvic/perineal pain, dysuria, hesitancy, and urinary retention secondary to suppurative prostatic microabscesses or macroabscesses, present in 18–30% of adult male melioidosis patients in endemic regions."}, {"name": "Acute Necrotizing Cavitary Pneumonia", "type": "Cardinal_Sign", "description": "High spiking fevers, profuse night sweats, purulent productive cough, pleuritic pain, and hemoptysis with rapid pulmonary cavitation on plain radiography, representing the primary presentation in ~50% of cases."}, {"name": "Neurological Melioidosis with Brainstem Encephalitis", "type": "Cardinal_Sign", "description": "Severe neuromelioidosis presenting with rhombencephalitis, peripheral facial palsy (cranial nerve VII), flaccid tetraparesis, or cerebellar ataxia, often presenting with normal initial brain CT imaging."}, {"name": "Marked Neutrophilic Leukocytosis with Toxic Granulation", "type": "Admission_Lab_Imaging", "description": "Admission triage CBC showing total WBC 15,000–35,000/µL with >15% band forms (bandemia) and toxic granulation, signaling overwhelming bacterial pyogenic infection (or profound leukopenia <3,000/µL in lethal septic shock)."}, {"name": "Massive Acute-Phase Reactive Protein Elevation", "type": "Admission_Lab_Imaging", "description": "Striking admission inflammatory markers with C-reactive protein (CRP) >150–300 mg/L, ESR >80 mm/h, and procalcitonin markedly elevated (>2–10 ng/mL), differentiating acute melioidosis from viral infections and subacute mycobacterial disease."}, {"name": "Severe Admission Hyperglycemia and Unmasked Diabetes", "type": "Admission_Lab_Imaging", "description": "Marked admission blood glucose elevation (>200–400 mg/dL) with elevated HbA1c (>9–12%), frequently unmasking previously undiagnosed Type 2 diabetes mellitus at triage."}, {"name": "Upper Lobe Infiltrates Without Mediastinal Lymphadenopathy on Chest Radiography", "type": "Admission_Lab_Imaging", "description": "Admission plain chest radiograph showing rapid upper-lobe alveolar consolidation, alveolar infiltrate, and thin/thick-walled cavitary lesions without the hilar or mediastinal lymphadenopathy typical of tuberculosis."}, {"name": "Bedside Ultrasound Hypoechoic Splenic and Prostatic Fluid Collections", "type": "Admission_Lab_Imaging", "description": "Rapid bedside POCUS ultrasound identifying multi-focal small hypoechoic lesions in the spleen and fluid collections in the prostate gland in febrile patients with sepsis."}, {"name": "Complete Absence of Tropical Endemic Exposure or Travel", "type": "Exclusion_Criterion", "description": "Absence of any lifetime travel or residence in known endemic regions (Southeast Asia, Northern Australia, South Asia, tropical Americas, US Gulf Coast) virtually excludes melioidosis in non-laboratory settings."}, {"name": "Immunocompetent Host with Zero Environmental Soil or Water Contact", "type": "Exclusion_Criterion", "description": "A healthy host without diabetes, alcoholism, or chronic kidney disease who has no history of contact with muddy soil, surface water, or severe weather exposure is extraordinarily unlikely to have melioidosis."}, {"name": "Normal Inflammatory Markers and Absence of Leukocytosis", "type": "Exclusion_Criterion", "description": "Completely normal admission CRP (<10 mg/L), normal procalcitonin (<0.1 ng/mL), and normal WBC count without bandemia strongly rules out acute systemic or invasive melioidosis."}, {"name": "Rapid Clinical Defervescence on Standard Ceftriaxone or Ampicillin", "type": "Exclusion_Criterion", "description": "Prompt defervescence and resolution of sepsis or pneumonia within 48–72 hours of empirical treatment with ampicillin, ceftriaxone, or cefotaxime definitively rules out Burkholderia pseudomallei due to uniform intrinsic beta-lactam resistance."}, {"name": "Chronic Indolent Progression Over Months with Mediastinal Lymphadenopathy", "type": "Exclusion_Criterion", "description": "An indolent constitutional course progressing over multiple months accompanied by prominent hilar and mediastinal lymphadenopathy and normal procalcitonin rules out acute pulmonary melioidosis and indicates primary mycobacterial infection."}, {"name": "Pulmonary Tuberculosis", "type": "Disease", "description": "Mycobacterium tuberculosis infection, the primary look-alike of pulmonary melioidosis presenting with chronic cough, night sweats, weight loss, hemoptysis, and upper lobe cavitary lesions."}, {"name": "Community-Acquired Bacterial Pneumonia", "type": "Disease", "description": "Acute bacterial pneumonia caused by Streptococcus pneumoniae or Klebsiella pneumoniae, presenting with acute cough, fever, and lobar consolidation."}, {"name": "Leptospirosis", "type": "Disease", "description": "Zoonotic spirochetal infection caused by Leptospira interrogans acquired via contaminated floodwater, presenting with acute high fever, severe myalgias, and multi-organ dysfunction."}, {"name": "Scrub Typhus", "type": "Disease", "description": "Vector-borne rickettsial infection caused by Orientia tsutsugamushi transmitted by larval trombiculid mites in rural tropical environments, presenting with acute febrile illness."}, {"name": "Intrinsic Resistance to Ceftriaxone Penicillins and Aminoglycosides", "type": "Drug_Response", "description": "Uniform chromosomal intrinsic resistance of Burkholderia pseudomallei to penicillins, ampicillin, first- and second-generation cephalosporins, third-generation cephalosporins (ceftriaxone, cefotaxime), macrolides, aminoglycosides, and colistin."}, {"name": "Intravenous Ceftazidime Intensive Phase Therapy", "type": "Drug_Response", "description": "First-line bactericidal acute intensive intravenous therapy (2 g IV every 6–8 hours or 50 mg/kg up to 2 g Q8H for ≥10–14 days) reducing acute mortality by 50%, characteristically accompanied by a slow median fever clearance of 9–10 days."}, {"name": "Intravenous Meropenem Intensive Phase Therapy", "type": "Drug_Response", "description": "Preferred carbapenem regimen (1–2 g IV every 8 hours) for critically ill patients presenting with septic shock, deep undrained collections, or neurological melioidosis, conferring rapid bactericidal activity and lower endotoxin release than ceftazidime."}, {"name": "Oral Trimethoprim-Sulfamethoxazole Eradication Phase Therapy", "type": "Drug_Response", "description": "Definitive oral eradication therapy (TMP-SMX 320/1600 mg BID with oral folic acid for a minimum of 3 to 6 months) essential to eradicate intracellular persisters and prevent recurrence and fatal late relapse ('Vietnam time-bomb' reactivation)."}, {"name": "Empirical Fluoroquinolone and Macrolide Treatment Failure", "type": "Drug_Response", "description": "Ineffective clinical response to fluoroquinolones (ciprofloxacin, ofloxacin) or macrolides (azithromycin), which demonstrate unacceptable failure and relapse rates (up to 29%) in clinical trials."}], "relationships": [{"source": "Melioidosis", "target": "Burkholderia pseudomallei", "keywords": "HAS_PATHOGEN, causative agent, microbiology", "description": "[HAS_PATHOGEN] Melioidosis is caused by Burkholderia pseudomallei, an aerobic, motile, oxidase-positive Gram-negative saprophytic bacillus with bipolar 'safety-pin' staining that persists in tropical soil and surface water."}, {"source": "Melioidosis", "target": "Wet Soil and Surface Water Inoculation During Monsoons", "keywords": "EXPOSURE_TO, environmental risk, transmission", "description": "[EXPOSURE_TO] Acquired primarily via percutaneous inoculation through broken skin or minor abrasions after direct occupational or recreational exposure to contaminated wet soil, mud, or surface water during tropical monsoons (e.g., rice farming, gardening, walking barefoot)."}, {"source": "Melioidosis", "target": "Aerosol Inhalation During Tropical Storms and Cyclones", "keywords": "TRANSMITTED_BY, environmental inoculation, aerosol", "description": "[TRANSMITTED_BY] Acquired via inhalation of aerosolized Burkholderia pseudomallei particles and contaminated water droplets during high-humidity monsoons, cyclones, typhoons, and near-drowning events, leading to hyperacute severe pneumonia."}, {"source": "Melioidosis", "target": "Type 2 Diabetes Mellitus Host Predisposition", "keywords": "EXPOSURE_TO, host predisposition, diabetes", "description": "[EXPOSURE_TO] Type 2 diabetes mellitus is the single strongest host susceptibility factor, present in 40–60% of all melioidosis patients due to diabetic neutrophil oxidative burst defects and impaired intracellular bacterial killing."}, {"source": "Melioidosis", "target": "Hazardous Alcohol Consumption Host Predisposition", "keywords": "EXPOSURE_TO, host predisposition, alcohol", "description": "[EXPOSURE_TO] Hazardous alcohol use is present in 15–30% of patients, impairing alveolar macrophage bactericidal function and predisposing to severe bacteremic dissemination and septic shock."}, {"source": "Melioidosis", "target": "Chronic Kidney Disease Host Predisposition", "keywords": "EXPOSURE_TO, host predisposition, renal disease", "description": "[EXPOSURE_TO] Underlying chronic renal disease is present in 10–25% of cases, conferring an independent elevated risk for severe bacteremic melioidosis, acute kidney injury, and high mortality."}, {"source": "Melioidosis", "target": "Endemic Tropical Geographic Exposure", "keywords": "EXPOSURE_TO, geographic risk, endemicity", "description": "[EXPOSURE_TO] Exposure requires travel or residence in tropical endemic areas, predominantly Northern Australia, Southeast Asia (Thailand, Vietnam, Cambodia, Laos, Malaysia, Singapore), South Asia (India, Sri Lanka), the tropical Americas, or the US Gulf Coast."}, {"source": "Melioidosis", "target": "Honeycomb Swiss-Cheese Splenic Microabscesses", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in", "description": "[HAS_PATHOGNOMONIC_HALLMARK] The presence of multiple small, discrete coalescing microabscesses throughout the splenic and hepatic parenchyma creating a classic 'honeycomb' or 'Swiss-cheese' appearance on abdominal ultrasound or CT is a pathognomonic hallmark strongly ruling in melioidosis."}, {"source": "Melioidosis", "target": "Suppurative Parotitis in Pediatric Patients", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Acute painful unilateral suppurative parotitis and preauricular abscess in an endemic child (accounting for up to 30% of pediatric melioidosis cases in Thailand and Cambodia) is a cardinal clinical hallmark."}, {"source": "Melioidosis", "target": "Prostatic Abscess in Adult Males", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Suppurative prostatic abscess presenting with perineal/pelvic pain, dysuria, hesitancy, and acute urinary retention in adult febrile males in endemic regions occurs in 18–30% of male melioidosis patients."}, {"source": "Melioidosis", "target": "Acute Necrotizing Cavitary Pneumonia", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Acute onset of high spiking fever, profuse drenching night sweats, productive purulent cough, pleuritic chest pain, and hemoptysis with rapid pulmonary cavitation represents the cardinal presentation in approximately 50% of melioidosis patients."}, {"source": "Melioidosis", "target": "Neurological Melioidosis with Brainstem Encephalitis", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Neuromelioidosis classically presents with rhombencephalitis (brainstem encephalitis), unilateral cranial nerve palsies (especially peripheral CN VII palsy), flaccid tetraparesis, or cerebellar ataxia, often despite normal initial head CT imaging."}, {"source": "Melioidosis", "target": "Marked Neutrophilic Leukocytosis with Toxic Granulation", "keywords": "EXHIBITS_LAB_PATTERN, admission lab, hematology", "description": "[EXHIBITS_LAB_PATTERN] Admission complete blood count demonstrates marked neutrophilic leukocytosis with total WBC 15,000–35,000/µL, prominent toxic left shift (bandemia >15%), and toxic granulation (or severe leukopenia <3,000/µL in fulminant septic shock portending extreme mortality)."}, {"source": "Melioidosis", "target": "Massive Acute-Phase Reactive Protein Elevation", "keywords": "EXHIBITS_LAB_PATTERN, admission lab, inflammatory markers", "description": "[EXHIBITS_LAB_PATTERN] Admission laboratory profile exhibits a massive acute-phase systemic response with C-reactive protein (CRP) >150–300 mg/L, ESR >80 mm/h, and procalcitonin markedly elevated (>2–10 ng/mL)."}, {"source": "Melioidosis", "target": "Severe Admission Hyperglycemia and Unmasked Diabetes", "keywords": "EXHIBITS_LAB_PATTERN, admission lab, biochemistry", "description": "[EXHIBITS_LAB_PATTERN] Admission metabolic panel frequently reveals severe hyperglycemia (>200–400 mg/dL) and elevated glycated hemoglobin (HbA1c >9–12%), unmasking previously undiagnosed or poorly controlled Type 2 diabetes mellitus at triage."}, {"source": "Melioidosis", "target": "Upper Lobe Infiltrates Without Mediastinal Lymphadenopathy on Chest Radiography", "keywords": "EXHIBITS_LAB_PATTERN, admission lab, imaging hallmark", "description": "[EXHIBITS_LAB_PATTERN] Admission chest radiograph demonstrates upper lobe alveolar consolidation, rapid progression to thin- or thick-walled cavitary lesions, and absence of mediastinal or hilar lymphadenopathy (which distinguishes it from primary tuberculosis)."}, {"source": "Melioidosis", "target": "Bedside Ultrasound Hypoechoic Splenic and Prostatic Fluid Collections", "keywords": "EXHIBITS_LAB_PATTERN, admission lab, POCUS", "description": "[EXHIBITS_LAB_PATTERN] Bedside POCUS ultrasound detects multiple discrete round hypoechoic parenchymal microabscesses in the spleen and liver, and hypoechoic fluid collections in the prostate gland in febrile septic patients."}, {"source": "Melioidosis", "target": "Complete Absence of Tropical Endemic Exposure or Travel", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary", "description": "[RULED_OUT_BY] Complete absence of lifetime residence in or travel to known tropical endemic areas (Southeast Asia, Northern Australia, South Asia, Latin America, US Gulf Coast) virtually rules out melioidosis in non-laboratory settings."}, {"source": "Melioidosis", "target": "Immunocompetent Host with Zero Environmental Soil or Water Contact", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary", "description": "[RULED_OUT_BY] A healthy host without underlying diabetes, renal disease, or alcohol excess who has had zero exposure to outdoor soil, mud, surface water, or tropical storm conditions is extraordinarily unlikely to have melioidosis."}, {"source": "Melioidosis", "target": "Normal Inflammatory Markers and Absence of Leukocytosis", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary", "description": "[RULED_OUT_BY] Normal admission inflammatory markers (CRP <10 mg/L, normal procalcitonin) and normal white blood cell count without bandemia effectively excludes acute systemic or invasive melioidosis."}, {"source": "Melioidosis", "target": "Rapid Clinical Defervescence on Standard Ceftriaxone or Ampicillin", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary", "description": "[RULED_OUT_BY] Prompt clinical defervescence and symptom resolution within 48–72 hours of empirical treatment with ampicillin, ceftriaxone, or cefotaxime definitively excludes Burkholderia pseudomallei due to its uniform intrinsic beta-lactam resistance."}, {"source": "Melioidosis", "target": "Chronic Indolent Progression Over Months with Mediastinal Lymphadenopathy", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary", "description": "[RULED_OUT_BY] An indolent constitutional course progressing over multiple months accompanied by prominent hilar and mediastinal lymphadenopathy and normal procalcitonin rules out acute pulmonary melioidosis and indicates primary mycobacterial infection."}, {"source": "Melioidosis", "target": "Pulmonary Tuberculosis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis", "description": "[DIFFERENTIATED_FROM] Pulmonary tuberculosis closely mimics the upper-lobe cavitary lesions and night sweats of melioidosis, but TB runs an insidious multi-week-to-month course, exhibits normal to mildly elevated WBC, prominent mediastinal lymphadenopathy on chest imaging, and acid-fast bacilli on sputum smear; acute pulmonary melioidosis evolves over days with high neutrophilic leukocytosis (WBC >15,000/µL), massively elevated CRP (>150 mg/L) and procalcitonin, absence of mediastinal adenopathy, and frequent concurrent splenic/prostatic microabscesses."}, {"source": "Melioidosis", "target": "Community-Acquired Bacterial Pneumonia", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis", "description": "[DIFFERENTIATED_FROM] Community-acquired bacterial pneumonia (Streptococcus pneumoniae, Klebsiella pneumoniae) presents with acute lobar consolidation but responds rapidly within 48–72 hours to empirical ampicillin, ceftriaxone, or respiratory fluoroquinolones; melioidosis is intrinsically resistant to ceftriaxone and penicillins, exhibits a characteristically prolonged fever clearance time (9–10 days on ceftazidime), and frequently presents with multi-organ microabscesses (spleen, liver, prostate) in diabetic hosts."}, {"source": "Melioidosis", "target": "Leptospirosis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis", "description": "[DIFFERENTIATED_FROM] Leptospirosis shares occupational exposure to wet mud and floodwater, but is distinguished at admission triage by pathognomonic bilateral non-purulent conjunctival suffusion, severe gastrocnemius calf tenderness, direct hyperbilirubinemia with disproportionately mild transaminitis, and rapid defervescence on IV penicillin or doxycycline; it does not produce the multi-organ honeycomb microabscesses (spleen, prostate, parotid) characteristic of melioidosis."}, {"source": "Melioidosis", "target": "Scrub Typhus", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis", "description": "[DIFFERENTIATED_FROM] Scrub typhus (Orientia tsutsugamushi) presents with acute tropical fever following outdoor environmental exposure, but is distinguished at admission triage by a pathognomonic necrotic cutaneous eschar, regional lymphadenopathy, frequent sensorineural deafness, and rapid defervescence within 24–48 hours of oral doxycycline; it lacks the necrotizing cavitary pneumonia and deep visceral microabscesses of melioidosis."}, {"source": "Melioidosis", "target": "Intrinsic Resistance to Ceftriaxone Penicillins and Aminoglycosides", "keywords": "INTRINSICALLY_RESISTANT_TO, antibiotic failure, intrinsic resistance", "description": "[INTRINSICALLY_RESISTANT_TO] Burkholderia pseudomallei possesses broad, intrinsic multidrug resistance to penicillins, ampicillin, 1st- and 2nd-generation cephalosporins, 3rd-generation cephalosporins (ceftriaxone, cefotaxime), macrolides, aminoglycosides, and colistin; standard empirical sepsis regimens fail and cause clinical progression."}, {"source": "Melioidosis", "target": "Intravenous Ceftazidime Intensive Phase Therapy", "keywords": "RESPONDS_TO, definitive therapy, intensive phase", "description": "[RESPONDS_TO] High-dose intravenous ceftazidime (2 g IV every 6–8 hours or 50 mg/kg up to 2 g Q8H for ≥10–14 days) is the standard first-line bactericidal acute intensive regimen; median time to defervescence is characteristically prolonged (9–10 days), and persistence of fever during week 1 does not indicate treatment failure."}, {"source": "Melioidosis", "target": "Intravenous Meropenem Intensive Phase Therapy", "keywords": "RESPONDS_TO, definitive therapy, intensive phase", "description": "[RESPONDS_TO] Intravenous meropenem (1–2 g IV every 8 hours) is the preferred carbapenem for critically ill patients presenting with septic shock, deep undrained collections, or neurological melioidosis, providing rapid bactericidal clearance and reduced endotoxin release compared to ceftazidime."}, {"source": "Melioidosis", "target": "Oral Trimethoprim-Sulfamethoxazole Eradication Phase Therapy", "keywords": "RESPONDS_TO, definitive therapy, eradication phase", "description": "[RESPONDS_TO] Oral co-trimoxazole (TMP-SMX 320/1600 mg twice daily with oral folic acid for a minimum of 3 to 6 months) is the mandatory eradication phase therapy to eliminate intracellular bacterial persisters and prevent late relapse ('Vietnam time-bomb' phenomenon)."}, {"source": "Melioidosis", "target": "Empirical Fluoroquinolone and Macrolide Treatment Failure", "keywords": "INTRINSICALLY_RESISTANT_TO, antibiotic failure, intrinsic resistance", "description": "[INTRINSICALLY_RESISTANT_TO] Empirical or eradication regimens utilizing fluoroquinolones (ciprofloxacin, ofloxacin) or macrolides (azithromycin) fail clinically, with unacceptably high failure and bacteriological relapse rates (~29%), and should not be used."}]}}
{"case_id": "mycetoma", "disease": "Mycetoma", "extraction": {"entities": [{"name": "Mycetoma", "type": "Disease", "description": "A chronic, progressively destructive, indolent granulomatous inflammatory disease of subcutaneous tissues, skin, and underlying bone, endemic within the tropical and subtropical Mycetoma Belt, caused by true filamentous fungi (eumycetoma) or aerobic actinomycete bacteria (actinomycetoma)."}, {"name": "Minor Percutaneous Traumatic Inoculation via Acacia Thorns While Walking Barefoot", "type": "Vector_Exposure", "description": "Direct mechanical inoculation of soil-dwelling organisms through broken skin via penetrating trauma from acacia tree thorns (Acacia nilotica), dry plant splinters, wood chips, or sharp stones in individuals walking barefoot."}, {"name": "Arid and Semi-Arid Geographic Endemicity in the Mycetoma Belt", "type": "Vector_Exposure", "description": "Residence or prolonged travel within the hyperendemic tropical and subtropical 'Mycetoma Belt' between latitudes 15°S and 30°N (notably Sudan, Mexico, India, Mauritania, Somalia, Senegal, Chad, Ethiopia, and Yemen) characterized by low rainfall and thorny scrub vegetation."}, {"name": "High-Risk Agricultural or Pastoralist Occupation Without Protective Footwear", "type": "Vector_Exposure", "description": "Employment in rural subsistence agriculture, field labor, or nomadic livestock pastoralism without protective footwear or gloves, conferring high occupational risk of percutaneous micro-trauma and soil contact."}, {"name": "Carrying Contaminated Firewood, Crops, or Soil-Laden Sacks on Back or Shoulders", "type": "Vector_Exposure", "description": "Manual carrying of thorny acacia branches, dry firewood, agricultural crops, or soil-laden sacks directly on the shoulders or back, resulting in upper trunk and extra-pedal inoculation."}, {"name": "Madurella mycetomatis", "type": "Pathogen", "description": "The predominant causative fungal agent of black-grain eumycetoma globally (>70% of eumycetoma cases), forming dark melanized cement-embedded grains with thick-walled hyphae and chlamydoconidia, hyperendemic in Sudan and Africa."}, {"name": "Trematosphaeria grisea", "type": "Pathogen", "description": "A dematiaceous filamentous fungal pathogen (formerly Madurella grisea) causing black-grain eumycetoma with tubular or hollow pigmented grains."}, {"name": "Falciformispora senegalensis", "type": "Pathogen", "description": "An ascomycete fungus (formerly Leptosphaeria senegalensis) causing black-grain eumycetoma characterized by dark granules containing large vesicular swollen cells."}, {"name": "Scedosporium boydii", "type": "Pathogen", "description": "A hyaline filamentous mold belonging to the Pseudallescheria boydii species complex, causing white-to-yellow grain eumycetoma with slender septate hyphae."}, {"name": "Acremonium falciforme", "type": "Pathogen", "description": "A hyaline filamentous fungus causing white-to-yellowish grain eumycetoma with delicate hyphae."}, {"name": "Nocardia brasiliensis", "type": "Pathogen", "description": "An aerobic, branching, partially acid-fast Gram-positive actinomycete bacterium producing small white-to-yellow grains; the leading cause of actinomycetoma in Mexico and Central/South America."}, {"name": "Actinomadura madurae", "type": "Pathogen", "description": "An aerobic actinomycete bacterium causing actinomycetoma characterized by large, soft white, cream-colored, or yellowish-to-pink grains, distributed worldwide."}, {"name": "Streptomyces somaliensis", "type": "Pathogen", "description": "An aerobic actinomycete bacterium causing yellow-to-brown grain actinomycetoma characterized by dense, hard, cement-bound grains, prevalent in arid regions of Sudan and the Horn of Africa."}, {"name": "Actinomadura pelletieri", "type": "Pathogen", "description": "An aerobic actinomycete bacterium producing distinctive small, hard, brilliant crimson or bright red grains and causing aggressive, rapidly destructive osteolytic actinomycetoma."}, {"name": "Nocardia asteroides", "type": "Pathogen", "description": "An aerobic, partially acid-fast branching Gram-positive bacterium capable of producing white-to-yellowish microcolonies and actinomycetoma."}, {"name": "Classic Triad of Painless Subcutaneous Mass Multiple Sinus Tracts and Grain Discharge", "type": "Cardinal_Sign", "description": "The pathognomonic clinical hallmark triad of mycetoma consisting of a firm indolent subcutaneous mass (tumefaction), multiple interconnected cutaneous sinus openings, and active discharge containing macroscopic pigmented grains."}, {"name": "Firm Indurated Painless Subcutaneous Tumefaction with Deep Fascial Fixation", "type": "Cardinal_Sign", "description": "A woody, non-tender, slow-growing subcutaneous nodule or indurated mass bound to underlying muscle fascial planes and deep structures, typically on the foot ('Madura foot') or lower extremity."}, {"name": "Multiple Elevated Crater-Like Interconnected Cutaneous Sinus Tracts", "type": "Cardinal_Sign", "description": "Multiple raised, crateriform cutaneous fistulous openings adhering to deep intermuscular fascial planes and draining serosanguinous, purulent, or oily fluid."}, {"name": "Macroscopic Black Grains Discharging from Cutaneous Sinuses", "type": "Cardinal_Sign", "description": "Visible, discrete, hard pigmented microcolonies (0.5 to 2 mm) ranging from dark brown to coal-black, pathognomonic of fungal eumycetoma caused by Madurella species or Trematosphaeria grisea."}, {"name": "Macroscopic Bright Red Grains Discharging from Cutaneous Sinuses", "type": "Cardinal_Sign", "description": "Visible, small, hard, brilliant deep red or garnet-colored microcolonies (0.3 to 0.5 mm), pathognomonic of bacterial actinomycetoma caused by Actinomadura pelletieri."}, {"name": "Macroscopic White to Yellow Grains Discharging from Cutaneous Sinuses", "type": "Cardinal_Sign", "description": "Visible soft or firm pale yellowish-white microcolonies (0.5 to 2 mm) observed in discharge, indicative of either bacterial actinomycetoma (Actinomadura madurae, Nocardia brasiliensis) or fungal eumycetoma (Scedosporium boydii)."}, {"name": "Striking Absence of Pain and Fever Despite Massive Deforming Tissue Swelling", "type": "Cardinal_Sign", "description": "Indolent clinical presentation in >85% of patients with normal body temperature and absent local tenderness despite massive limb deformity and extensive osteolysis, mediated by anesthetic fungal/bacterial metabolic products."}, {"name": "Direct Microscopic Examination of Grains via 10-20% KOH Mount and Gram Stain", "type": "Admission_Lab_Imaging", "description": "Direct bedside microscopic examination of crushed grain discharge revealing either thick, septate, branched fungal hyphae (2-6 um) with chlamydoconidia in dark cement matrix (eumycetoma) or delicate Gram-positive branching bacterial filaments (<1 um) and cocci (actinomycetoma)."}, {"name": "Modified Kinyoun Acid-Fast Staining Demonstrating Partially Acid-Fast Branching Filaments", "type": "Admission_Lab_Imaging", "description": "Direct cytological acid-fast stain on crushed pale grains demonstrating partially acid-fast branching filaments, confirming Nocardia species infection."}, {"name": "Dot-in-Circle Sign on T2-Weighted and Contrast-Enhanced MRI", "type": "Admission_Lab_Imaging", "description": "Pathognomonic magnetic resonance imaging feature on T2-weighted and contrast sequences featuring round, high-signal granulomatous spheres containing a central or eccentric low-signal punctate dot representing the grain."}, {"name": "Point-of-Care Ultrasound Demonstrating Thick-Walled Hypoechoic Granulomas with Hyper-Reflective Central Echoes", "type": "Admission_Lab_Imaging", "description": "Musculoskeletal ultrasound showing multiple thick-walled hypoechoic cavities containing sharp hyper-reflective central echoes with acoustic shadowing corresponding to fungal grains in eumycetoma."}, {"name": "Plain Radiography Showing Multiple Punched-Out Osteolytic Cavities with Preserved Joint Spaces", "type": "Admission_Lab_Imaging", "description": "Plain limb radiograph demonstrating extensive soft-tissue lobulation, periosteal cortical reaction, and round punched-out osteolytic bone cavities ('geodes' or 'moth-eaten' appearance) characteristically preserving articular joint spaces until end-stage destruction."}, {"name": "Chronic Inflammatory Blood Profile with Markedly Elevated ESR and Normal White Blood Cell Count", "type": "Admission_Lab_Imaging", "description": "Admission laboratory evaluation demonstrating moderately to markedly elevated erythrocyte sedimentation rate (40-80 mm/h) in the presence of normal leukocyte counts and absent acute leukocytosis, indicative of chronic indolent granulomatous inflammation."}, {"name": "Acute Rapidly Progressive Inflammatory Swelling Developing Within Less Than 4 Weeks", "type": "Exclusion_Criterion", "description": "Sudden onset of painful, hot, erythematous limb swelling evolving within days to under 4 weeks rules out uncomplicated primary mycetoma, which characteristically evolves over months to years (mean 2-5 years)."}, {"name": "Complete Absence of Discharging Macroscopic Grains or Granules from Active Sinuses", "type": "Exclusion_Criterion", "description": "Exudate or aspirate from chronic draining sinuses that consistently lacks macroscopic or microscopic colored grains or microcolonies rules out active typical mycetoma."}, {"name": "Rapid Systemic Pyogenic Sepsis with High Fever and Prominent Neutrophilic Leukocytosis at Initial Presentation", "type": "Exclusion_Criterion", "description": "Acute presentation characterized by spiking fevers, chills, toxic hemodynamics, and high neutrophilic leukocytosis at initial presentation rules out uncomplicated mycetoma, pointing toward acute pyogenic bacterial cellulitis or acute osteomyelitis."}, {"name": "Presence of Pigmented Medlar Bodies Copper Pennies on Cytological Examination", "type": "Exclusion_Criterion", "description": "Cytological or histological visualization of thick-walled, golden-brown muriform cells ('medlar bodies' or 'copper pennies') on microscopic scraping rules out mycetoma and establishes the diagnosis of chromoblastomycosis."}, {"name": "Chronic Pyogenic Bacterial Osteomyelitis", "type": "Disease", "description": "A pyogenic bacterial bone infection (predominantly Staphylococcus aureus) characterized by severe localized bone pain, fevers, acute leukocytosis, and purulent sinus discharge lacking discrete colored grains."}, {"name": "Osteosarcoma", "type": "Disease", "description": "A primary malignant bone tumor presenting with a rapidly growing, painful extremity mass and aggressive cortical bone destruction with periosteal reaction, but lacking cutaneous sinuses, fistulae, or grain discharge."}, {"name": "Chromoblastomycosis", "type": "Disease", "description": "A chronic subcutaneous fungal infection presenting as superficial, cauliflower-like, verrucous hyperkeratotic plaques with surface black dots and pathognomonic medlar bodies, lacking deep bone geodes, deep sinus tracts, or grain discharge."}, {"name": "Podoconiosis", "type": "Disease", "description": "An endemic non-filarial geochemical elephantiasis caused by barefoot exposure to volcanic red clay soils, presenting as ascending bilateral non-pitting lymphedema, hyperkeratosis, and mossy papillomas without sinus tracts, bone cavities, or grains."}, {"name": "Lymphatic Filariasis", "type": "Disease", "description": "A mosquito-borne parasitic nematode disease (Wuchereria bancrofti) presenting with hydrocele and chronic ascending lymphatic elephantiasis, lacking localized crater-like sinus tracts, bone geodes, or grain discharge."}, {"name": "Kaposi Sarcoma", "type": "Disease", "description": "A vascular neoplasm associated with HHV-8 causing multiple violaceous cutaneous plaques, nodules, and lymphedema of the lower extremities, lacking sinus tracts, osteolytic cavitations, and grain discharge."}, {"name": "The Welsh Regimen of Amikacin Cycles Combined with Trimethoprim-Sulfamethoxazole", "type": "Drug_Response", "description": "Chemotherapy protocol for actinomycetoma consisting of pulse amikacin (15 mg/kg/day for 3-week cycles) combined with oral trimethoprim-sulfamethoxazole (TMP-SMX 800/160 mg twice daily for 6-12 months), achieving medical cure in >90% of cases without surgery."}, {"name": "Oral Itraconazole Chemotherapy Combined with Wide Surgical Excision", "type": "Drug_Response", "description": "Standard curative protocol for eumycetoma consisting of pre-operative oral itraconazole (200 mg twice daily for 6-12 months) to encapsulate the lesion, followed by wide local surgical excision, and post-operative continuation of itraconazole."}, {"name": "Oral Voriconazole Second-Line Chemotherapy", "type": "Drug_Response", "description": "Second-line expanded-spectrum oral triazole antifungal therapy (200 mg twice daily) effective in refractory eumycetoma or cases caused by Scedosporium boydii."}, {"name": "Primary Surgical Excision Alone Without Antifungal Coverage in Eumycetoma", "type": "Drug_Response", "description": "Incomplete or primary surgical excision performed without prolonged preoperative and postoperative antifungal coverage, resulting in catastrophic high rates of local recurrence and deep fascial dissemination."}, {"name": "Standard Antibacterial Therapy Administered for Fungal Eumycetoma", "type": "Drug_Response", "description": "Administration of antibacterial agents (such as the Welsh regimen or beta-lactam antibiotics) for fungal eumycetoma, which yields zero therapeutic efficacy and leads to uncontrolled disease progression and limb loss."}, {"name": "Antifungal Azole Monotherapy Administered for Bacterial Actinomycetoma", "type": "Drug_Response", "description": "Administration of antifungal azole agents (itraconazole, ketoconazole, voriconazole) for bacterial actinomycetoma, which has no antibacterial activity and results in treatment failure."}], "relationships": [{"source": "Mycetoma", "target": "Minor Percutaneous Traumatic Inoculation via Acacia Thorns While Walking Barefoot", "keywords": "percutaneous inoculation, trauma, acacia thorns, barefoot walking, transmission", "description": "[TRANSMITTED_BY] Mycetoma is acquired through percutaneous traumatic inoculation of soil-dwelling fungi or bacteria via acacia tree thorns, plant splinters, or sharp stones in barefoot individuals."}, {"source": "Mycetoma", "target": "Arid and Semi-Arid Geographic Endemicity in the Mycetoma Belt", "keywords": "geographic distribution, mycetoma belt, arid climate, endemicity", "description": "[EXPOSURE_TO] Mycetoma hyperendemicity is concentrated within the arid and semi-arid 'Mycetoma Belt' between latitudes 15°S and 30°N with sparse rainfall and thorny scrub vegetation."}, {"source": "Mycetoma", "target": "High-Risk Agricultural or Pastoralist Occupation Without Protective Footwear", "keywords": "occupational exposure, farmers, herdsmen, agricultural labor", "description": "[EXPOSURE_TO] Mycetoma predominantly affects barefoot rural agricultural workers, manual field laborers, and nomadic pastoralists."}, {"source": "Mycetoma", "target": "Carrying Contaminated Firewood, Crops, or Soil-Laden Sacks on Back or Shoulders", "keywords": "occupational carrying, firewood trauma, upper trunk mycetoma, shoulder lesion", "description": "[EXPOSURE_TO] Carrying thorny firewood, dry brush, or soil-contaminated crop sacks on the shoulders or back provides a direct percutaneous exposure route resulting in extra-pedal trunk mycetoma."}, {"source": "Mycetoma", "target": "Madurella mycetomatis", "keywords": "fungal pathogen, eumycetoma, black grains, Sudan", "description": "[HAS_PATHOGEN] Madurella mycetomatis is the primary causative fungal pathogen of black-grain eumycetoma, accounting for more than 70% of eumycetoma cases globally."}, {"source": "Mycetoma", "target": "Trematosphaeria grisea", "keywords": "dematiaceous fungus, eumycetoma, black grains", "description": "[HAS_PATHOGEN] Trematosphaeria grisea is an etiologic dematiaceous fungus causing black-grain eumycetoma."}, {"source": "Mycetoma", "target": "Falciformispora senegalensis", "keywords": "fungal pathogen, ascomycete, black grains, eumycetoma", "description": "[HAS_PATHOGEN] Falciformispora senegalensis is an ascomycete fungal pathogen responsible for black-grain eumycetoma."}, {"source": "Mycetoma", "target": "Scedosporium boydii", "keywords": "hyaline mold, white grains, yellow grains, eumycetoma", "description": "[HAS_PATHOGEN] Scedosporium boydii is a filamentous hyaline fungal mold that causes pale white-to-yellow grain eumycetoma."}, {"source": "Mycetoma", "target": "Acremonium falciforme", "keywords": "fungal pathogen, pale grains, eumycetoma", "description": "[HAS_PATHOGEN] Acremonium falciforme is an etiologic hyaline fungal species that causes white-to-yellow grain eumycetoma."}, {"source": "Mycetoma", "target": "Nocardia brasiliensis", "keywords": "actinomycete, bacterial pathogen, actinomycetoma, Mexico", "description": "[HAS_PATHOGEN] Nocardia brasiliensis is an aerobic, partially acid-fast actinomycete bacterium causing actinomycetoma with small white-to-yellow grains, highly prevalent in the Americas."}, {"source": "Mycetoma", "target": "Actinomadura madurae", "keywords": "actinomycete, bacterial pathogen, actinomycetoma, pale grains", "description": "[HAS_PATHOGEN] Actinomadura madurae is an aerobic branching actinomycete bacterium causing actinomycetoma characterized by large white-to-yellow or pink grains."}, {"source": "Mycetoma", "target": "Streptomyces somaliensis", "keywords": "actinomycete, bacterial pathogen, yellow grains, actinomycetoma", "description": "[HAS_PATHOGEN] Streptomyces somaliensis is an aerobic actinomycete bacterium causing yellow-to-brown grain actinomycetoma in arid regions."}, {"source": "Mycetoma", "target": "Actinomadura pelletieri", "keywords": "actinomycete, red grains, aggressive actinomycetoma", "description": "[HAS_PATHOGEN] Actinomadura pelletieri is an aerobic actinomycete bacterium producing pathognomonic small, bright red grains and aggressive osteolytic lesions."}, {"source": "Mycetoma", "target": "Nocardia asteroides", "keywords": "actinomycete, bacterial pathogen, actinomycetoma", "description": "[HAS_PATHOGEN] Nocardia asteroides is an aerobic branching bacterium recognized as a causative agent of actinomycetoma."}, {"source": "Mycetoma", "target": "Classic Triad of Painless Subcutaneous Mass Multiple Sinus Tracts and Grain Discharge", "keywords": "pathognomonic hallmark, cardinal triad, tumefaction, sinuses, grain discharge", "description": "[HAS_PATHOGNOMONIC_HALLMARK] The physical triad of painless subcutaneous tumefaction, multiple discharging cutaneous sinuses, and macroscopic grains is the cardinal clinical hallmark of mycetoma."}, {"source": "Mycetoma", "target": "Firm Indurated Painless Subcutaneous Tumefaction with Deep Fascial Fixation", "keywords": "tumefaction, nodule, woody induration, madura foot", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Mycetoma presents as an indolent, woody, firm, non-tender subcutaneous mass bound to deep fascial planes."}, {"source": "Mycetoma", "target": "Multiple Elevated Crater-Like Interconnected Cutaneous Sinus Tracts", "keywords": "sinus tracts, fistulae, draining openings, fascial planes", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Mycetoma develops multiple crater-like discharging sinus tracts interconnected across intermuscular fascial planes."}, {"source": "Mycetoma", "target": "Macroscopic Black Grains Discharging from Cutaneous Sinuses", "keywords": "black grains, eumycetoma, pathognomonic sign, Madurella", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Discharging macroscopic black grains (0.5 to 2 mm) are pathognomonic of fungal eumycetoma, predominantly caused by Madurella mycetomatis."}, {"source": "Mycetoma", "target": "Macroscopic Bright Red Grains Discharging from Cutaneous Sinuses", "keywords": "red grains, Actinomadura pelletieri, pathognomonic sign, actinomycetoma", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Discharging macroscopic bright red grains are pathognomonic of bacterial actinomycetoma caused by Actinomadura pelletieri."}, {"source": "Mycetoma", "target": "Macroscopic White to Yellow Grains Discharging from Cutaneous Sinuses", "keywords": "pale grains, yellow grains, actinomycetoma, Scedosporium, Nocardia", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Discharging pale white-to-yellow grains indicate either bacterial actinomycetoma (Actinomadura madurae, Nocardia brasiliensis) or fungal eumycetoma (Scedosporium boydii)."}, {"source": "Mycetoma", "target": "Striking Absence of Pain and Fever Despite Massive Deforming Tissue Swelling", "keywords": "indolent swelling, afebrile presentation, lack of pain, deforming mass", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Mycetoma lesions remain non-tender and patients remain afebrile in >85% of cases despite grotesque limb deformity and bone invasion."}, {"source": "Mycetoma", "target": "Direct Microscopic Examination of Grains via 10-20% KOH Mount and Gram Stain", "keywords": "direct microscopy, KOH mount, Gram stain, fungal hyphae, bacterial filaments", "description": "[EXHIBITS_LAB_PATTERN] Direct grain cytology rapidly differentiates broad branched septate fungal hyphae (eumycetoma) from delicate Gram-positive branching bacterial filaments (actinomycetoma)."}, {"source": "Mycetoma", "target": "Modified Kinyoun Acid-Fast Staining Demonstrating Partially Acid-Fast Branching Filaments", "keywords": "modified Kinyoun, acid-fast stain, Nocardia identification", "description": "[EXHIBITS_LAB_PATTERN] Modified Kinyoun acid-fast staining identifies delicate partially acid-fast branching bacterial filaments diagnostic of Nocardia species."}, {"source": "Mycetoma", "target": "Dot-in-Circle Sign on T2-Weighted and Contrast-Enhanced MRI", "keywords": "MRI, dot-in-circle sign, pathognomonic imaging, granuloma", "description": "[EXHIBITS_LAB_PATTERN] Magnetic resonance imaging demonstrates the pathognomonic dot-in-circle sign on T2-weighted scans, showing high-signal granulomatous spheres surrounding low-signal grain dots."}, {"source": "Mycetoma", "target": "Point-of-Care Ultrasound Demonstrating Thick-Walled Hypoechoic Granulomas with Hyper-Reflective Central Echoes", "keywords": "ultrasound, POCUS, hyper-reflective echoes, acoustic shadowing, grains", "description": "[EXHIBITS_LAB_PATTERN] Point-of-care ultrasound demonstrates thick-walled hypoechoic granulomas containing bright central hyper-reflective echoes with acoustic shadowing corresponding to grains."}, {"source": "Mycetoma", "target": "Plain Radiography Showing Multiple Punched-Out Osteolytic Cavities with Preserved Joint Spaces", "keywords": "plain X-ray, osteolytic cavities, geodes, moth-eaten bone, joint preservation", "description": "[EXHIBITS_LAB_PATTERN] Plain radiography displays soft-tissue swelling, periosteal cortical reaction, and round punched-out osteolytic bone cavities ('geodes') with preserved articular spaces until late disease."}, {"source": "Mycetoma", "target": "Chronic Inflammatory Blood Profile with Markedly Elevated ESR and Normal White Blood Cell Count", "keywords": "elevated ESR, normal WBC, chronic inflammation, absence of leukocytosis", "description": "[EXHIBITS_LAB_PATTERN] Admission laboratory testing reveals moderate-to-severe ESR elevation (40-80 mm/h) with normal total leukocyte counts and absent neutrophilia."}, {"source": "Mycetoma", "target": "Acute Rapidly Progressive Inflammatory Swelling Developing Within Less Than 4 Weeks", "keywords": "acute onset, rapid swelling, exclusion criteria, cellulitis", "description": "[RULED_OUT_BY] Acute localized pain, erythema, and rapid volumetric swelling developing in less than 4 weeks rules out primary mycetoma, which progresses insidiously over months to years."}, {"source": "Mycetoma", "target": "Complete Absence of Discharging Macroscopic Grains or Granules from Active Sinuses", "keywords": "absence of grains, negative exudate, rule out mycetoma", "description": "[RULED_OUT_BY] Persistent absence of macroscopic or microscopic grains upon careful inspection of discharge or deep aspirate rules out active typical mycetoma."}, {"source": "Mycetoma", "target": "Rapid Systemic Pyogenic Sepsis with High Fever and Prominent Neutrophilic Leukocytosis at Initial Presentation", "keywords": "systemic sepsis, high fever, leukocytosis, acute bacterial infection", "description": "[RULED_OUT_BY] Acute presentation with spiking fevers, chills, toxic hemodynamics, and high neutrophilic leukocytosis at initial presentation rules out uncomplicated mycetoma."}, {"source": "Mycetoma", "target": "Presence of Pigmented Medlar Bodies Copper Pennies on Cytological Examination", "keywords": "medlar bodies, copper pennies, muriform cells, chromoblastomycosis exclusion", "description": "[RULED_OUT_BY] Identification of golden-brown muriform cells ('medlar bodies' or 'copper pennies') on direct microscopic scraping rules out mycetoma and confirms chromoblastomycosis."}, {"source": "Mycetoma", "target": "Chronic Pyogenic Bacterial Osteomyelitis", "keywords": "differential diagnosis, osteomyelitis, bone pain, fever, Staphylococcus aureus", "description": "[DIFFERENTIATED_FROM] Chronic pyogenic osteomyelitis presents with severe bone pain, systemic fevers, acute neutrophilic leukocytosis, and sinus discharge without colored grains, unlike indolent, painless mycetoma."}, {"source": "Mycetoma", "target": "Osteosarcoma", "keywords": "differential diagnosis, osteosarcoma, bone neoplasm, periosteal reaction", "description": "[DIFFERENTIATED_FROM] Osteosarcoma causes painful rapidly expanding bone tumefaction and aggressive periosteal reactions without draining sinuses, fistulae, or grain discharge."}, {"source": "Mycetoma", "target": "Chromoblastomycosis", "keywords": "differential diagnosis, chromoblastomycosis, verrucous plaques, medlar bodies", "description": "[DIFFERENTIATED_FROM] Chromoblastomycosis produces superficial, cauliflower-like verrucous plaques with black surface dots and diagnostic medlar bodies, lacking deep sinus tracts, bone cavities, or grain discharge."}, {"source": "Mycetoma", "target": "Podoconiosis", "keywords": "differential diagnosis, podoconiosis, endemic elephantiasis, lymphedema", "description": "[DIFFERENTIATED_FROM] Podoconiosis produces bilateral ascending non-pitting lymphedema and mossy skin changes without cutaneous sinus openings, osteolytic geodes, or grain discharge."}, {"source": "Mycetoma", "target": "Lymphatic Filariasis", "keywords": "differential diagnosis, lymphatic filariasis, elephantiasis, Wuchereria", "description": "[DIFFERENTIATED_FROM] Lymphatic filariasis presents with chronic lymphatic obstruction and elephantiasis without localized discharging sinus tracts, bone destruction, or grain shedding."}, {"source": "Mycetoma", "target": "Kaposi Sarcoma", "keywords": "differential diagnosis, Kaposi sarcoma, violaceous plaques, HHV-8", "description": "[DIFFERENTIATED_FROM] Kaposi sarcoma manifests as violaceous vascular plaques and nodular lesions with lymphedema, lacking deep sinus tracts, bone geodes, and grain discharge."}, {"source": "Mycetoma", "target": "The Welsh Regimen of Amikacin Cycles Combined with Trimethoprim-Sulfamethoxazole", "keywords": "Welsh regimen, amikacin, TMP-SMX, actinomycetoma cure, medical therapy", "description": "[RESPONDS_TO] Actinomycetoma achieves complete cure in >90% of cases using cyclical amikacin combined with oral trimethoprim-sulfamethoxazole (Welsh regimen) without surgical resection."}, {"source": "Mycetoma", "target": "Oral Itraconazole Chemotherapy Combined with Wide Surgical Excision", "keywords": "itraconazole, wide surgical excision, eumycetoma cure, combined therapy", "description": "[RESPONDS_TO] Eumycetoma responds to long-term oral itraconazole (6-12 months) combined with meticulous wide local surgical excision."}, {"source": "Mycetoma", "target": "Oral Voriconazole Second-Line Chemotherapy", "keywords": "voriconazole, second-line antifungal, refractory eumycetoma, Scedosporium", "description": "[RESPONDS_TO] Eumycetoma refractory to itraconazole or caused by Scedosporium boydii responds to extended-spectrum oral voriconazole."}, {"source": "Mycetoma", "target": "Primary Surgical Excision Alone Without Antifungal Coverage in Eumycetoma", "keywords": "surgical failure, local recurrence, unencapsulated resection, eumycetoma", "description": "[INTRINSICALLY_RESISTANT_TO] Fungal eumycetoma is resistant to surgical eradication alone; surgery without prolonged antifungal encapsulation results in rapid local recurrence and tissue dissemination."}, {"source": "Mycetoma", "target": "Standard Antibacterial Therapy Administered for Fungal Eumycetoma", "keywords": "therapeutic failure, antibacterial mismatch, eumycetoma progression", "description": "[INTRINSICALLY_RESISTANT_TO] Fungal eumycetoma is intrinsically resistant to antibacterial regimens, leading to continuous clinical progression and limb loss."}, {"source": "Mycetoma", "target": "Antifungal Azole Monotherapy Administered for Bacterial Actinomycetoma", "keywords": "therapeutic failure, antifungal mismatch, actinomycetoma progression", "description": "[INTRINSICALLY_RESISTANT_TO] Bacterial actinomycetoma is intrinsically resistant to antifungal azole therapy, which lacks antibacterial efficacy and results in complete treatment failure."}]}}
{"case_id": "neurocysticercosis", "disease": "Neurocysticercosis", "extraction": {"entities": [{"name": "Neurocysticercosis", "type": "Disease", "description": "A central nervous system parasitic infection caused by the larval metacestode stage (cysticerci) of the pork tapeworm Taenia solium, representing the leading identifiable cause of acquired adult-onset epilepsy in endemic regions worldwide."}, {"name": "Ingestion of Taenia solium Eggs via Fecal-Oral Route", "type": "Vector_Exposure", "description": "Primary mode of transmission occurring exclusively through ingestion of microscopic Taenia solium eggs excreted in human tapeworm carrier feces via contaminated food, drinking water, unwashed agricultural produce, or fecal-oral autoinfection (consuming pork causes intestinal taeniasis, NOT neurocysticercosis)."}, {"name": "Household Contact with a Human Taenia solium Tapeworm Carrier", "type": "Vector_Exposure", "description": "Close contact, cohabitation, or food preparation by an individual harboring an adult intestinal Taenia solium tapeworm, acting as the direct source of infectious egg shedding."}, {"name": "Residence in or Travel to Taenia solium Endemic Regions", "type": "Vector_Exposure", "description": "Living in or travel history to endemic regions of Latin America, South and Southeast Asia, or sub-Saharan Africa where inadequate sanitation, open human defecation, and free-roaming domestic swine perpetuate the life cycle."}, {"name": "Subsistence Pig Farming with Free-Roaming Swine and Inadequate Sanitation", "type": "Vector_Exposure", "description": "Agro-environmental exposure in rural agricultural communities characterized by free-roaming domestic pigs accessing human feces and lack of sanitary latrines or meat inspection."}, {"name": "Taenia solium Metacestode Larvae (Cysticercus cellulosae)", "type": "Pathogen", "description": "The larval metacestode form of the cyclophyllidean pork tapeworm Taenia solium, establishing fluid-filled cystic structures within the cerebral parenchyma, subarachnoid spaces, or ventricular system after hematogenous oncosphere dissemination."}, {"name": "New-Onset Adult Seizures in Endemic Setting", "type": "Cardinal_Sign", "description": "Adult-onset focal seizures (with or without secondary generalization) or generalized tonic-clonic convulsions occurring in 70-90% of symptomatic parenchymal NCC, provoked either by active colloidal inflammatory edema or chronic epileptogenic gliotic calcified scars."}, {"name": "Cystic Brain Lesion with Pathognomonic Invaginated Scolex on Neuroimaging", "type": "Cardinal_Sign", "description": "Del Brutto absolute pathognomonic neuroimaging hallmark: a well-circumscribed 5-20 mm rounded cystic lesion containing an eccentric, punctate hyperdense or hyperintense mural nodule representing the invaginated scolex ('hole-with-a-dot' sign) on contrast CT or MRI."}, {"name": "Bruns Syndrome Paroxysms from Mobile Intraventricular Cyst", "type": "Cardinal_Sign", "description": "Paroxysmal, catastrophic attacks of severe occipital headache, projectile vomiting, vertiginous ataxia, and episodic syncope triggered by rotational head movements, caused by a mobile 4th ventricular cyst transiently occluding CSF outflow (ball-valve effect)."}, {"name": "Chronic Tension or Throbbing Headaches with Intracranial Hypertension", "type": "Cardinal_Sign", "description": "Persistent severe headaches present in 35-50% of symptomatic patients, frequently associated with intracranial hypertension, nausea, vomiting, or papilledema due to hydrocephalus or basilar arachnoiditis."}, {"name": "Colloidal Vesicular Stage Ring-Enhancing Lesion with Perilesional Edema", "type": "Admission_Lab_Imaging", "description": "Contrast-enhanced CT or MRI finding showing round, ring-enhancing cystic lesions with thick regular capsular enhancement and marked surrounding hypodense vasogenic edema on T2/FLAIR, marking the host inflammatory attack against degenerating larvae."}, {"name": "Punctate Calcified Granulomas on Non-Contrast Brain CT", "type": "Admission_Lab_Imaging", "description": "Non-contrast CT finding demonstrating single or multiple small (2-5 mm), discrete, hyperdense, non-enhancing punctate calcifications without active surrounding edema, representing non-viable mineralized parasitic remnants."}, {"name": "Enzyme-Linked Immunoelectrotransfer Blot (EITB) Glycoprotein Antigen Seropositivity", "type": "Admission_Lab_Imaging", "description": "Gold-standard serological Western blot using lentil lectin-purified Taenia solium glycoprotein antigens (LL-GP), achieving >98% sensitivity and 100% specificity for patients with two or more viable parenchymal or extraparenchymal cysts."}, {"name": "Racemose Subarachnoid Giant Lobulated Cystic Clusters in Basal Cisterns", "type": "Admission_Lab_Imaging", "description": "High-resolution neuroimaging (CISS/FIESTA MRI) revealing multilocular, grape-like budding cystic clusters within basal cisterns or Sylvian fissures without visible scolices, producing chronic basilar arachnoiditis, hydrocephalus, or stroke."}, {"name": "CSF Lymphocytic Pleocytosis with Elevated Protein and Normal Glucose", "type": "Admission_Lab_Imaging", "description": "Cerebrospinal fluid profile in extraparenchymal or meningeal disease demonstrating 10-300 mononuclear cells/μL, elevated protein (50-300 mg/dL), normal to mildly decreased glucose, and elevated opening pressure."}, {"name": "Normal Peripheral Leukocyte Count with Variable Mild Eosinophilia", "type": "Admission_Lab_Imaging", "description": "Standard CBC triage profile in parenchymal NCC characterized by normal total leukocyte count and absence of systemic leukocytosis; mild peripheral eosinophilia (5-10%) occurs in under 20-30% of cases and its absence does not rule out the disease."}, {"name": "Acute Toxic High Spiking Fever with Meningismus and Purulent CSF Pleocytosis", "type": "Exclusion_Criterion", "description": "Acute high spiking fever, systemic toxic delirium, prominent meningeal rigidity, marked neutrophilic leukocytosis, and purulent turbid CSF pleocytosis, which rule out uncomplicated parenchymal neurocysticercosis."}, {"name": "Restricted Diffusion on Diffusion-Weighted MRI (DWI) with Low ADC", "type": "Exclusion_Criterion", "description": "Central hyperintense restricted diffusion on DWI with corresponding hypointensity on apparent diffusion coefficient (ADC) mapping within a ring-enhancing brain mass, which rules out neurocysticercosis and confirms pyogenic bacterial abscess."}, {"name": "Large Multilocular Cystic Lesions with Internal Daughter Cysts and Hydatid Sand", "type": "Exclusion_Criterion", "description": "Massive unilocular or multilocular intracranial cysts exhibiting internal daughter cysts, floating membranes ('water lily' sign), or hydatid sand, which rule out neurocysticercosis and establish cerebral echinococcosis."}, {"name": "Irregular Shaggy Enhancing Infiltrative Cerebral Mass with Extensive Midline Shift", "type": "Exclusion_Criterion", "description": "Thick, irregular, nodular, shaggy enhancing margins with central necrosis, invasive parenchymal neovascularization, and severe midline shift, which rule out benign discrete neurocysticercosis cysts in favor of high-grade glioma or metastatic malignancy."}, {"name": "Absence of Neuroimaging Lesions on Contrast Brain CT and High-Resolution MRI", "type": "Exclusion_Criterion", "description": "Complete absence of cystic lesions, mural nodules, ring enhancement, focal edema, or punctate calcifications on modern contrast-enhanced neuroimaging, which rules out active or inactive symptomatic neurocysticercosis."}, {"name": "Cerebral Tuberculoma", "type": "Disease", "description": "Intracranial granulomatous infection caused by Mycobacterium tuberculosis presenting as ring-enhancing cerebral masses; differentiated from NCC by thick irregular nodular walls, T2-hypointense center, constitutional symptoms (fever, night sweats, weight loss), pulmonary lesions, and negative Taenia solium EITB."}, {"name": "Pyogenic Brain Abscess", "type": "Disease", "description": "Bacterial intracranial focal infection causing ring-enhancing lesions; differentiated from NCC by acute high fever, toxic delirium, marked peripheral neutrophilia, elevated ESR/CRP, and hallmark central restricted diffusion on diffusion-weighted MRI (DWI/ADC)."}, {"name": "High-Grade Glioma and Brain Metastases", "type": "Disease", "description": "Primary or secondary central nervous system malignancies presenting as ring-enhancing lesions; differentiated from NCC by thick shaggy irregular margins, central necrosis, progressive neurological deterioration, lack of discrete cystic walls, and absence of an eccentric scolex."}, {"name": "Cerebral Echinococcosis", "type": "Disease", "description": "Larval cestode infection caused by Echinococcus granulosus or multilocularis; differentiated from NCC by large expansive cysts containing internal daughter cysts and detached germinal membranes ('water lily' sign) rather than small scolex-containing cysts."}, {"name": "Pre-Treatment High-Dose Corticosteroids (Dexamethasone or Prednisone)", "type": "Drug_Response", "description": "High-dose systemic corticosteroid therapy (dexamethasone 0.1 mg/kg/day or prednisone 1 mg/kg/day) initiated 24-48 hours prior to cysticidal anthelmintics to prevent life-threatening inflammatory cerebral edema, intracranial hypertension, and status epilepticus triggered by antigen release from dying cysticerci."}, {"name": "Oral Albendazole Anthelmintic Therapy with Fatty Meals", "type": "Drug_Response", "description": "First-line cysticidal regimen of oral Albendazole (15 mg/kg/day divided twice daily for 10-14 days administered with fatty meals to maximize systemic absorption and CSF penetration) achieving parasiticidal destruction of 1-2 viable parenchymal cysts."}, {"name": "Dual Anthelmintic Regimen with Albendazole and Praziquantel", "type": "Drug_Response", "description": "Combination therapy of oral Albendazole (15 mg/kg/day) plus oral Praziquantel (50 mg/kg/day divided 3 times daily) for 10-14 days, achieving significantly superior cyst clearance (>75% resolution) compared to monotherapy in patients with multiple (>2) viable parenchymal cysts."}, {"name": "Anti-Epileptic Drug Monotherapy for Seizure Control", "type": "Drug_Response", "description": "First-line anti-epileptic monotherapy (e.g., levetiracetam, carbamazepine) providing effective seizure prophylaxis for acute provoked seizures during inflammatory degeneration and as the sole indicated treatment for inactive calcified epileptogenic lesions."}, {"name": "Anthelmintic Cysticidal Therapy in Inactive Calcified Lesions Alone", "type": "Drug_Response", "description": "Inactive calcified granulomas contain only dead, mineralized parasitic debris and are intrinsically unresponsive to anthelmintic therapy; cysticidal drugs are contraindicated as they provide no clinical benefit and carry risks of unnecessary adverse effects."}, {"name": "Anthelmintic Therapy in Untreated Hydrocephalus or Cysticercal Encephalitis", "type": "Drug_Response", "description": "Administration of cysticidal drugs is contraindicated in untreated obstructive hydrocephalus or massive cysticercal encephalitis because acute parasite lysis precipitates fatal intracranial hypertension and herniation; primary management requires surgical CSF diversion and high-dose anti-inflammatory agents."}], "relationships": [{"source": "Neurocysticercosis", "target": "Ingestion of Taenia solium Eggs via Fecal-Oral Route", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] Acquired exclusively through the fecal-oral ingestion of microscopic Taenia solium eggs shed in the feces of a human tapeworm carrier via contaminated food, water, or poor hygiene; consuming pork causes intestinal taeniasis, NOT neurocysticercosis."}, {"source": "Neurocysticercosis", "target": "Household Contact with a Human Taenia solium Tapeworm Carrier", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Clustered risk resulting from household cohabitation or close personal contact with an individual harboring an adult intestinal tapeworm shedding infective eggs."}, {"source": "Neurocysticercosis", "target": "Residence in or Travel to Taenia solium Endemic Regions", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Epidemiological exposure in endemic rural regions of Latin America, South/Southeast Asia, and sub-Saharan Africa where the domestic pig-human transmission cycle remains active."}, {"source": "Neurocysticercosis", "target": "Subsistence Pig Farming with Free-Roaming Swine and Inadequate Sanitation", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Environmental exposure in agricultural settings where free-roaming domestic pigs feed on human feces due to lack of closed latrines and sanitation infrastructure."}, {"source": "Neurocysticercosis", "target": "Taenia solium Metacestode Larvae (Cysticercus cellulosae)", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Caused by the larval metacestode stage (cysticerci) of Taenia solium colonizing the brain parenchyma, ventricular cavities, or subarachnoid spaces."}, {"source": "Neurocysticercosis", "target": "New-Onset Adult Seizures in Endemic Setting", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Adult-onset focal or generalized tonic-clonic seizures in an endemic area represent the primary cardinal clinical presentation (70-90% of symptomatic parenchymal cases), triggered by colloidal host inflammation or chronic calcified scars."}, {"source": "Neurocysticercosis", "target": "Cystic Brain Lesion with Pathognomonic Invaginated Scolex on Neuroimaging", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Del Brutto absolute diagnostic criterion defined by a 5-20 mm cystic lesion with an eccentric hyperdense or hyperintense mural nodule representing the invaginated scolex ('hole-with-a-dot' sign) on CT or MRI."}, {"source": "Neurocysticercosis", "target": "Bruns Syndrome Paroxysms from Mobile Intraventricular Cyst", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Episodic severe occipital headache, projectile vomiting, and syncope provoked by head rotation due to intermittent obstruction of CSF flow by a mobile 4th ventricular cyst via a ball-valve mechanism."}, {"source": "Neurocysticercosis", "target": "Chronic Tension or Throbbing Headaches with Intracranial Hypertension", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Persistent severe headaches presenting in 35-50% of symptomatic patients, often accompanied by vomiting, visual obscurations, or papilledema due to hydrocephalus or basilar inflammation."}, {"source": "Neurocysticercosis", "target": "Colloidal Vesicular Stage Ring-Enhancing Lesion with Perilesional Edema", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Neuroimaging pattern on contrast CT/MRI displaying smooth, round ring-enhancing parenchymal cysts with capsule enhancement and prominent perilesional vasogenic edema on T2/FLAIR reflecting active host immune response."}, {"source": "Neurocysticercosis", "target": "Punctate Calcified Granulomas on Non-Contrast Brain CT", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Admission non-contrast CT pattern showing single or multiple 2-5 mm discrete hyperdense non-enhancing calcified nodules devoid of edema, indicating chronic non-viable mineralized parasitic scars."}, {"source": "Neurocysticercosis", "target": "Enzyme-Linked Immunoelectrotransfer Blot (EITB) Glycoprotein Antigen Seropositivity", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Serum/CSF Western blot utilizing lentil lectin-purified Taenia solium glycoprotein antigens (LL-GP) showing >98% sensitivity and 100% specificity in patients with multiple viable or extraparenchymal cysts."}, {"source": "Neurocysticercosis", "target": "Racemose Subarachnoid Giant Lobulated Cystic Clusters in Basal Cisterns", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Multilocular, grape-like budding cystic clusters within basal cisterns or Sylvian fissures lacking scolices, causing basilar arachnoiditis, hydrocephalus, or endarteritis obliterans leading to stroke."}, {"source": "Neurocysticercosis", "target": "CSF Lymphocytic Pleocytosis with Elevated Protein and Normal Glucose", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Cerebrospinal fluid pattern in extraparenchymal disease demonstrating lymphocytic pleocytosis (10-300 WBC/μL), elevated protein (50-300 mg/dL), normal or mildly decreased glucose, and elevated opening pressure."}, {"source": "Neurocysticercosis", "target": "Normal Peripheral Leukocyte Count with Variable Mild Eosinophilia", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Complete blood count profile at admission triage showing normal total WBC count without neutrophilic leukocytosis; mild peripheral eosinophilia occurs in <20-30% of cases and its absence does not rule out NCC."}, {"source": "Neurocysticercosis", "target": "Acute Toxic High Spiking Fever with Meningismus and Purulent CSF Pleocytosis", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Presence of acute high fever, toxic encephalopathy, nuchal rigidity, marked peripheral leukocytosis, and turbid purulent CSF pleocytosis rules out uncomplicated parenchymal neurocysticercosis, indicating acute bacterial meningitis or brain abscess."}, {"source": "Neurocysticercosis", "target": "Restricted Diffusion on Diffusion-Weighted MRI (DWI) with Low ADC", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Central hyperintense signal on DWI with low ADC mapping within a cystic ring-enhancing lesion rules out neurocysticercosis, confirming a pyogenic bacterial brain abscess."}, {"source": "Neurocysticercosis", "target": "Large Multilocular Cystic Lesions with Internal Daughter Cysts and Hydatid Sand", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Finding of expansive, large multivesicular cysts containing internal daughter cysts or hydatid sand rules out neurocysticercosis, establishing cerebral echinococcosis."}, {"source": "Neurocysticercosis", "target": "Irregular Shaggy Enhancing Infiltrative Cerebral Mass with Extensive Midline Shift", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Grossly irregular, thick, shaggy enhancing margins with central necrosis, invasive parenchymal infiltrative edema, and rapid mass effect rule out discrete benign neurocysticercosis cysts, indicating glioblastoma or brain metastasis."}, {"source": "Neurocysticercosis", "target": "Absence of Neuroimaging Lesions on Contrast Brain CT and High-Resolution MRI", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Complete absence of cystic lesions, mural nodules, ring enhancement, focal edema, or calcifications on dedicated high-resolution contrast brain imaging rules out active or inactive symptomatic neurocysticercosis."}, {"source": "Neurocysticercosis", "target": "Cerebral Tuberculoma", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Cerebral Tuberculoma: Tuberculomas display thick irregular nodular rim enhancement with central T2-hypointensity, systemic constitutional symptoms (fever, night sweats, weight loss), chest X-ray findings, and negative EITB, whereas NCC lesions are smooth, afebrile, and EITB positive."}, {"source": "Neurocysticercosis", "target": "Pyogenic Brain Abscess", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Pyogenic Brain Abscess: Pyogenic abscess presents with acute toxic high fever, marked peripheral neutrophilia, elevated ESR/CRP, and central restricted diffusion on DWI/ADC, whereas parenchymal NCC lacks systemic toxemia, has normal inflammatory labs, and shows non-restricting cyst fluid."}, {"source": "Neurocysticercosis", "target": "High-Grade Glioma and Brain Metastases", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from High-Grade Glioma and Brain Metastases: Neoplastic brain lesions exhibit thick, nodular, irregular enhancing margins with central necrosis, invasive parenchymal distortion, and progressive clinical deterioration, contrasting with the discrete, non-infiltrative, stage-specific morphology of neurocysticercosis."}, {"source": "Neurocysticercosis", "target": "Cerebral Echinococcosis", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Cerebral Echinococcosis: Echinococcus granulosus or multilocularis presents as huge unilocular or multilocular mass lesions often containing internal daughter cysts without perilesional edema prior to rupture, lacking the pathognomonic invaginated scolex dot of Taenia solium."}, {"source": "Neurocysticercosis", "target": "Pre-Treatment High-Dose Corticosteroids (Dexamethasone or Prednisone)", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] High-dose corticosteroids (dexamethasone 0.1 mg/kg/day or prednisone 1 mg/kg/day) administered 24-48 hours before cysticidal anthelmintic therapy prevent severe local parenchymal inflammatory edema, intracranial hypertension, and status epilepticus triggered by parasitic antigen release."}, {"source": "Neurocysticercosis", "target": "Oral Albendazole Anthelmintic Therapy with Fatty Meals", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Oral Albendazole (15 mg/kg/day divided twice daily for 10-14 days taken with fat-containing meals to optimize systemic bioavailability) achieves successful parasiticidal destruction of 1-2 viable parenchymal cysticerci."}, {"source": "Neurocysticercosis", "target": "Dual Anthelmintic Regimen with Albendazole and Praziquantel", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Combined Albendazole (15 mg/kg/day) plus Praziquantel (50 mg/kg/day in 3 divided doses) for 10-14 days achieves significantly higher cyst resolution rates (>75%) than monotherapy in patients with multiple (>2) viable parenchymal cysts."}, {"source": "Neurocysticercosis", "target": "Anti-Epileptic Drug Monotherapy for Seizure Control", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] First-line anti-epileptic monotherapy (levetiracetam, carbamazepine) provides effective seizure suppression in both active inflammatory and inactive calcified parenchymal disease."}, {"source": "Neurocysticercosis", "target": "Anthelmintic Cysticidal Therapy in Inactive Calcified Lesions Alone", "keywords": "INTRINSICALLY_RESISTANT_TO", "description": "[INTRINSICALLY_RESISTANT_TO] Dead, mineralized calcified parenchymal lesions contain no living metacestodes and are intrinsically unresponsive to anthelmintics (albendazole/praziquantel); cysticidal therapy is contraindicated as it confers no clinical benefit and causes drug-induced adverse effects."}, {"source": "Neurocysticercosis", "target": "Anthelmintic Therapy in Untreated Hydrocephalus or Cysticercal Encephalitis", "keywords": "INTRINSICALLY_RESISTANT_TO", "description": "[INTRINSICALLY_RESISTANT_TO] Cysticidal anthelmintics are contraindicated prior to surgical CSF diversion in hydrocephalus or in massive cysticercal encephalitis because drug-induced larval lysis precipitates fatal intracranial hypertension and herniation; therapy requires initial neurosurgical decompression and anti-inflammatory management."}]}}
{"case_id": "paracoccidioidomycosis", "disease": "Paracoccidioidomycosis", "extraction": {"entities": [{"name": "Paracoccidioidomycosis", "type": "Disease", "description": "Chronic granulomatous systemic fungal infection caused by dimorphic fungi of the Paracoccidioides genus, endemic to Latin America, presenting as either an acute juvenile form with reticuloendothelial dissemination or a chronic adult form with moriform stomatitis, pulmonary butterfly-wing infiltrates, and adrenal involvement."}, {"name": "Inhalation of Aerosolized Microconidia from Disturbed Acidic Soil in Latin America", "type": "Vector_Exposure", "description": "Inhalation of airborne infectious microconidia released into aerosols from disturbed acidic, humid topsoil during rural environmental activities in continental Latin America."}, {"name": "Rural Agricultural Worker in South America Coffee and Tobacco Plantations", "type": "Vector_Exposure", "description": "Occupational rural labor involving manual manipulation of soil and crops (coffee harvesting, tobacco farming, earth moving, tilling) in hyperendemic South American regions, especially Brazil, Colombia, and Venezuela."}, {"name": "Sylvatic Animal Reservoir Contact with Nine-Banded Armadillos and Rural Canines", "type": "Vector_Exposure", "description": "Environmental cohabitation or direct contact with natural animal reservoirs including nine-banded armadillos (Dasypus novemcinctus) and rural domestic dogs harboring Paracoccidioides in endemic areas."}, {"name": "Male Agricultural Smoker with Chronic Alcohol Consumption Lifestyle", "type": "Vector_Exposure", "description": "Demographic and behavioral profile of adult males (10:1 to 15:1 male-to-female ratio) with history of heavy tobacco smoking (>14-fold elevated risk) and regular distilled alcohol intake exceeding 50 g/day."}, {"name": "Absence of Inhibitory Circulating 17-Beta-Estradiol Protection in Adult Males", "type": "Vector_Exposure", "description": "Lack of female 17-beta-estradiol hormone, which normally binds fungal cytoplasmic estrogen receptors and blocks mycelium-to-yeast dimorphic transformation, allowing unchecked yeast conversion in adult males."}, {"name": "Prolonged Decade-Scale Clinical Latency Following Remote Latin American Residence", "type": "Vector_Exposure", "description": "Remote residential or travel history in Latin America with dormant quiescent fungal foci undergoing clinical reactivation 10 to 30 or more years after emigrating from the endemic zone."}, {"name": "Paracoccidioides brasiliensis", "type": "Pathogen", "description": "Thermally dimorphic fungal pathogen belonging to the Ajellomycetaceae family, existing as infective mycelia/microconidia at 20-25°C and transforming into large, multi-budding thick-walled parasitic yeast cells at 37°C."}, {"name": "Paracoccidioides lutzii", "type": "Pathogen", "description": "Distinct cryptic species within the Paracoccidioides genus predominantly localized to the Center-West and Amazon basin of Brazil, causing endemic systemic paracoccidioidomycosis."}, {"name": "Moriform Painful Stomatitis with Mulberry-Like Granulomatous Gingival Ulcers", "type": "Cardinal_Sign", "description": "Painful, granular, infiltrative mucosal ulcerations studded with pinpoint red hemorrhagic spots (mulberry-like stomatitis of Aguiar-Pupo) affecting lips, gums, tongue, and palate, accompanied by intense odynophagia, sialorrhea, loose teeth, and cervical lymphadenopathy."}, {"name": "Acute Juvenile Fulminant Reticuloendothelial Dissemination with Suppurative Fistulizing Lymphadenopathy", "type": "Cardinal_Sign", "description": "Rapidly progressive disease in children and young adults under 30 years of age with massive peripheral and intra-abdominal lymphadenopathy that softens and ulcerates with draining fistulae, profound hepatosplenomegaly, and osteolytic bone lesions without prominent lung involvement."}, {"name": "Bilateral Adrenal Granulomatous Destruction with Primary Addisonian Adrenal Insufficiency", "type": "Cardinal_Sign", "description": "Granulomatous infiltration and necrotizing destruction of adrenal cortices in chronic disease manifesting as profound asthenia, postural hypotension, cutaneous melanoderma, hyponatremia, and hyperkalemia."}, {"name": "Chronic Progressive Fibrosing Pulmonary Syndrome with Exertional Dyspnea and Cor Pulmonale", "type": "Cardinal_Sign", "description": "Chronic productive cough, mucopurulent sputum, hemoptysis, and progressive dyspnea resulting from extensive peribronchovascular and interstitial pulmonary fibrosis leading to pulmonary hypertension and cor pulmonale."}, {"name": "Microscopic Mariner Wheel or Pilot Wheel Multi-Budding Yeast on Direct KOH Preparation", "type": "Admission_Lab_Imaging", "description": "Direct microscopic examination (10-20% KOH mount or calcofluor white) of mucosal scrapings, sputum, or lymph node aspirates revealing large spherical mother yeast cells (15-30 μm up to 60 μm) surrounded by multiple narrow-necked daughter blastoconidia (rueda de timón / pilot wheel or Mickey Mouse appearance)."}, {"name": "Bilateral Symmetrical Butterfly-Wing Infiltrates Spared at Apices and Bases on Chest Imaging", "type": "Admission_Lab_Imaging", "description": "Chest radiography or CT demonstrating bilateral, symmetrical coarse reticulonodular opacities and alveolar consolidations concentrated in perihilar and mid-lung zones (butterfly-wing or bat-wing pattern), with characteristic sparing of the lung apices and bases, reversed halo signs, and interlobular septal thickening."}, {"name": "High-Resolution CT Reversed Halo Sign with Perihilar Nodular Ground-Glass Opacities", "type": "Admission_Lab_Imaging", "description": "High-resolution computed tomography finding of the reversed halo sign (central ground-glass opacity encircled by a crescentic or complete ring of consolidation) alongside centrolobular nodules and interlobular septal thickening."}, {"name": "Marked Peripheral Blood Eosinophilia Exceeding 10 to 30 Percent in Juvenile Presentation", "type": "Admission_Lab_Imaging", "description": "Marked elevation of absolute peripheral blood eosinophil count (frequently 10-30% or more) on admission CBC, highly characteristic of the acute/subacute juvenile form, accompanied by elevated ESR and CRP."}, {"name": "Positive Serum Double Immunodiffusion Precipitin Band Against gp43 Antigen", "type": "Admission_Lab_Imaging", "description": "Quantitative serum double immunodiffusion (DID) demonstrating diagnostic precipitin bands against the 43-kDa glycoprotein (gp43) of Paracoccidioides brasiliensis with >90% sensitivity and >95% specificity."}, {"name": "Serum Electrolyte Pattern of Addisonian Adrenal Crisis with Hyponatremia and Hyperkalemia", "type": "Admission_Lab_Imaging", "description": "Admission chemistry showing hyponatremia, hyperkalemia, and depressed early morning serum cortisol indicating primary hypocortisolism from bilateral fungal adrenalitis."}, {"name": "Absence of Historical Travel or Residential Exposure to Continental Latin America", "type": "Exclusion_Criterion", "description": "Complete lifetime absence of residence or travel in continental Latin America, which definitively excludes paracoccidioidomycosis as the environmental reservoir and endemic acquisition are strictly confined to this geography."}, {"name": "Healthy Premenopausal Female Host with Normal Endogenous Estrogen Levels", "type": "Exclusion_Criterion", "description": "Presence of physiological circulating 17-beta-estradiol in premenopausal adult women, which potently inhibits the dimorphic transition from conidia to parasitic yeast, rendering chronic adult paracoccidioidomycosis exceptionally improbable."}, {"name": "Absence of Multi-Budding Pilot Wheel Yeasts on Repeated Direct Microscopy of Mucosal Ulcer Scrapes", "type": "Exclusion_Criterion", "description": "Consistent failure to identify characteristic multi-budding mother yeasts on direct KOH smears or histopathology of active granulomatous lesions on repeated testing, strongly arguing against active disease."}, {"name": "Pulmonary Tuberculosis", "type": "Disease", "description": "Mycobacterial infection presenting with chronic cough, hemoptysis, and weight loss, distinguished by apical and posterior upper-lobe cavitary consolidations, presence of acid-fast bacilli on sputum smear/GeneXpert, and absence of mulberry-like oral lesions."}, {"name": "Oral Squamous Cell Carcinoma", "type": "Disease", "description": "Malignant epithelial oral neoplasm occurring in chronic smoking males, distinguished by indurated ulcers with everted hard borders and malignant cytology on biopsy, lacking moriform punctate hemorrhages and budding yeasts."}, {"name": "Mucocutaneous Leishmaniasis", "type": "Disease", "description": "Protozoan infection caused by Leishmania braziliensis causing destructive mucosal ulceration in Latin America, distinguished by predominant cartilaginous nasal septal perforation (tapir nose), pulmonary sparing, and intracellular amastigotes (Leishman-Donovan bodies) within macrophages."}, {"name": "Disseminated Histoplasmosis", "type": "Disease", "description": "Endemic dimorphic mycosis caused by Histoplasma capsulatum, distinguished by tiny (2-4 μm) intracellular yeasts with narrow single budding within reticuloendothelial macrophages, contrasting with giant (15-30 μm) extracellular multi-budding pilot-wheel yeasts."}, {"name": "Prolonged Oral Itraconazole Monotherapy", "type": "Drug_Response", "description": "First-line oral antifungal regimen (200 mg daily for 9 to 12 months) achieving >95% cure rate with low relapse in mild-to-moderate chronic paracoccidioidomycosis."}, {"name": "Extended Oral Trimethoprim-Sulfamethoxazole Regimen", "type": "Drug_Response", "description": "First-line alternative oral protocol (800/160 mg twice daily for 18 to 24 months) widely utilized in rural public health systems and effective for central nervous system disease."}, {"name": "Intravenous Amphotericin B Deoxycholate or Liposomal Formulation", "type": "Drug_Response", "description": "Parenteral induction therapy (0.7-1.0 mg/kg/day conventional or 3-5 mg/kg/day liposomal) reserved for severe, life-threatening disseminated or respiratory paracoccidioidomycosis until stabilization."}, {"name": "Hormonal Glucocorticoid and Mineralocorticoid Replacement Therapy", "type": "Drug_Response", "description": "Physiological replacement with oral Hydrocortisone and Fludrocortisone required to reverse refractory hypotension and electrolyte derangements in patients with Addisonian adrenal involvement."}, {"name": "Complete Clinical Refractoriness to Standard Antibacterial Agents", "type": "Drug_Response", "description": "Total failure to respond to empirical broad-spectrum antibacterial regimens (beta-lactams, macrolides, fluoroquinolones) for pulmonary infiltrates or oral ulcers, supporting a fungal rather than bacterial etiology."}], "relationships": [{"source": "Paracoccidioidomycosis", "target": "Inhalation of Aerosolized Microconidia from Disturbed Acidic Soil in Latin America", "keywords": "respiratory transmission, inhaled microconidia, endemic soil", "description": "[TRANSMITTED_BY] Paracoccidioidomycosis is acquired via inhalation of aerosolized infective microconidia produced by saprophytic mycelia residing in acidic, humid soils of continental Latin America."}, {"source": "Paracoccidioidomycosis", "target": "Rural Agricultural Worker in South America Coffee and Tobacco Plantations", "keywords": "occupational risk, manual agriculture, coffee crops, tobacco crops", "description": "[EXPOSURE_TO] Paracoccidioidomycosis develops with highest frequency following occupational exposure during manual soil tillage, coffee harvesting, and tobacco farming in rural South America."}, {"source": "Paracoccidioidomycosis", "target": "Sylvatic Animal Reservoir Contact with Nine-Banded Armadillos and Rural Canines", "keywords": "zoonotic niche, sylvatic reservoir, Dasypus novemcinctus, rural dogs", "description": "[EXPOSURE_TO] Paracoccidioidomycosis shares an ecological niche with nine-banded armadillos (Dasypus novemcinctus) and domestic rural canines that serve as natural sylvatic and domestic reservoirs in endemic areas."}, {"source": "Paracoccidioidomycosis", "target": "Male Agricultural Smoker with Chronic Alcohol Consumption Lifestyle", "keywords": "lifestyle risk, smoking habit, alcohol consumption, adult male predisposition", "description": "[EXPOSURE_TO] Paracoccidioidomycosis chronic adult form occurs overwhelmingly in adult male rural workers with heavy tobacco smoking habits (14-fold elevated risk) and regular intake of distilled spirits."}, {"source": "Paracoccidioidomycosis", "target": "Absence of Inhibitory Circulating 17-Beta-Estradiol Protection in Adult Males", "keywords": "hormonal modulation, estrogen receptor, 17-beta-estradiol, male predilection", "description": "[EXPOSURE_TO] Paracoccidioidomycosis manifests with a 10:1 to 15:1 male-to-female ratio because physiological circulating 17-beta-estradiol in adult females binds to a cytoplasmic fungal receptor and blocks conidium-to-yeast transformation, a protection absent in post-pubertal males."}, {"source": "Paracoccidioidomycosis", "target": "Prolonged Decade-Scale Clinical Latency Following Remote Latin American Residence", "keywords": "prolonged incubation, clinical latency, remote exposure, travel-acquired reactivation", "description": "[EXPOSURE_TO] Paracoccidioidomycosis chronic form undergoes prolonged latency of 10 to 30 or more years, presenting as late reactivation long after leaving endemic Latin American rural regions."}, {"source": "Paracoccidioidomycosis", "target": "Paracoccidioides brasiliensis", "keywords": "etiologic pathogen, dimorphic fungus, Ascomycota, species complex", "description": "[HAS_PATHOGEN] Paracoccidioidomycosis is caused by the thermally dimorphic fungus Paracoccidioides brasiliensis, which transforms from infectious environmental hyphae/conidia at 20-25°C into multi-budding parasitic yeast cells at 37°C."}, {"source": "Paracoccidioidomycosis", "target": "Paracoccidioides lutzii", "keywords": "cryptic species, Center-West Brazil, Amazon basin, dimorphic yeast", "description": "[HAS_PATHOGEN] Paracoccidioidomycosis is caused by Paracoccidioides lutzii, a distinct molecular species prevalent in the Center-West and Amazon regions of Brazil displaying dimorphic multi-budding yeast morphology."}, {"source": "Paracoccidioidomycosis", "target": "Moriform Painful Stomatitis with Mulberry-Like Granulomatous Gingival Ulcers", "keywords": "pathognomonic hallmark, Aguiar-Pupo stomatitis, moriform ulcers, mulberry appearance", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Paracoccidioidomycosis chronic form displays pathognomonic moriform stomatitis of Aguiar-Pupo in 50-70% of cases, consisting of painful granular mucosal ulcerations with pinpoint red hemorrhagic spots on gums, lips, and palate."}, {"source": "Paracoccidioidomycosis", "target": "Acute Juvenile Fulminant Reticuloendothelial Dissemination with Suppurative Fistulizing Lymphadenopathy", "keywords": "juvenile form, suppurative lymphadenopathy, cutaneous fistulae, hepatosplenomegaly", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Paracoccidioidomycosis acute/subacute juvenile form presents in children and young adults with rapidly progressive massive lymphadenomegaly that softens, suppurates, and forms cutaneous draining fistulae, accompanied by marked hepatosplenomegaly."}, {"source": "Paracoccidioidomycosis", "target": "Bilateral Adrenal Granulomatous Destruction with Primary Addisonian Adrenal Insufficiency", "keywords": "Addison syndrome, bilateral adrenal necrosis, melanoderma, postural hypotension", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Paracoccidioidomycosis chronic form causes bilateral adrenal granulomatous destruction in 15-50% of necropsies, manifesting clinically with asthenia, hypotension, skin hyperpigmentation, and adrenal crisis."}, {"source": "Paracoccidioidomycosis", "target": "Chronic Progressive Fibrosing Pulmonary Syndrome with Exertional Dyspnea and Cor Pulmonale", "keywords": "respiratory syndrome, peribronchovascular fibrosis, cor pulmonale, exertional dyspnea", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Paracoccidioidomycosis chronic form causes progressive productive cough, dyspnea, and hemoptysis, driving extensive peribronchovascular fibrosis that progresses to pulmonary hypertension and cor pulmonale."}, {"source": "Paracoccidioidomycosis", "target": "Microscopic Mariner Wheel or Pilot Wheel Multi-Budding Yeast on Direct KOH Preparation", "keywords": "direct microscopy, pilot wheel yeast, mariner wheel, Mickey Mouse head, KOH mount", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Paracoccidioidomycosis is diagnosed on bedside 10-20% KOH scraping by the pathognomonic pilot wheel (mariner's steering wheel / rueda de timón) yeast: a large 15-30 μm mother cell surrounded circumferentially by multiple narrow-necked daughter buds."}, {"source": "Paracoccidioidomycosis", "target": "Bilateral Symmetrical Butterfly-Wing Infiltrates Spared at Apices and Bases on Chest Imaging", "keywords": "butterfly-wing infiltrates, bat-wing pattern, perihilar consolidation, apical sparing, reversed halo sign", "description": "[EXHIBITS_LAB_PATTERN] Paracoccidioidomycosis displays bilateral symmetrical reticulonodular and alveolar consolidations centered in the mid-lung and perihilar zones (bat-wing / butterfly-wing distribution) with characteristically spared lung apices and bases on chest radiography and CT."}, {"source": "Paracoccidioidomycosis", "target": "High-Resolution CT Reversed Halo Sign with Perihilar Nodular Ground-Glass Opacities", "keywords": "reversed halo sign, atoll sign, ground-glass opacity, high-resolution CT", "description": "[EXHIBITS_LAB_PATTERN] Paracoccidioidomycosis high-resolution chest tomography demonstrates the reversed halo sign (atoll sign) characterized by central ground-glass opacity enveloped by a ring-like consolidation, along with parenchymal bands and centrolobular nodules."}, {"source": "Paracoccidioidomycosis", "target": "Marked Peripheral Blood Eosinophilia Exceeding 10 to 30 Percent in Juvenile Presentation", "keywords": "peripheral eosinophilia, Th2 immune response, juvenile form, acute phase elevation", "description": "[EXHIBITS_LAB_PATTERN] Paracoccidioidomycosis acute juvenile form exhibits marked peripheral blood eosinophilia (often 10-30% or higher) on admission CBC, driven by an aberrant Th2-skewed immune response."}, {"source": "Paracoccidioidomycosis", "target": "Positive Serum Double Immunodiffusion Precipitin Band Against gp43 Antigen", "keywords": "gp43 serology, double immunodiffusion, precipitin band, diagnostic sensitivity", "description": "[EXHIBITS_LAB_PATTERN] Paracoccidioidomycosis exhibits high-titer precipitin bands against the Paracoccidioides brasiliensis gp43 glycoprotein antigen on quantitative double immunodiffusion with >90% sensitivity and >95% specificity."}, {"source": "Paracoccidioidomycosis", "target": "Serum Electrolyte Pattern of Addisonian Adrenal Crisis with Hyponatremia and Hyperkalemia", "keywords": "hyponatremia, hyperkalemia, low morning cortisol, adrenal insufficiency labs", "description": "[EXHIBITS_LAB_PATTERN] Paracoccidioidomycosis with adrenal invasion exhibits admission laboratory derangements of hyponatremia, hyperkalemia, hypoglycemia, and subnormal morning serum cortisol levels."}, {"source": "Paracoccidioidomycosis", "target": "Absence of Historical Travel or Residential Exposure to Continental Latin America", "keywords": "geographic restriction, non-endemic exclusion, travel history", "description": "[RULED_OUT_BY] Paracoccidioidomycosis is ruled out in patients who have never resided in or traveled to continental Latin America, as the environmental reservoir and endemic acquisition are strictly confined to this geography."}, {"source": "Paracoccidioidomycosis", "target": "Healthy Premenopausal Female Host with Normal Endogenous Estrogen Levels", "keywords": "estrogen protection, premenopausal female, hormonal resistance", "description": "[RULED_OUT_BY] Paracoccidioidomycosis chronic adult disease is ruled out with very high negative predictive value in immunocompetent premenopausal adult women due to 17-beta-estradiol inhibition of mycelial-to-yeast transformation."}, {"source": "Paracoccidioidomycosis", "target": "Absence of Multi-Budding Pilot Wheel Yeasts on Repeated Direct Microscopy of Mucosal Ulcer Scrapes", "keywords": "negative direct microscopy, lack of pilot wheel yeasts, mucosal scraping exclusion", "description": "[RULED_OUT_BY] Paracoccidioidomycosis is effectively ruled out when repeated direct KOH or calcofluor mounts of mucosal scrapings or exudates fail to show characteristic multi-budding mother yeasts in a patient with oral ulcers."}, {"source": "Paracoccidioidomycosis", "target": "Pulmonary Tuberculosis", "keywords": "differential diagnosis, Mycobacterium tuberculosis, apical cavitation, acid-fast bacilli", "description": "[DIFFERENTIATED_FROM] Paracoccidioidomycosis is differentiated from Pulmonary Tuberculosis by mid-lung butterfly-wing infiltrates with spared apices, moriform oral mucosal ulcers, and mariner's wheel budding yeasts, whereas Tuberculosis features upper-lobe apical cavitary lesions and acid-fast bacilli on sputum smear or GeneXpert."}, {"source": "Paracoccidioidomycosis", "target": "Oral Squamous Cell Carcinoma", "keywords": "differential diagnosis, oral malignancy, neoplastic ulcer, punch biopsy", "description": "[DIFFERENTIATED_FROM] Paracoccidioidomycosis is differentiated from Oral Squamous Cell Carcinoma by diffuse granular mucosal stomatitis with fine red hemorrhagic spots (moriform) and pilot-wheel yeasts that resolve with antifungal therapy, whereas Carcinoma exhibits solitary hard, everted margins with neoplastic epithelial cells on biopsy."}, {"source": "Paracoccidioidomycosis", "target": "Mucocutaneous Leishmaniasis", "keywords": "differential diagnosis, Leishmania braziliensis, tapir nose, Leishman-Donovan bodies", "description": "[DIFFERENTIATED_FROM] Paracoccidioidomycosis is differentiated from Mucocutaneous Leishmaniasis by pulmonary involvement, prominent gingival-palatal moriform ulcers, and large multi-budding yeasts, whereas Leishmaniasis selectively destroys the nasal cartilaginous septum (tapir nose), spares the lungs, and shows intracellular amastigotes within macrophages."}, {"source": "Paracoccidioidomycosis", "target": "Disseminated Histoplasmosis", "keywords": "differential diagnosis, Histoplasma capsulatum, intracellular yeast, narrow-base budding", "description": "[DIFFERENTIATED_FROM] Paracoccidioidomycosis is differentiated from Disseminated Histoplasmosis by giant extracellular yeasts (15-30 μm) with multiple circumferential daughter buds, whereas Histoplasmosis exhibits tiny (2-4 μm) intracellular yeasts with single narrow-necked buds within macrophages."}, {"source": "Paracoccidioidomycosis", "target": "Prolonged Oral Itraconazole Monotherapy", "keywords": "first-line therapy, oral triazole, clinical cure, maintenance regimen", "description": "[RESPONDS_TO] Paracoccidioidomycosis responds rapidly and effectively to first-line oral Itraconazole (200 mg daily for 9 to 12 months), achieving >95% clinical cure rates and low relapse rates in mild-to-moderate disease."}, {"source": "Paracoccidioidomycosis", "target": "Extended Oral Trimethoprim-Sulfamethoxazole Regimen", "keywords": "alternative oral therapy, cotrimoxazole, CNS penetration, prolonged maintenance", "description": "[RESPONDS_TO] Paracoccidioidomycosis responds to long-term oral Trimethoprim-Sulfamethoxazole (800/160 mg twice daily for 18 to 24 months), which is widely accessible in public health systems and provides excellent central nervous system penetration."}, {"source": "Paracoccidioidomycosis", "target": "Intravenous Amphotericin B Deoxycholate or Liposomal Formulation", "keywords": "induction therapy, severe disease, polyene antifungal, liposomal amphotericin", "description": "[RESPONDS_TO] Paracoccidioidomycosis severe or life-threatening disseminated forms respond to induction therapy with intravenous Amphotericin B (0.7-1.0 mg/kg/day conventional or 3-5 mg/kg/day liposomal) until clinical stabilization."}, {"source": "Paracoccidioidomycosis", "target": "Hormonal Glucocorticoid and Mineralocorticoid Replacement Therapy", "keywords": "hydrocortisone, fludrocortisone, Addisonian crisis, adrenal replacement", "description": "[RESPONDS_TO] Paracoccidioidomycosis-induced adrenal insufficiency responds to physiological hormone replacement with oral Hydrocortisone and Fludrocortisone, correcting hypotension and electrolyte disturbances."}, {"source": "Paracoccidioidomycosis", "target": "Complete Clinical Refractoriness to Standard Antibacterial Agents", "keywords": "antibacterial resistance, treatment failure, diagnostic verification", "description": "[INTRINSICALLY_RESISTANT_TO] Paracoccidioidomycosis is intrinsically resistant to broad-spectrum antibacterial agents (beta-lactams, macrolides, fluoroquinolones); lack of response in presumed bacterial pneumonia or stomatitis aids diagnostic recognition."}]}}
{"case_id": "scabies", "disease": "Scabies", "extraction": {"entities": [{"name": "Scabies", "type": "Disease", "description": "Contagious ectoparasitic skin infestation caused by Sarcoptes scabiei var. hominis, clinically characterized by intense nocturnal pruritus, pathognomonic serpiginous intraepidermal burrows, male genital nodules, and secondary pyoderma."}, {"name": "Sarcoptes scabiei var. hominis", "type": "Pathogen", "description": "Obligate human microscopic ectoparasitic mite (Arachnida, Acari; adult females 0.3–0.45 mm) that excavates the epidermal stratum corneum, depositing 2–3 eggs daily and dark brown fecal pellets (scybala)."}, {"name": "Direct Prolonged Skin-to-Skin Contact", "type": "Vector_Exposure", "description": "Continuous close skin contact for at least 10 to 20 minutes (holding hands, co-sleeping, sexual intimacy) required for transfer of low mite burdens in classical scabies."}, {"name": "Overcrowded Institutional or Enclosed Community Settings", "type": "Vector_Exposure", "description": "High-density residential environments including refugee camps, prisons, day-care centers, residential aged-care facilities, and remote tropical island communities where crowding accelerates mite transmission."}, {"name": "Severe Immunocompromise or Cognitive and Physical Debility", "type": "Vector_Exposure", "description": "Defective cell-mediated immunity (advanced HIV/AIDS, HTLV-1 coinfection, solid-organ transplantation, immunosuppressive therapy) or physical/cognitive debility preventing scratching, predisposing to hyperinfestation crusted scabies."}, {"name": "Fomite Contamination via Shed Scales and Bedding in Crusted Scabies", "type": "Vector_Exposure", "description": "Indirect transmission route through shed hyperkeratotic crusts, unwashed clothing, and contaminated bed linen harboring millions of viable mites shedding from patients with crusted scabies."}, {"name": "Serpiginous Burrows in Interdigital Web Spaces and Wrists", "type": "Cardinal_Sign", "description": "Delicate, thread-like, slightly elevated, wavy or sinuous grayish-white or light brownish intraepidermal tunnels (1–10 mm long) terminating in a pinpoint papule or vesicle, pathognomonic for scabies (2020 IACS Level B1)."}, {"name": "Exquisitely Pruritic Inflammatory Nodules on Penile Shaft and Scrotum", "type": "Cardinal_Sign", "description": "Firm, indurated, exquisitely pruritic erythematous or violaceous inflammatory nodules on the penis and scrotum in males representing delayed hypersensitivity, highly specific for scabies (2020 IACS Level B2)."}, {"name": "Intense Nocturnal Pruritus Sparing Head and Neck in Adults", "type": "Cardinal_Sign", "description": "Severe, unrelenting pruritus characteristically worsening dramatically at night and after warm baths, developing 3–6 weeks post-primary infection, with strict sparing of the adult head, scalp, face, and neck."}, {"name": "Hyperkeratotic Crusted Norwegian Scabies in Immunocompromised Hosts", "type": "Cardinal_Sign", "description": "Massive, adherent, fissured yellow-gray or brown hyperkeratotic crusts involving the hands, feet, scalp, and subungual spaces (onychauxis) harboring millions of mites, often with mild or absent pruritus."}, {"name": "Diffuse Polymorphic Acropustulosis Involving Palms Soles and Scalp in Infants", "type": "Cardinal_Sign", "description": "Atypical distribution in infants under 2 years where the adult sparing rule breaks down, presenting as widespread inflammatory papules, vesicles, pustules, and burrows on the scalp, face, retroauricular folds, palms, and soles."}, {"name": "Delta-Wing Jet Sign on High-Resolution Dermoscopy", "type": "Admission_Lab_Imaging", "description": "Bedside dermoscopic hallmark (10–20x magnification) revealing a dark, triangular or delta-shaped structure (mite head and forelegs) at the leading terminus of a sinuous translucent intraepidermal track ('jet with vapor contrail', 2020 IACS Level A3)."}, {"name": "Microscopic Identification of Mites Ova or Scybala from Skin Scrapings", "type": "Admission_Lab_Imaging", "description": "Direct optical light microscopy (10–40x) of mineral oil skin scrapings definitively identifying adult female mites (0.3–0.4 mm with 4 pairs of legs), translucent oval eggs (100–150 µm), or dark brown fecal pellets (scybala) (2020 IACS Level A1)."}, {"name": "Marked Hyper-IgE and Severe Peripheral Eosinophilia in Crusted Scabies", "type": "Admission_Lab_Imaging", "description": "Laboratory hallmark in crusted scabies showing severe peripheral blood eosinophilia (>30–50%) and marked serum IgE elevation (>1,000–10,000 IU/mL), contrasted with normal or mild eosinophilia (5–15%) in classical scabies."}, {"name": "Positive Burrow Ink Test on Superficial Epidermis", "type": "Admission_Lab_Imaging", "description": "Bedside diagnostic maneuver where surgical pen ink rubbed across a suspected lesion and wiped with alcohol highlights a distinct zig-zag or wavy intraepidermal track by capillary filling of the burrow."}, {"name": "Complete Absence of Pruritus in an Immunocompetent Host", "type": "Exclusion_Criterion", "description": "Total lack of pruritus in an immunocompetent adult or child virtually excludes classical scabies, as delayed-type cell-mediated hypersensitivity to mite antigens universally causes severe itch."}, {"name": "Pruritic Eruption Involving Face Scalp and Neck in an Immunocompetent Adult", "type": "Exclusion_Criterion", "description": "Pruritic rash involving the face, scalp, and neck in an adult immunocompetent host violates the anatomical 'rule of sparing' and strongly excludes classical scabies, indicating alternative dermatoses."}, {"name": "Non-Pruritic Palmoplantar Maculopapular Rash with Generalized Lymphadenopathy", "type": "Exclusion_Criterion", "description": "Palmoplantar maculopapular eruption that lacks pruritus and presents with generalized nontender lymphadenopathy or condyloma lata excludes scabies, confirming secondary syphilis."}, {"name": "Silvery Extensor Scaly Plaques with Auspitz Sign and Negative Skin Scraping", "type": "Exclusion_Criterion", "description": "Thick silvery plaques on extensor surfaces (elbows, knees) displaying punctate bleeding upon scale removal (Auspitz sign) with zero mites or eggs on mineral oil scraping excludes crusted scabies and confirms plaque psoriasis."}, {"name": "Atopic Dermatitis", "type": "Disease", "description": "Chronic inflammatory pruriginous dermatosis primarily affecting flexural folds (antecubital and popliteal fossae), neck, and face, lacking intraepidermal burrows and penile nodules."}, {"name": "Papular Urticaria and Arthropod Bites", "type": "Disease", "description": "Hypersensitivity reaction to insect bites characterized by clustered wheals and papules on exposed limbs without web-space predilection, burrows, or genital nodules."}, {"name": "Plaque Psoriasis", "type": "Disease", "description": "Immune-mediated dermatosis producing silvery micaceous plaques on extensor surfaces, mimicking crusted scabies but lacking mites and exhibiting the Auspitz sign."}, {"name": "Secondary Syphilis", "type": "Disease", "description": "Systemic Treponema pallidum infection causing ham-colored maculopapular eruptions on palms and soles, constitutional symptoms, generalized lymphadenopathy, and positive treponemal serologies."}, {"name": "Topical 5% Permethrin Cream with Mandatory Day 7-14 Reapplication", "type": "Drug_Response", "description": "First-line neurotoxic scabicide applied neck-to-toes for 8–14 hours; requires a mandatory second application 7 to 14 days later to eradicate newly hatched nymphs because it lacks complete ovicidal efficacy."}, {"name": "Oral Ivermectin with Mandatory Day 7-14 Repeat Dosing", "type": "Drug_Response", "description": "First-line systemic scabicide (200 µg/kg single oral dose); requires a mandatory second dose 7 to 14 days later due to lack of ovicidal activity, ideal for institutional outbreaks and mass drug administration."}, {"name": "Simultaneous Treatment of All Household and Sexual Contacts", "type": "Drug_Response", "description": "Epidemiological requirement to treat all co-habiting household members and close physical contacts concurrently regardless of symptoms, preventing reinfection from asymptomatic incubation-phase carriers."}, {"name": "Intensive Combination Therapy with Topical Permethrin Oral Ivermectin and Keratolytics", "type": "Drug_Response", "description": "Mandatory multimodal regimen for crusted scabies comprising repeated oral Ivermectin (multiple doses across 4 weeks), daily topical 5% Permethrin, and topical keratolytics (5% salicylic acid or 40% urea) to debride thick crusts."}, {"name": "Persistence of Post-Scabietic Pruritus Despite Parasitological Cure", "type": "Drug_Response", "description": "Benign continuation of pruritus for 2 to 4 weeks post-treatment caused by lingering dead mite antigens in the stratum corneum; responds to emollients and mild topical steroids rather than repeated scabicides."}, {"name": "Single-Dose Scabicidal Monotherapy", "type": "Drug_Response", "description": "Monotherapy with a single application of permethrin or single dose of oral ivermectin without day 7-14 re-treatment; leads to clinical relapse because neither agent is reliably ovicidal."}], "relationships": [{"source": "Scabies", "target": "Sarcoptes scabiei var. hominis", "keywords": "HAS_PATHOGEN, causative agent, ectoparasite", "description": "[HAS_PATHOGEN] Scabies is caused by Sarcoptes scabiei var. hominis, an obligate human microscopic ectoparasitic mite (0.3-0.45 mm) that excavates intraepidermal burrows within the stratum corneum, depositing eggs and fecal pellets (scybala)."}, {"source": "Scabies", "target": "Direct Prolonged Skin-to-Skin Contact", "keywords": "TRANSMITTED_BY, transmission mode, physical contact", "description": "[TRANSMITTED_BY] Transmission of classical scabies occurs predominantly through direct, prolonged skin-to-skin contact (typically requiring at least 10–20 minutes of continuous physical contact, such as holding hands, co-sleeping, or sexual contact) due to a low average mite burden (10-15 mites)."}, {"source": "Scabies", "target": "Overcrowded Institutional or Enclosed Community Settings", "keywords": "EXPOSURE_TO, epidemiological risk, residential crowding", "description": "[EXPOSURE_TO] High-risk environments include overcrowded tropical communities, refugee and displaced person camps, prisons, day-care centers, boarding schools, and long-term residential aged-care facilities where close contact facilitates mite spread."}, {"source": "Scabies", "target": "Severe Immunocompromise or Cognitive and Physical Debility", "keywords": "EXPOSURE_TO, host susceptibility, defective cell-mediated immunity", "description": "[EXPOSURE_TO] Defective cell-mediated immunity (advanced HIV/AIDS, HTLV-1 coinfection, solid-organ transplantation, prolonged corticosteroid therapy) or physical/cognitive debility preventing normal scratching responses predisposes to hyperinfestation crusted (Norwegian) scabies."}, {"source": "Scabies", "target": "Fomite Contamination via Shed Scales and Bedding in Crusted Scabies", "keywords": "TRANSMITTED_BY, fomite transmission, indirect contact", "description": "[TRANSMITTED_BY] While fomite transmission is rare and inefficient in classical scabies, indirect transmission readily occurs from patients with crusted scabies via shedding of millions of viable mites in exfoliated keratin crusts, clothing, towels, bedding, and room dust."}, {"source": "Scabies", "target": "Serpiginous Burrows in Interdigital Web Spaces and Wrists", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, intraepidermal burrow", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Delicate, thread-like, slightly elevated, wavy or serpiginous grayish-white or brownish intraepidermal tunnels (1–10 mm in length) terminating in a tiny papule or vesicle harboring the female mite, characteristically found on finger web spaces, volar wrists, and ankles (2020 IACS Level B1)."}, {"source": "Scabies", "target": "Exquisitely Pruritic Inflammatory Nodules on Penile Shaft and Scrotum", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, pathognomonic male genital sign, nodular scabies", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Exquisitely itchy, firm, indurated erythematous or violaceous inflammatory papules and nodules on the penile shaft, glans, prepuce, and scrotum represent a pathognomonic delayed hypersensitivity hallmark in males (2020 IACS Level B2) that may persist for months."}, {"source": "Scabies", "target": "Intense Nocturnal Pruritus Sparing Head and Neck in Adults", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, cardinal clinical sign, nocturnal itch", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Severe, unrelenting pruritus characteristically worsening at night and after warm baths, developing 3–6 weeks after initial infestation or within 24–48 hours upon reinfection, with classic sparing of the head, scalp, face, and neck in adult patients."}, {"source": "Scabies", "target": "Hyperkeratotic Crusted Norwegian Scabies in Immunocompromised Hosts", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, hyperinfestation, crusted scabies", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Massive, thick, adherent, fissured yellow-gray or brown hyperkeratotic scales and crusts affecting hands, feet, scalp, and subungual nail beds (onychauxis) harboring millions of viable mites; itch is characteristically diminished or absent."}, {"source": "Scabies", "target": "Diffuse Polymorphic Acropustulosis Involving Palms Soles and Scalp in Infants", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, infantile presentation, atypical distribution", "description": "[HAS_PATHOGNOMONIC_HALLMARK] In infants and children under 2 years of age, the classic adult distribution breaks down, presenting as diffuse inflammatory papules, vesicles, pustules, and burrows involving the scalp, face, retroauricular folds, palms, and soles (infantile acropustulosis pattern)."}, {"source": "Scabies", "target": "Delta-Wing Jet Sign on High-Resolution Dermoscopy", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, bedside gold standard, dermoscopy", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Bedside dermoscopy at 10–20x magnification visualizes a dark, pigmented triangular structure (mite head and forelegs) at the distal end of a sinuous translucent intraepidermal track ('delta-wing jet with contrail sign'), definitively confirming active scabies (2020 IACS Level A3)."}, {"source": "Scabies", "target": "Microscopic Identification of Mites Ova or Scybala from Skin Scrapings", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, definitive microscopic confirmation, skin scraping", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Light microscopy (10–40x) of mineral oil skin scrapings taken from an unexcoriated burrow definitively demonstrates the adult female mite (0.3–0.45 mm with 4 pairs of legs), translucent oval eggs (100–150 µm), or dark brown fecal pellets (scybala) (2020 IACS Level A1)."}, {"source": "Scabies", "target": "Marked Hyper-IgE and Severe Peripheral Eosinophilia in Crusted Scabies", "keywords": "EXHIBITS_LAB_PATTERN, laboratory hallmark, crusted scabies lab", "description": "[EXHIBITS_LAB_PATTERN] While routine CBC in classical scabies is normal or shows mild eosinophilia (5-15%), crusted scabies characteristically produces profound peripheral eosinophilia (>30-50%) and massive serum IgE elevations (>1,000–10,000 IU/mL) reflecting unchecked Th2 immune polarization."}, {"source": "Scabies", "target": "Positive Burrow Ink Test on Superficial Epidermis", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, bedside diagnostic test, ink tracking", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Bedside application of surgical pen or fountain pen ink followed by alcohol wipe removal demonstrates distinctive linear, zig-zag ink tracking into the open stratum corneum burrow tunnel, confirming burrow architecture at triage."}, {"source": "Scabies", "target": "Complete Absence of Pruritus in an Immunocompetent Host", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary", "description": "[RULED_OUT_BY] Complete absence of pruritus in an immunocompetent adult or child virtually rules out classical scabies, as the cell-mediated delayed hypersensitivity reaction to mite antigens invariably generates intense itch."}, {"source": "Scabies", "target": "Pruritic Eruption Involving Face Scalp and Neck in an Immunocompetent Adult", "keywords": "RULED_OUT_BY, exclusion criterion, anatomical sparing rule", "description": "[RULED_OUT_BY] A pruritic papular eruption involving the face, scalp, and neck in an immunocompetent adult violates the cardinal 'rule of sparing' and strongly excludes classical scabies, indicating instead atopic or seborrheic dermatitis."}, {"source": "Scabies", "target": "Non-Pruritic Palmoplantar Maculopapular Rash with Generalized Lymphadenopathy", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary", "description": "[RULED_OUT_BY] A palmoplantar maculopapular rash that is non-pruritic and accompanied by generalized lymphadenopathy, mucous patches, or positive treponemal serology excludes scabies in favor of secondary syphilis."}, {"source": "Scabies", "target": "Silvery Extensor Scaly Plaques with Auspitz Sign and Negative Skin Scraping", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary", "description": "[RULED_OUT_BY] Thick, silvery, micaceous scaly plaques on extensor surfaces (elbows, knees) exhibiting punctate bleeding upon scale removal (Auspitz sign) and completely negative skin scrapings for mites excludes crusted scabies and confirms plaque psoriasis."}, {"source": "Scabies", "target": "Atopic Dermatitis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis", "description": "[DIFFERENTIATED_FROM] Atopic dermatitis predominantly affects the flexural antecubital and popliteal folds, neck, and face, features personal or family atopic diathesis, lacks discrete linear burrows and penile nodules, lacks the dermoscopic delta-wing sign, and does not simultaneously affect asymptomatic household contacts."}, {"source": "Scabies", "target": "Papular Urticaria and Arthropod Bites", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis", "description": "[DIFFERENTIATED_FROM] Papular urticaria presents with episodic, clustered wheals and excoriated erythematous papules on exposed extremities (classic 'breakfast, lunch, and dinner' distribution) without intraepidermal burrows, web space involvement, or genital nodules."}, {"source": "Scabies", "target": "Plaque Psoriasis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis", "description": "[DIFFERENTIATED_FROM] Plaque psoriasis (the chief mimic of crusted scabies) presents with well-demarcated erythematous plaques with silvery scales on extensor surfaces with positive Auspitz sign and zero mites, whereas crusted scabies features diffuse yellow-gray fissured crusts teeming with thousands of live mites, eggs, and scybala on mineral oil scraping."}, {"source": "Scabies", "target": "Secondary Syphilis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis", "description": "[DIFFERENTIATED_FROM] Secondary syphilis features non-pruritic, coppery, ham-colored macules and papules on the palms and soles, constitutional symptoms, generalized non-tender lymphadenopathy, and reactive RPR/VDRL serology, whereas scabies is intensely pruritic (worse nocturnally), demonstrates burrows, and spares the adult head/face."}, {"source": "Scabies", "target": "Topical 5% Permethrin Cream with Mandatory Day 7-14 Reapplication", "keywords": "RESPONDS_TO, first-line topical scabicide, therapeutic cure", "description": "[RESPONDS_TO] Classical scabies responds to overnight application (8–14 hours) of topical 5% Permethrin cream applied from neck to soles; a mandatory second application 7 to 14 days later is required to eradicate newly hatched nymphs before sexual maturity due to incomplete ovicidal action."}, {"source": "Scabies", "target": "Oral Ivermectin with Mandatory Day 7-14 Repeat Dosing", "keywords": "RESPONDS_TO, first-line oral scabicide, systemic therapy", "description": "[RESPONDS_TO] Scabies responds to oral Ivermectin (200 µg/kg single dose with food/water); a mandatory second dose 7 to 14 days later is strictly required because ivermectin lacks activity against scabies eggs."}, {"source": "Scabies", "target": "Simultaneous Treatment of All Household and Sexual Contacts", "keywords": "RESPONDS_TO, epidemiological management, transmission interruption", "description": "[RESPONDS_TO] Verification of definitive cure requires simultaneous treatment of all cohabiting household members and close contacts regardless of symptoms to eliminate incubation-phase mites (3-6 week delay) and avoid ping-pong re-infestation."}, {"source": "Scabies", "target": "Intensive Combination Therapy with Topical Permethrin Oral Ivermectin and Keratolytics", "keywords": "RESPONDS_TO, intensive combination protocol, crusted scabies", "description": "[RESPONDS_TO] Crusted (Norwegian) scabies is refractory to monotherapy and responds to combination therapy: daily topical 5% Permethrin cream for 1-2 weeks plus multiple oral Ivermectin doses (days 1, 2, 8, 9, 15, and up to 22/29) combined with topical keratolytics (5% salicylic acid or 40% urea) to break down thick protective scales."}, {"source": "Scabies", "target": "Persistence of Post-Scabietic Pruritus Despite Parasitological Cure", "keywords": "RESPONDS_TO, post-treatment allergic pruritus, clinical verification", "description": "[RESPONDS_TO] Pruritus characteristically persists for 2 to 4 weeks after successful mite eradication due to retained dead parasite antigens (post-scabietic itch); this delayed resolution does not represent treatment failure and responds to emollients and mild topical steroids rather than repeated scabicides."}, {"source": "Scabies", "target": "Single-Dose Scabicidal Monotherapy", "keywords": "INTRINSICALLY_RESISTANT_TO, ovicidal failure, treatment relapse", "description": "[INTRINSICALLY_RESISTANT_TO] Scabies eggs are intrinsically resistant to single-dose neurotoxic scabicide monotherapy (both permethrin and ivermectin lack reliable ovicidal activity); failure to repeat dosing at 7–14 days allows surviving eggs to hatch into viable nymphs, causing clinical relapse."}]}}
{"case_id": "schistosomiasis", "disease": "Schistosomiasis", "extraction": {"entities": [{"name": "Schistosomiasis", "type": "Disease", "description": "A major neglected tropical parasitic disease caused by blood-dwelling digenetic trematodes of the genus Schistosoma, manifesting as acute Katayama syndrome, chronic urogenital schistosomiasis with terminal hematuria, or chronic intestinal and hepatosplenic disease with Symmers pipestem periportal fibrosis and non-cirrhotic portal hypertension."}, {"name": "Freshwater Cercarial Percutaneous Penetration via Aquatic Snail Intermediate Hosts", "type": "Vector_Exposure", "description": "Percutaneous penetration of intact human skin by free-swimming, fork-tailed cercariae within seconds to minutes of contact with infested freshwater bodies (lakes, rivers, irrigation canals, dams) during domestic, occupational, or recreational water exposure, where specific freshwater snails (Biomphalaria, Bulinus, Oncomelania) act as obligatory intermediate hosts."}, {"name": "Sub-Saharan Africa, Nile Basin, Neotropical and East Asian Endemic Regions", "type": "Vector_Exposure", "description": "Epidemiological exposure across geographic regions with established transmission, predominantly sub-Saharan Africa (>90% of global burden), the Nile River basin (Egypt, Sudan), the Middle East, parts of South America (Brazil, Venezuela, Suriname), the Caribbean, China (Yangtze river basin), the Philippines, and the Mekong River basin."}, {"name": "Schistosoma haematobium", "type": "Pathogen", "description": "Digenean blood trematode residing in the pelvic and vesical venous plexuses, shedding terminal-spined eggs into the urinary tract that trigger granulomatous inflammation, sandy patches, terminal hematuria, obstructive uropathy, and bladder squamous cell carcinoma."}, {"name": "Schistosoma mansoni", "type": "Pathogen", "description": "Digenean blood trematode residing in the inferior mesenteric venules, producing prominent lateral-spined eggs that lodge in the intestinal mucosa and embolize to intrahepatic portal venules, triggering intestinal polyposis and Symmers pipestem periportal fibrosis."}, {"name": "Schistosoma japonicum", "type": "Pathogen", "description": "Zoonotic blood fluke endemic to East and Southeast Asia (China, Philippines, Indonesia), dwelling in superior mesenteric venules with >40 mammalian reservoir hosts, shedding small eggs with a rudimentary lateral knob that cause severe hepatosplenic disease and cerebral neuroschistosomiasis."}, {"name": "Schistosoma mekongi and Schistosoma intercalatum", "type": "Pathogen", "description": "Localized schistosome species causing intestinal schistosomiasis; S. mekongi is endemic to the Mekong River basin in Cambodia and Laos, while S. intercalatum is localized to Central and West African rainforest regions."}, {"name": "Painless Terminal Hematuria in Urogenital Disease", "type": "Cardinal_Sign", "description": "The pathognomonic physical hallmark of active urogenital S. haematobium schistosomiasis, occurring in >80% of affected children and adolescents, characterized by bright red blood voided selectively at the final conclusion of micturition due to detrusor contraction against egg-infiltrated bladder mucosa."}, {"name": "Preserved Hepatic Synthetic Function Despite Severe Presinusoidal Portal Hypertension", "type": "Cardinal_Sign", "description": "Critical diagnostic hallmark of chronic hepatosplenic schistosomiasis: intact hepatocellular protein synthesis and coagulation (normal serum albumin, normal PT/INR, absence of jaundice, absence of spider angiomas, and absence of hepatic encephalopathy) in the presence of massive splenomegaly, caput medusae, and catastrophic esophageal variceal hemorrhage."}, {"name": "Acute Katayama Syndrome with Serum Sickness-Like Hypersensitivity Reaction", "type": "Cardinal_Sign", "description": "Systemic immune-complex hypersensitivity syndrome occurring 2 to 8 weeks after initial cercarial exposure in non-immune individuals, characterized by abrupt high-spiking fevers, shaking chills, generalized urticaria, periorbital angioedema, nocturnal dry cough, wheezing, prostration, and tender hepatosplenomegaly."}, {"name": "Cystoscopic Sandy Patches and Bladder Granulomatous Pseudopolyps", "type": "Cardinal_Sign", "description": "Pathognomonic cystoscopic appearance in urogenital schistosomiasis showing submucosal calcified degenerated egg clusters resembling grains of beach sand (sandy patches) alongside hyperplastic inflammatory pseudopolyps in the bladder mucosa."}, {"name": "Acute Lumbosacral Myeloradiculopathy via Batson Vertebral Venous Plexus", "type": "Cardinal_Sign", "description": "Severe ectopic neuroschistosomiasis manifestation (predominantly S. mansoni) where eggs travel through Batson valveless vertebral venous plexus into the spinal cord, presenting as acute transverse myelitis or subacute myeloradiculopathy with flaccid paraplegia, T11-L1 sensory level, and urinary retention."}, {"name": "Female Genital Schistosomiasis with Sandy Patches and Post-Coital Bleeding", "type": "Cardinal_Sign", "description": "Urogenital involvement in women presenting with granulomatous vulvovaginal and cervical sandy patches, contact/post-coital bleeding, pelvic dyspareunia, subfertility, and markedly heightened biological susceptibility to HIV acquisition."}, {"name": "Symmers Clay-Pipe Stem Periportal Fibrosis on Ultrasound", "type": "Admission_Lab_Imaging", "description": "Bedside abdominal ultrasound findings (WHO Niamey protocol) demonstrating dense, echogenic fibrous sleeves collar-wrapping intrahepatic portal vein branches (pipestem, doughnut, or bullseye sign, cuff thickness >4-6 mm) with dilated main portal vein (>12-14 mm), massive splenomegaly, and preserved smooth liver margins."}, {"name": "Urine Polycarbonate Membrane Filtration Revealing Terminal-Spined Eggs", "type": "Admission_Lab_Imaging", "description": "Gold standard admission microscopic parasitology for S. haematobium: polycarbonate or nylon filter filtration of 10 mL daytime urine (collected between 10:00 and 14:00) identifying characteristic large, oval, transparent eggs (110-170 x 40-70 µm) bearing a sharp, distinct terminal spine."}, {"name": "Kato-Katz Smear Revealing Lateral-Spined or Lateral-Knobbed Schistosome Eggs", "type": "Admission_Lab_Imaging", "description": "Microscopic examination of fecal smears via Kato-Katz thick smear or formalin-ether concentration demonstrating golden-brown eggs with a prominent, sharp lateral spine (S. mansoni, 114-180 x 45-70 µm) or smaller subglobular eggs with an inconspicuous lateral knob (S. japonicum, 70-100 x 50-70 µm)."}, {"name": "Striking Peripheral Blood Eosinophilia on Admission CBC", "type": "Admission_Lab_Imaging", "description": "Complete blood count hallmark demonstrating dramatic peripheral eosinophilia (>20-50% of differential, absolute eosinophil count >3,000-8,000/µL) during acute Katayama syndrome, and persistent mild-to-moderate eosinophilia (5-15%) in chronic active infections."}, {"name": "Point-of-Care Urine Circulating Cathodic Antigen Detection", "type": "Admission_Lab_Imaging", "description": "Rapid lateral flow urine cassette test (POC-CCA) detecting regurgitated gut proteoglycans of active, living adult Schistosoma mansoni flukes within 20 minutes with high sensitivity at admission/triage."}, {"name": "Urinary Tract Ultrasound Demonstrating Bladder Wall Thickening and Hydroureteronephrosis", "type": "Admission_Lab_Imaging", "description": "Bedside urinary tract sonography showing irregular, thickened bladder mucosa (>5 mm), luminal pseudopolyps, bladder wall calcifications, and obstructive ureterovesical pathology leading to unilateral or bilateral hydroureter and hydronephrosis."}, {"name": "Complete Absence of Freshwater Immersion or Exposure in Endemic Regions", "type": "Exclusion_Criterion", "description": "Total lack of any lifetime or travel-related exposure to freshwater bodies (lakes, rivers, ponds, irrigation streams) in recognized schistosomiasis-endemic regions effectively rules out schistosome infection."}, {"name": "Total Absence of Microscopic Hematuria on Urinalysis Dipsticks and Normal Bladder Ultrasound", "type": "Exclusion_Criterion", "description": "Complete absence of microhematuria on repeated reagent strip urinalyses combined with entirely normal bladder wall thickness and architecture on ultrasound virtually excludes active urogenital S. haematobium infection."}, {"name": "Absence of Peripheral Blood Eosinophilia During Acute Febrile Presentation", "type": "Exclusion_Criterion", "description": "Absence of peripheral eosinophilia on admission complete blood count during an acute febrile multisystem illness following freshwater contact strongly argues against acute Katayama syndrome schistosomiasis."}, {"name": "Cirrhosis of the Liver", "type": "Disease", "description": "Diffuse chronic end-stage parenchymal liver disease characterized by architectural distortion, regenerative nodules, and severe hepatocellular synthetic impairment (hypoalbuminemia, prolonged PT/INR, direct hyperbilirubinemia, and hepatic encephalopathy)."}, {"name": "Visceral Leishmaniasis", "type": "Disease", "description": "Systemic protozoan infection caused by Leishmania donovani species complex, characterized by prolonged undulating fevers, massive splenomegaly, pancytopenia without eosinophilia, and intracellular Leishman-Donovan bodies in bone marrow or splenic tissue."}, {"name": "Bacterial Urinary Tract Infection", "type": "Disease", "description": "Acute bacterial cystitis or pyelonephritis caused by uropathogens (e.g., E. coli), presenting with dysuria throughout micturition, pyuria, positive urine nitrite/leukocyte esterase, positive bacterial culture, and response to standard antibacterial therapy."}, {"name": "Urothelial Bladder Carcinoma", "type": "Disease", "description": "Primary transitional cell carcinoma of the urinary bladder typically arising in older individuals with a history of tobacco exposure, manifesting as painless continuous hematuria and irregular exophytic papillary masses on cystoscopy."}, {"name": "Praziquantel Chemotherapy", "type": "Drug_Response", "description": "Oral anthelmintic agent of choice (40 mg/kg for S. haematobium/S. mansoni; 60 mg/kg for S. japonicum/S. mekongi) causing rapid tegumental vacuolization, calcium influx, muscular paralysis, and immune-mediated clearance of adult schistosomes, achieving >90% egg excretion reduction and >75-90% cure rates."}, {"name": "Systemic Corticosteroid Suppression for Acute Katayama Syndrome", "type": "Drug_Response", "description": "Corticosteroid therapy (prednisone 0.5-2.0 mg/kg/day) that suppresses severe immune-complex hypersensitivity, pulmonary infiltrates, and systemic inflammation in acute Katayama syndrome before introducing delayed praziquantel once worms reach maturity."}, {"name": "Praziquantel Refractoriness in Immature Migrating Schistosomula", "type": "Drug_Response", "description": "Biological insensitivity of juvenile migrating schistosomula (<4-6 weeks of age) to praziquantel; premature praziquantel monotherapy fails to kill immature larvae and may precipitate severe paradoxical immune reactions in acute infection."}, {"name": "Standard Antibacterial and Antiprotozoal Agents", "type": "Drug_Response", "description": "Standard antimicrobial classes (fluoroquinolones, cephalosporins, cotrimoxazole, metronidazole) which lack any antiparasitic activity against Schistosoma trematodes and result in complete therapeutic non-response."}], "relationships": [{"source": "Schistosomiasis", "target": "Freshwater Cercarial Percutaneous Penetration via Aquatic Snail Intermediate Hosts", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] Transmission occurs via direct percutaneous penetration of intact human skin by free-swimming cercariae shed by intermediate aquatic snail hosts (Biomphalaria, Bulinus, Oncomelania) during contact with infested freshwater lakes, rivers, or canals."}, {"source": "Schistosomiasis", "target": "Sub-Saharan Africa, Nile Basin, Neotropical and East Asian Endemic Regions", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Epidemiological exposure in high-risk geographic areas, predominantly sub-Saharan Africa (>90% of global cases), Egypt/Sudan (Nile basin), parts of South America, the Caribbean, China, the Philippines, and Southeast Asia."}, {"source": "Schistosomiasis", "target": "Schistosoma haematobium", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Caused by Schistosoma haematobium, an adult blood fluke residing in the vesical and pelvic venous plexuses that sheds terminal-spined eggs, driving urogenital inflammation, hematuria, and bladder malignancy."}, {"source": "Schistosomiasis", "target": "Schistosoma mansoni", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Caused by Schistosoma mansoni, inhabiting the inferior mesenteric venules and shedding lateral-spined eggs into the liver and colonic wall to trigger intestinal ulceration and Symmers periportal fibrosis."}, {"source": "Schistosomiasis", "target": "Schistosoma japonicum", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Caused by Schistosoma japonicum, a zoonotic blood fluke inhabiting the superior mesenteric venules with mammalian reservoir hosts, inducing aggressive hepatosplenic fibrosis and cerebral neuroschistosomiasis."}, {"source": "Schistosomiasis", "target": "Schistosoma mekongi and Schistosoma intercalatum", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Caused by regional schistosome species Schistosoma mekongi (endemic to the Mekong River basin) and Schistosoma intercalatum (endemic to central and western Africa), producing localized intestinal schistosomiasis."}, {"source": "Schistosomiasis", "target": "Painless Terminal Hematuria in Urogenital Disease", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Painless, bright red hematuria occurring selectively at the very end of micturition is present in >80% of children and adolescents with urogenital S. haematobium, resulting from terminal contraction of the egg-studded bladder wall."}, {"source": "Schistosomiasis", "target": "Preserved Hepatic Synthetic Function Despite Severe Presinusoidal Portal Hypertension", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Critical hallmark of advanced hepatosplenic schistosomiasis: intact hepatic synthetic capacity (normal serum albumin, normal INR/PT, absence of jaundice, and absence of hepatic encephalopathy) despite massive splenomegaly, caput medusae, and life-threatening bleeding esophageal varices due to pure presinusoidal portal block sparing lobular parenchyma."}, {"source": "Schistosomiasis", "target": "Acute Katayama Syndrome with Serum Sickness-Like Hypersensitivity Reaction", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] High-spiking abrupt fevers, rigors, generalized urticaria, facial angioedema, nocturnal dry cough, wheezing, and tender hepatosplenomegaly arising 2 to 8 weeks post-immersion in non-immune individuals, provoked by circulating immune complexes against maturing schistosomula and initial oviposition."}, {"source": "Schistosomiasis", "target": "Cystoscopic Sandy Patches and Bladder Granulomatous Pseudopolyps", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Direct visual inspection or cystoscopy reveals classic sandy patches (rough, yellowish calcified ovular submucosal aggregations resembling beach sand) and hyperplastic granulomatous pseudopolyps in the bladder mucosa."}, {"source": "Schistosomiasis", "target": "Acute Lumbosacral Myeloradiculopathy via Batson Vertebral Venous Plexus", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Ectopic migration of schistosome eggs (predominantly S. mansoni) via Batson valveless vertebral venous plexus leads to acute spinal granulomatous compression, presenting with acute or subacute flaccid paraplegia, a sharp sensory level at T11-L1, lumbar radicular pain, and neurogenic urinary retention."}, {"source": "Schistosomiasis", "target": "Female Genital Schistosomiasis with Sandy Patches and Post-Coital Bleeding", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Granulomatous cervical, vaginal, and vulvar lesions featuring mucosal sandy patches, contact bleeding, post-coital hemorrhage, dyspareunia, and an elevated vulnerability to HIV acquisition."}, {"source": "Schistosomiasis", "target": "Symmers Clay-Pipe Stem Periportal Fibrosis on Ultrasound", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Point-of-care abdominal ultrasound (WHO Niamey protocol) demonstrates distinctive echogenic fibrous cuffs surrounding intrahepatic portal branches (pipestem, doughnut, or bullseye sign, periportal wall thickness >4-6 mm) with main portal vein dilation (>12-14 mm) and smooth liver surface contour."}, {"source": "Schistosomiasis", "target": "Urine Polycarbonate Membrane Filtration Revealing Terminal-Spined Eggs", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Microscopic filtration of 10 mL midday urine (collected between 10:00 and 14:00) through polycarbonate or nylon filters reveals definitive large transparent eggs (110-170 x 40-70 µm) bearing a sharp, terminal apical spine pathognomonic of Schistosoma haematobium."}, {"source": "Schistosomiasis", "target": "Kato-Katz Smear Revealing Lateral-Spined or Lateral-Knobbed Schistosome Eggs", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Stool Kato-Katz thick smear or formalin-ether concentration microscopically demonstrates diagnostic golden-brown eggs with a prominent sharp lateral spine (S. mansoni, 114-180 x 45-70 µm) or subglobular eggs with a subtle lateral knob (S. japonicum, 70-100 x 50-70 µm)."}, {"source": "Schistosomiasis", "target": "Striking Peripheral Blood Eosinophilia on Admission CBC", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Peripheral blood complete blood count on admission exhibits prominent eosinophilia (>20-50% of white blood cell differential, absolute count >3,000-8,000/µL in acute Katayama syndrome; 5-15% persistent eosinophilia in chronic phases)."}, {"source": "Schistosomiasis", "target": "Point-of-Care Urine Circulating Cathodic Antigen Detection", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Urine POC-CCA lateral flow dipstick test detects regurgitated adult worm gut proteoglycans within 20 minutes, serving as a rapid, sensitive biomarker for active Schistosoma mansoni infection."}, {"source": "Schistosomiasis", "target": "Urinary Tract Ultrasound Demonstrating Bladder Wall Thickening and Hydroureteronephrosis", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Bedside ultrasound of the urinary tract displays irregular thickening of the bladder wall (>5 mm), pseudopolyps, calcified bladder wall margins, ureteric strictures, and unilateral or bilateral hydroureter and hydronephrosis."}, {"source": "Schistosomiasis", "target": "Complete Absence of Freshwater Immersion or Exposure in Endemic Regions", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Absolute lack of history of recreational, domestic, or occupational skin contact with freshwater bodies in an endemic transmission zone effectively excludes schistosomiasis as the underlying etiology."}, {"source": "Schistosomiasis", "target": "Total Absence of Microscopic Hematuria on Urinalysis Dipsticks and Normal Bladder Ultrasound", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Persistent, complete absence of microhematuria across multiple chemical reagent dipsticks coupled with completely normal bladder wall morphology on ultrasound virtually excludes active urogenital Schistosoma haematobium disease."}, {"source": "Schistosomiasis", "target": "Absence of Peripheral Blood Eosinophilia During Acute Febrile Presentation", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Complete absence of peripheral blood eosinophilia during an acute febrile multisystem illness following freshwater immersion strongly argues against acute Katayama syndrome."}, {"source": "Schistosomiasis", "target": "Cirrhosis of the Liver", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from cirrhosis of the liver because hepatosplenic schistosomiasis causes pure presinusoidal portal hypertension that preserves normal hepatic synthetic function (normal albumin, normal coagulation PT/INR, absence of jaundice or encephalopathy) and maintains a smooth liver contour with ultrasound periportal pipestem collars, whereas cirrhosis displays diffuse parenchymal nodularity, small shrunken liver, and marked hepatocellular functional failure."}, {"source": "Schistosomiasis", "target": "Visceral Leishmaniasis", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from visceral leishmaniasis (kala-azar) which causes chronic undulating fever, profound pancytopenia without eosinophilia, and intracellular Leishman-Donovan amastigotes on bone marrow aspirate, whereas chronic hepatosplenic schistosomiasis is predominantly afebrile, preserves leukocyte lines, features peripheral eosinophilia, and exhibits Symmers periportal fibrosis."}, {"source": "Schistosomiasis", "target": "Bacterial Urinary Tract Infection", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from bacterial urinary tract infection which typically produces initial or continuous dysuria, significant pyuria, positive nitrite/leukocyte esterase, positive bacterial urine cultures, and swift clearance with antibacterial therapy, whereas urogenital schistosomiasis is characterized by terminal hematuria, eosinophilia, terminal-spined eggs, and total refractoriness to antibacterial agents."}, {"source": "Schistosomiasis", "target": "Urothelial Bladder Carcinoma", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from transitional cell urothelial carcinoma which presents in older patients with heavy tobacco exposure with continuous hematuria and exophytic transitional cell bladder masses, whereas schistosomal bladder pathology occurs in younger exposed patients, produces squamous cell carcinoma rather than urothelial carcinoma, shows bladder mural calcification, and demonstrates terminal-spined eggs on microscopy."}, {"source": "Schistosomiasis", "target": "Praziquantel Chemotherapy", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Patent mature schistosome infections demonstrate high parasitological cure and >90-95% egg reduction following oral praziquantel (40 mg/kg for S. mansoni/S. haematobium; 60 mg/kg for S. japonicum/S. mekongi), which disrupts parasite tegumental calcium channels and provokes immune-mediated clearance."}, {"source": "Schistosomiasis", "target": "Systemic Corticosteroid Suppression for Acute Katayama Syndrome", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Acute Katayama syndrome responds promptly to systemic corticosteroids (prednisone 0.5-2.0 mg/kg/day) by blunting life-threatening immune-complex hypersensitivity and tissue edema, allowing safe bridging to delayed praziquantel once worms mature."}, {"source": "Schistosomiasis", "target": "Praziquantel Refractoriness in Immature Migrating Schistosomula", "keywords": "INTRINSICALLY_RESISTANT_TO", "description": "[INTRINSICALLY_RESISTANT_TO] Immature migrating schistosomula (<4-6 weeks old) are intrinsically refractory to praziquantel, causing treatment failure if praziquantel is administered alone prematurely during early pre-patent infection."}, {"source": "Schistosomiasis", "target": "Standard Antibacterial and Antiprotozoal Agents", "keywords": "INTRINSICALLY_RESISTANT_TO", "description": "[INTRINSICALLY_RESISTANT_TO] Schistosoma flukes are intrinsically unresponsive to standard antibacterial (e.g., fluoroquinolones, penicillins), antifungal, and antiprotozoal drugs, failing to clear infection or abate egg excretion despite symptom overlap with bacterial cystitis or dysentery."}]}}
{"case_id": "scrub_typhus", "disease": "Scrub Typhus", "extraction": {"entities": [{"name": "Scrub Typhus", "type": "Disease", "description": "Acute life-threatening zoonotic febrile illness caused by Orientia tsutsugamushi and transmitted by larval trombiculid mites (chiggers), characterized by disseminated endothelial microvascular infection, perivascular cuffing vasculitis, and potential multiorgan failure."}, {"name": "Leptotrombidium Mite Larva Chigger Bite", "type": "Vector_Exposure", "description": "Painless bite from the microscopic six-legged larval stage of trombiculid mites (chiggers), predominantly Leptotrombidium deliense, L. akamushi, and L. fletcheri, which feed on liquefied host epidermal tissue."}, {"name": "Scrub Vegetation & Agricultural Terrain Exposure", "type": "Vector_Exposure", "description": "Occupational or recreational exposure to overgrown secondary scrub vegetation, grasslands, forest fringes, riverbanks, or rice fields ('scrub typhus islands') during weeding, harvesting, or monsoon periods."}, {"name": "Tsutsugamushi Triangle Endemic Residence or Travel", "type": "Vector_Exposure", "description": "Residence in or travel to the endemic Asia-Pacific Tsutsugamushi Triangle spanning South, Southeast, and East Asia to Northern Australia, as well as emerging focal areas in South America (Chile) and Africa."}, {"name": "Orientia tsutsugamushi", "type": "Pathogen", "description": "Obligate intracellular Gram-negative alphaproteobacterium that selectively infects microvascular endothelial cells and monocyte-macrophages, inducing disseminated microvascular leakage and systemic inflammation."}, {"name": "Cigarette-Burn Cutaneous Necrotic Eschar in Flexural Folds", "type": "Cardinal_Sign", "description": "Pathognomonic primary cutaneous lesion beginning as an indolent erythematous macule/papule that ulcerates into a black necrotic crust with an erythematous halo resembling a cigarette burn, primarily in warm, moist, intertriginous skin folds (groin, axilla, perineum, sub-mammary creases, waistline)."}, {"name": "Regional Tender Lymphadenopathy Draining Eschar", "type": "Cardinal_Sign", "description": "Painful, tender enlargement of localized lymph node basins draining the cutaneous eschar site appearing early in the illness course and preceding generalized lymphadenopathy."}, {"name": "Acute Sensorineural Hearing Loss and Tinnitus", "type": "Cardinal_Sign", "description": "Sudden-onset subjective hearing impairment, tinnitus, or bilateral sensory deafness occurring in 20–35% of patients during acute infection due to cranial nerve VIII or cochlear microvasculitis."}, {"name": "Bilateral Non-Purulent Bulbar Conjunctival Suffusion", "type": "Cardinal_Sign", "description": "Prominent bilateral bulbar conjunctival hyperemia and injection without purulent discharge or exudate, frequently accompanied by subconjunctival hemorrhages and photophobia."}, {"name": "Centrifugal Trunk-to-Extremity Maculopapular Exanthem", "type": "Cardinal_Sign", "description": "Transient non-pruritic erythematous maculopapular eruption appearing on the trunk around days 4 to 6 of fever, spreading centrifugally to proximal extremities and fading over several days."}, {"name": "Normal WBC with Prominent Bandemia and Moderate Thrombocytopenia", "type": "Admission_Lab_Imaging", "description": "Admission complete blood count pattern showing normal or mild leukocyte counts (8,000–14,000/µL) with prominent toxic left shift (bandemia >10%) and moderate thrombocytopenia (platelets 50,000–100,000/µL)."}, {"name": "Marked CRP Elevation with Disproportionate Transaminitis", "type": "Admission_Lab_Imaging", "description": "Substantially elevated acute-phase C-reactive protein (CRP > 50–100 mg/L) paired with 2–5x ULN elevation of AST and ALT transaminases and mild alkaline phosphatase elevation reflecting acute endothelial and hepatic injury."}, {"name": "Bilateral Reticulonodular Interstitial Infiltrates on Triage Chest Radiograph", "type": "Admission_Lab_Imaging", "description": "Triage plain chest radiograph showing prominent bronchovascular markings, Kerley B lines, bilateral reticulonodular interstitial infiltrates, and small reactive pleural effusions consistent with interstitial pneumonitis."}, {"name": "Mild-to-Moderate Hepatosplenomegaly on Bedside Ultrasound", "type": "Admission_Lab_Imaging", "description": "Point-of-care abdominal ultrasound demonstrating diffuse homogeneous splenomegaly and hepatomegaly in the absence of focal liver abscesses, intrahepatic biliary dilatation, or gallbladder wall edema."}, {"name": "Failure to Defervesce Within 48 to 72 Hours of Doxycycline Therapy", "type": "Exclusion_Criterion", "description": "Persistence of high fever and clinical failure despite 48 to 72 hours of appropriate oral or intravenous doxycycline or azithromycin therapy strongly excludes uncomplicated scrub typhus."}, {"name": "Purulent Exudative Skin Ulcer or Fluctuant Subcutaneous Abscess", "type": "Exclusion_Criterion", "description": "Presence of purulent drainage, frank exudate, or fluctuant subcutaneous abscess formation at a cutaneous lesion site rules out the characteristically dry, indolent, non-purulent necrotic eschar of scrub typhus."}, {"name": "Severe Leukocytosis Exceeding 20,000/µL Without Secondary Infection", "type": "Exclusion_Criterion", "description": "Marked leukocytosis (>20,000/µL) at admission in the absence of concurrent pyogenic bacterial superinfection strongly argues against uncomplicated scrub typhus."}, {"name": "Normal C-Reactive Protein Under 10 mg/L in Sustained High Fever", "type": "Exclusion_Criterion", "description": "Normal or near-normal C-reactive protein level (<10 mg/L) in a patient with sustained high remittent fever strongly rules out scrub typhus, which uniformly triggers intense endothelial inflammation with CRP > 50 mg/L."}, {"name": "Dengue", "type": "Disease", "description": "Arboviral illness presenting with acute high fever, severe retro-orbital pain, arthralgia, and early critical-phase plasma leakage."}, {"name": "Leptospirosis", "type": "Disease", "description": "Zoonotic spirochetal infection transmitted via freshwater/urine contact presenting with high fever, conjunctival suffusion, severe calf pain, and jaundice."}, {"name": "Malaria", "type": "Disease", "description": "Mosquito-borne intraerythrocytic parasitic infection presenting with paroxysmal fevers, rigors, hemolytic anemia, and splenomegaly."}, {"name": "Murine Typhus", "type": "Disease", "description": "Flea-borne rickettsiosis caused by Rickettsia typhi endemic to urban, suburban, and port environments associated with rodents."}, {"name": "Rapid Defervescence Within 48 Hours of Doxycycline Therapy", "type": "Drug_Response", "description": "Complete temperature normalization and symptomatic relief within 24 to 48 hours of starting oral or IV Doxycycline (100 mg twice daily), serving as a diagnostic therapeutic confirmation hallmark."}, {"name": "Clinical Defervescence with Oral Azithromycin Therapy", "type": "Drug_Response", "description": "Rapid clinical cure and fever clearance following oral Azithromycin (500 mg once daily for 3–5 days), serving as the first-line therapeutic regimen for pregnant patients, children, and doxycycline-tolerant geographic strains."}, {"name": "Intrinsic Resistance to Beta-Lactams Aminoglycosides and Fluoroquinolones", "type": "Drug_Response", "description": "Orientia tsutsugamushi possesses total intrinsic resistance to penicillins, cephalosporins (e.g. ceftriaxone), carbapenems, aminoglycosides, and fluoroquinolones; empirical administration leads to therapeutic failure and progressive clinical deterioration."}], "relationships": [{"source": "Scrub Typhus", "target": "Leptotrombidium Mite Larva Chigger Bite", "keywords": "TRANSMITTED_BY, vector transmission, trombiculid mite, chigger bite", "description": "[TRANSMITTED_BY] Scrub Typhus is transmitted exclusively through the bite of the microscopic six-legged larva of trombiculid mites (chiggers), predominantly Leptotrombidium deliense, L. akamushi, and L. fletcheri, during extracellular host tissue feeding."}, {"source": "Scrub Typhus", "target": "Scrub Vegetation & Agricultural Terrain Exposure", "keywords": "EXPOSURE_TO, environmental risk, agricultural hazard, occupational exposure", "description": "[EXPOSURE_TO] Acquisition occurs following outdoor occupational or recreational exposure to neglected scrub vegetation, secondary grasslands, forest fringes, riverbanks, or rice fields ('scrub typhus islands') during weeding, harvesting, or monsoon periods."}, {"source": "Scrub Typhus", "target": "Tsutsugamushi Triangle Endemic Residence or Travel", "keywords": "EXPOSURE_TO, geographic endemicity, travel history, Tsutsugamushi Triangle", "description": "[EXPOSURE_TO] Endemic to the expansive Tsutsugamushi Triangle covering South Asia, Southeast Asia, East Asia, and Northern Australia, with emerging documented foci in South America (Chile) and Africa."}, {"source": "Scrub Typhus", "target": "Orientia tsutsugamushi", "keywords": "HAS_PATHOGEN, causative agent, microbiology, obligate intracellular", "description": "[HAS_PATHOGEN] Scrub Typhus is caused by Orientia tsutsugamushi, an obligate intracellular Gram-negative alphaproteobacterium that selectively invades vascular endothelial cells, triggering disseminated vasculitis and perivascular cuffing."}, {"source": "Scrub Typhus", "target": "Cigarette-Burn Cutaneous Necrotic Eschar in Flexural Folds", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, cutaneous eschar", "description": "[HAS_PATHOGNOMONIC_HALLMARK] The pathognomonic cutaneous eschar is a painless, non-pruritic black necrotic crust with an indurated erythematous halo resembling a cigarette burn, identified in 50–90% of patients upon thorough search of warm, moist flexural areas (groin, axilla, perineum, sub-mammary folds, waistline)."}, {"source": "Scrub Typhus", "target": "Regional Tender Lymphadenopathy Draining Eschar", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, cardinal sign, localized adenopathy, lymphatic drainage", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Marked enlargement and tenderness of the regional lymph nodes draining the anatomical site of the eschar is present in the acute phase, preceding generalized lymphadenopathy."}, {"source": "Scrub Typhus", "target": "Acute Sensorineural Hearing Loss and Tinnitus", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, sensory hallmark, cranial neuropathy, cochlear vasculitis", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Acute sensorineural hearing impairment, tinnitus, or subjective deafness occurs in 20–35% of patients during acute febrile illness secondary to cranial nerve VIII or cochlear microvasculitis, serving as a highly specific diagnostic indicator."}, {"source": "Scrub Typhus", "target": "Bilateral Non-Purulent Bulbar Conjunctival Suffusion", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, ocular hallmark, conjunctival suffusion, microvascular injection", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Striking bilateral bulbar conjunctival hyperemia and suffusion without purulent discharge or exudate occurs during the acute febrile phase due to ocular microvascular endothelial involvement."}, {"source": "Scrub Typhus", "target": "Centrifugal Trunk-to-Extremity Maculopapular Exanthem", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, exanthem, maculopapular rash, systemic vasculitis", "description": "[HAS_PATHOGNOMONIC_HALLMARK] A transient, erythematous, non-pruritic maculopapular rash appears over the trunk around illness days 4 to 6, spreading centrifugally to the proximal extremities and fading over several days."}, {"source": "Scrub Typhus", "target": "Normal WBC with Prominent Bandemia and Moderate Thrombocytopenia", "keywords": "EXHIBITS_LAB_PATTERN, admission lab, CBC, left shift, thrombocytopenia", "description": "[EXHIBITS_LAB_PATTERN] Admission complete blood count typically demonstrates a normal or mildly elevated white blood cell count (8,000–14,000/µL) paired with prominent toxic left shift (bandemia >10%) and moderate thrombocytopenia (platelets 50,000–100,000/µL)."}, {"source": "Scrub Typhus", "target": "Marked CRP Elevation with Disproportionate Transaminitis", "keywords": "EXHIBITS_LAB_PATTERN, admission lab, inflammatory markers, LFT, CRP", "description": "[EXHIBITS_LAB_PATTERN] Marked elevation of C-reactive protein (CRP > 50–100 mg/L) paired with moderate AST and ALT transaminitis (2–5x upper limit of normal) reflects acute systemic endothelial injury and distinguishes scrub typhus from common viral infections."}, {"source": "Scrub Typhus", "target": "Bilateral Reticulonodular Interstitial Infiltrates on Triage Chest Radiograph", "keywords": "EXHIBITS_LAB_PATTERN, admission imaging, chest radiograph, interstitial pneumonitis", "description": "[EXHIBITS_LAB_PATTERN] Plain chest radiography at admission reveals bilateral reticulonodular interstitial opacities, prominent bronchovascular markings, Kerley B lines, and mild reactive pleural effusions consistent with rickettsial interstitial pneumonitis."}, {"source": "Scrub Typhus", "target": "Mild-to-Moderate Hepatosplenomegaly on Bedside Ultrasound", "keywords": "EXHIBITS_LAB_PATTERN, admission imaging, POCUS ultrasound, organomegaly", "description": "[EXHIBITS_LAB_PATTERN] Bedside ultrasound demonstrates homogeneous splenomegaly and hepatomegaly without focal hepatic abscesses, biliary tract dilation, or prominent gallbladder wall thickening."}, {"source": "Scrub Typhus", "target": "Failure to Defervesce Within 48 to 72 Hours of Doxycycline Therapy", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, treatment failure", "description": "[RULED_OUT_BY] Failure of a febrile patient to show clinical defervescence and symptomatic improvement within 48 to 72 hours of appropriate oral or IV doxycycline therapy strongly rules out uncomplicated scrub typhus and necessitates immediate alternate evaluation."}, {"source": "Scrub Typhus", "target": "Purulent Exudative Skin Ulcer or Fluctuant Subcutaneous Abscess", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, lesion morphology", "description": "[RULED_OUT_BY] Presence of purulent, fluctuant, or grossly suppurative skin ulcers rules out the characteristically dry, indolent, non-purulent cigarette-burn necrotic eschar of scrub typhus."}, {"source": "Scrub Typhus", "target": "Severe Leukocytosis Exceeding 20,000/µL Without Secondary Infection", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, CBC cutoff", "description": "[RULED_OUT_BY] Severe leukocytosis (WBC > 20,000/µL) at admission in the absence of documented bacterial superinfection strongly argues against scrub typhus, which characteristically presents with normal or mildly elevated leukocytes."}, {"source": "Scrub Typhus", "target": "Normal C-Reactive Protein Under 10 mg/L in Sustained High Fever", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, normal inflammatory markers", "description": "[RULED_OUT_BY] A normal or near-normal C-reactive protein (<10 mg/L) in a patient presenting with sustained high fever (>39°C) and acute illness strongly excludes scrub typhus, which reliably induces intense systemic inflammation with CRP > 50 mg/L."}, {"source": "Scrub Typhus", "target": "Dengue", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, dengue", "description": "[DIFFERENTIATED_FROM] Dengue presents with profound leukopenia (WBC < 4,000/µL), critical hemoconcentration (hematocrit rise >= 20%), gallbladder wall thickening, and plasma leakage at defervescence; Dengue NEVER presents with a necrotic cigarette-burn eschar, acute sensorineural deafness, prominent localized lymphadenopathy, or high CRP (> 50 mg/L)."}, {"source": "Scrub Typhus", "target": "Leptospirosis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, leptospirosis", "description": "[DIFFERENTIATED_FROM] Leptospirosis features marked neutrophilic leukocytosis (WBC > 15,000/µL), severe gastrocnemius calf tenderness, deep conjugated hyperbilirubinemia, and oliguric acute renal failure following freshwater immersion; Leptospirosis does NOT cause a cigarette-burn cutaneous eschar or acute sensorineural hearing loss."}, {"source": "Scrub Typhus", "target": "Malaria", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, malaria", "description": "[DIFFERENTIATED_FROM] Malaria is characterized by periodic teeth-chattering rigors, marked hemolytic anemia (unconjugated hyperbilirubinemia, elevated LDH, low haptoglobin), and blood smears positive for intraerythrocytic Plasmodium parasites; Malaria lacks an eschar, regional lymphadenopathy, and sensorineural deafness."}, {"source": "Scrub Typhus", "target": "Murine Typhus", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, murine typhus", "description": "[DIFFERENTIATED_FROM] Murine typhus (Rickettsia typhi) is transmitted by rat fleas in urban port environments rather than chiggers in rural scrub vegetation, exceptionally rarely produces an eschar (<1%), and does not cause acute sensorineural hearing loss."}, {"source": "Scrub Typhus", "target": "Rapid Defervescence Within 48 Hours of Doxycycline Therapy", "keywords": "RESPONDS_TO, therapeutic verification, doxycycline, diagnostic therapeutic trial", "description": "[RESPONDS_TO] Administration of oral or intravenous Doxycycline (100 mg twice daily) results in rapid defervescence, reduction of severe headache, and hemodynamic stabilization within 24 to 48 hours, acting as a diagnostic therapeutic hallmark."}, {"source": "Scrub Typhus", "target": "Clinical Defervescence with Oral Azithromycin Therapy", "keywords": "RESPONDS_TO, therapeutic verification, azithromycin, macrolide therapy", "description": "[RESPONDS_TO] Administration of oral Azithromycin (500 mg once daily for 3–5 days) achieves rapid fever clearance and cure rates equivalent to doxycycline, serving as the first-line therapeutic regimen for pregnant patients, children, and regions with doxycycline-tolerant strains."}, {"source": "Scrub Typhus", "target": "Intrinsic Resistance to Beta-Lactams Aminoglycosides and Fluoroquinolones", "keywords": "INTRINSICALLY_RESISTANT_TO, antibiotic failure, intrinsic resistance, beta-lactam", "description": "[INTRINSICALLY_RESISTANT_TO] Orientia tsutsugamushi is naturally intrinsically resistant to all beta-lactams (penicillins, cephalosporins including ceftriaxone, carbapenems), aminoglycosides, and fluoroquinolones (ciprofloxacin); empirical treatment with these agents results in persistent fever, multi-organ deterioration, and avoidable mortality."}]}}
{"case_id": "soil_transmitted_helminths", "disease": "Soil-Transmitted Helminths", "extraction": {"entities": [{"name": "Soil-Transmitted Helminths", "type": "Disease", "description": "A major cluster of neglected tropical intestinal nematode infections transmitted through human contact with fecally contaminated soil, predominantly comprising Ascaris lumbricoides, Trichuris trichiura, hookworms (Necator americanus and Ancylostoma duodenale), and Strongyloides stercoralis. The infections manifest with acute transpulmonary larval migration, chronic microcytic iron-deficiency anemia, protein-losing enteropathy, mechanical intestinal or hepatobiliary obstruction, trichuris dysentery with rectal prolapse, and life-threatening disseminated strongyloidiasis in immunosuppressed hosts."}, {"name": "Fecal-Oral Ingestion of Infective Embryonated Eggs from Contaminated Soil or Food", "type": "Vector_Exposure", "description": "Transmission pathway involving the oral ingestion of infective embryonated eggs of Ascaris lumbricoides or Trichuris trichiura from fecally contaminated agricultural soil, unwashed vegetables and fruit, contaminated water, or soil-soiled hands, common in environments utilizing untreated human nightsoil."}, {"name": "Percutaneous Penetration by Infective Filariform Larvae in Warm Moist Soil", "type": "Vector_Exposure", "description": "Direct transcutaneous inoculation pathway where free-living, infective third-stage filariform larvae of hookworms (Necator americanus, Ancylostoma duodenale) or Strongyloides stercoralis actively bore through bare human skin (typically feet, toes, or ankles) walking or resting on warm, shaded, fecally contaminated ground."}, {"name": "Rural Tropical and Subtropical Communities with Inadequate Sanitation and Open Defecation", "type": "Vector_Exposure", "description": "Environmental exposure characterized by residence in or travel through impoverished rural tropical and subtropical regions lacking basic latrines, municipal wastewater infrastructure, or clean drinking water, where frequent open defecation sustains intense environmental contamination with helminth ova and larvae."}, {"name": "Immunosuppressive State or Systemic Corticosteroid Therapy Predisposing to Hyperinfection", "type": "Vector_Exposure", "description": "Host predisposing condition of impaired cell-mediated immunity—most notably high-dose systemic corticosteroid administration, immunosuppressive antineoplastic chemotherapy, organ transplantation, or HTLV-1 co-infection—triggering accelerated Strongyloides stercoralis autoinfection leading to lethal disseminated hyperinfection syndrome."}, {"name": "Ascaris lumbricoides", "type": "Pathogen", "description": "The giant intestinal nematode roundworm measuring 15 to 35 cm in length that inhabits the lumen of the jejunum and ileum. Adult females produce up to 200,000 thick-shelled mammillated eggs per day, and large aggregated worm burdens cause mechanical intestinal occlusion or erratic migration into the biliary tree."}, {"name": "Trichuris trichiura", "type": "Pathogen", "description": "The human whipworm measuring 3 to 5 cm in length, possessing an attenuated, whip-like anterior three-fifths that embeds securely within cecal and colonic mucosal syncytia, producing characteristic barrel-shaped eggs with bipolar plugs and causing mucosal inflammation and capillary hemorrhage."}, {"name": "Necator americanus", "type": "Pathogen", "description": "The New World intestinal hookworm (8 to 11 mm cylindrical nematode) possessing paired semilunar cutting plates in its buccal capsule, attaching securely to duodenal and jejunal mucosa, lacerating capillaries, and ingesting approximately 0.03 to 0.05 mL of host blood per worm daily."}, {"name": "Ancylostoma duodenale", "type": "Pathogen", "description": "The Old World hookworm (10 to 13 mm cylindrical nematode) equipped with ventral pairs of curved cutting teeth, attaching to the upper small intestine and causing severe mucosal blood loss of up to 0.2 mL of host blood per worm daily, leading to rapid iron and protein depletion."}, {"name": "Strongyloides stercoralis", "type": "Pathogen", "description": "A minute intestinal threadworm (2 mm parthenogenetic parasitic female) residing in duodenal mucosa that undergoes an endogenous autoinfective cycle where rhabditiform larvae transform internally into infectious filariform larvae, enabling decades-long persistent infections without environmental re-exposure."}, {"name": "Ground Itch Papulovesicular Pruritic Dermatitis", "type": "Cardinal_Sign", "description": "Intensely pruritic, erythematous, papular or vesicular dermatologic eruption arising on the dorsum of the feet, soles, or interdigital webbing at the exact anatomical site of cutaneous hookworm larval penetration within hours to days of contact with infested soil."}, {"name": "Larva Currens Rapidly Advancing Serpiginous Urticarial Wheal", "type": "Cardinal_Sign", "description": "Pathognomonic cutaneous hallmark of Strongyloides stercoralis autoinfection, presenting as an excruciatingly itchy, raised, erythematous, linear serpiginous urticarial wheal that advances at a remarkably rapid velocity of 5 to 10 cm per hour over the perianal area, buttocks, thighs, or trunk."}, {"name": "Rectal Prolapse Studded with White Whipworms in Trichuris Dysentery Syndrome", "type": "Cardinal_Sign", "description": "Pathognomonic physical hallmark of severe pediatric whipworm infection (Trichuris Dysentery Syndrome), characterized by edematous, hyperemic rectal mucosa prolapsing through the anal sphincter during painful defecation, visibly encrusted with dozens of embedded white, thread-like adult Trichuris trichiura worms."}, {"name": "Mechanical Bowel Obstruction with Palpable Doughy Abdominal Mass from Ascaris Worm Bolus", "type": "Cardinal_Sign", "description": "Acute mechanical intestinal obstruction seen in young children harboring massive worm burdens (>100 to >1,000 adult roundworms) that aggregate into a solid luminal bolus occluding the ileocecal valve, manifesting with colicky abdominal pain, bilious vomiting, obstipation, and a moveable, non-tender doughy mass on abdominal palpation."}, {"name": "Erratic Biliary Ascariasis with Acute Suppurative Cholangitis or Biliary Colic", "type": "Cardinal_Sign", "description": "Severe hepatobiliary complication arising when adult Ascaris roundworms erratically migrate into the ampulla of Vater and common bile duct, precipitating excruciating right upper quadrant biliary colic, acute suppurative cholangitis, acute pancreatitis, or hepatic microabscesses."}, {"name": "Löffler Syndrome Transient Eosinophilic Pulmonary Infiltrates", "type": "Cardinal_Sign", "description": "Acute hypersensitivity pneumonitis occurring during the transpulmonary migration of helminth larvae (Ascaris, hookworms, Strongyloides) breaking through alveolar capillaries, presenting with dry hacking cough, burning substernal pain, wheezing, dyspnea, and transient migratory radiographic infiltrates."}, {"name": "Severe Microcytic Hypochromic Iron Deficiency Anemia from Chronic Hookworm Blood Loss", "type": "Admission_Lab_Imaging", "description": "Profound hypochromic microcytic anemia on admission complete blood count (hemoglobin < 7 g/dL, often 3–6 g/dL; MCV < 70 fL; serum ferritin < 10 ng/mL; elevated TIBC) accompanied by hypoalbuminemia (< 2.5 g/dL) caused by cumulative capillary blood extraction and protein-losing enteropathy from adult hookworms."}, {"name": "Peripheral Blood Eosinophilia during Larval Tissue Migration and Strongyloidiasis", "type": "Admission_Lab_Imaging", "description": "Marked elevation in peripheral eosinophil percentage and absolute count (20% to 50% during acute Löffler larval pulmonary migration; persistent 10% to 25% in chronic Strongyloides autoinfection), signaling systemic tissue-invasive helminthic immune activation."}, {"name": "Diagnostic Stool Microscopy Demonstrating Characteristic Helminth Eggs or Rhabditiform Larvae", "type": "Admission_Lab_Imaging", "description": "Definitive admission parasitological identification in stool via Kato-Katz smear or Baermann concentration showing mammillated thick-shelled Ascaris eggs (45–75 x 35–50 um), barrel-shaped Trichuris eggs with bipolar mucoid plugs (50–55 x 22–24 um), thin-shelled hookworm eggs containing morulae (60–75 x 35–40 um), or motile Strongyloides rhabditiform larvae (200–300 um)."}, {"name": "Abdominal Ultrasound Inner Tube Sign or Tangled Spaghetti Pattern", "type": "Admission_Lab_Imaging", "description": "Admission bedside ultrasonography demonstrating either non-shadowing, linear, hyperechoic tubular structures with an anechoic central longitudinal line ('strip sign' / 'inner tube sign') actively writhing within the common bile duct, or clustered acoustic shadowing tubular loops ('whirlpool' / 'tangled spaghetti sign') inside obstructed bowel."}, {"name": "Abdominal Radiography Railroad Track Linear Intestinal Filling Defects", "type": "Admission_Lab_Imaging", "description": "Admission plain abdominal radiography showing dilated bowel loops with multiple air-fluid levels, and barium contrast outlining distinctive parallel longitudinal linear filling defects ('railroad track sign') corresponding to adult roundworms in the small intestinal lumen."}, {"name": "Absence of Helminth Eggs and Larvae on Multiple Concentrated Stool Examinations", "type": "Exclusion_Criterion", "description": "Total absence of parasitic ova and larvae across three serial concentrated fecal examinations using Kato-Katz thick smear, formalin-ether concentration, and Baermann funnel techniques in an immunocompetent patient, which definitively excludes symptomatic moderate-to-heavy soil-transmitted helminthiasis."}, {"name": "Normal Hemoglobin Ferritin and Absolute Eosinophil Count", "type": "Exclusion_Criterion", "description": "Normal hemoglobin concentration (>12 g/dL), normal serum ferritin (>30 ng/mL), and normal absolute eosinophil count, the presence of which makes moderate-to-heavy hookworm disease and active invasive tissue helminthiasis virtually impossible."}, {"name": "Absence of Environmental Exposure to Fecally Contaminated Soil or Endemic Transmission Zones", "type": "Exclusion_Criterion", "description": "Confirmed absence of residence or travel to rural tropical/subtropical endemic areas with inadequate sanitation and lack of personal contact with nightsoil, unwashed produce, or barefoot soil walking, rendering soil-transmitted helminth transmission epidemiologically implausible."}, {"name": "Nutritional Iron Deficiency Anemia", "type": "Disease", "description": "Microcytic hypochromic anemia stemming strictly from inadequate dietary iron intake, poor iron bioavailability, or physiologic increased requirements without parasitic enteric blood loss."}, {"name": "Inflammatory Bowel Disease", "type": "Disease", "description": "Idiopathic autoimmune chronic inflammatory colitis (Ulcerative Colitis or Crohn's Disease) causing recurrent bloody mucoid diarrhea, tenesmus, abdominal cramping, and rectal mucosal inflammation in children and young adults."}, {"name": "Cutaneous Scabies Infestation", "type": "Disease", "description": "Contagious parasitic infestation of the epidermis by Sarcoptes scabiei mites presenting with pruritic burrow tracks, erythematous papules, and severe nocturnal itching."}, {"name": "Acute Mechanical Bowel Obstruction from Intussusception or Volvulus", "type": "Disease", "description": "Non-helminthic mechanical pediatric intestinal obstruction caused by telescoping of the bowel (ileocolic intussusception) or midgut twisting (volvulus) presenting with acute colicky abdominal pain, vomiting, and obstipation."}, {"name": "Choledocholithiasis and Acute Bacterial Cholangitis", "type": "Disease", "description": "Biliary tract obstruction produced by radiopaque or cholesterol gallstones impacted in the common bile duct, precipitating Charcot's triad of right upper quadrant pain, fever, and jaundice."}, {"name": "Single-Dose Oral Albendazole 400 mg", "type": "Drug_Response", "description": "Standard WHO first-line anthelmintic regimen comprising a single oral dose of 400 mg albendazole (200 mg for toddlers 12–24 months), which binds parasite beta-tubulin, achieving >95% cure rates against Ascaris lumbricoides and >80% cure against hookworms."}, {"name": "Oral Mebendazole 500 mg Single Dose or 100 mg Twice Daily for Three Days", "type": "Drug_Response", "description": "First-line benzimidazole anthelmintic regimen delivering mebendazole 500 mg single dose or 100 mg BID for 3 days, providing superior efficacy against Trichuris trichiura and significant clearance of adult Ascaris roundworms."}, {"name": "Oral Ivermectin 200 mcg per kg for Two Doses", "type": "Drug_Response", "description": "Highly specific macrocyclic lactone anthelmintic administered orally at 200 mcg/kg/day for 2 consecutive days, achieving >95% cure rates against Strongyloides stercoralis by opening glutamate-gated chloride channels, and serving as essential therapy for refractory Trichuris trichiura when paired with albendazole."}, {"name": "Intrinsic Resistance and Refractoriness of Strongyloides stercoralis to Benzimidazole Monotherapy", "type": "Drug_Response", "description": "Inherent biological tolerance and clinical failure of Strongyloides stercoralis when treated with standard single-dose or short-course albendazole or mebendazole, which fail to achieve parasitological cure and permit continuous life-threatening autoinfection."}, {"name": "Oral Ferrous Sulfate Iron Replacement Therapy", "type": "Drug_Response", "description": "Adjuvant oral iron supplementation (3 to 6 mg elemental iron/kg/day in children; 200 mg three times daily in adults) maintained for 3 months following anthelmintic deworming to fully replenish depleted bone marrow iron stores."}, {"name": "Conservative Decompression and Piperazine Citrate for Ascaris Intestinal Obstruction", "type": "Drug_Response", "description": "Conservative non-surgical therapeutic protocol comprising nasogastric decompression, fluid resuscitation, and oral piperazine citrate (which flaccidly paralyzes adult Ascaris worms via GABA-receptor agonism) allowing spontaneous peristaltic clearance of the obstructing worm mass."}, {"name": "Refractoriness to Standard Antibacterial and Antifungal Therapies", "type": "Drug_Response", "description": "Clinical failure of empiric broad-spectrum antibacterial or antifungal medications to eliminate helminthic infection, manifested by unremitting eosinophilia, ongoing gastrointestinal symptoms, and persistent fecal egg excretion."}], "relationships": [{"source": "Soil-Transmitted Helminths", "target": "Fecal-Oral Ingestion of Infective Embryonated Eggs from Contaminated Soil or Food", "keywords": "fecal-oral transmission, embryonated eggs, contaminated produce, unwashed vegetables, nightsoil", "description": "[TRANSMITTED_BY] Soil-Transmitted Helminths (specifically Ascaris lumbricoides and Trichuris trichiura) are transmitted through the ingestion of soil-matured embryonated infective eggs via contaminated hands, untreated drinking water, or unwashed produce grown in soil fertilized with human feces."}, {"source": "Soil-Transmitted Helminths", "target": "Percutaneous Penetration by Infective Filariform Larvae in Warm Moist Soil", "keywords": "percutaneous inoculation, filariform larvae, barefoot walking, skin penetration, hookworm transmission", "description": "[TRANSMITTED_BY] Soil-Transmitted Helminths (specifically Necator americanus, Ancylostoma duodenale, and Strongyloides stercoralis) are transmitted through active percutaneous penetration of bare skin by free-living third-stage filariform larvae when walking barefoot on warm, moist, fecally contaminated soil."}, {"source": "Soil-Transmitted Helminths", "target": "Rural Tropical and Subtropical Communities with Inadequate Sanitation and Open Defecation", "keywords": "tropical endemicity, open defecation, inadequate sanitation, rural poverty, environmental contamination", "description": "[EXPOSURE_TO] Soil-Transmitted Helminths infections are concentrated in impoverished rural tropical and subtropical regions where open defecation and the absence of municipal sanitary facilities lead to continuous contamination of the living environment with helminth ova and larvae."}, {"source": "Soil-Transmitted Helminths", "target": "Immunosuppressive State or Systemic Corticosteroid Therapy Predisposing to Hyperinfection", "keywords": "immunosuppression, corticosteroid risk, HTLV-1 co-infection, accelerated autoinfection, hyperinfection trigger", "description": "[EXPOSURE_TO] Soil-Transmitted Helminths (specifically Strongyloides stercoralis) progress to life-threatening hyperinfection syndrome and dissemination when exposed to host immunosuppressive conditions, particularly systemic corticosteroid therapy or HTLV-1 co-infection."}, {"source": "Soil-Transmitted Helminths", "target": "Ascaris lumbricoides", "keywords": "giant roundworm, etiologic agent, small intestinal nematode, Ascaris pathogen", "description": "[HAS_PATHOGEN] Soil-Transmitted Helminths include ascariasis, caused by the giant intestinal roundworm Ascaris lumbricoides, which parasitizes the lumen of the jejunum and ileum."}, {"source": "Soil-Transmitted Helminths", "target": "Trichuris trichiura", "keywords": "human whipworm, etiologic agent, colonic nematode, Trichuris pathogen", "description": "[HAS_PATHOGEN] Soil-Transmitted Helminths include trichuriasis, caused by the whipworm Trichuris trichiura, which embeds its thin anterior segment into the mucosal epithelium of the cecum and colon."}, {"source": "Soil-Transmitted Helminths", "target": "Necator americanus", "keywords": "New World hookworm, etiologic agent, cutting plates, intestinal blood loss", "description": "[HAS_PATHOGEN] Soil-Transmitted Helminths include hookworm disease caused by Necator americanus, which uses buccal cutting plates to attach to small bowel mucosa and ingest host blood."}, {"source": "Soil-Transmitted Helminths", "target": "Ancylostoma duodenale", "keywords": "Old World hookworm, etiologic agent, ventral teeth, mucosal hemorrhage", "description": "[HAS_PATHOGEN] Soil-Transmitted Helminths include hookworm disease caused by Ancylostoma duodenale, which uses sharp buccal teeth to lacerate mucosal vessels and cause severe intestinal blood loss."}, {"source": "Soil-Transmitted Helminths", "target": "Strongyloides stercoralis", "keywords": "human threadworm, autoinfective nematode, rhabditiform larvae, filariform autoinfection", "description": "[HAS_PATHOGEN] Soil-Transmitted Helminths include strongyloidiasis caused by Strongyloides stercoralis, an intestinal nematode uniquely capable of lifelong internal autoinfection and catastrophic dissemination."}, {"source": "Soil-Transmitted Helminths", "target": "Ground Itch Papulovesicular Pruritic Dermatitis", "keywords": "ground itch, larval entry, papulovesicular dermatitis, hookworm penetration, pruritic feet", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Soil-Transmitted Helminths produce 'ground itch'—an intensely pruritic, papulovesicular dermatitis at the dermal penetration sites of hookworm filariform larvae on the dorsum of feet and toes."}, {"source": "Soil-Transmitted Helminths", "target": "Larva Currens Rapidly Advancing Serpiginous Urticarial Wheal", "keywords": "larva currens, pathognomonic rash, rapid migration, urticarial wheal, Strongyloides hallmark", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Soil-Transmitted Helminths (specifically Strongyloides stercoralis) produce larva currens, a pathognomonic raised, erythematous, serpiginous linear wheal advancing at 5 to 10 cm per hour across the perianal skin, buttocks, and thighs."}, {"source": "Soil-Transmitted Helminths", "target": "Rectal Prolapse Studded with White Whipworms in Trichuris Dysentery Syndrome", "keywords": "rectal prolapse, visible whipworms, Trichuris dysentery syndrome, pathognomonic hallmark, pediatric tenesmus", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Soil-Transmitted Helminths (specifically heavy Trichuris trichiura infection in children) cause Trichuris Dysentery Syndrome with pathognomonic rectal prolapse displaying hyperemic mucosa visibly studded with dozens of white, thread-like adult whipworms."}, {"source": "Soil-Transmitted Helminths", "target": "Mechanical Bowel Obstruction with Palpable Doughy Abdominal Mass from Ascaris Worm Bolus", "keywords": "mechanical bowel obstruction, worm bolus, doughy mass, ileocecal obstruction, Ascaris mass", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Soil-Transmitted Helminths (specifically massive Ascaris lumbricoides burdens in young children) cause acute mechanical bowel obstruction where hundreds of coiled worms form an intraluminal bolus, presenting with bilious vomiting, abdominal distension, and a moveable, doughy abdominal mass."}, {"source": "Soil-Transmitted Helminths", "target": "Erratic Biliary Ascariasis with Acute Suppurative Cholangitis or Biliary Colic", "keywords": "biliary ascariasis, wandering worms, ampulla of Vater, suppurative cholangitis, biliary colic", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Soil-Transmitted Helminths feature erratic migration of adult Ascaris into the ampulla of Vater, presenting as acute right upper quadrant biliary colic, suppurative cholangitis, acute pancreatitis, or hepatic microabscesses."}, {"source": "Soil-Transmitted Helminths", "target": "Löffler Syndrome Transient Eosinophilic Pulmonary Infiltrates", "keywords": "Löffler syndrome, transpulmonary migration, eosinophilic pneumonitis, dry cough, fleeting infiltrates", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Soil-Transmitted Helminths provoke Löffler syndrome during transpulmonary larval migration, characterized by dry hacking cough, wheezing, substernal burning pain, marked peripheral eosinophilia, and migratory pulmonary infiltrates on chest radiography."}, {"source": "Soil-Transmitted Helminths", "target": "Severe Microcytic Hypochromic Iron Deficiency Anemia from Chronic Hookworm Blood Loss", "keywords": "microcytic hypochromic anemia, severe iron deficiency, low ferritin, hookworm blood loss, hypoalbuminemia", "description": "[EXHIBITS_LAB_PATTERN] Soil-Transmitted Helminths (specifically chronic hookworm infection) exhibit profound microcytic hypochromic iron-deficiency anemia (hemoglobin < 7 g/dL, MCV < 70 fL, ferritin < 10 ng/mL) and hypoalbuminemia (< 2.5 g/dL) due to ongoing intestinal blood loss and protein-losing enteropathy."}, {"source": "Soil-Transmitted Helminths", "target": "Peripheral Blood Eosinophilia during Larval Tissue Migration and Strongyloidiasis", "keywords": "peripheral eosinophilia, larval migration, tissue invasion, strongyloidiasis eosinophilia, Löffler eosinophilia", "description": "[EXHIBITS_LAB_PATTERN] Soil-Transmitted Helminths characteristically demonstrate marked peripheral blood eosinophilia (20% to 50% during acute Löffler larval migration; persistent 10% to 25% in chronic Strongyloides infection) reflecting tissue-invasive larval immune responses."}, {"source": "Soil-Transmitted Helminths", "target": "Diagnostic Stool Microscopy Demonstrating Characteristic Helminth Eggs or Rhabditiform Larvae", "keywords": "stool microscopy, Kato-Katz smear, Baermann technique, mammillated eggs, bipolar plugs, rhabditiform larvae", "description": "[EXHIBITS_LAB_PATTERN] Soil-Transmitted Helminths exhibit diagnostic hallmark parasitological patterns on admission stool microscopy: mammillated eggs (Ascaris), barrel-shaped bipolar-plugged eggs (Trichuris), thin-shelled morulated eggs (hookworms), or motile rhabditiform larvae on Baermann funnel / agar plate (Strongyloides)."}, {"source": "Soil-Transmitted Helminths", "target": "Abdominal Ultrasound Inner Tube Sign or Tangled Spaghetti Pattern", "keywords": "bedside ultrasound, inner tube sign, strip sign, tangled spaghetti sign, biliary ascariasis ultrasound", "description": "[EXHIBITS_LAB_PATTERN] Soil-Transmitted Helminths display characteristic bedside abdominal ultrasound patterns: non-shadowing tubular hyperechoic structures with an anechoic central lumen ('inner tube / strip sign') in biliary ascariasis, and clustered acoustic interfaces ('tangled spaghetti sign') in intestinal obstruction."}, {"source": "Soil-Transmitted Helminths", "target": "Abdominal Radiography Railroad Track Linear Intestinal Filling Defects", "keywords": "abdominal radiograph, air-fluid levels, barium contrast, railroad track sign, intestinal roundworms", "description": "[EXHIBITS_LAB_PATTERN] Soil-Transmitted Helminths exhibit plain abdominal radiographic findings of small bowel obstruction with air-fluid levels, and barium contrast outlining parallel longitudinal linear filling defects ('railroad track sign') created by adult roundworms in the intestinal lumen."}, {"source": "Soil-Transmitted Helminths", "target": "Absence of Helminth Eggs and Larvae on Multiple Concentrated Stool Examinations", "keywords": "rule-out criterion, negative stool exams, Kato-Katz negative, Baermann negative, exclusion of helminthiasis", "description": "[RULED_OUT_BY] Heavy symptomatic Soil-Transmitted Helminths infection is ruled out by the documented absence of helminth eggs and larvae on multiple serial concentrated stool examinations using both Kato-Katz thick smear and Baermann concentration techniques in an immunocompetent patient."}, {"source": "Soil-Transmitted Helminths", "target": "Normal Hemoglobin Ferritin and Absolute Eosinophil Count", "keywords": "rule-out criterion, normal hemoglobin, normal ferritin, normal eosinophils, exclusion of hookworm", "description": "[RULED_OUT_BY] Heavy hookworm disease and active invasive tissue helminthiasis are ruled out by entirely normal admission hemoglobin (>12 g/dL), normal serum ferritin (>30 ng/mL), and normal absolute eosinophil count."}, {"source": "Soil-Transmitted Helminths", "target": "Absence of Environmental Exposure to Fecally Contaminated Soil or Endemic Transmission Zones", "keywords": "rule-out criterion, zero exposure, non-endemic, sanitation adequate, epidemiological exclusion", "description": "[RULED_OUT_BY] Soil-Transmitted Helminths are ruled out by the definitive lack of environmental exposure, including no lifetime travel or residence in endemic tropical/subtropical regions lacking sanitation and zero contact with unwashed soil-grown foods or nightsoil."}, {"source": "Soil-Transmitted Helminths", "target": "Nutritional Iron Deficiency Anemia", "keywords": "differential diagnosis, dietary iron deficiency, non-parasitic anemia, absent eosinophilia, negative stool", "description": "[DIFFERENTIATED_FROM] Soil-Transmitted Helminths are differentiated from nutritional iron deficiency anemia because nutritional anemia lacks hookworm eggs on stool microscopy, lacks peripheral eosinophilia, and achieves permanent hematological cure with oral iron alone without anthelmintic therapy."}, {"source": "Soil-Transmitted Helminths", "target": "Inflammatory Bowel Disease", "keywords": "differential diagnosis, ulcerative colitis, Crohn disease, Trichuris dysentery, non-parasitic colitis", "description": "[DIFFERENTIATED_FROM] Soil-Transmitted Helminths (Trichuris Dysentery Syndrome) are differentiated from inflammatory bowel disease because IBD demonstrates chronic mucosal or transmural inflammation without visible parasites on endoscopy, lacks bipolar-plugged eggs on stool microscopy, and fails to resolve with benzimidazole anthelmintics."}, {"source": "Soil-Transmitted Helminths", "target": "Cutaneous Scabies Infestation", "keywords": "differential diagnosis, Sarcoptes scabiei, scabies burrows, larva currens contrast, stationary lesions", "description": "[DIFFERENTIATED_FROM] Soil-Transmitted Helminths (Strongyloides larva currens) are differentiated from cutaneous scabies because scabies burrows are stationary and favor interdigital web spaces and wrists with nocturnal pruritus, whereas larva currens is a hyper-mobile urticarial wheal migrating rapidly at 5 to 10 cm per hour over the perianal skin and trunk."}, {"source": "Soil-Transmitted Helminths", "target": "Acute Mechanical Bowel Obstruction from Intussusception or Volvulus", "keywords": "differential diagnosis, pediatric bowel obstruction, idiopathic intussusception, midgut volvulus, absence of worm bolus", "description": "[DIFFERENTIATED_FROM] Soil-Transmitted Helminths are differentiated from idiopathic intussusception or volvulus because non-parasitic mechanical obstructions lack intraluminal tubular masses ('tangled spaghetti' / 'railroad track' signs) on ultrasonography/radiography and do not expel adult Ascaris roundworms."}, {"source": "Soil-Transmitted Helminths", "target": "Choledocholithiasis and Acute Bacterial Cholangitis", "keywords": "differential diagnosis, gallstone obstruction, biliary colic, acoustic shadowing, non-parasitic cholangitis", "description": "[DIFFERENTIATED_FROM] Soil-Transmitted Helminths (biliary ascariasis) are differentiated from choledocholithiasis because gallstone obstruction displays acoustic-shadowing calculi on ultrasound without motile tubular non-shadowing structures ('inner tube sign'), and lacks expelled adult worms or helminth eggs."}, {"source": "Soil-Transmitted Helminths", "target": "Single-Dose Oral Albendazole 400 mg", "keywords": "first-line anthelmintic, albendazole 400 mg, roundworm cure, hookworm clearance, beta-tubulin inhibitor", "description": "[RESPONDS_TO] Soil-Transmitted Helminths show high therapeutic responsiveness to a single oral dose of albendazole 400 mg, achieving >95% cure rates for Ascaris lumbricoides and >80% cure rates for hookworms, rapidly eliminating intestinal worm burdens."}, {"source": "Soil-Transmitted Helminths", "target": "Oral Mebendazole 500 mg Single Dose or 100 mg Twice Daily for Three Days", "keywords": "first-line anthelmintic, mebendazole, whipworm treatment, Trichuris clearance, multi-dose regimen", "description": "[RESPONDS_TO] Soil-Transmitted Helminths respond effectively to mebendazole 500 mg single dose or 100 mg BID for 3 days, providing superior clearance against Trichuris trichiura and prompt resolution of Trichuris Dysentery Syndrome."}, {"source": "Soil-Transmitted Helminths", "target": "Oral Ivermectin 200 mcg per kg for Two Doses", "keywords": "drug of choice, ivermectin, Strongyloides cure, larva currens resolution, hyperinfection therapy", "description": "[RESPONDS_TO] Soil-Transmitted Helminths (specifically Strongyloides stercoralis) respond exquisitely to oral ivermectin 200 mcg/kg/day for 2 consecutive days (>95% cure rate), rapidly halting larva currens and resolving chronic or disseminated strongyloidiasis."}, {"source": "Soil-Transmitted Helminths", "target": "Intrinsic Resistance and Refractoriness of Strongyloides stercoralis to Benzimidazole Monotherapy", "keywords": "intrinsic resistance, benzimidazole failure, Strongyloides insensitivity, albendazole failure, autoinfection persistence", "description": "[INTRINSICALLY_RESISTANT_TO] Soil-Transmitted Helminths (specifically Strongyloides stercoralis) exhibit intrinsic therapeutic refractoriness and low cure rates when treated with standard single-dose albendazole or mebendazole, allowing internal autoinfection to persist."}, {"source": "Soil-Transmitted Helminths", "target": "Oral Ferrous Sulfate Iron Replacement Therapy", "keywords": "iron replacement, oral ferrous sulfate, anemia resolution, hookworm rehabilitation, reticulocytosis", "description": "[RESPONDS_TO] Soil-Transmitted Helminths (hookworm-associated iron-deficiency anemia) demonstrate robust therapeutic hematological recovery and replenishment of bone marrow iron stores when treated with oral ferrous sulfate for 3 months following anthelmintic deworming."}, {"source": "Soil-Transmitted Helminths", "target": "Conservative Decompression and Piperazine Citrate for Ascaris Intestinal Obstruction", "keywords": "conservative management, piperazine citrate, flaccid paralysis, nasogastric decompression, worm bolus passage", "description": "[RESPONDS_TO] Partial mechanical bowel obstruction caused by Ascaris lumbricoides responds favorably to conservative nasogastric decompression and oral piperazine citrate, which flaccidly paralyzes adult worms and allows spontaneous evacuation without laparotomy."}, {"source": "Soil-Transmitted Helminths", "target": "Refractoriness to Standard Antibacterial and Antifungal Therapies", "keywords": "antibiotic refractoriness, antimicrobial insensitivity, antibacterial failure, persistent eosinophilia", "description": "[INTRINSICALLY_RESISTANT_TO] Soil-Transmitted Helminths do not respond to standard antibacterial or antifungal agents, displaying persistent eosinophilia, gastrointestinal symptoms, and ongoing fecal egg shedding unless targeted anthelmintic therapy is initiated."}, {"source": "Ascaris lumbricoides", "target": "Mechanical Bowel Obstruction with Palpable Doughy Abdominal Mass from Ascaris Worm Bolus", "keywords": "pathogen hallmark, luminal occlusion, aggregated worm mass, intestinal ascariasis", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Ascaris lumbricoides causes mechanical bowel obstruction when large worm burdens aggregate into a solid luminal bolus occluding the ileocecal valve in young children."}, {"source": "Ascaris lumbricoides", "target": "Erratic Biliary Ascariasis with Acute Suppurative Cholangitis or Biliary Colic", "keywords": "pathogen hallmark, biliary migration, ampulla of Vater, ductal obstruction, suppurative cholangitis", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Ascaris lumbricoides migrates erratically through the ampulla of Vater into the biliary tree, causing biliary colic, acute cholangitis, or pancreatitis."}, {"source": "Trichuris trichiura", "target": "Rectal Prolapse Studded with White Whipworms in Trichuris Dysentery Syndrome", "keywords": "pathogen hallmark, colonic mucosal invasion, whipworm studding, Trichuris dysentery, rectal prolapse", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Trichuris trichiura causes severe Trichuris Dysentery Syndrome with pathognomonic rectal prolapse visibly studded with embedded white adult whipworms."}, {"source": "Necator americanus", "target": "Severe Microcytic Hypochromic Iron Deficiency Anemia from Chronic Hookworm Blood Loss", "keywords": "pathogen hallmark, mucosal capillary laceration, blood ingestion, microcytic anemia", "description": "[EXHIBITS_LAB_PATTERN] Necator americanus causes severe microcytic hypochromic iron-deficiency anemia by lacerating duodenal capillaries with cutting plates and ingesting host blood."}, {"source": "Ancylostoma duodenale", "target": "Severe Microcytic Hypochromic Iron Deficiency Anemia from Chronic Hookworm Blood Loss", "keywords": "pathogen hallmark, mucosal blood loss, buccal teeth laceration, microcytic anemia", "description": "[EXHIBITS_LAB_PATTERN] Ancylostoma duodenale causes severe microcytic hypochromic iron-deficiency anemia by lacerating upper small intestinal mucosa with curved ventral teeth and extracting up to 0.2 mL blood per worm daily."}, {"source": "Strongyloides stercoralis", "target": "Larva Currens Rapidly Advancing Serpiginous Urticarial Wheal", "keywords": "pathogen hallmark, rapid cutaneous migration, larva currens, autoinfection wheal", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Strongyloides stercoralis produces the pathognomonic rapidly advancing serpiginous urticarial eruption known as larva currens during subcutaneous larval autoinfection."}, {"source": "Strongyloides stercoralis", "target": "Intrinsic Resistance and Refractoriness of Strongyloides stercoralis to Benzimidazole Monotherapy", "keywords": "pathogen resistance, benzimidazole insensitivity, treatment failure, autoinfection persistence", "description": "[INTRINSICALLY_RESISTANT_TO] Strongyloides stercoralis is intrinsically refractoriness to standard single-dose benzimidazoles (albendazole and mebendazole), failing to achieve parasitological cure."}, {"source": "Strongyloides stercoralis", "target": "Oral Ivermectin 200 mcg per kg for Two Doses", "keywords": "pathogen targeted therapy, ivermectin sensitivity, macrocyclic lactone cure, Strongyloides eradication", "description": "[RESPONDS_TO] Strongyloides stercoralis responds with >95% cure rates to oral ivermectin 200 mcg/kg/day for 2 consecutive days, which terminates autoinfection and prevents fatal dissemination."}, {"source": "Ascaris lumbricoides", "target": "Single-Dose Oral Albendazole 400 mg", "keywords": "targeted therapy, high cure rate, Ascaris clearance, albendazole efficacy", "description": "[RESPONDS_TO] Ascaris lumbricoides is highly susceptible to single-dose oral albendazole 400 mg, achieving >95% parasitological cure and stool egg reduction."}, {"source": "Trichuris trichiura", "target": "Oral Mebendazole 500 mg Single Dose or 100 mg Twice Daily for Three Days", "keywords": "targeted therapy, Trichuris clearance, whipworm eradication, mebendazole efficacy", "description": "[RESPONDS_TO] Trichuris trichiura responds preferentially to oral mebendazole 500 mg single dose or 100 mg twice daily for 3 days, clearing adult whipworms from colonic mucosa."}, {"source": "Necator americanus", "target": "Ground Itch Papulovesicular Pruritic Dermatitis", "keywords": "pathogen hallmark, larval skin invasion, ground itch, papulovesicular dermatitis", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Necator americanus provokes intense pruritic ground itch papulovesicular dermatitis at the dermal site where infective filariform larvae penetrate the host's feet."}, {"source": "Ancylostoma duodenale", "target": "Ground Itch Papulovesicular Pruritic Dermatitis", "keywords": "pathogen hallmark, percutaneous entry, ground itch, foot dermatitis", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Ancylostoma duodenale causes ground itch dermatitis at dermal sites of larval skin penetration following contact with infested soil."}, {"source": "Ascaris lumbricoides", "target": "Löffler Syndrome Transient Eosinophilic Pulmonary Infiltrates", "keywords": "pathogen hallmark, larval pulmonary migration, transpulmonary transit, Löffler syndrome", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Ascaris lumbricoides larvae trigger Löffler syndrome during transpulmonary migration, breaking through alveolar capillaries and provoking transient eosinophilic pulmonary infiltrates."}]}}
{"case_id": "talaromycosis", "disease": "Talaromycosis", "extraction": {"entities": [{"name": "Talaromycosis", "type": "Disease", "description": "A life-threatening systemic opportunistic fungal infection caused by the thermally dimorphic fungus Talaromyces marneffei, predominantly affecting severely immunocompromised individuals (notably advanced HIV with CD4 < 100 cells/uL and patients with anti-IFN-gamma autoantibodies) in endemic Southeast Asia and southern China, characterized by reticuloendothelial dissemination and umbilicated necrotic papules."}, {"name": "Endemic Residence or Travel in Southeast Asia and Southern China", "type": "Vector_Exposure", "description": "Strict geographic restriction to tropical and subtropical Southeast Asia and southern China, including northern and central Thailand, northern Vietnam, southern China (Guangxi, Guangdong, Yunnan), Myanmar, Laos, Cambodia, Taiwan, and northeastern India (Manipur)."}, {"name": "Agricultural Soil and Bamboo Rat Habitat Exposure During Rainy Season", "type": "Vector_Exposure", "description": "Environmental exposure to agricultural soil and burrows of endemic bamboo rats (Rhizomys pruinosus, Cannomys badius), with marked transmission peaks during the monsoon/rainy season."}, {"name": "Aerosol Inhalation of Environmental Conidia", "type": "Vector_Exposure", "description": "Primary route of transmission involving inhalation of aerosolized environmental infectious conidia from disturbed soil into the pulmonary alveoli."}, {"name": "Advanced HIV Infection with CD4 Count Below 100 cells/uL", "type": "Vector_Exposure", "description": "Severe cell-mediated immunosuppression from advanced HIV infection, representing 80-90% of clinical cases, typically presenting with CD4 T-lymphocyte counts below 50-100 cells/uL."}, {"name": "High-Titer Neutralizing Anti-Interferon-Gamma Autoantibodies", "type": "Vector_Exposure", "description": "Acquired adult-onset immunodeficiency syndrome in non-HIV Asian adults caused by high-titer neutralizing autoantibodies against interferon-gamma, predisposing to severe, refractory disseminated talaromycosis with frequent osteoarticular and intestinal involvement."}, {"name": "Secondary Immunosuppression from Hematological Malignancies and Targeted Immunosuppressants", "type": "Vector_Exposure", "description": "Non-HIV immunocompromised states including hematological malignancies, solid organ transplantation, and targeted immunosuppressive therapies such as anti-CD20 monoclonal antibodies (rituximab) and kinase inhibitors."}, {"name": "Talaromyces marneffei", "type": "Pathogen", "description": "Thermally dimorphic ascomycete fungus (formerly Penicillium marneffei) of the order Eurotiales and family Trichocomaceae, transitioning from mould at 25°C to yeast at 37°C."}, {"name": "Thermal Dimorphism with Diffusible Wine-Red Pigment at 25C", "type": "Pathogen", "description": "Pathognomonic phenotypic characteristic where the mould phase grown on Sabouraud dextrose agar at 25°C secretes a soluble, diffusible brick-red to wine-red pigment staining the reverse of the agar medium within 3-5 days."}, {"name": "Intracellular Yeasts Dividing by Transverse Binary Fission Without Budding", "type": "Pathogen", "description": "Pathognomonic parasitic tissue phase at 37°C consisting of unicellular, pleomorphic yeast cells (3–8 um) that reside inside host reticuloendothelial macrophages and divide exclusively by binary transverse fission (schizogony) with a central cross-wall septum, never by budding."}, {"name": "Umbilicated Molluscum-Like Facial Papules with Central Necrotic Crater", "type": "Cardinal_Sign", "description": "Primary visual hallmark present in 70% to 85% of patients at admission: crops of painless, non-pruritic, dome-shaped papules and nodules featuring a distinctive central necrotic depression, umbilication, or black hemorrhagic crust with prominent facial, neck, ear, and upper trunk predilection."}, {"name": "Disseminated Reticuloendothelial Syndrome with Hepatosplenomegaly and Lymphadenopathy", "type": "Cardinal_Sign", "description": "Systemic constitutional syndrome characterized by high remittent or continuous fever (39–40°C), drenching night sweats, profound cachectic weight loss, generalized non-tender lymphadenopathy, and marked firm hepatosplenomegaly."}, {"name": "Multifocal Osteolytic Bone Lesions and Subcutaneous Abscesses", "type": "Cardinal_Sign", "description": "Severe destructive osteoarticular and soft tissue manifestations presenting with multiple osteolytic lesions (skull, ribs, long bones), septic arthritis, and subcutaneous cold abscesses, particularly prominent in non-HIV anti-IFN-gamma autoantibody patients."}, {"name": "Pulmonary Reticulonodular Infiltrates and Alveolar Consolidation", "type": "Cardinal_Sign", "description": "Respiratory involvement present in 50% to 60% of cases manifesting as productive cough, dyspnea, and hemoptysis, with radiographic evidence of diffuse bilateral interstitial reticulonodular opacities or alveolar consolidation."}, {"name": "Touch Imprint Smear Demonstrating Transverse Septate Yeasts in Histiocytes", "type": "Admission_Lab_Imaging", "description": "Rapid bedside triage gold standard: Wright, Giemsa, or Gomori methenamine silver (GMS) stained touch imprint smear or scraping of skin lesions demonstrating numerous intracellular (within histiocytes/macrophages) and extracellular 3–8 um yeasts displaying pathognomonic central transverse dividing septa."}, {"name": "Rapid Fungal Culture Growth with Wine-Red Agar Diffusion at 25C", "type": "Admission_Lab_Imaging", "description": "Definitive culture confirmation: lysis-centrifugation blood culture or bone marrow aspirate culture yielding mould growth within 3 to 5 days at 25°C accompanied by deep brick-red to wine-red pigment diffusing into the agar medium."}, {"name": "Profound Normocytic Anemia and Bicytopenia/Pancytopenia", "type": "Admission_Lab_Imaging", "description": "Admission complete blood count abnormalities including severe normocytic normochromic anemia (Hb < 7–8 g/dL), leukopenia (WBC < 3,000/uL), and thrombocytopenia (platelets < 50,000/uL) secondary to histiocytic bone marrow infiltration and hypersplenism."}, {"name": "Marked Disproportionate Elevation of Serum Alkaline Phosphatase and GGT", "type": "Admission_Lab_Imaging", "description": "Admission liver chemistry demonstrating marked disproportionate cholestatic enzyme elevation (ALP and GGT 3–5x ULN) with mild-to-moderate AST/ALT transaminitis (2–3x ULN) resulting from diffuse granulomatous hepatic infiltration."}, {"name": "Abdominal Ultrasound Demonstrating Hepatosplenomegaly with Microabscesses and Retroperitoneal Lymphadenopathy", "type": "Admission_Lab_Imaging", "description": "Bedside abdominal point-of-care ultrasound (POCUS) showing marked hepatosplenomegaly with multiple tiny (<1 cm) hypoechoic microabscesses and enlarged retroperitoneal/mesenteric lymph nodes (>1.5 cm)."}, {"name": "Chest Radiography Revealing Diffuse Bilateral Interstitial Reticulonodular Opacities", "type": "Admission_Lab_Imaging", "description": "Admission chest X-ray demonstrating diffuse bilateral reticulonodular interstitial opacities, patchy alveolar consolidation, localized cavitary lesions, and prominent hilar/mediastinal lymphadenopathy."}, {"name": "Complete Absence of Travel or Residence in Endemic Southeast Asia and Southern China", "type": "Exclusion_Criterion", "description": "Complete lack of travel or residence in the strictly restricted geographic endemic zones of Southeast Asia and southern China makes the diagnosis of talaromycosis virtually impossible."}, {"name": "Microscopic Identification of Budding Yeasts Rather Than Binary Fission Septa", "type": "Exclusion_Criterion", "description": "Identification of budding yeasts (narrow-based or broad-based) on cytology, histopathology, or direct smear rules OUT Talaromyces marneffei, which reproduces strictly by transverse binary fission without budding."}, {"name": "Absence of Thermal Dimorphism and Failure to Produce Soluble Red Pigment at 25C", "type": "Exclusion_Criterion", "description": "Failure of an isolated fungus to demonstrate temperature-dependent mould-to-yeast phase transition or absence of soluble brick-red/wine-red pigment diffusion at 25°C excludes Talaromyces marneffei."}, {"name": "Normal CD4 Count in an Immunocompetent Patient Without Autoantibodies", "type": "Exclusion_Criterion", "description": "Preserved cell-mediated immunity with normal CD4 count (>500 cells/uL) in the absence of neutralizing anti-IFN-gamma autoantibodies, immunosuppressive therapy, or malignancy makes disseminated talaromycosis exceptionally improbable."}, {"name": "Disseminated Histoplasmosis", "type": "Disease", "description": "Systemic dimorphic fungal infection caused by Histoplasma capsulatum, presenting in advanced HIV with fever, hepatosplenomegaly, and skin lesions, but distinguished by narrow-based budding yeasts (2–4 um) and absence of red diffusible pigment on culture at 25°C."}, {"name": "Disseminated Cryptococcosis", "type": "Disease", "description": "Invasive fungal infection caused by Cryptococcus neoformans, presenting in advanced HIV with umbilicated facial papules and fever, but characterized by subacute meningoencephalitis with high opening pressure, positive cryptococcal antigen, and round encapsulated budding yeasts on India ink."}, {"name": "Molluscum Contagiosum", "type": "Disease", "description": "Cutaneous poxvirus infection presenting with dome-shaped umbilicated facial papules in advanced HIV, distinguished by purely superficial epidermal localization without systemic fever, wasting, organomegaly, cytopenias, or fungal elements, and biopsy showing Henderson-Paterson bodies."}, {"name": "Miliary Tuberculosis", "type": "Disease", "description": "Disseminated mycobacterial infection caused by Mycobacterium tuberculosis presenting with fever, cachexia, hepatosplenomegaly, and diffuse micronodular lung lesions in HIV, differentiated by acid-fast bacilli on Ziehl-Neelsen stain and typical absence of umbilicated necrotic facial papules."}, {"name": "Pneumocystis Jirovecii Pneumonia", "type": "Disease", "description": "Opportunistic fungal pulmonary infection presenting in advanced HIV with dyspnea, dry cough, and bilateral interstitial infiltrates, differentiated by disease confinement to lungs without cutaneous lesions, organomegaly, or fission yeasts."}, {"name": "Intravenous Liposomal or Deoxycholate Amphotericin B Induction Therapy", "type": "Drug_Response", "description": "Evidence-based first-line 2-week induction regimen (liposomal amphotericin B 3–5 mg/kg/day or amphotericin B deoxycholate 0.7–1.0 mg/kg/day) demonstrated superior to itraconazole with faster blood fungal clearance, rapid defervescence, and >50% relative reduction in 2-week mortality."}, {"name": "Oral Itraconazole Consolidation and Maintenance Prophylaxis", "type": "Drug_Response", "description": "Second-phase consolidation therapy (oral itraconazole 200 mg twice daily with food for 10 weeks) followed by secondary maintenance prophylaxis (200 mg once daily) until sustained CD4 > 100 cells/uL on ART for at least 6 months."}, {"name": "Early Antiretroviral Therapy Initiation Within One to Two Weeks", "type": "Drug_Response", "description": "Prompt initiation of antiretroviral therapy (ART) within 1 to 2 weeks after commencing amphotericin B therapy in HIV-infected patients, restoring cellular immunity with minimal risk of fatal IRIS."}, {"name": "Universal Refractoriness to Broad-Spectrum Antibacterial Agents", "type": "Drug_Response", "description": "Complete lack of clinical and microbiological response to broad-spectrum antibacterial regimens (beta-lactams, fluoroquinolones, macrolides, carbapenems), serving as an important clinical diagnostic clue for fungal infection."}], "relationships": [{"source": "Talaromycosis", "target": "Endemic Residence or Travel in Southeast Asia and Southern China", "keywords": "EXPOSURE_TO, endemic zone, geographic restriction, Southeast Asia, southern China", "description": "[EXPOSURE_TO] Talaromycosis is strictly restricted geographically to endemic regions of Southeast Asia and southern China (Thailand, Vietnam, southern China, Myanmar, Laos, Cambodia, Taiwan, and northeastern India)."}, {"source": "Talaromycosis", "target": "Agricultural Soil and Bamboo Rat Habitat Exposure During Rainy Season", "keywords": "EXPOSURE_TO, bamboo rats, agricultural soil, monsoon, rainy season", "description": "[EXPOSURE_TO] Environmental exposure to endemic reservoirs including agricultural soil and habitats of bamboo rats (Rhizomys pruinosus, Cannomys badius), with incidence peaking during the rainy/monsoon season."}, {"source": "Talaromycosis", "target": "Aerosol Inhalation of Environmental Conidia", "keywords": "TRANSMITTED_BY, conidia, aerosol, inhalation, respiratory entry", "description": "[TRANSMITTED_BY] Transmission occurs via inhalation of infectious aerosolized environmental conidia into the host respiratory tract."}, {"source": "Talaromycosis", "target": "Advanced HIV Infection with CD4 Count Below 100 cells/uL", "keywords": "EXPOSURE_TO, advanced HIV, AIDS-defining infection, severe immunosuppression, CD4 under 100", "description": "[EXPOSURE_TO] Over 80-90% of cases occur in patients with advanced HIV infection and severe immunosuppression characterized by CD4 counts below 100 cells/uL (typically <50 cells/uL)."}, {"source": "Talaromycosis", "target": "High-Titer Neutralizing Anti-Interferon-Gamma Autoantibodies", "keywords": "EXPOSURE_TO, anti-IFN-gamma autoantibodies, adult-onset immunodeficiency, non-HIV", "description": "[EXPOSURE_TO] Non-HIV adult patients with high-titer neutralizing anti-interferon-gamma autoantibodies suffer from severe, refractory disseminated talaromycosis with frequent osteolytic lesions."}, {"source": "Talaromycosis", "target": "Secondary Immunosuppression from Hematological Malignancies and Targeted Immunosuppressants", "keywords": "EXPOSURE_TO, hematological malignancy, organ transplant, rituximab, kinase inhibitors", "description": "[EXPOSURE_TO] Non-HIV immunosuppression resulting from hematological malignancies, solid organ transplantation, or treatment with targeted agents (rituximab, kinase inhibitors) predisposes to disseminated disease."}, {"source": "Talaromycosis", "target": "Talaromyces marneffei", "keywords": "HAS_PATHOGEN, Talaromyces marneffei, Penicillium marneffei, dimorphic fungus", "description": "[HAS_PATHOGEN] Talaromycosis is caused etiologically by the thermally dimorphic ascomycete fungus Talaromyces marneffei (formerly Penicillium marneffei)."}, {"source": "Talaromycosis", "target": "Thermal Dimorphism with Diffusible Wine-Red Pigment at 25C", "keywords": "HAS_PATHOGEN, thermal dimorphism, wine-red pigment, mould phase, 25C", "description": "[HAS_PATHOGEN] Talaromycosis exhibits thermal dimorphism, producing a mould phase at 25°C that secretes a soluble brick-red to wine-red diffusible pigment into agar media."}, {"source": "Talaromycosis", "target": "Intracellular Yeasts Dividing by Transverse Binary Fission Without Budding", "keywords": "HAS_PATHOGEN, binary fission, transverse septum, intracellular yeast, schizogony", "description": "[HAS_PATHOGEN] Talaromycosis is driven by parasitic yeast forms inside reticuloendothelial macrophages that replicate strictly by transverse binary fission across a cross-wall septum without budding."}, {"source": "Talaromyces marneffei", "target": "Thermal Dimorphism with Diffusible Wine-Red Pigment at 25C", "keywords": "HAS_PATHOGEN, mould form, Sabouraud agar, red pigment secretion", "description": "[HAS_PATHOGEN] Talaromyces marneffei grows at 25°C as a filamentous sporulating mould that secretes a characteristic diffusible wine-red pigment on Sabouraud agar within 3-5 days."}, {"source": "Talaromyces marneffei", "target": "Intracellular Yeasts Dividing by Transverse Binary Fission Without Budding", "keywords": "HAS_PATHOGEN, yeast phase, binary fission, non-budding, macrophage multiplication", "description": "[HAS_PATHOGEN] In host tissue at 37°C, Talaromyces marneffei converts into an intracellular yeast dividing exclusively by transverse binary fission without forming buds."}, {"source": "Talaromycosis", "target": "Umbilicated Molluscum-Like Facial Papules with Central Necrotic Crater", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, umbilicated papules, necrotic crater, face", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Present in 70-85% of patients at admission, painless umbilicated papules with central necrotic crateriform depression or black crust on the face and trunk serve as the definitive clinical hallmark."}, {"source": "Talaromycosis", "target": "Disseminated Reticuloendothelial Syndrome with Hepatosplenomegaly and Lymphadenopathy", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, remittent fever, hepatosplenomegaly, lymphadenopathy, cachexia", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Manifests as a severe disseminated reticuloendothelial syndrome featuring high remittent fever (39-40°C), profound wasting, generalized lymphadenopathy, and firm hepatosplenomegaly."}, {"source": "Talaromycosis", "target": "Multifocal Osteolytic Bone Lesions and Subcutaneous Abscesses", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, osteolytic lesions, bone destruction, cold abscesses, anti-IFN-gamma", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Multifocal osteolytic bone lesions of the skull, ribs, and long bones, accompanied by subcutaneous cold abscesses, form a prominent hallmark in non-HIV anti-IFN-gamma autoantibody patients."}, {"source": "Talaromycosis", "target": "Pulmonary Reticulonodular Infiltrates and Alveolar Consolidation", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, pulmonary infiltrates, cough, dyspnea, alveolar consolidation", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Pulmonary disease occurs in 50-60% of cases, presenting with productive cough, dyspnea, hemoptysis, and diffuse bilateral reticulonodular or alveolar infiltrates."}, {"source": "Talaromycosis", "target": "Touch Imprint Smear Demonstrating Transverse Septate Yeasts in Histiocytes", "keywords": "EXHIBITS_LAB_PATTERN, touch prep smear, skin scraping, transverse septum, Giemsa", "description": "[EXHIBITS_LAB_PATTERN] Rapid bedside touch imprint or skin scraping stained with Wright/Giemsa reveals intracellular yeasts (3-8 um) displaying pathognomonic central transverse dividing septa within macrophages."}, {"source": "Talaromycosis", "target": "Rapid Fungal Culture Growth with Wine-Red Agar Diffusion at 25C", "keywords": "EXHIBITS_LAB_PATTERN, blood culture, bone marrow, wine-red pigment, lysis centrifugation", "description": "[EXHIBITS_LAB_PATTERN] Fungal blood or bone marrow culture yields mould colonies within 3-5 days at 25°C accompanied by deep brick-red to wine-red pigment diffusing into the agar."}, {"source": "Talaromycosis", "target": "Profound Normocytic Anemia and Bicytopenia/Pancytopenia", "keywords": "EXHIBITS_LAB_PATTERN, pancytopenia, severe anemia, thrombocytopenia, marrow suppression", "description": "[EXHIBITS_LAB_PATTERN] Admission CBC reveals severe normocytic normochromic anemia (Hb < 7-8 g/dL), leukopenia, and thrombocytopenia secondary to histiocytic marrow infiltration and hypersplenism."}, {"source": "Talaromycosis", "target": "Marked Disproportionate Elevation of Serum Alkaline Phosphatase and GGT", "keywords": "EXHIBITS_LAB_PATTERN, alkaline phosphatase, GGT, cholestatic pattern, hepatic granulomas", "description": "[EXHIBITS_LAB_PATTERN] Serum biochemistry reveals marked elevation of cholestatic enzymes (ALP and GGT 3-5x ULN) with modest transaminase elevation due to granulomatous hepatic parenchymal infiltration."}, {"source": "Talaromycosis", "target": "Abdominal Ultrasound Demonstrating Hepatosplenomegaly with Microabscesses and Retroperitoneal Lymphadenopathy", "keywords": "EXHIBITS_LAB_PATTERN, POCUS, abdominal ultrasound, microabscesses, lymphadenopathy", "description": "[EXHIBITS_LAB_PATTERN] Bedside abdominal ultrasound demonstrates hepatosplenomegaly studded with tiny hypoechoic microabscesses (<1 cm) and enlarged retroperitoneal/mesenteric lymph nodes (>1.5 cm)."}, {"source": "Talaromycosis", "target": "Chest Radiography Revealing Diffuse Bilateral Interstitial Reticulonodular Opacities", "keywords": "EXHIBITS_LAB_PATTERN, chest X-ray, reticulonodular opacities, mediastinal lymphadenopathy", "description": "[EXHIBITS_LAB_PATTERN] Admission chest radiograph shows diffuse bilateral interstitial reticulonodular opacities, patchy alveolar consolidation, and prominent hilar/mediastinal lymphadenopathy."}, {"source": "Touch Imprint Smear Demonstrating Transverse Septate Yeasts in Histiocytes", "target": "Intracellular Yeasts Dividing by Transverse Binary Fission Without Budding", "keywords": "EXHIBITS_LAB_PATTERN, microscopic visualization, transverse septum, macrophage", "description": "[EXHIBITS_LAB_PATTERN] Bedside touch imprint smear directly visualizes intracellular yeasts dividing by transverse binary fission with cross-walls inside macrophages."}, {"source": "Rapid Fungal Culture Growth with Wine-Red Agar Diffusion at 25C", "target": "Thermal Dimorphism with Diffusible Wine-Red Pigment at 25C", "keywords": "EXHIBITS_LAB_PATTERN, culture confirmation, wine-red pigment, agar diffusion", "description": "[EXHIBITS_LAB_PATTERN] Blood or bone marrow culture confirms thermal dimorphism by growing filamentous colonies that secrete soluble wine-red pigment at 25°C."}, {"source": "Talaromycosis", "target": "Complete Absence of Travel or Residence in Endemic Southeast Asia and Southern China", "keywords": "RULED_OUT_BY, travel history, non-endemic, negative geographic exposure", "description": "[RULED_OUT_BY] Complete absence of travel or residence in endemic Southeast Asia or southern China effectively rules out talaromycosis."}, {"source": "Talaromycosis", "target": "Microscopic Identification of Budding Yeasts Rather Than Binary Fission Septa", "keywords": "RULED_OUT_BY, budding yeasts, absence of fission, narrow-based budding", "description": "[RULED_OUT_BY] Identification of budding fungal yeasts on cytological or histological examination rules out Talaromyces marneffei, which reproduces strictly by transverse binary fission."}, {"source": "Talaromycosis", "target": "Absence of Thermal Dimorphism and Failure to Produce Soluble Red Pigment at 25C", "keywords": "RULED_OUT_BY, absence of red pigment, lack of dimorphism, monomorphic fungus", "description": "[RULED_OUT_BY] Lack of thermal dimorphism and failure to secrete diffusible wine-red pigment into agar medium at 25°C rules out Talaromyces marneffei."}, {"source": "Talaromycosis", "target": "Normal CD4 Count in an Immunocompetent Patient Without Autoantibodies", "keywords": "RULED_OUT_BY, normal CD4 count, immunocompetent host, absent autoantibodies", "description": "[RULED_OUT_BY] Disseminated talaromycosis is virtually ruled out in an immunocompetent host with normal CD4 count (>500 cells/uL) and no immunosuppressive risk factors or autoantibodies."}, {"source": "Talaromycosis", "target": "Disseminated Histoplasmosis", "keywords": "DIFFERENTIATED_FROM, Histoplasma capsulatum, narrow-based budding, absent red pigment", "description": "[DIFFERENTIATED_FROM] Differentiated from Disseminated Histoplasmosis by Histoplasma's narrow-based budding yeasts (2-4 um) and lack of red pigment at 25°C, versus Talaromyces' transverse binary fission and diffusible wine-red pigment."}, {"source": "Talaromycosis", "target": "Disseminated Cryptococcosis", "keywords": "DIFFERENTIATED_FROM, Cryptococcus neoformans, meningitis, polysaccharide capsule, India ink", "description": "[DIFFERENTIATED_FROM] Differentiated from Disseminated Cryptococcosis by Cryptococcus' predominant meningoencephalitis, encapsulated budding yeasts on India ink/mucicarmine, and positive CrAg, compared to non-encapsulated fission yeasts and dominant reticuloendothelial/skin pathology in Talaromyces."}, {"source": "Talaromycosis", "target": "Molluscum Contagiosum", "keywords": "DIFFERENTIATED_FROM, Molluscum contagiosum virus, Henderson-Paterson bodies, localized skin lesion", "description": "[DIFFERENTIATED_FROM] Differentiated from Molluscum Contagiosum by Molluscum's purely localized superficial cutaneous restriction and intracytoplasmic Henderson-Paterson inclusion bodies, contrasting with Talaromyces' severe systemic illness, organomegaly, cytopenias, and fungal fission yeasts."}, {"source": "Talaromycosis", "target": "Miliary Tuberculosis", "keywords": "DIFFERENTIATED_FROM, Mycobacterium tuberculosis, acid-fast bacilli, lack of umbilicated skin papules", "description": "[DIFFERENTIATED_FROM] Differentiated from Miliary Tuberculosis by TB's acid-fast rod morphology on Ziehl-Neelsen stain and typical absence of umbilicated necrotic skin papules, compared to fungal fission yeasts on skin touch smears in Talaromycosis."}, {"source": "Talaromycosis", "target": "Pneumocystis Jirovecii Pneumonia", "keywords": "DIFFERENTIATED_FROM, Pneumocystis jirovecii, pulmonary restricted, lack of mucocutaneous lesions", "description": "[DIFFERENTIATED_FROM] Differentiated from Pneumocystis Jirovecii Pneumonia by PCP's lung-restricted presentation and trophic cyst morphology without umbilicated skin lesions, hepatosplenomegaly, or systemic dissemination."}, {"source": "Talaromycosis", "target": "Intravenous Liposomal or Deoxycholate Amphotericin B Induction Therapy", "keywords": "RESPONDS_TO, amphotericin B, induction therapy, mortality reduction, rapid defervescence", "description": "[RESPONDS_TO] Responds rapidly to intravenous amphotericin B induction (liposomal 3-5 mg/kg/day or deoxycholate 0.7-1.0 mg/kg/day) for 14 days, demonstrating superiority over itraconazole with faster blood fungal clearance and >50% relative reduction in 2-week mortality."}, {"source": "Talaromycosis", "target": "Oral Itraconazole Consolidation and Maintenance Prophylaxis", "keywords": "RESPONDS_TO, itraconazole, consolidation therapy, secondary prophylaxis, CD4 recovery", "description": "[RESPONDS_TO] Responds effectively to step-down oral itraconazole (200 mg twice daily with food for 10 weeks) for consolidation, followed by maintenance prophylaxis (200 mg once daily) until sustained CD4 > 100 cells/uL for at least 6 months on ART."}, {"source": "Talaromycosis", "target": "Early Antiretroviral Therapy Initiation Within One to Two Weeks", "keywords": "RESPONDS_TO, antiretroviral therapy, ART, immune reconstitution, early timing", "description": "[RESPONDS_TO] Clinical survival improves with early initiation of antiretroviral therapy within 1-2 weeks after starting amphotericin B, restoring cellular immunity with minimal risk of fatal IRIS."}, {"source": "Talaromycosis", "target": "Universal Refractoriness to Broad-Spectrum Antibacterial Agents", "keywords": "INTRINSICALLY_RESISTANT_TO, antibacterial refractoriness, beta-lactams, fluoroquinolones, carbapenems", "description": "[INTRINSICALLY_RESISTANT_TO] Intrinsically unresponsive to all broad-spectrum antibacterial classes (beta-lactams, fluoroquinolones, macrolides, carbapenems), serving as a crucial clinical diagnostic clue for fungal etiology."}]}}
{"case_id": "trypanosomiasis", "disease": "Trypanosomiasis", "extraction": {"entities": [{"name": "Trypanosomiasis", "type": "Disease", "description": "A complex neglected tropical protozoan disease caused by kinetoplastid parasites of the genus Trypanosoma, encompassing American Trypanosomiasis (Chagas disease caused by Trypanosoma cruzi, featuring acute chagoma/Romaña sign and chronic dilated cardiomyopathy with apical aneurysm/RBBB or digestive megasyndromes) and Human African Trypanosomiasis (sleeping sickness caused by Trypanosoma brucei gambiense or Trypanosoma brucei rhodesiense, featuring chancre, Winterbottom cervical adenopathy, and progressive sleep-wake cycle inversion with meningoencephalitis)."}, {"name": "Nocturnal Triatomine Kissing Bug Feces Contamination in Endemic Rural Latin America", "type": "Vector_Exposure", "description": "Vector-borne exposure to nocturnal hematophagous triatomine bugs (family Reduviidae, subfamily Triatominae; kissing bugs such as Triatoma infestans and Rhodnius prolixus) infesting cracked adobe walls and thatch roofs in rural Latin America, which feed on sleeping hosts and defecate metacyclic trypomastigotes that are rubbed into bite wounds or mucous membranes."}, {"name": "Oral Ingestion of Fresh Juices Contaminated with Crushed Triatomine Vectors", "type": "Vector_Exposure", "description": "Foodborne exposure via ingestion of unpasteurized sugarcane juice, fresh açaí pulp, or meals contaminated with crushed infected triatomines or opossum secretions, triggering explosive point-source outbreaks of acute severe Chagas myocarditis with high mortality."}, {"name": "Blood Product Transfusion, Organ Transplantation, or Congenital Maternal-Fetal Exposure", "type": "Vector_Exposure", "description": "Non-vector transmission pathways of Trypanosoma cruzi including transplacental congenital transmission from infected mothers, transfusion of unscreened blood/platelet products, and solid organ transplantation, responsible for emerging cases in both endemic countries and global non-endemic metropolitan centers."}, {"name": "Daytime Tsetse Fly Bite in Sub-Saharan African Riverine or Savannah Habitats", "type": "Vector_Exposure", "description": "Vector-borne exposure via the painful daytime bite of infected tsetse flies (genus Glossina): riverine Glossina palpalis species transmitting T. b. gambiense in Western and Central Africa, or savannah Glossina morsitans species transmitting T. b. rhodesiense in Eastern and Southern Africa."}, {"name": "Exposure to East African Game and Cattle Reservoirs in Rhodesiense Habitats", "type": "Vector_Exposure", "description": "Occupational or recreational exposure (safari travelers, park rangers, cattle pastoralists) in East and Southern African savannah woodlands where wild game ungulates and domestic cattle serve as primary zoonotic reservoirs for virulent Trypanosoma brucei rhodesiense."}, {"name": "Trypanosoma cruzi", "type": "Pathogen", "description": "Kinetoplastid protozoan parasite and intracellular hemoflagellate that proliferates as intracellular amastigotes within cardiac myocytes, enteric smooth muscle, and autonomic ganglia, and circulates as extracellular motile C-shaped trypomastigotes in blood, causing Chagas disease."}, {"name": "Trypanosoma brucei gambiense", "type": "Pathogen", "description": "Extracellular hemoflagellate protozoan parasite responsible for anthroponotic, slowly progressive, chronic Human African Trypanosomiasis across 24 countries of West and Central Africa, accounting for over 90% of reported sleeping sickness cases."}, {"name": "Trypanosoma brucei rhodesiense", "type": "Pathogen", "description": "Extracellular hemoflagellate protozoan parasite causing acute, virulent, rapidly fulminant zoonotic Human African Trypanosomiasis in Eastern and Southern Africa, causing rapid parasitemia, early neurovascular invasion, and myocarditis."}, {"name": "Romaña Sign Unilateral Painless Periorbital Edema and Conjunctivitis", "type": "Cardinal_Sign", "description": "Unilateral, painless, bipalpebral violaceous edema with ipsilateral conjunctivitis and non-tender preauricular lymphadenopathy resulting from T. cruzi contamination of the ocular mucous membranes, pathognomonic of acute Chagas disease present in up to 50% of acute ocular inoculations."}, {"name": "Inoculation Chagoma Indurated Violaceous Skin Nodule", "type": "Cardinal_Sign", "description": "Indurated, erythematous, violaceous inflammatory skin nodule appearing at the cutaneous portal of entry of Trypanosoma cruzi following triatomine bite and defecation, frequently accompanied by local satellite lymphadenopathy."}, {"name": "Chagasic Cardiomyopathy with Apical Aneurysm and Right Bundle Branch Block", "type": "Cardinal_Sign", "description": "Severe chronic dilated cardiomyopathy characterized by biventricular systolic failure, localized left ventricular apical dyskinesia or thinning (pathognomonic apical aneurysm), mural thrombus formation predisposing to cardioembolic stroke, and conduction system disease presenting with Right Bundle Branch Block and Left Anterior Fascicular Block."}, {"name": "Chagasic Megaesophagus with Progressive Dysphagia and Regurgitation", "type": "Cardinal_Sign", "description": "Severe esophageal motricity disorder resulting from destruction of myenteric (Auerbach) parasympathetic plexus neurons, manifesting as progressive dysphagia for solids and liquids, odynophagia, regurgitation of undigested meals, nocturnal pulmonary aspiration, and profound cachexia."}, {"name": "Chagasic Megacolon with Severe Obstipation and Fecaloma Impaction", "type": "Cardinal_Sign", "description": "Severe colonic dilatation and hypomotility secondary to enteric parasympathetic neuronal loss, leading to intractable chronic obstipation (defecation once every 2–4 weeks), massive abdominal distension and meteorism, impaction of stony-hard fecalomas, and high risk of acute sigmoid volvulus."}, {"name": "Winterbottom Sign Posterior Cervical Lymphadenopathy", "type": "Cardinal_Sign", "description": "Prominent, non-tender, rubbery, mobile lymph node enlargement localized to the posterior cervical triangle of the neck, serving as the classical admission physical hallmark of hemolymphatic Stage 1 T. b. gambiense sleeping sickness."}, {"name": "Trypanosomal Chancre at Tsetse Bite Site", "type": "Cardinal_Sign", "description": "Painful, tender, indurated, erythematous nodule developing at the site of an infected tsetse fly bite within days of inoculation, typically desquamating or ulcerating centrally, especially common in T. b. rhodesiense."}, {"name": "Severe Sleep-Wake Cycle Inversion and Daytime Somnolence", "type": "Cardinal_Sign", "description": "Circadian sleep rhythm fragmentation pathognomonic of Stage 2 meningoencephalitic African sleeping sickness, characterized by uncontrollable daytime somnolence and sleep attacks alternating with intractable nocturnal insomnia, motor agitation, and progressive neuropsychiatric decay."}, {"name": "Direct Blood Microscopy of Motile C-Shaped Trypomastigotes", "type": "Admission_Lab_Imaging", "description": "Direct microscopic identification of motile, extracellular, flagellated C-shaped trypomastigotes on fresh anticoagulated blood wet mounts, microhematocrit centrifugation (Woo test), or Giemsa-stained thin/thick blood smears during acute Chagas disease or Stage 1 African trypanosomiasis."}, {"name": "Dual Concordant Positive Serological Assays for Anti-T. cruzi IgG", "type": "Admission_Lab_Imaging", "description": "Mandatory laboratory confirmation for chronic Chagas disease requiring two separate, concordantly reactive serological assays (e.g., ELISA, indirect immunofluorescence, or indirect hemagglutination) using different parasite antigenic preparations, due to subpatent parasitemia."}, {"name": "12-Lead ECG Showing Right Bundle Branch Block and Left Anterior Fascicular Block", "type": "Admission_Lab_Imaging", "description": "Admission 12-lead electrocardiogram demonstrating bifascicular conduction delay with complete Right Bundle Branch Block (RBBB) and Left Anterior Fascicular Block (LAFB), frequent ventricular premature beats, or complete atrioventricular block in chronic Chagasic cardiomyopathy."}, {"name": "Echocardiographic Left Ventricular Apical Thinning and Aneurysm with Thrombus", "type": "Admission_Lab_Imaging", "description": "Transthoracic echocardiogram revealing segmental wall-motion abnormalities, global systolic dysfunction, and localized left ventricular apical thinning or dyskinetic outpouching (apical aneurysm) frequently harboring mural thrombi."}, {"name": "Barium Esophagogram Bird-Beak Distal Narrowing and Megacolon Dilatation", "type": "Admission_Lab_Imaging", "description": "Fluoroscopic barium contrast imaging demonstrating marked esophageal dilation with distal smooth tapering (bird-beak sign or pencil-tip narrowing) on esophagogram, and massive elongation and dilation of the sigmoid colon (dolichomegacolon) on barium enema."}, {"name": "CSF Lymphocytic Pleocytosis, Elevated Protein, and Mott Morular Cells", "type": "Admission_Lab_Imaging", "description": "Staging lumbar puncture findings in Stage 2 Human African Trypanosomiasis demonstrating CSF leukocyte count > 5 WBC/mcL, elevated total protein (> 45 mg/dL), centrifuged CSF trypomastigotes, and Mott morular plasma cells containing IgM inclusions."}, {"name": "Positive Card Agglutination Test for Trypanosomiasis in Gambiense HAT", "type": "Admission_Lab_Imaging", "description": "Rapid serological agglutination assay (CATT) detecting circulating antibodies against variable surface glycoprotein antigens of T. b. gambiense in whole blood or serum, used for triage screening in West/Central African endemic areas."}, {"name": "Absence of Travel, Residence, or Exposure in Endemic Latin American or Sub-Saharan Regions", "type": "Exclusion_Criterion", "description": "Complete absence of lifetime travel, residence, vector contact, or ancestral origin in rural Latin America (for Chagas) or sub-Saharan African tsetse fly belts (for HAT), without history of blood transfusion or organ transplant, virtually excluding trypanosomiasis."}, {"name": "Normal 12-Lead Electrocardiogram and Normal Transthoracic Echocardiogram", "type": "Exclusion_Criterion", "description": "A strictly normal 12-lead ECG (no bundle branch block, fascicular block, or arrhythmias) and normal echocardiogram showing intact apical wall motion and normal chamber dimensions, virtually ruling out symptomatic Chagasic cardiomyopathy."}, {"name": "Normal CSF Analysis with Cell Count Below 5 Cells per Microliter and Absent Trypanosomes", "type": "Exclusion_Criterion", "description": "Normal cerebrospinal fluid examination demonstrating leukocyte count < 5 cells/mcL, normal protein, and absence of trypanosomes or Mott cells, definitively ruling out Stage 2 meningoencephalitic African sleeping sickness."}, {"name": "Negative Results on Two Concordant Distinct Anti-T. cruzi IgG Serologic Assays", "type": "Exclusion_Criterion", "description": "Non-reactive serologic results across two distinct, validated assays using different antigen preparations (e.g., negative ELISA and negative indirect immunofluorescence), ruling out chronic Chagas disease."}, {"name": "Idiopathic Dilated Cardiomyopathy and Ischemic Heart Disease", "type": "Disease", "description": "Non-infectious cardiomyopathy and ischemic heart failure presenting with biventricular failure and cardiomegaly, differentiated from Chagas cardiomyopathy by diffuse global hypokinesia without apical thinning/aneurysm, absence of RBBB+LAFB bifascicular block, absence of digestive megasyndromes, and negative T. cruzi serology."}, {"name": "Idiopathic Achalasia and Hirschsprung Disease", "type": "Disease", "description": "Primary neuromuscular gastrointestinal motility disorders causing progressive dysphagia or severe obstipation, differentiated from Chagasic megadisease by the absence of concurrent cardiac apical aneurysms, absence of bundle branch conduction defects, negative T. cruzi serology, and lack of triatomine exposure."}, {"name": "Severe Malaria", "type": "Disease", "description": "Acute febrile infection caused by Plasmodium falciparum presenting with high cyclical fever, hemolytic anemia, and splenomegaly, differentiated from African trypanosomiasis by the presence of intraerythrocytic ring parasites on blood smears and absence of Winterbottom cervical adenopathy or sleep-wake cycle inversion."}, {"name": "Visceral Leishmaniasis", "type": "Disease", "description": "Systemic kinetoplastid infection (Kala-azar) caused by Leishmania donovani/infantum presenting with prolonged undulating fever, massive splenomegaly, pancytopenia, and hypergammaglobulinemia, differentiated by intracellular amastigotes inside macrophages on bone marrow aspirate and lack of extracellular flagellates, Winterbottom adenopathy, or apical aneurysms."}, {"name": "Benznidazole Oral Therapy", "type": "Drug_Response", "description": "First-line oral nitroimidazole trypanocidal regimen (5–7 mg/kg/day for 60 days) providing high parasitological cure rates (>80%) in acute, congenital, and early chronic Chagas disease, but accompanied by frequent adverse effects (exfoliative dermatitis, peripheral neuropathy)."}, {"name": "Nifurtimox Oral Therapy", "type": "Drug_Response", "description": "Oral nitrofuran antiprotozoal therapy (8–10 mg/kg/day for 60–90 days) effective in acute Chagas disease, and also utilized as an oral component of combination therapy (NECT) for Stage 2 African sleeping sickness."}, {"name": "Pentamidine Isethionate Intramuscular Regimen", "type": "Drug_Response", "description": "Intramuscular diamidine therapy (4 mg/kg/day for 7–10 days) achieving high cure rates in Stage 1 hemolymphatic Trypanosoma brucei gambiense sleeping sickness, but incapable of penetrating the blood-brain barrier for Stage 2 disease."}, {"name": "Nifurtimox-Eflornithine Combination Therapy and Oral Fexinidazole", "type": "Drug_Response", "description": "Standard-of-care treatments for Stage 2 meningoencephalitic T. b. gambiense sleeping sickness: NECT (oral nifurtimox for 10 days plus IV eflornithine infusions for 7 days) and oral fexinidazole (with food for Stage 1 and non-severe Stage 2), achieving >95% cure with low neurotoxicity."}, {"name": "Suramin Intravenous Regimen for Rhodesiense First Stage", "type": "Drug_Response", "description": "Intravenous polysulfonated naphthylamine therapy (20 mg/kg weekly up to 1 g for 5 doses) used specifically for first-stage hemolymphatic Trypanosoma brucei rhodesiense infection, requiring renal monitoring."}, {"name": "Melarsoprol Intravenous Organoarsenical Regimen", "type": "Drug_Response", "description": "Intravenous organoarsenical capable of crossing the blood-brain barrier for Stage 2 meningoencephalitic Trypanosoma brucei rhodesiense, effective but associated with a 5–10% risk of fatal post-treatment reactive encephalopathy."}, {"name": "Refractoriness to Standard Antibacterial and Antiviral Agents", "type": "Drug_Response", "description": "Inherent lack of clinical, microbiological, or parasitological response to broad-spectrum antibacterial, antifungal, or antiviral agents, confirming the necessity of targeted kinetoplastid antiprotozoal therapy."}, {"name": "Refractoriness of Advanced Fibrotic Chagas Cardiomyopathy and Megasyndromes to Benznidazole", "type": "Drug_Response", "description": "Inability of antiparasitic therapy with benznidazole to reverse established transmural myocardial apical fibrosis, ventricular dilatation, or irreversible enteric neurolysis in advanced chronic Chagas disease, requiring supportive cardiac/surgical care."}], "relationships": [{"source": "Trypanosomiasis", "target": "Nocturnal Triatomine Kissing Bug Feces Contamination in Endemic Rural Latin America", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] American trypanosomiasis (Chagas disease) is primarily transmitted through contamination of bite wounds or mucous membranes with metacyclic trypomastigote-containing feces of nocturnal triatomine bugs inhabiting rural dwellings in Latin America."}, {"source": "Trypanosomiasis", "target": "Oral Ingestion of Fresh Juices Contaminated with Crushed Triatomine Vectors", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] Trypanosomiasis can be transmitted orally via ingestion of fresh juices (açai, sugarcane) contaminated with crushed infected triatomines, producing an explosive, severe acute Chagas myocarditis outbreak."}, {"source": "Trypanosomiasis", "target": "Blood Product Transfusion, Organ Transplantation, or Congenital Maternal-Fetal Exposure", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Trypanosomiasis is acquired non-vectorially through transplacental vertical transmission, transfusions of contaminated blood products, or solid organ transplants from infected donors in both endemic and non-endemic regions."}, {"source": "Trypanosomiasis", "target": "Daytime Tsetse Fly Bite in Sub-Saharan African Riverine or Savannah Habitats", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] Human African trypanosomiasis is transmitted by the painful daytime bite of infected Glossina tsetse flies in riverine or savannah ecozones of sub-Saharan Africa."}, {"source": "Trypanosomiasis", "target": "Exposure to East African Game and Cattle Reservoirs in Rhodesiense Habitats", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Human African trypanosomiasis caused by T. b. rhodesiense is linked to exposure to savannah wildlife and domestic cattle reservoirs in Eastern and Southern Africa."}, {"source": "Trypanosomiasis", "target": "Trypanosoma cruzi", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Trypanosomiasis (Chagas disease) is caused by the intracellular kinetoplastid protozoan Trypanosoma cruzi, which replicates inside cardiomyocytes and autonomic enteric plexuses."}, {"source": "Trypanosomiasis", "target": "Trypanosoma brucei gambiense", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Human African trypanosomiasis in West and Central Africa is caused by Trypanosoma brucei gambiense, producing a chronic, slowly progressive meningoencephalitic illness."}, {"source": "Trypanosomiasis", "target": "Trypanosoma brucei rhodesiense", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Human African trypanosomiasis in East and Southern Africa is caused by Trypanosoma brucei rhodesiense, producing an acute, virulent infection with rapid multi-organ and central nervous system invasion."}, {"source": "Trypanosomiasis", "target": "Romaña Sign Unilateral Painless Periorbital Edema and Conjunctivitis", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Romaña sign presents as unilateral, painless, bipalpebral periorbital edema and violaceous conjunctivitis with preauricular lymphadenopathy, representing the pathognomonic physical hallmark of acute ocular Chagas disease."}, {"source": "Trypanosomiasis", "target": "Inoculation Chagoma Indurated Violaceous Skin Nodule", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Inoculation chagoma manifests as an inflammatory, indurated, violaceous skin nodule at the site of triatomine bug defecation during the acute phase of Chagas disease."}, {"source": "Trypanosomiasis", "target": "Chagasic Cardiomyopathy with Apical Aneurysm and Right Bundle Branch Block", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Chronic Chagasic cardiomyopathy presents with biventricular heart failure, a pathognomonic left ventricular apical aneurysm, mural thrombosis predisposing to stroke, and bifascicular conduction defects (RBBB plus LAFB)."}, {"source": "Trypanosomiasis", "target": "Chagasic Megaesophagus with Progressive Dysphagia and Regurgitation", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Chagasic megaesophagus presents at admission with progressive solid and liquid dysphagia, painful odynophagia, regurgitation of undigested meals, and severe cachexia secondary to enteric nervous system destruction."}, {"source": "Trypanosomiasis", "target": "Chagasic Megacolon with Severe Obstipation and Fecaloma Impaction", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Chagasic megacolon manifests with severe intractable obstipation, massive abdominal distension, impaction of stony-hard fecalomas, and acute sigmoid volvulus requiring surgical intervention."}, {"source": "Trypanosomiasis", "target": "Winterbottom Sign Posterior Cervical Lymphadenopathy", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Winterbottom sign presents as visible, painless, rubbery, mobile posterior cervical lymphadenopathy, serving as the classical admission physical hallmark of Stage 1 T. b. gambiense sleeping sickness."}, {"source": "Trypanosomiasis", "target": "Trypanosomal Chancre at Tsetse Bite Site", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] A trypanosomal chancre manifests as a painful, indurated, erythematous nodule at the site of a tsetse fly bite, appearing days before systemic dissemination, especially in T. b. rhodesiense."}, {"source": "Trypanosomiasis", "target": "Severe Sleep-Wake Cycle Inversion and Daytime Somnolence", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Circadian sleep disruption presents with pathognomonic sleep-wake cycle inversion, featuring uncontrollable daytime somnolence and nocturnal insomnia in Stage 2 meningoencephalitic sleeping sickness."}, {"source": "Trypanosomiasis", "target": "Direct Blood Microscopy of Motile C-Shaped Trypomastigotes", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Admission wet mounts, microhematocrit centrifugation (Woo test), or Giemsa smears confirm acute trypanosomiasis by visualizing motile extracellular flagellated C-shaped trypomastigotes in circulating blood."}, {"source": "Trypanosomiasis", "target": "Dual Concordant Positive Serological Assays for Anti-T. cruzi IgG", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Chronic Chagas disease diagnosis on admission requires two concordantly positive serological assays (such as ELISA and indirect immunofluorescence) using different T. cruzi antigenic preparations."}, {"source": "Trypanosomiasis", "target": "12-Lead ECG Showing Right Bundle Branch Block and Left Anterior Fascicular Block", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Admission 12-lead ECG reveals a characteristic bifascicular conduction pattern of Right Bundle Branch Block (RBBB) combined with Left Anterior Fascicular Block (LAFB) in over 50% of chronic Chagasic cardiomyopathy patients."}, {"source": "Trypanosomiasis", "target": "Echocardiographic Left Ventricular Apical Thinning and Aneurysm with Thrombus", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Admission echocardiography reveals localized left ventricular apical thinning, dyskinetic apical aneurysm, and mural thrombi indicative of advanced Chagas cardiomyopathy."}, {"source": "Trypanosomiasis", "target": "Barium Esophagogram Bird-Beak Distal Narrowing and Megacolon Dilatation", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Barium radiography demonstrates distal esophageal tapering with proximal dilation (bird-beak sign) and massive elongation/dilation of the sigmoid colon (dolichomegacolon) in Chagasic digestive megasyndromes."}, {"source": "Trypanosomiasis", "target": "CSF Lymphocytic Pleocytosis, Elevated Protein, and Mott Morular Cells", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Staging lumbar puncture reveals CSF lymphocytic pleocytosis (> 5 WBC/mcL), elevated protein (> 45 mg/dL), motile trypanosomes, and Mott morular plasma cells containing IgM inclusions, diagnosing Stage 2 African sleeping sickness."}, {"source": "Trypanosomiasis", "target": "Positive Card Agglutination Test for Trypanosomiasis in Gambiense HAT", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] High-titer positivity on the Card Agglutination Test for Trypanosomiasis (CATT) provides rapid admission serological screening confirmation for T. b. gambiense infection."}, {"source": "Trypanosomiasis", "target": "Absence of Travel, Residence, or Exposure in Endemic Latin American or Sub-Saharan Regions", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Trypanosomiasis is virtually ruled out in patients with zero epidemiological exposure or residency in endemic rural Latin America or sub-Saharan Africa, in the absence of blood/organ donation or congenital exposure."}, {"source": "Trypanosomiasis", "target": "Normal 12-Lead Electrocardiogram and Normal Transthoracic Echocardiogram", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Symptomatic Chagasic cardiomyopathy is effectively ruled out by a completely normal 12-lead ECG and normal echocardiogram showing preserved apical wall motion without conduction defects."}, {"source": "Trypanosomiasis", "target": "Normal CSF Analysis with Cell Count Below 5 Cells per Microliter and Absent Trypanosomes", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Second-stage meningoencephalitic African trypanosomiasis is ruled out by normal CSF cell count (< 5 WBC/mcL), absence of Mott cells, and absence of centrifuged CSF trypanosomes."}, {"source": "Trypanosomiasis", "target": "Negative Results on Two Concordant Distinct Anti-T. cruzi IgG Serologic Assays", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Chronic Chagas disease is ruled out by non-reactive results on two independent, validated serological assays detecting anti-T. cruzi antibodies."}, {"source": "Trypanosomiasis", "target": "Idiopathic Dilated Cardiomyopathy and Ischemic Heart Disease", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Trypanosomiasis (Chagas cardiomyopathy) is differentiated from idiopathic dilated cardiomyopathy and ischemic heart disease by the presence of pathognomonic apical LV aneurysm, RBBB with LAFB, positive T. cruzi serology, and associated digestive megasyndromes, whereas idiopathic DCM causes diffuse global hypokinesia without apical thinning."}, {"source": "Trypanosomiasis", "target": "Idiopathic Achalasia and Hirschsprung Disease", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Trypanosomiasis is differentiated from idiopathic achalasia and Hirschsprung disease by the presence of positive anti-T. cruzi serology, concurrent cardiac conduction abnormalities, apical aneurysms, and triatomine exposure in Latin America."}, {"source": "Trypanosomiasis", "target": "Severe Malaria", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Trypanosomiasis is differentiated from severe malaria because malaria exhibits intraerythrocytic parasites on blood smears and lacks Winterbottom posterior cervical adenopathy and characteristic sleep-wake cycle inversion."}, {"source": "Trypanosomiasis", "target": "Visceral Leishmaniasis", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Trypanosomiasis is differentiated from visceral leishmaniasis because visceral leishmaniasis exhibits profound pancytopenia and intracellular amastigotes in bone marrow macrophages, whereas trypanosomiasis presents with extracellular flagellates, Winterbottom sign, or Chagasic apical aneurysm."}, {"source": "Trypanosomiasis", "target": "Benznidazole Oral Therapy", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Trypanosomiasis (acute, congenital, and early chronic Chagas disease) responds with high parasitological cure rates to oral benznidazole therapy, halting disease progression."}, {"source": "Trypanosomiasis", "target": "Nifurtimox Oral Therapy", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Trypanosomiasis responds to oral nifurtimox therapy in acute Chagas disease and as an essential oral component of combination therapy for Stage 2 gambiense sleeping sickness."}, {"source": "Trypanosomiasis", "target": "Pentamidine Isethionate Intramuscular Regimen", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Trypanosomiasis in Stage 1 hemolymphatic T. b. gambiense sleeping sickness responds to intramuscular pentamidine isethionate, clearing peripheral parasitemia."}, {"source": "Trypanosomiasis", "target": "Nifurtimox-Eflornithine Combination Therapy and Oral Fexinidazole", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Trypanosomiasis with Stage 2 CNS T. b. gambiense infection responds to Nifurtimox-Eflornithine Combination Therapy (NECT) and oral fexinidazole, achieving high cure rates with low neurotoxicity."}, {"source": "Trypanosomiasis", "target": "Suramin Intravenous Regimen for Rhodesiense First Stage", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Trypanosomiasis caused by first-stage hemolymphatic T. b. rhodesiense responds to intravenous suramin therapy."}, {"source": "Trypanosomiasis", "target": "Melarsoprol Intravenous Organoarsenical Regimen", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Trypanosomiasis in Stage 2 meningoencephalitic T. b. rhodesiense responds to intravenous melarsoprol, although therapy carries significant risk of reactive encephalopathy."}, {"source": "Trypanosomiasis", "target": "Refractoriness to Standard Antibacterial and Antiviral Agents", "keywords": "INTRINSICALLY_RESISTANT_TO", "description": "[INTRINSICALLY_RESISTANT_TO] Trypanosomiasis is intrinsically resistant to standard broad-spectrum antibacterial and antiviral agents, showing no clinical improvement upon their administration."}, {"source": "Trypanosomiasis", "target": "Refractoriness of Advanced Fibrotic Chagas Cardiomyopathy and Megasyndromes to Benznidazole", "keywords": "INTRINSICALLY_RESISTANT_TO", "description": "[INTRINSICALLY_RESISTANT_TO] Established fibrotic lesions in advanced chronic Chagasic cardiomyopathy and end-stage digestive megacolon are refractory to parasitological reversal by benznidazole or nifurtimox, requiring supportive cardiac/surgical care."}]}}
{"case_id": "tuberculosis", "disease": "Tuberculosis", "extraction": {"entities": [{"name": "Tuberculosis", "type": "Disease", "description": "Chronic granulomatous infectious disease caused by Mycobacterium tuberculosis complex, transmitted airborne via droplet nuclei, primarily affecting pulmonary parenchyma with characteristic cavitation, but capable of extrapulmonary dissemination."}, {"name": "Airborne Inhalation of Droplet Nuclei in Poorly Ventilated Spaces", "type": "Vector_Exposure", "description": "Exclusively airborne transmission via microscopic droplet nuclei (1–5 µm) suspended in ambient air from infectious coughs or sneezes, heavily exacerbated by prolonged indoor contact in crowded, poorly ventilated environments such as prisons, homeless shelters, and refugee camps."}, {"name": "Advanced HIV/AIDS Immunosuppression", "type": "Vector_Exposure", "description": "Most potent host risk factor (12-fold increased risk of active disease; leading cause of HIV-associated mortality), driving rapid reactivation of latent infection or accelerated progression of primary disease due to depleted CD4+ T-cell-mediated immunity."}, {"name": "Type 2 Diabetes Mellitus with Chronic Hyperglycemia", "type": "Vector_Exposure", "description": "Major host comorbidity that triples the lifetime risk of active tuberculosis reactivation due to impaired alveolar macrophage phagocytosis, defective chemotaxis, and blunted cell-mediated immune responses."}, {"name": "Silicosis and Occupational Dust Inhalation", "type": "Vector_Exposure", "description": "Occupational exposure causing macrophage lysis and pulmonary fibrosis, producing up to a 30-fold increased lifetime susceptibility to pulmonary tuberculosis (silicotuberculosis)."}, {"name": "High-Burden Endemic Geography in South-East Asia and Sub-Saharan Africa", "type": "Vector_Exposure", "description": "Residency or prolonged travel in countries with extreme tuberculosis incidence and prevalence (such as India, Indonesia, China, the Philippines, Pakistan, Nigeria, and South Africa), accounting for over 80% of global cases."}, {"name": "Mycobacterium tuberculosis Complex", "type": "Pathogen", "description": "Obligate aerobic, slow-growing, acid-fast bacillus with a lipid-rich, mycolic-acid-dense cell wall that resists Gram staining, acid-alcohol decolorization, and intracellular macrophage destruction."}, {"name": "Chronic Productive Cough Exceeding 3 Weeks with Hemoptysis", "type": "Cardinal_Sign", "description": "Indolent cough lasting >2–3 weeks progressing from dry irritation to purulent or blood-streaked sputum, potentially escalating to life-threatening Rasmussen aneurysm rupture within cavitary lesions."}, {"name": "Drenching Night Sweats with Profound Cachectic Weight Loss", "type": "Cardinal_Sign", "description": "Classic systemic constitutional B-symptom triad comprising soaking nocturnal diaphoresis requiring change of clothing, evening low-grade fever spikes, and progressive wasting consumption."}, {"name": "Matted Cervical Lymphadenopathy with Cold Abscess Formation", "type": "Cardinal_Sign", "description": "Scrofula presentation featuring firm, matted, non-tender cervical or supraclavicular lymph node enlargement that softens into fluctuant cold abscesses with chronic fistulous drainage."}, {"name": "Thoracolumbar Vertebral Gibbus Deformity with Cold Psoas Abscess", "type": "Cardinal_Sign", "description": "Pott disease presentation characterized by localized spinal pain, anterior vertebral body collapse causing acute angular kyphosis (gibbus deformity), and tracking retroperitoneal cold psoas abscesses."}, {"name": "Apical and Posterior Upper Lobe Cavitary Infiltrates on Chest Radiography", "type": "Admission_Lab_Imaging", "description": "Heterogeneous patchy consolidation and thick-walled cavitary lesions localized to the apical/posterior segments of the upper lobes or superior segments of lower lobes, often surrounded by tree-in-bud nodular satellite opacities."}, {"name": "Diffuse Bilateral 1-2 mm Micronodular Opacities on Chest Radiography", "type": "Admission_Lab_Imaging", "description": "Classic 'millet seed' pattern of uniform, 1–2 mm discrete micronodules evenly distributed throughout both lungs from apex to base, reflecting acute hematogenous miliary dissemination."}, {"name": "Acid-Fast Bacilli on Ziehl-Neelsen or Auramine-O Sputum Microscopy", "type": "Admission_Lab_Imaging", "description": "Immediate admission microscopical visualization of bright red or glowing rod-shaped acid-fast bacilli on Ziehl-Neelsen or auramine-O fluorochrome stained sputum smears."}, {"name": "Rapid Sputum Cartridge NAAT Detection of MTB Complex and rpoB Resistance", "type": "Admission_Lab_Imaging", "description": "Rapid cartridge-based nucleic acid amplification (Xpert MTB/RIF) providing bacteriological confirmation of M. tuberculosis DNA and detecting mutations in the rpoB gene within 2 hours directly from sputum."}, {"name": "Normocytic Anemia with Reactive Thrombocytosis and Extreme ESR Elevation", "type": "Admission_Lab_Imaging", "description": "Admission hematology showing normocytic normochromic anemia (Hb 8–11 g/dL), normal or mildly elevated WBC without marked leukocytosis, elevated platelets (400,000–600,000/µL), and marked ESR elevation (>60–100 mm/h)."}, {"name": "Polyserositis and Splenic Microabscesses on Bedside FASH Ultrasound", "type": "Admission_Lab_Imaging", "description": "Focused Assessment with Sonography for HIV-associated TB (FASH) identifying pericardial effusion, pleural fluid, ascites, and abdominal lymphadenopathy (>1.5 cm) or hypoechoic splenic microabscesses at triage."}, {"name": "Hyperacute Febrile Respiratory Distress Evolving Within 48-72 Hours", "type": "Exclusion_Criterion", "description": "Hyperacute onset of fever, rigors, and dyspnea developing in under 48 to 72 hours, which strongly points toward acute pyogenic bacterial community-acquired pneumonia rather than indolent tuberculosis."}, {"name": "Marked Peripheral Blood Eosinophilia Exceeding 15 Percent", "type": "Exclusion_Criterion", "description": "Absolute eosinophil count >1,500/µL or eosinophil fraction >15–30%, which is virtually never seen in active pulmonary tuberculosis and indicates parasitic lung flukes (Paragonimiasis) or allergic/fungal pulmonary disease."}, {"name": "Complete Radiographic Resolution Within 5-7 Days of Beta-Lactam Monotherapy", "type": "Exclusion_Criterion", "description": "Rapid clinical defervescence and near-total radiological resolution of pulmonary consolidation within 5 to 7 days of treatment with standard beta-lactam antibiotics (e.g., amoxicillin, ceftriaxone)."}, {"name": "Marked Neutrophilic Leukocytosis Exceeding 15000 per Microliter with Severe Left Shift", "type": "Exclusion_Criterion", "description": "Pronounced peripheral leukocytosis (WBC >15,000–30,000/µL) with bandemia >15% and hyperacute procalcitonin elevation, which is distinctly atypical for uncomplicated active tuberculosis and indicates acute pyogenic sepsis or melioidosis."}, {"name": "Melioidosis", "type": "Disease", "description": "Severe tropical infection caused by Burkholderia pseudomallei presenting with upper-lobe cavitary pneumonia and hemoptysis in endemic regions of Southeast Asia and Northern Australia."}, {"name": "Paragonimiasis", "type": "Disease", "description": "Endemic lung fluke infection caused by Paragonimus westermani contracted through ingestion of raw or undercooked freshwater crabs/crayfish, mimicking pulmonary TB with chronic cough and hemoptysis."}, {"name": "Bronchogenic Carcinoma", "type": "Disease", "description": "Primary pulmonary malignancy occurring in older smokers presenting with chronic cough, hemoptysis, cachexia, and cavitary or nodular lung lesions."}, {"name": "Paracoccidioidomycosis", "type": "Disease", "description": "Endemic South American systemic mycosis caused by Paracoccidioides brasiliensis presenting with chronic cavitary lung disease, lymphadenopathy, and mucosal ulcerations."}, {"name": "Standard First-Line 4-Drug Regimen (Rifampicin, Isoniazid, Pyrazinamide, Ethambutol)", "type": "Drug_Response", "description": "WHO-standardized short-course antitubercular therapy (RIPE) comprising a 2-month intensive phase (RHZE) followed by a 4-month continuation phase (RH), yielding clinical defervescence within 2–4 weeks and sputum smear conversion by month 2."}, {"name": "Mandatory Pyridoxine Co-Administration to Prevent Isoniazid Neurotoxicity", "type": "Drug_Response", "description": "Mandatory daily supplementation with Vitamin B6 (25–50 mg daily) to prevent dose-dependent isoniazid-induced peripheral sensory neuropathy and central neurotoxicity."}, {"name": "Fluoroquinolone-Induced Transient Symptomatic Masking Hazard", "type": "Drug_Response", "description": "Partial, transient clinical and radiographic improvement following empirical respiratory fluoroquinolone monotherapy (e.g., levofloxacin, moxifloxacin) due to inherent anti-mycobacterial activity, creating hazardous diagnostic delays."}, {"name": "Intrinsic Resistance to Broad-Spectrum Beta-Lactam and Standard Cephalosporin Monotherapy", "type": "Drug_Response", "description": "Intrinsic therapeutic refractoriness to standard aminopenicillins, first-to-fourth generation cephalosporins, and macrolides due to robust bacterial beta-lactamases and the impermeable mycolic acid cell envelope."}, {"name": "Novel 6-Month All-Oral BPaLM Regimen for Multidrug-Resistant Tuberculosis", "type": "Drug_Response", "description": "WHO-recommended 6-month all-oral regimen consisting of Bedaquiline, Pretomanid, Linezolid, and Moxifloxacin (BPaLM) for rifampicin-resistant and multidrug-resistant tuberculosis (MDR-TB)."}], "relationships": [{"source": "Tuberculosis", "target": "Airborne Inhalation of Droplet Nuclei in Poorly Ventilated Spaces", "keywords": "TRANSMITTED_BY, droplet nuclei, airborne aerosol, inhalation, poorly ventilated indoor spaces", "description": "[TRANSMITTED_BY] Acquired exclusively via inhalation of aerosolized 1–5 µm droplet nuclei expelled by active infectious pulmonary cases, suspended in stagnant ambient air."}, {"source": "Tuberculosis", "target": "Advanced HIV/AIDS Immunosuppression", "keywords": "EXPOSURE_TO, host susceptibility, CD4 immunosuppression, HIV coinfection, cellular immunity failure", "description": "[EXPOSURE_TO] Severely impaired cell-mediated immunity in HIV/AIDS is the most potent global host risk factor, multiplying active disease reactivation risk by 12-fold."}, {"source": "Tuberculosis", "target": "Type 2 Diabetes Mellitus with Chronic Hyperglycemia", "keywords": "EXPOSURE_TO, host metabolic comorbidity, diabetes mellitus, macrophage dysfunction, reactivation", "description": "[EXPOSURE_TO] Chronic hyperglycemia triples the risk of latent tuberculosis reactivation through impaired alveolar macrophage chemotaxis and blunted antigen presentation."}, {"source": "Tuberculosis", "target": "Silicosis and Occupational Dust Inhalation", "keywords": "EXPOSURE_TO, occupational hazard, silica dust, macrophage lysis, silicotuberculosis", "description": "[EXPOSURE_TO] Chronic occupational inhalation of crystalline silica destroys alveolar macrophages and elevates active tuberculosis risk up to 30-fold."}, {"source": "Tuberculosis", "target": "High-Burden Endemic Geography in South-East Asia and Sub-Saharan Africa", "keywords": "EXPOSURE_TO, geographic endemicity, high-burden settings, regional reservoir, transmission intensity", "description": "[EXPOSURE_TO] Exposure or prolonged residence within hyperendemic regions of South-East Asia, the Western Pacific, or sub-Saharan Africa represents the primary epidemiological risk pool."}, {"source": "Tuberculosis", "target": "Mycobacterium tuberculosis Complex", "keywords": "HAS_PATHOGEN, etiologic agent, acid fast bacillus, mycolic acid cell wall, obligate aerobe", "description": "[HAS_PATHOGEN] Caused by infection with Mycobacterium tuberculosis complex, an obligate aerobe whose lipid-dense mycolic acid cell wall confers acid-fastness and intracellular persistence."}, {"source": "Tuberculosis", "target": "Chronic Productive Cough Exceeding 3 Weeks with Hemoptysis", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, cardinal sign, chronic hemoptysis, Rasmussen aneurysm", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Indolent cough lasting >3 weeks with blood-streaked sputum or life-threatening Rasmussen aneurysm hemoptysis reflects progressive bronchial ulceration and cavitary necrosis."}, {"source": "Tuberculosis", "target": "Drenching Night Sweats with Profound Cachectic Weight Loss", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, constitutional B-symptoms, drenching diaphoresis, consumption", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Subacute wasting cachexia accompanied by evening fever spikes and drenching nocturnal sweats represents the classic constitutional hallmark of active tuberculosis."}, {"source": "Tuberculosis", "target": "Matted Cervical Lymphadenopathy with Cold Abscess Formation", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, scrofula, tuberculous lymphadenitis, cold abscess", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Painless, firm, matted cervical or supraclavicular lymph node chains breaking down into cold abscesses and chronically draining fistulae represent the cardinal sign of scrofula."}, {"source": "Tuberculosis", "target": "Thoracolumbar Vertebral Gibbus Deformity with Cold Psoas Abscess", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, Pott disease, tuberculous spondylitis, gibbus deformity", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Sharp angular thoracolumbar kyphosis (gibbus) resulting from anterior vertebral body destruction with tracking cold psoas abscess is pathognomonic for skeletal tuberculosis."}, {"source": "Tuberculosis", "target": "Apical and Posterior Upper Lobe Cavitary Infiltrates on Chest Radiography", "keywords": "EXHIBITS_LAB_PATTERN, chest radiography, apical cavitary lesion, upper lobe infiltrates, tree in bud", "description": "[EXHIBITS_LAB_PATTERN] Plain admission chest radiograph shows patchy consolidation, tree-in-bud nodular satellite opacities, and thick-walled cavitary lesions localized to the apical/posterior upper lobes."}, {"source": "Tuberculosis", "target": "Diffuse Bilateral 1-2 mm Micronodular Opacities on Chest Radiography", "keywords": "EXHIBITS_LAB_PATTERN, miliary tuberculosis, micronodular interstitial pattern, millet seed appearance", "description": "[EXHIBITS_LAB_PATTERN] Uniform, diffuse 1–2 mm micronodular opacities evenly scattered from lung apices to bases on admission chest radiography reflect acute hematogenous miliary dissemination."}, {"source": "Tuberculosis", "target": "Acid-Fast Bacilli on Ziehl-Neelsen or Auramine-O Sputum Microscopy", "keywords": "EXHIBITS_LAB_PATTERN, acid fast bacilli, Ziehl Neelsen smear, auramine O fluorescence, microscopic hallmark", "description": "[EXHIBITS_LAB_PATTERN] Direct admission sputum microscopy demonstrates bright red rods on Ziehl-Neelsen staining or glowing fluorescing rods under auramine-O microscopy."}, {"source": "Tuberculosis", "target": "Rapid Sputum Cartridge NAAT Detection of MTB Complex and rpoB Resistance", "keywords": "EXHIBITS_LAB_PATTERN, GeneXpert MTB/RIF, cartridge molecular assay, rpoB resistance, rapid admission NAAT", "description": "[EXHIBITS_LAB_PATTERN] Rapid cartridge-based automated NAAT (Xpert MTB/RIF) directly identifies M. tuberculosis complex DNA and detects rpoB rifampicin resistance mutations within 2 hours."}, {"source": "Tuberculosis", "target": "Normocytic Anemia with Reactive Thrombocytosis and Extreme ESR Elevation", "keywords": "EXHIBITS_LAB_PATTERN, anemia of chronic disease, normal WBC, reactive thrombocytosis, extreme ESR elevation", "description": "[EXHIBITS_LAB_PATTERN] Admission laboratory profile demonstrates normocytic anemia (Hb 8-11 g/dL), normal or mildly elevated WBC, reactive thrombocytosis (400-600k/µL), and ESR markedly elevated >60-100 mm/h."}, {"source": "Tuberculosis", "target": "Polyserositis and Splenic Microabscesses on Bedside FASH Ultrasound", "keywords": "EXHIBITS_LAB_PATTERN, bedside ultrasound, FASH protocol, pericardial effusion, abdominal lymphadenopathy", "description": "[EXHIBITS_LAB_PATTERN] Point-of-care ultrasound under the FASH protocol identifies pericardial effusion, pleural fluid, retroperitoneal/mesenteric lymphadenopathy (>1.5 cm), and hypoechoic splenic microabscesses at triage."}, {"source": "Tuberculosis", "target": "Hyperacute Febrile Respiratory Distress Evolving Within 48-72 Hours", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, hyperacute onset, temporal threshold", "description": "[RULED_OUT_BY] Hyperacute onset of toxic fever and respiratory distress evolving within <48–72 hours strongly excludes uncomplicated tuberculosis, which inherently follows an insidious multi-week course."}, {"source": "Tuberculosis", "target": "Marked Peripheral Blood Eosinophilia Exceeding 15 Percent", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, peripheral eosinophilia, parasitic differentiation", "description": "[RULED_OUT_BY] High-grade peripheral blood eosinophilia (>1,500/µL or >15–30%) strongly rules out pulmonary tuberculosis, pointing instead to parasitic fluke infestations or allergic bronchopulmonary disorders."}, {"source": "Tuberculosis", "target": "Complete Radiographic Resolution Within 5-7 Days of Beta-Lactam Monotherapy", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, beta lactam response, rapid clearing", "description": "[RULED_OUT_BY] Rapid clinical resolution and complete radiological clearance of pulmonary infiltrates within 5–7 days of standard beta-lactam therapy rules out mycobacterial infection."}, {"source": "Tuberculosis", "target": "Marked Neutrophilic Leukocytosis Exceeding 15000 per Microliter with Severe Left Shift", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, leukocytosis threshold, toxic bandemia", "description": "[RULED_OUT_BY] Profound neutrophilic leukocytosis (>15,000–30,000/µL) with toxic bandemia >15% is distinctly atypical for uncomplicated tuberculosis and points toward acute pyogenic sepsis or melioidosis."}, {"source": "Tuberculosis", "target": "Melioidosis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, Burkholderia pseudomallei, acute sepsis", "description": "[DIFFERENTIATED_FROM] Melioidosis presents with acute fulminant toxicity (<1–2 weeks), marked leukocytosis (>15,000/µL), and splenic honeycomb microabscesses primarily in diabetics; Tuberculosis presents with insidious progression (>3 weeks), normal/mild WBC, positive AFB/GeneXpert, and response to RIPE."}, {"source": "Tuberculosis", "target": "Paragonimiasis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, lung fluke, raw crustacean ingestion, eosinophilia", "description": "[DIFFERENTIATED_FROM] Paragonimiasis presents with chronic cough, rusty-brown sputum, ingestion of raw freshwater crabs/crayfish, and marked peripheral eosinophilia (>15–30%); Tuberculosis lacks eosinophilia and reveals acid-fast bacilli on sputum smear microscopy."}, {"source": "Tuberculosis", "target": "Bronchogenic Carcinoma", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, pulmonary malignancy, cavitary mass", "description": "[DIFFERENTIATED_FROM] Bronchogenic carcinoma presents in older smokers with irregular, eccentrically excavated thick-walled cavities lacking tree-in-bud satellites, negative AFB/GeneXpert, and malignant cytology on bronchoscopy."}, {"source": "Tuberculosis", "target": "Paracoccidioidomycosis", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, endemic mycosis, mucosal ulceration, pilot wheel", "description": "[DIFFERENTIATED_FROM] Paracoccidioidomycosis features mulberry-like ulcerative stomatitis in the oropharynx, marked cervical adenopathy, and pilot's wheel budding yeast cells on histology; Tuberculosis lacks oral mulberry ulcerations and yields acid-fast bacilli."}, {"source": "Tuberculosis", "target": "Standard First-Line 4-Drug Regimen (Rifampicin, Isoniazid, Pyrazinamide, Ethambutol)", "keywords": "RESPONDS_TO, RIPE regimen, first-line antitubercular therapy, defervescence timeline, sputum smear conversion", "description": "[RESPONDS_TO] Shows systematic clinical defervescence, cessation of nocturnal diaphoresis, and weight gain within 2–4 weeks of initiating 4-drug RIPE therapy, with sputum conversion to negative by month 2."}, {"source": "Tuberculosis", "target": "Mandatory Pyridoxine Co-Administration to Prevent Isoniazid Neurotoxicity", "keywords": "RESPONDS_TO, pyridoxine supplementation, vitamin B6, isoniazid prophylaxis, neuroprotection", "description": "[RESPONDS_TO] Requires mandatory co-administration of pyridoxine (vitamin B6, 25–50 mg daily) alongside isoniazid to prevent disabling dose-dependent peripheral sensory neuropathy."}, {"source": "Tuberculosis", "target": "Fluoroquinolone-Induced Transient Symptomatic Masking Hazard", "keywords": "RESPONDS_TO, fluoroquinolone masking, empirical quinolone delay, temporary defervescence", "description": "[RESPONDS_TO] Exhibits transient, deceptive symptomatic improvement upon empirical respiratory fluoroquinolone therapy (e.g., levofloxacin, moxifloxacin), which dangerously masks active tuberculosis and delays definitive therapy."}, {"source": "Tuberculosis", "target": "Intrinsic Resistance to Broad-Spectrum Beta-Lactam and Standard Cephalosporin Monotherapy", "keywords": "INTRINSICALLY_RESISTANT_TO, antibiotic failure, intrinsic resistance, beta-lactamase BlaC, cephalosporin refractoriness", "description": "[INTRINSICALLY_RESISTANT_TO] Intrinsically refractory to standard aminopenicillins and first-through-fourth generation cephalosporins due to constitutive BlaC beta-lactamase production and impermeable mycolic acid cell envelope."}, {"source": "Tuberculosis", "target": "Novel 6-Month All-Oral BPaLM Regimen for Multidrug-Resistant Tuberculosis", "keywords": "RESPONDS_TO, MDR-TB, drug-resistant tuberculosis, BPaLM regimen, all-oral short course", "description": "[RESPONDS_TO] Multidrug-resistant and rifampicin-resistant tuberculosis strains respond to the WHO-prioritized 6-month all-oral BPaLM regimen (bedaquiline, pretomanid, linezolid, and moxifloxacin)."}]}}
{"case_id": "viral_hemorrhagic_fevers", "disease": "Viral Hemorrhagic Fevers", "extraction": {"entities": [{"name": "Viral Hemorrhagic Fevers", "type": "Disease", "description": "A group of life-threatening severe systemic zoonoses caused by enveloped RNA viruses from four families (Filoviridae, Bunyavirales, Arenaviridae, Flaviviridae), characterized by abrupt fever, diffuse microvascular permeability, severe thrombocytopenia, marked AST-dominant transaminitis, coagulopathy progressing to disseminated intravascular coagulation, and high mortality."}, {"name": "Direct Contact with Infected Body Fluids and Nosocomial Blood Exposure", "type": "Vector_Exposure", "description": "Direct cutaneous or mucosal contact with blood, vomitus, diarrhea, saliva, amniotic fluid, or percutaneous needle-stick exposure from infected VHF patients, creating severe nosocomial transmission hazard for healthcare personnel without barrier PPE."}, {"name": "Cave or Mine Exposure Harboring Rousettus aegyptiacus Fruit Bats", "type": "Vector_Exposure", "description": "Prolonged occupational or recreational exposure to subterranean caves or abandoned mines inhabited by colonies of Egyptian fruit bats (Rousettus aegyptiacus), the primary natural reservoir host of Marburg virus."}, {"name": "Hyalomma Marginatum Tick Bite or Crushing Ticks", "type": "Vector_Exposure", "description": "Bite of infected Hyalomma ticks (principally Hyalomma marginatum marginatum or Hyalomma anatolicum) or direct cutaneous crushing of engorged ticks during agricultural work, transmitting Crimean-Congo Hemorrhagic Fever virus."}, {"name": "Slaughterhouse Contact with Viraemic Livestock Blood or Tissues", "type": "Vector_Exposure", "description": "Occupational contact with viraemic blood, body fluids, or tissues of livestock (cattle, sheep, goats) or ostriches during animal slaughter, shearing, or butchering without barrier protection."}, {"name": "Mastomys natalensis Multimammate Rat Excreta Exposure", "type": "Vector_Exposure", "description": "Ingestion of food contaminated with rodent urine/feces or inhalation of aerosolized excreta from the domestic multimammate rat (Mastomys natalensis) in endemic areas of West Africa, transmitting Lassa virus."}, {"name": "Aedes and Haemagogus Mosquito Vectors", "type": "Vector_Exposure", "description": "Bites of infected Aedes (urban/peri-domestic) or Haemagogus (forest canopy) mosquitoes transmitting Yellow fever virus in tropical endemic regions of South America and sub-Saharan Africa."}, {"name": "Unsafe Burial Rituals with Direct Handling of Deceased Bodies", "type": "Vector_Exposure", "description": "Traditional funeral preparation and burial practices involving direct physical contact and washing of deceased VHF patients, whose corpses maintain peak viral titers and remain intensely infectious."}, {"name": "Filoviridae Family Viruses (Marburg and Ebola Viruses)", "type": "Pathogen", "description": "Filamentous, enveloped negative-sense single-stranded RNA viruses (including Marburg virus, Zaire ebolavirus, and Sudan ebolavirus) causing catastrophic endothelial damage, immune cell lysis, and cytokine storm."}, {"name": "Crimean-Congo Hemorrhagic Fever Virus (CCHFV)", "type": "Pathogen", "description": "Enveloped tripartite negative-sense single-stranded RNA virus of the Orthonairovirus genus (Nairoviridae family, order Bunyavirales) triggering severe vascular leak, tissue factor activation, and consumptive coagulopathy."}, {"name": "Lassa Virus (Arenaviridae)", "type": "Pathogen", "description": "Bi-segmented ambisense single-stranded RNA virus of the Mammarenavirus genus (Arenaviridae family) endemic to West Africa, mediating severe vascular permeability, mucosal exudates, and multi-organ decompensation."}, {"name": "Yellow Fever Virus (Flaviviridae)", "type": "Pathogen", "description": "Positive-sense single-stranded enveloped RNA arbovirus belonging to the Flavivirus genus (Flaviviridae family) causing extensive midzonal hepatic necrosis (Councilman bodies), severe jaundice, and hemorrhagic collapse."}, {"name": "Spontaneous Mucosal and Gastrointestinal Hemorrhage with Diffuse Ecchymoses", "type": "Cardinal_Sign", "description": "Rapid emergence of multi-site hemorrhagic manifestations between days 3 to 7, including profuse epistaxis, bleeding gums, hematemesis ('black vomit'), melena, hematochezia, gross hematuria, and oozing from venipuncture puncture sites."}, {"name": "Non-Pruritic Erythematous Maculopapular Morbilliform Rash with Centrifugal Spread", "type": "Cardinal_Sign", "description": "Characteristic non-itchy erythematous maculopapular rash developing around days 5-7 on the trunk, neck, and limbs, accompanied by facial flushing and malar erythema, followed by fine post-eruptive desquamation in survivors."}, {"name": "Profound Capillary Leak Syndrome with Hypovolemic Distributive Shock", "type": "Cardinal_Sign", "description": "Systemic endothelial breakdown resulting in extensive vascular leakage, third-spacing, facial and periorbital edema, pulmonary edema, severe hemoconcentration, and refractory distributive/hypovolemic shock."}, {"name": "Severe Exudative Pharyngitis with Retrosternal Chest Pain", "type": "Cardinal_Sign", "description": "Severe tonsillopharyngeal inflammation with mucosal exudates and retrosternal chest pain present during initial febrile presentation, serving as a high-likelihood admission hallmark in Lassa fever."}, {"name": "Abrupt High Fever Exceeding 39C with Excruciating Lumbosacral Myalgia and Prostration", "type": "Cardinal_Sign", "description": "Explosive onset of high continuous fever (>39°C), severe chills, prostrating weakness, intense retro-orbital or frontal headache, non-purulent conjunctival injection, and incapacitating lumbar and generalized myalgia."}, {"name": "Severe Rapid-Onset Thrombocytopenia Below 50,000/uL", "type": "Admission_Lab_Imaging", "description": "Precipitous reduction in admission platelet count, routinely falling below 50,000/µL and frequently below 20,000/µL in severe cases, caused by endothelial activation, platelet aggregation, and reactive hemophagocytosis."}, {"name": "Biphasic Leukocyte Profile with Early Marked Leukopenia Followed by Toxic Granulation", "type": "Admission_Lab_Imaging", "description": "Initial severe leukopenia (WBC <3,000/µL) driven by absolute lymphopenia during days 1-3, shifting dramatically during clinical deterioration to neutrophilic leukocytosis with significant left shift and toxic granulation."}, {"name": "Massive Transaminitis with Striking AST-Predominant Ratio Exceeding 3:1", "type": "Admission_Lab_Imaging", "description": "Marked serum aspartate aminotransferase elevation (frequently 1,000 to >10,000 U/L) disproportionately exceeding alanine aminotransferase, with an AST:ALT ratio greater than 3:1 to 5:1 reflecting extensive hepatocellular, endothelial, and lymphoid lysis."}, {"name": "Consumptive Coagulopathy DIC with Marked aPTT-PT Prolongation and Severe Hypofibrinogenemia", "type": "Admission_Lab_Imaging", "description": "Severe overt disseminated intravascular coagulation manifested on admission by aPTT >60 seconds, prolonged PT/INR, marked hypofibrinogenemia (<100-110 mg/dL), and massive increases in D-dimer and fibrin degradation products."}, {"name": "Polyserosal Third-Spacing on Bedside Ultrasound (POCUS)", "type": "Admission_Lab_Imaging", "description": "Point-of-care ultrasound showing prominent gallbladder wall thickening/edema, bilateral pleural effusions, ascites, and paralytic ileus secondary to acute systemic microvascular leakage, in the absence of surgical pathology."}, {"name": "Complete Absence of Travel or Residence in VHF Endemic Regions Within Preceding 21 Days", "type": "Exclusion_Criterion", "description": "Lack of travel, residence, or direct contact with suspected/confirmed patients from known VHF endemic zones (sub-Saharan Africa, rural Anatolia, Central Asia, Balkans, South America) within the preceding 21 days reliably excludes acute VHF."}, {"name": "Preserved Normal Platelet Count and Normal Coagulation Parameters in Toxic Shock", "type": "Exclusion_Criterion", "description": "A normal platelet count (>150,000/µL) accompanied by normal PT/INR and aPTT in a patient presenting in septic or toxic shock effectively excludes acute Viral Hemorrhagic Fever."}, {"name": "Absence of Transaminitis with AST and ALT Within Normal Reference Limits", "type": "Exclusion_Criterion", "description": "Normal serum transaminases (AST and ALT within normal reference ranges) during an acute toxic febrile illness rules out VHF, as hepatotropic and endothelial necrosis universally causes marked transaminase elevations."}, {"name": "High Peripheral Parasitemia on Giemsa-Stained Thick and Thin Blood Smears", "type": "Exclusion_Criterion", "description": "Presence of high-density intraerythrocytic Plasmodium falciparum ring forms responding promptly to IV artesunate without viral hemorrhagic progression or secondary transmission excludes primary VHF."}, {"name": "Severe Falciparum Malaria", "type": "Disease", "description": "Leading look-alike parasitic infection presenting with high fevers, rigors, hemolytic anemia, and splenomegaly, distinguished by high parasitemia on blood smear and response to IV artesunate."}, {"name": "Severe Dengue (Dengue Shock Syndrome)", "type": "Disease", "description": "Arboviral look-alike presenting with thrombocytopenia and plasma leakage, distinguished by timing of leak strictly at defervescence (days 3-7), transaminases rarely exceeding 1,000 U/L, and absence of human-to-human body fluid transmission."}, {"name": "Leptospirosis (Weil Disease)", "type": "Disease", "description": "Bacterial zoonotic look-alike presenting with biphasic fever, severe calf tenderness, conjunctival suffusion, direct hyperbilirubinemia, marked neutrophilic leukocytosis from day 1, and prompt response to IV penicillin or ceftriaxone."}, {"name": "Fulminant Meningococcemia and Septic Shock", "type": "Disease", "description": "Bacterial sepsis look-alike characterized by rapidly progressive purpura fulminans, markedly elevated procalcitonin (>10 ng/mL), absence of viral prodrome, and rapid microbiological response to parenteral cephalosporins."}, {"name": "Early Intravenous Ribavirin in CCHF and Lassa Fever", "type": "Drug_Response", "description": "Early administration of intravenous or oral Ribavirin (within the first 6 days of symptom onset) demonstrates marked reduction in viral load and mortality in Crimean-Congo Hemorrhagic Fever and Lassa Fever."}, {"name": "Monoclonal Antibody Cocktails for Zaire Ebolavirus (Inmazeb and Ebanga)", "type": "Drug_Response", "description": "Neutralizing monoclonal antibody therapeutics (Inmazeb [atoltivimab, maftivimab, odesivimab] and Ebanga [ansuvimab]) providing substantial survival benefit and viral clearance when administered early in confirmed Zaire ebolavirus."}, {"name": "Total Refractoriness to Broad-Spectrum Antibacterial Therapy", "type": "Drug_Response", "description": "Complete lack of clinical defervescence, hemodynamic stabilization, or laboratory improvement under broad-spectrum antibacterial regimens (carbapenems, third-generation cephalosporins, vancomycin)."}, {"name": "Filovirus Intrinsic Resistance to Ribavirin", "type": "Drug_Response", "description": "Filoviruses (Ebola virus and Marburg virus) exhibit intrinsic non-responsiveness to Ribavirin therapy, showing no suppression of viremia or survival improvement."}], "relationships": [{"source": "Viral Hemorrhagic Fevers", "target": "Direct Contact with Infected Body Fluids and Nosocomial Blood Exposure", "keywords": "EXPOSURE_TO, secondary human-to-human transmission, nosocomial infection, body fluids", "description": "[EXPOSURE_TO] Catastrophic human-to-human transmission occurs via direct cutaneous or mucosal contact with blood, vomitus, diarrhea, saliva, or contaminated medical equipment, posing extreme hazard to healthcare workers."}, {"source": "Viral Hemorrhagic Fevers", "target": "Cave or Mine Exposure Harboring Rousettus aegyptiacus Fruit Bats", "keywords": "EXPOSURE_TO, natural bat reservoir, cave exposure, filovirus", "description": "[EXPOSURE_TO] Primary zoonotic infection of Marburg virus occurs after visiting or working in underground mines or caves colonized by Egyptian fruit bats (Rousettus aegyptiacus)."}, {"source": "Viral Hemorrhagic Fevers", "target": "Hyalomma Marginatum Tick Bite or Crushing Ticks", "keywords": "TRANSMITTED_BY, tick vector, Hyalomma marginatum, CCHF transmission", "description": "[TRANSMITTED_BY] Crimean-Congo Hemorrhagic Fever virus is transmitted to humans through bites of Hyalomma marginatum marginatum ticks or direct crushing of engorged ticks during agricultural activities."}, {"source": "Viral Hemorrhagic Fevers", "target": "Slaughterhouse Contact with Viraemic Livestock Blood or Tissues", "keywords": "EXPOSURE_TO, occupational risk, animal tissue exposure, livestock viraemia", "description": "[EXPOSURE_TO] Occupational transmission occurs in livestock farmers, abattoir workers, and veterinarians through contact with viraemic blood and tissues of infected sheep, cattle, or ostriches during slaughtering."}, {"source": "Viral Hemorrhagic Fevers", "target": "Mastomys natalensis Multimammate Rat Excreta Exposure", "keywords": "EXPOSURE_TO, rodent reservoir, Mastomys natalensis, Lassa virus", "description": "[EXPOSURE_TO] Transmission of Lassa virus occurs through ingestion of food contaminated with rodent urine/feces or inhalation of aerosolized excreta from peri-domestic Mastomys natalensis rats in West Africa."}, {"source": "Viral Hemorrhagic Fevers", "target": "Aedes and Haemagogus Mosquito Vectors", "keywords": "TRANSMITTED_BY, arbovirus vector, mosquito bite, Yellow fever", "description": "[TRANSMITTED_BY] Yellow fever virus is inoculated into humans via the bites of infected Aedes aegypti (urban transmission) or canopy Haemagogus mosquitoes (sylvan forest transmission)."}, {"source": "Viral Hemorrhagic Fevers", "target": "Unsafe Burial Rituals with Direct Handling of Deceased Bodies", "keywords": "EXPOSURE_TO, funeral transmission, high viraemic corpse, contact hazard", "description": "[EXPOSURE_TO] Direct physical contact with the body of a deceased patient during traditional funeral and washing rituals drives rapid secondary transmission due to high post-mortem tissue viraemia."}, {"source": "Viral Hemorrhagic Fevers", "target": "Filoviridae Family Viruses (Marburg and Ebola Viruses)", "keywords": "HAS_PATHOGEN, Filoviridae, Marburg virus, Ebola virus, filovirus", "description": "[HAS_PATHOGEN] Caused by enveloped non-segmented negative-sense RNA filoviruses including Marburg virus, Zaire ebolavirus, and Sudan ebolavirus, causing massive endothelial lysis and lymphoid depletion."}, {"source": "Viral Hemorrhagic Fevers", "target": "Crimean-Congo Hemorrhagic Fever Virus (CCHFV)", "keywords": "HAS_PATHOGEN, Nairoviridae, Bunyavirales, tickborne bunyavirus", "description": "[HAS_PATHOGEN] Caused by Crimean-Congo Hemorrhagic Fever virus, an enveloped tripartite negative-sense RNA virus in the Orthonairovirus genus of the Nairoviridae family."}, {"source": "Viral Hemorrhagic Fevers", "target": "Lassa Virus (Arenaviridae)", "keywords": "HAS_PATHOGEN, Arenaviridae, Mammarenavirus, ambisense RNA virus", "description": "[HAS_PATHOGEN] Caused by Lassa virus, an ambisense bi-segmented RNA virus belonging to the Mammarenavirus genus within the Arenaviridae family."}, {"source": "Viral Hemorrhagic Fevers", "target": "Yellow Fever Virus (Flaviviridae)", "keywords": "HAS_PATHOGEN, Flaviviridae, Flavivirus, arbovirus", "description": "[HAS_PATHOGEN] Caused by Yellow fever virus, a positive-sense single-stranded enveloped RNA flavivirus producing severe midzonal hepatocellular necrosis and coagulopathy."}, {"source": "Viral Hemorrhagic Fevers", "target": "Spontaneous Mucosal and Gastrointestinal Hemorrhage with Diffuse Ecchymoses", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, hemorrhagic diathesis", "description": "[HAS_PATHOGNOMONIC_HALLMARK] The appearance of spontaneous multisite mucosal bleeding (epistaxis, hematemesis, melena, gross hematuria) and needle-puncture ecchymoses between days 3-7 confirms decompensated hemorrhagic diathesis."}, {"source": "Viral Hemorrhagic Fevers", "target": "Non-Pruritic Erythematous Maculopapular Morbilliform Rash with Centrifugal Spread", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, cutaneous hallmark", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Emergence of a non-pruritic, erythematous maculopapular rash around day 5-7 spreading centrifugally across the trunk and neck, followed by fine desquamation, is a pathognomonic physical sign of Filovirus infection."}, {"source": "Viral Hemorrhagic Fevers", "target": "Profound Capillary Leak Syndrome with Hypovolemic Distributive Shock", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, vascular collapse", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Diffuse endothelial breakdown causing massive microvascular leakage, third-spacing, facial edema, hemoconcentration, and refractory hypovolemic/distributive shock characterizes the fatal toxic phase."}, {"source": "Viral Hemorrhagic Fevers", "target": "Severe Exudative Pharyngitis with Retrosternal Chest Pain", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, prodromal hallmark", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Marked tonsillopharyngeal exudative inflammation accompanied by severe retrosternal chest pain and facial flushing serves as a high-likelihood admission hallmark, especially prominent in Lassa fever."}, {"source": "Viral Hemorrhagic Fevers", "target": "Abrupt High Fever Exceeding 39C with Excruciating Lumbosacral Myalgia and Prostration", "keywords": "HAS_PATHOGNOMONIC_HALLMARK, smoking gun, rules in, acute prodrome", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Sudden onset of high continuous fever (>39°C), conjunctival injection, severe prostration, and excruciating lumbosacral back pain and myalgias marks the acute prodrome of VHF."}, {"source": "Viral Hemorrhagic Fevers", "target": "Severe Rapid-Onset Thrombocytopenia Below 50,000/uL", "keywords": "EXHIBITS_LAB_PATTERN, thrombocytopenia, CBC admission hallmark, triage lab", "description": "[EXHIBITS_LAB_PATTERN] Admission CBC routinely displays profound thrombocytopenia rapidly falling below 50,000/µL and frequently below 20,000/µL during the early toxic phase, reflecting platelet consumption and reactive hemophagocytosis."}, {"source": "Viral Hemorrhagic Fevers", "target": "Biphasic Leukocyte Profile with Early Marked Leukopenia Followed by Toxic Granulation", "keywords": "EXHIBITS_LAB_PATTERN, leukopenia, leukocytosis with left shift, admission CBC", "description": "[EXHIBITS_LAB_PATTERN] Triage CBC reveals an initial marked leukopenia (WBC <3,000/µL) with profound lymphopenia on days 1-3, shifting abruptly to prominent neutrophilic leukocytosis with toxic granulation as tissue necrosis progresses."}, {"source": "Viral Hemorrhagic Fevers", "target": "Massive Transaminitis with Striking AST-Predominant Ratio Exceeding 3:1", "keywords": "EXHIBITS_LAB_PATTERN, transaminitis, AST greater than ALT, hepatic injury", "description": "[EXHIBITS_LAB_PATTERN] Liver function tests demonstrate marked AST elevations (1,000 to >10,000 U/L) that dramatically exceed ALT with an AST:ALT ratio greater than 3:1 to 5:1, signaling widespread hepatocellular, endothelial, and lymphoid lysis."}, {"source": "Viral Hemorrhagic Fevers", "target": "Consumptive Coagulopathy DIC with Marked aPTT-PT Prolongation and Severe Hypofibrinogenemia", "keywords": "EXHIBITS_LAB_PATTERN, DIC, coagulopathy, aPTT prolongation, hypofibrinogenemia", "description": "[EXHIBITS_LAB_PATTERN] Coagulation profile reveals profound prolongation of aPTT (>60 seconds) and PT/INR, severe hypofibrinogenemia (<100 mg/dL), and massive surges in D-dimer and fibrin degradation products."}, {"source": "Viral Hemorrhagic Fevers", "target": "Polyserosal Third-Spacing on Bedside Ultrasound (POCUS)", "keywords": "EXHIBITS_LAB_PATTERN, POCUS, ultrasound, polyserositis, gallbladder wall edema", "description": "[EXHIBITS_LAB_PATTERN] Point-of-care ultrasound demonstrates diffuse gallbladder wall thickening, ascites, and bilateral pleural effusions resulting from acute systemic capillary leakage, without bacterial focal peritonitis."}, {"source": "Viral Hemorrhagic Fevers", "target": "Complete Absence of Travel or Residence in VHF Endemic Regions Within Preceding 21 Days", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, incubation window", "description": "[RULED_OUT_BY] Absence of travel to, residence in, or contact with cases from VHF endemic zones within the preceding 21-day maximum incubation window reliably excludes acute Viral Hemorrhagic Fever."}, {"source": "Viral Hemorrhagic Fevers", "target": "Preserved Normal Platelet Count and Normal Coagulation Parameters in Toxic Shock", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, normal platelets", "description": "[RULED_OUT_BY] A normal platelet count (>150,000/µL) combined with normal PT/INR and aPTT in a patient with severe prostration or shock effectively rules out acute VHF, where consumptive coagulopathy is universal."}, {"source": "Viral Hemorrhagic Fevers", "target": "Absence of Transaminitis with AST and ALT Within Normal Reference Limits", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, normal transaminases", "description": "[RULED_OUT_BY] Normal serum transaminase levels (AST and ALT within reference ranges) during the acute toxic phase rules out VHF, as hepatic and endothelial cytolysis universally induces significant transaminitis."}, {"source": "Viral Hemorrhagic Fevers", "target": "High Peripheral Parasitemia on Giemsa-Stained Thick and Thin Blood Smears", "keywords": "RULED_OUT_BY, exclusion criterion, negative boundary, malaria smear", "description": "[RULED_OUT_BY] High-density Plasmodium falciparum parasitemia on blood smears resolving promptly upon parenteral artesunate without coagulopathy or nosocomial transmission rules out primary VHF."}, {"source": "Viral Hemorrhagic Fevers", "target": "Severe Falciparum Malaria", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, malaria contrast", "description": "[DIFFERENTIATED_FROM] Severe Falciparum Malaria presents with cyclic high fevers, rigors, hemolytic anemia, and positive blood smears resolving with artesunate, whereas VHF displays AST:ALT ratios >3:1, early maculopapular rash, spontaneous mucosal bleeding, and extreme human-to-human body fluid transmission."}, {"source": "Viral Hemorrhagic Fevers", "target": "Severe Dengue (Dengue Shock Syndrome)", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, dengue contrast", "description": "[DIFFERENTIATED_FROM] Severe Dengue develops circulatory collapse strictly at defervescence (days 3-7) with transaminases typically below 1,000 U/L and zero human-to-human body fluid transmission, whereas VHF causes shock during ongoing high fever, massive AST elevation (>2,000-10,000 U/L), and severe nosocomial transmission risks."}, {"source": "Viral Hemorrhagic Fevers", "target": "Leptospirosis (Weil Disease)", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, leptospirosis contrast", "description": "[DIFFERENTIATED_FROM] Leptospirosis features marked initial neutrophilic leukocytosis without early leukopenia, intense calf tenderness, conjunctival suffusion without discharge, profound direct hyperbilirubinemia, and prompt defervescence to penicillin or ceftriaxone, unlike VHF which exhibits early leukopenia, massive AST-dominant transaminitis, and complete antibiotic refractoriness."}, {"source": "Viral Hemorrhagic Fevers", "target": "Fulminant Meningococcemia and Septic Shock", "keywords": "DIFFERENTIATED_FROM, look-alike, differential diagnosis, bacterial sepsis contrast", "description": "[DIFFERENTIATED_FROM] Meningococcemia presents with rapidly progressive purpura fulminans, markedly elevated procalcitonin (>10 ng/mL), absence of viral prodrome, and rapid response to intravenous cephalosporins, in contrast to VHF which displays viral prodromes, massive transaminitis, and refractoriness to antibacterial therapy."}, {"source": "Viral Hemorrhagic Fevers", "target": "Early Intravenous Ribavirin in CCHF and Lassa Fever", "keywords": "RESPONDS_TO, antiviral therapy, ribavirin, early intervention", "description": "[RESPONDS_TO] Crimean-Congo Hemorrhagic Fever and Lassa Fever show marked reductions in viremia, hemorrhagic severity, and mortality when treated within the first 6 days of symptom onset with intravenous or oral Ribavirin."}, {"source": "Viral Hemorrhagic Fevers", "target": "Monoclonal Antibody Cocktails for Zaire Ebolavirus (Inmazeb and Ebanga)", "keywords": "RESPONDS_TO, targeted immunotherapy, monoclonal antibodies, Ebola therapeutics", "description": "[RESPONDS_TO] Confirmed Zaire ebolavirus infection demonstrates significant survival benefit and rapid clearance of viremia when treated early with neutralizing monoclonal antibody cocktails (Inmazeb [atoltivimab, maftivimab, odesivimab] or Ebanga [ansuvimab])."}, {"source": "Viral Hemorrhagic Fevers", "target": "Total Refractoriness to Broad-Spectrum Antibacterial Therapy", "keywords": "INTRINSICALLY_RESISTANT_TO, antibiotic failure, intrinsic resistance, antibacterial refractoriness", "description": "[INTRINSICALLY_RESISTANT_TO] Viral Hemorrhagic Fevers exhibit absolute clinical refractoriness to broad-spectrum antibacterial regimens (carbapenems, third-generation cephalosporins, vancomycin), distinguishing viral cytolysis from bacterial sepsis."}, {"source": "Viral Hemorrhagic Fevers", "target": "Filovirus Intrinsic Resistance to Ribavirin", "keywords": "INTRINSICALLY_RESISTANT_TO, antiviral resistance, filovirus, Ribavirin inefficacy", "description": "[INTRINSICALLY_RESISTANT_TO] Filoviruses (Marburg virus and Ebola virus) possess intrinsic resistance to Ribavirin, demonstrating no suppression of viremia or survival improvement."}]}}
{"case_id": "zika_virus", "disease": "Zika Virus", "extraction": {"entities": [{"name": "Zika Virus", "type": "Disease", "description": "An acute mosquito-borne arboviral disease caused by Zika virus (flavivirus), characterized by a mild self-limiting illness with low-grade fever, pruritic maculopapular exanthem, bilateral non-purulent conjunctivitis, and migratory polyarthralgia, with critical potential for severe neurotropic and teratogenic complications including Guillain-Barré syndrome and Congenital Zika Syndrome."}, {"name": "Diurnal Aedes Mosquito Bite (Aedes aegypti and Aedes albopictus)", "type": "Vector_Exposure", "description": "Bite inoculations from infected female daytime-biting mosquitoes belonging to the Aedes genus (primarily Aedes aegypti and Aedes albopictus), with peak biting activity occurring during early morning and late afternoon."}, {"name": "Unprotected Sexual Contact with Infected Partner", "type": "Vector_Exposure", "description": "Secondary non-vector sexual transmission of Zika virus through unprotected vaginal, anal, or oral sex due to prolonged shedding of infectious viral particles in semen (up to several months post-infection), vaginal fluids, and saliva."}, {"name": "Transplacental Vertical Transmission During Pregnancy", "type": "Vector_Exposure", "description": "In utero maternal-to-fetal transmission occurring across any gestational trimester, crossing the placental barrier to infect fetal neural progenitor cells and conferring significant risk of severe embryopathy."}, {"name": "Blood Transfusion or Organ Transplantation Exposure", "type": "Vector_Exposure", "description": "Iatrogenic hematogenous or tissue-mediated transmission through transfusion of contaminated, unscreened blood products or transplantation of infected donor organs."}, {"name": "Travel to or Residence in Zika Endemic Tropical Regions", "type": "Vector_Exposure", "description": "Epidemiological exposure through travel to or residence in tropical and subtropical regions of the Americas, Caribbean, Pacific Islands, Southeast Asia, or Africa with established active Aedes transmission."}, {"name": "Zika Virus (ZIKV Flavivirus)", "type": "Pathogen", "description": "An enveloped, positive-sense single-stranded RNA arbovirus belonging to the genus Flavivirus within the family Flaviviridae, closely related to Spondweni virus and dengue virus, possessing neurotropic and fetotropic pathogenicity."}, {"name": "Mild Non-Spiking Low-Grade Fever (37.5°C–38.5°C)", "type": "Cardinal_Sign", "description": "Mild, non-spiking elevation of core body temperature typically between 37.5°C and 38.5°C, self-limiting within 2 to 7 days or occasionally completely absent (subclinical/afebrile), lacking the rigors of malaria or high continuous fever of dengue."}, {"name": "Pruritic Centrifugal Maculopapular Exanthem", "type": "Cardinal_Sign", "description": "Erythematous, punctate, finely maculopapular and notably pruritic skin eruption appearing early (day 1–2) on the face and spreading centrifugally to the trunk, extremities, palms, and soles over several days."}, {"name": "Bilateral Non-Purulent Conjunctival Hyperemia", "type": "Cardinal_Sign", "description": "Diffuse injection of bulbar and palpebral conjunctivae occurring bilaterally without purulent exudate, eyelid crusting, or photophobia, appearing early in the symptomatic phase."}, {"name": "Migratory Polyarthralgia with Periarticular Edema", "type": "Cardinal_Sign", "description": "Mild to moderate migratory joint pain predominantly involving small peripheral joints of the hands, wrists, knees, and ankles, accompanied by soft-tissue periarticular edema or tenosynovitis without joint destruction."}, {"name": "Congenital Microcephaly and Intracranial Calcifications", "type": "Cardinal_Sign", "description": "Severe intrauterine neurodevelopmental disruption in neonates presenting with disproportionate microcephaly, corticomedullary subcortical calcifications, ventriculomegaly, simplified gyral pattern, chorioretinal atrophy, and arthrogryposis (Congenital Zika Syndrome)."}, {"name": "Post-Infectious Guillain-Barré Syndrome Ascending Paralysis", "type": "Cardinal_Sign", "description": "Acute post-infectious autoimmune polyradiculoneuropathy manifesting 1 to 3 weeks following acute Zika illness, characterized by progressive symmetrical ascending flaccid weakness, hyporeflexia/areflexia, and potential respiratory compromise."}, {"name": "Normal or Mildly Depressed Leukocyte Count without Severe Leukopenia", "type": "Admission_Lab_Imaging", "description": "Triage complete blood count showing normal or mild leukopenia (total WBC 3,500–5,000/µL), lacking the profound leukopenia (<2,000/µL) frequently seen in acute severe dengue."}, {"name": "Mild Thrombocytopenia without Severe Platelet Depletion", "type": "Admission_Lab_Imaging", "description": "Peripheral platelet counts demonstrating normal levels or mild thrombocytopenia (typically 100,000–150,000/µL), with severe thrombocytopenia (<50,000/µL) being exceptionally rare in uncomplicated infection."}, {"name": "Normal Hematocrit with Absence of Hemoconcentration or Plasma Leakage", "type": "Admission_Lab_Imaging", "description": "Admission baseline hematocrit values showing normal stability without hemoconcentration (hematocrit increase ≥ 20%), capillary hyperpermeability, or plasma leakage."}, {"name": "Normal Bedside POCUS without Serosal Effusion or Gallbladder Wall Thickening", "type": "Admission_Lab_Imaging", "description": "Point-of-care ultrasonography (POCUS) demonstrating normal liver, spleen, and gallbladder wall architecture, with complete absence of ascites, pleural effusions, or pericardial fluid."}, {"name": "Zika Virus RNA Detection via RT-PCR in Acute Serum or Urine", "type": "Admission_Lab_Imaging", "description": "Confirmatory molecular diagnostic detection of Zika viral RNA by reverse transcription-polymerase chain reaction (RT-PCR) in acute-phase serum (within 10–11 days of symptom onset) or urine."}, {"name": "Severe Plasma Leakage, Hemoconcentration, or Hypovolemic Shock", "type": "Exclusion_Criterion", "description": "Presence of objective plasma leakage signs including pleural effusions, ascites, hemoconcentration (hematocrit rise ≥ 20%), narrow pulse pressure, or hypovolemic shock, which definitively rules out uncomplicated Zika virus."}, {"name": "Profound Thrombocytopenia (<50,000/µL) with Spontaneous Hemorrhage", "type": "Exclusion_Criterion", "description": "Platelet counts dropping below 50,000/µL, spontaneous petechiae, ecchymoses, or mucosal bleeding, which effectively excludes uncomplicated Zika virus infection."}, {"name": "Crippling Symmetrical Polyarthritis with Inability to Ambulate", "type": "Exclusion_Criterion", "description": "Incapacitating, severe inflammatory polyarthritis preventing ambulation or hand flexion with prolonged morning stiffness, which points to Chikungunya rather than Zika virus."}, {"name": "Purulent Conjunctival Exudate with Photophobia", "type": "Exclusion_Criterion", "description": "Presence of thick purulent or mucopurulent ocular discharge, matting of eyelids, or marked photophobia, which rules out Zika non-purulent conjunctivitis in favor of bacterial or adenoviral conjunctivitis."}, {"name": "Prolonged High Fever Exceeding 7 Days", "type": "Exclusion_Criterion", "description": "High continuous or spiking fever persisting beyond 7 days, which is incompatible with the typically mild, self-limiting 2–7 day febrile course of acute Zika virus."}, {"name": "Prominent Respiratory Symptoms (Cough, Coryza) or Koplik Spots", "type": "Exclusion_Criterion", "description": "Presence of pronounced upper or lower respiratory symptoms including persistent cough, purulent coryza, or pathognomonic mucosal Koplik spots, ruling out Zika virus in favor of measles or common respiratory infections."}, {"name": "Dengue Fever", "type": "Disease", "description": "Flavivirus infection transmitted by Aedes mosquitoes, characterized by high continuous fever (>39°C), severe retro-orbital headache, prostrating myalgia/bone pain, profound thrombocytopenia (<50,000/µL), and risks of plasma leakage and dengue shock syndrome."}, {"name": "Chikungunya Virus Disease", "type": "Disease", "description": "Alphavirus infection transmitted by Aedes mosquitoes, presenting with sudden high-spiking fever and crippling, severe, symmetrical polyarthritis predominantly affecting peripheral small joints, frequently persisting chronically for months to years."}, {"name": "Measles (Rubeola)", "type": "Disease", "description": "Highly contagious paramyxovirus infection presenting with high fevers, the classic triad of cough, coryza, and photophobic conjunctivitis, followed by pathognomonic Koplik spots and a cephalocaudal maculopapular rash."}, {"name": "Rubella (German Measles)", "type": "Disease", "description": "Togavirus infection presenting with mild fever, fine pink maculopapular rash, and prominent tender retroauricular, suboccipital, and posterior cervical lymphadenopathy, without marked conjunctivitis or mosquito vector transmission."}, {"name": "Parvovirus B19 Infection", "type": "Disease", "description": "Erythrovirus infection presenting in children with an erythematous 'slapped-cheek' facial rash and reticular body exanthem, or in adult females with acute symmetric polyarthropathy mimicking rheumatoid arthritis, without tropical vector exposure."}, {"name": "Acetaminophen Symptomatic Analgesia and Antipyresis", "type": "Drug_Response", "description": "First-line oral acetaminophen (paracetamol) therapy providing effective symptomatic reduction of mild fever, headache, and peripheral arthralgias, avoiding platelet dysfunction before dengue is excluded."}, {"name": "Oral Second-Generation Antihistamines for Pruritus Relief", "type": "Drug_Response", "description": "Oral second-generation H1-receptor antagonists (e.g., cetirizine, loratadine) providing targeted symptomatic relief for the pruritic component of the maculopapular rash."}, {"name": "Supportive Fluid Hydration and Rest", "type": "Drug_Response", "description": "Conservative clinical management with adequate oral fluid replenishment and rest leading to spontaneous disease resolution within 2 to 7 days, as no specific antiviral therapy exists."}, {"name": "Empirical Antibacterial Therapy Refractoriness", "type": "Drug_Response", "description": "Intrinsic unresponsiveness to empirical broad-spectrum antibacterial agents (beta-lactams, fluoroquinolones, macrolides), confirming a non-bacterial, viral etiology."}], "relationships": [{"source": "Zika Virus", "target": "Diurnal Aedes Mosquito Bite (Aedes aegypti and Aedes albopictus)", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] Primarily transmitted to humans through the bites of infected female diurnal Aedes mosquitoes (Aedes aegypti and Aedes albopictus) active during early morning and late afternoon hours."}, {"source": "Zika Virus", "target": "Unprotected Sexual Contact with Infected Partner", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] Transmitted directly between humans via sexual intercourse due to prolonged shedding of replication-competent virus in male semen and female genital tract secretions."}, {"source": "Zika Virus", "target": "Transplacental Vertical Transmission During Pregnancy", "keywords": "TRANSMITTED_BY", "description": "[TRANSMITTED_BY] Transmitted vertically from mother to fetus across the placenta throughout pregnancy, directly infecting embryonic and fetal neuroprogenitor cells."}, {"source": "Zika Virus", "target": "Blood Transfusion or Organ Transplantation Exposure", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Contracted via direct hematogenous inoculation through transfusion of contaminated, unscreened blood products or transplantation of infected solid organs."}, {"source": "Zika Virus", "target": "Travel to or Residence in Zika Endemic Tropical Regions", "keywords": "EXPOSURE_TO", "description": "[EXPOSURE_TO] Contracted via epidemiological exposure during travel to or residence in tropical and subtropical regions across the Americas, Caribbean, Pacific Islands, Southeast Asia, or Africa where Aedes vectors circulate."}, {"source": "Zika Virus", "target": "Zika Virus (ZIKV Flavivirus)", "keywords": "HAS_PATHOGEN", "description": "[HAS_PATHOGEN] Caused etiologically by Zika virus, an enveloped, positive-sense single-stranded RNA virus of the Flavivirus genus within the Flaviviridae family."}, {"source": "Zika Virus", "target": "Mild Non-Spiking Low-Grade Fever (37.5°C–38.5°C)", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Presents classically with mild, non-spiking low-grade fever (37.5°C–38.5°C) lasting 2–7 days, or a completely afebrile subclinical course, contrasting with the high spiking rigors of dengue or malaria."}, {"source": "Zika Virus", "target": "Pruritic Centrifugal Maculopapular Exanthem", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Manifests as an erythematous, finely maculopapular, intensely pruritic eruption appearing on days 1–2 on the face and rapidly spreading centrifugally to the trunk, limbs, palms, and soles."}, {"source": "Zika Virus", "target": "Bilateral Non-Purulent Conjunctival Hyperemia", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Features diffuse bilateral bulbar and palpebral conjunctival injection without purulent discharge, eyelid crusting, or photophobia as an early cardinal sign."}, {"source": "Zika Virus", "target": "Migratory Polyarthralgia with Periarticular Edema", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Manifests as mild to moderate migratory polyarthralgia primarily targeting small peripheral joints of the hands, wrists, knees, and ankles, accompanied by soft tissue periarticular puffiness without destructive arthritis."}, {"source": "Zika Virus", "target": "Congenital Microcephaly and Intracranial Calcifications", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Causes severe teratogenic congenital malformations in infants infected in utero, characterized by severe microcephaly, corticomedullary intracranial calcifications, ventriculomegaly, simplified gyral pattern, chorioretinopathy, and arthrogryposis."}, {"source": "Zika Virus", "target": "Post-Infectious Guillain-Barré Syndrome Ascending Paralysis", "keywords": "HAS_PATHOGNOMONIC_HALLMARK", "description": "[HAS_PATHOGNOMONIC_HALLMARK] Triggers acute post-infectious autoimmune polyradiculoneuropathy 1 to 3 weeks post-infection, leading to progressive ascending symmetrical flaccid weakness, hyporeflexia, and potential respiratory failure."}, {"source": "Zika Virus", "target": "Normal or Mildly Depressed Leukocyte Count without Severe Leukopenia", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Admission laboratory profile demonstrates normal or mildly decreased total leukocyte count (3,500–5,000/µL), notably lacking marked leukopenia (<2,000/µL)."}, {"source": "Zika Virus", "target": "Mild Thrombocytopenia without Severe Platelet Depletion", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Shows normal or only mildly reduced platelet counts (100,000–150,000/µL); drop below 50,000/µL is exceptionally rare in uncomplicated infection."}, {"source": "Zika Virus", "target": "Normal Hematocrit with Absence of Hemoconcentration or Plasma Leakage", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Preserves stable baseline hematocrit without evidence of vascular hyperpermeability, hemoconcentration, or plasma leakage."}, {"source": "Zika Virus", "target": "Normal Bedside POCUS without Serosal Effusion or Gallbladder Wall Thickening", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Bedside point-of-care ultrasound reveals completely normal gallbladder wall thickness, liver, and spleen, with absence of pleural effusion, ascites, or pericardial fluid."}, {"source": "Zika Virus", "target": "Zika Virus RNA Detection via RT-PCR in Acute Serum or Urine", "keywords": "EXHIBITS_LAB_PATTERN", "description": "[EXHIBITS_LAB_PATTERN] Confirmed at admission by direct molecular detection of viral RNA via RT-PCR in acute serum (detectable up to 10–11 days from onset) or urine."}, {"source": "Zika Virus", "target": "Severe Plasma Leakage, Hemoconcentration, or Hypovolemic Shock", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Presence of third-space plasma leakage (pleural effusion, ascites, hemoconcentration with hematocrit increase ≥ 20%), narrow pulse pressure, or hypovolemic shock definitively rules out uncomplicated Zika virus."}, {"source": "Zika Virus", "target": "Profound Thrombocytopenia (<50,000/µL) with Spontaneous Hemorrhage", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Severe platelet count depression (<50,000/µL), spontaneous mucosal hemorrhage, or petechiae completely rules out uncomplicated Zika virus."}, {"source": "Zika Virus", "target": "Crippling Symmetrical Polyarthritis with Inability to Ambulate", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Severe, crippling, incapacitating polyarthritis that prevents walking or finger flexion with intense morning stiffness rules out Zika virus in favor of Chikungunya."}, {"source": "Zika Virus", "target": "Purulent Conjunctival Exudate with Photophobia", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Presence of copious purulent eye discharge, crusting, pseudomembranes, or severe photophobia rules out the benign non-purulent conjunctival hyperemia of Zika virus."}, {"source": "Zika Virus", "target": "Prolonged High Fever Exceeding 7 Days", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Prolonged high-grade fever persisting longer than 7 days rules out acute uncomplicated Zika virus infection, which typically subsides within 2 to 7 days."}, {"source": "Zika Virus", "target": "Prominent Respiratory Symptoms (Cough, Coryza) or Koplik Spots", "keywords": "RULED_OUT_BY", "description": "[RULED_OUT_BY] Prominent upper or lower respiratory manifestations such as heavy cough, purulent nasal discharge, or pathognomonic Koplik spots rules out Zika virus in favor of measles or acute respiratory virus infections."}, {"source": "Zika Virus", "target": "Dengue Fever", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Dengue Fever, which causes high continuous/biphasic fever (>39°C), severe retro-orbital headache, profound thrombocytopenia (<50,000/µL), hemoconcentration, and life-threatening plasma leakage/shock, whereas Zika presents with low-grade fever, pruritic maculopapular rash, and non-purulent conjunctivitis without plasma leak."}, {"source": "Zika Virus", "target": "Chikungunya Virus Disease", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Chikungunya Virus Disease, which presents with sudden high-spiking fever and incapacitating, severe, symmetrical polyarthritis predominantly affecting peripheral small joints that frequently persists for months to years, compared to Zika's mild transient polyarthralgia and non-purulent conjunctivitis."}, {"source": "Zika Virus", "target": "Measles (Rubeola)", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Measles, which manifests with high fever, prominent triad of cough, coryza, and photophobic conjunctivitis, and buccal Koplik spots, all of which are absent in Zika virus."}, {"source": "Zika Virus", "target": "Rubella (German Measles)", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Rubella, which features prominent tender retroauricular and suboccipital lymphadenopathy and lacks the intense conjunctival injection and mosquito vector transmission profile of Zika virus."}, {"source": "Zika Virus", "target": "Parvovirus B19 Infection", "keywords": "DIFFERENTIATED_FROM", "description": "[DIFFERENTIATED_FROM] Differentiated from Parvovirus B19, which causes classic slapped-cheek facial rash in children or symmetric rheumatoid-like polyarthropathy in adult women without tropical mosquito vector exposure or conjunctivitis."}, {"source": "Zika Virus", "target": "Acetaminophen Symptomatic Analgesia and Antipyresis", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Symptomatically responsive to oral acetaminophen (paracetamol) for alleviation of low-grade fever and mild joint pain; preferred initial analgesic while awaiting exclusion of dengue."}, {"source": "Zika Virus", "target": "Oral Second-Generation Antihistamines for Pruritus Relief", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Symptomatically responsive to oral second-generation H1-receptor antagonists (cetirizine, loratadine) for effective relief of the pruritic maculopapular rash."}, {"source": "Zika Virus", "target": "Supportive Fluid Hydration and Rest", "keywords": "RESPONDS_TO", "description": "[RESPONDS_TO] Clinically responsive to conservative supportive care with oral fluid replenishment and rest, spontaneously resolving over 2 to 7 days in uncomplicated cases."}, {"source": "Zika Virus", "target": "Empirical Antibacterial Therapy Refractoriness", "keywords": "INTRINSICALLY_RESISTANT_TO", "description": "[INTRINSICALLY_RESISTANT_TO] Intrinsically unresponsive to empirical broad-spectrum antibacterial regimens (such as beta-lactams, fluoroquinolones, or macrolides) due to its viral etiology."}]}}
